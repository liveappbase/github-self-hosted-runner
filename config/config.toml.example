# config.toml — runscaler 0.9.5's configuration for this host. install creates /Users/ci/.config/runner/config.toml
# (0600) from this example ONLY when there is none, and sets cpu and memory below from this Mac. Then fill each
# [[scaleset]] (README: "Configure the scale sets"). Top-level keys must stay ABOVE the first [table].
log-level = "info"
concurrent = 2                    # Apple allows 2 macOS VMs per host
health-address = "127.0.0.1"
drain-timeout = "60m"
provider = "tart"
max-runners = 2

[tart]
runner-dir = "/Users/admin/actions-runner"   # in the guest: where golden-build put the GitHub runner
cpu = 4                           # install: max(2, floor((ncpu - 2) / 2))
memory = 8192                     # install: MB, max(4096, floor((RAM GB - 8) / 2) x 1024)
pool-size = 0                     # no warm pool: an idle warm VM of one scale set would hold one of the 2 slots
cache-budget = 60                 # GB for Tart's image cache
dns = ["1.1.1.1", "8.8.8.8"]

# One [[scaleset]] per repository (or organization). Copy the block for each.
#   url           the repository (or organization) the runners serve
#   token         env:RUNNER_TOKEN_<X> reads the file /Users/ci/.config/runner/token-<x> (lower case; letters,
#                 digits and _ only), 0600 — README: "The token"
#   labels        what a workflow names in runs-on (for example mac-ci)
#   runner-group  organization scale sets only: the runner group this set joins. Without it, the organization's
#                 Default group. The group decides which repositories can send jobs here (README: "Configure the
#                 scale sets")
#   runner-image  the name golden-build printed (liveapp-mac-golden-<yyyymmdd>)
#   disable-update — neither value keeps the runner current:
#     false (this example): the runner may update itself when GitHub tells it to. That download is not checked by
#       digest (docs/design.md, decision 3). Measured (2026-10): runners on 2.338.0, on sets created with false, did
#       not update in the 3 days after 2.338.2 came out.
#     true: the runner never updates itself. It stays the version the image was built with.
#     GitHub retires each runner version some weeks after newer ones come out. A retired runner is refused and
#       exits, and jobs stay queued, with either value (runscaler 0.10.0's README; not measured here). So rebuild
#       the image from the release that pins each new runner, before the old version's runtime_deprecates_at
#       (docs/operations.md, "Rebuilding the image").
[[scaleset]]
url = "https://github.com/OWNER/REPO"
name = "mac-ci-REPO"
token = "env:RUNNER_TOKEN_OWNER"
provider = "tart"
labels = ["mac-ci"]
# runner-group = "GROUP"
max-runners = 2
runner-image = "liveapp-mac-golden-YYYYMMDD"
disable-update = false
