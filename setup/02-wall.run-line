@ROOT@ /bin/zsh -f -c 'f=$(/usr/bin/mktemp /private/tmp/02wall.XXXXXX) || exit 1; trap "/bin/rm -f -- $f" EXIT; trap "exit 130" INT TERM HUP; /bin/cp -X @SCRIPT@ "$f" && [[ "$(/usr/bin/shasum -a 256 < "$f")" == "@SHA@  -" ]] && { /bin/zsh -f "$f"; r=$?; } || { print -u2 -r -- "REFUSE: @SCRIPT@ could not be copied, or is not the reviewed copy (sha256 @SHA@): nothing run"; r=1; }; exit $r'
