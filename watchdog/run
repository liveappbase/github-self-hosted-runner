#!/usr/bin/env bash
# watchdog/run — the weekly runner watchdog (PLAN D8). A liveapp calendar duty runs it in the self-instance, from a
# release of this repository checked by its sha256, where bash, gh and jq exist. It READS GitHub (gh api: the newest
# actions/runner release and its list; the jobs on main of the last 14 days in --repo; the head of a few job logs),
# writes nothing there, and prints ONLY lines:
#   open TOPIC TEXT      ask the owner:        liveapp ask-owner open TOPIC --need "TEXT"
#   clear TOPIC          withdraw that ask:    liveapp ask-owner clear TOPIC
# every `clear` before every `open` (a full ask cap frees first). The duty runs each line as printed.
#
#   watchdog/run --repo OWNER/REPO --hz 'LINE' --studio 'LINE' --family NAME=HOST:LABEL[,LABEL...] ... [--now EPOCH]
#
# --hz, --studio  the line that runs a command on that host, as the updater's user, before the command: the asks say
#                 `LINE runner-updater status` (no host value lives in this program)
# --family        a family (PLAN §3), its host (hz or studio) and the job labels that run on its image
# --now           the clock, UTC epoch seconds (default: now); for a test, or to read a past week
#
# The rules (watchdog.jq): STALE, FAILING; one topic per (rule, newest release), e.g. runner-stale-2-339-0, and
# `clear` for the topics of the three releases before it and for a rule that finds nothing. NOT MEASURED (a label with
# no job, a log with no version) never opens an ask alone: it rides in another ask's text. COULD-NOT-RUN (a jq that
# core/TESTED_JQ does not list for the watchdog, a gh failure, a program error, a bad argument): that ONE line only,
# `open runner-watchdog-could-not-run-<release> …` (no release suffix when the newest release cannot be read).
# Exit 0 whenever it printed its lines; it reads no environment variable of its own. bash 3.2 parses it (macOS).
set -u -o pipefail
export LC_ALL=C

here=$(cd "${0%/*}" && pwd -P) || { printf 'open runner-watchdog-could-not-run %s\n' "The weekly runner watchdog could not run: it cannot find its own folder. Fix it, then run the duty again."; exit 0; }
release=
tmp=
cleanup() { [ -n "$tmp" ] && [ -d "$tmp" ] && rm -rf -- "$tmp"; }
trap cleanup EXIT

cnr() { # REASON — the one COULD-NOT-RUN line, then stop
  local t=runner-watchdog-could-not-run
  [ -n "$release" ] && t="$t-$(printf '%s' "$release" | tr . -)"
  printf 'open %s %s\n' "$t" "The weekly runner watchdog could not run: $1. Fix it, then run the duty again."
  exit 0
}

# the newest release first: every topic is per release
tag=$(gh api repos/actions/runner/releases/latest --jq .tag_name 2>/dev/null) || cnr "gh api repos/actions/runner/releases/latest failed"
[[ $tag =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]] || cnr "the newest actions/runner release has no version tag"
release=${BASH_REMATCH[1]}

repo= hz= studio= now= fams=
while [ $# -gt 0 ]; do
  case $1 in
    --repo)   [ $# -ge 2 ] || cnr "--repo needs OWNER/REPO"; repo=$2; shift 2 ;;
    --hz)     [ $# -ge 2 ] || cnr "--hz needs a line"; hz=$2; shift 2 ;;
    --studio) [ $# -ge 2 ] || cnr "--studio needs a line"; studio=$2; shift 2 ;;
    --now)    [ $# -ge 2 ] || cnr "--now needs an epoch"; now=$2; shift 2 ;;
    --family) [ $# -ge 2 ] || cnr "--family needs NAME=HOST:LABEL[,LABEL...]"
              [[ $2 =~ ^[a-z0-9][a-z0-9-]*=(hz|studio):[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)*$ ]] || cnr "a --family is not NAME=HOST:LABEL[,LABEL...] with HOST hz or studio"
              fams="$fams$2
"; shift 2 ;;
    *)        cnr "an unknown argument (see the header of watchdog/run)" ;;
  esac
done
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || cnr "--repo OWNER/REPO is missing"
[ -n "$fams" ] || cnr "no --family"
case $fams in *=hz:*) [ -n "$hz" ] || cnr "a family runs on hz, and --hz is missing" ;; esac
case $fams in *=studio:*) [ -n "$studio" ] || cnr "a family runs on studio, and --studio is missing" ;; esac
if [ -z "$now" ]; then now=$(date -u +%s) || cnr "date failed"; fi
[[ $now =~ ^[0-9]+$ ]] || cnr "--now is not epoch seconds"

# the jq: one core/TESTED_JQ lists for the watchdog (the file comes with this program, from the same release)
tested=$here/../core/TESTED_JQ
[ -f "$tested" ] && [ -r "$tested" ] || cnr "core/TESTED_JQ is not next to this program"
jqv=$(jq --version 2>/dev/null) || cnr "jq does not run"
ok=0 list=
while read -r v areas where; do
  case $v in ''|'#'*) continue ;; esac
  case ",$areas," in *,watchdog,*) list="$list $v"; [ "$v" = "$jqv" ] && ok=1 ;; esac
done < "$tested"
[ $ok = 1 ] || cnr "this jq prints $jqv, which core/TESTED_JQ does not list for the watchdog (tested:$list)"

prog=$here/watchdog.jq
[ -f "$prog" ] || cnr "watchdog/watchdog.jq is not next to this program"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/watchdog.XXXXXX") || cnr "mktemp failed"

api() { # FILE PATH [--paginate] — one read; a failure ends the run as COULD-NOT-RUN, naming the call
  local f=$1 p=$2; shift 2
  gh api "$@" "$p" > "$f" 2>/dev/null || cnr "gh api $p failed"
}

api "$tmp/releases.json" 'repos/actions/runner/releases?per_page=30'
since=$(jq -rn --argjson now "$now" '$now - 14 * 86400 | strftime("%Y-%m-%d")') || cnr "jq failed on the date"
api "$tmp/runs.json" "repos/$repo/actions/runs?branch=main&created=>=$since&per_page=100" --paginate
ids=$(jq -r '.workflow_runs[]?.id' "$tmp/runs.json") || cnr "the runs list is not JSON"
n=0
for id in $ids; do
  [[ $id =~ ^[0-9]+$ ]] || cnr "a run id is not a number"
  n=$((n + 1))
  api "$tmp/jobs-$n.json" "repos/$repo/actions/runs/$id/jobs?per_page=100" --paginate
done
if [ $n -gt 0 ]; then
  cat "$tmp"/jobs-*.json | jq -s '[.[].jobs[]?]' > "$tmp/jobs.json" || cnr "a jobs list is not JSON"
else
  printf '[]\n' > "$tmp/jobs.json"
fi

# the families and hosts, as data for the rules
printf '%s' "$fams" | jq -R -s --arg hz "$hz" --arg studio "$studio" \
  '{hosts: {hz: $hz, studio: $studio},
    families: [split("\n")[] | select(length > 0) | capture("^(?<name>[^=]+)=(?<host>[^:]+):(?<l>.*)$")
               | {name, host, labels: (.l | split(","))}]}' > "$tmp/cfg.json" || cnr "jq failed on the families"

run_rules() { # STEP [--slurpfile logs FILE] — watchdog.jq; a failure is COULD-NOT-RUN
  local step=$1; shift
  jq -n -r -f "$prog" --arg step "$step" --argjson now "$now" --arg release "$release" --slurpfile cfg "$tmp/cfg.json" \
     --slurpfile releases "$tmp/releases.json" --slurpfile jobs "$tmp/jobs.json" "$@"
}

picks=$(run_rules pick) || cnr "watchdog/watchdog.jq failed at its step pick (rc $?)"
printf '{}\n' > "$tmp/logs.json"
for id in $picks; do
  [[ $id =~ ^[0-9]+$ ]] || cnr "a job id is not a number"
  api "$tmp/log-$id.txt" "repos/$repo/actions/jobs/$id/logs"
  head -n 40 "$tmp/log-$id.txt" > "$tmp/head-$id.txt"
  jq --arg id "$id" --rawfile t "$tmp/head-$id.txt" '. + {($id): $t}' "$tmp/logs.json" > "$tmp/logs.new" \
    && mv "$tmp/logs.new" "$tmp/logs.json" || cnr "jq failed on a job log"
done

lines=$(run_rules rules --slurpfile logs "$tmp/logs.json") || cnr "watchdog/watchdog.jq failed at its step rules (rc $?)"
printf '%s\n' "$lines"
