set -u; u='@URL@'; h=@SHA@; v=@VERSION@; t=@TAG@; [ "$(id -u)" != 0 ] || { echo "REFUSE $t: run this line as the host's RUN_USER or RS_USER, never as root: nothing downloaded"; exit 1; }; umask 022; f=$(mktemp "$HOME/.release-dl.XXXXXXXX") || { echo "REFUSE $t: cannot make a file in $HOME: nothing downloaded"; exit 1; }; if ! curl -q -fsSL --proto =https --proto-redir =https --tlsv1.2 --max-redirs 5 --max-time 900 -o "$f" "$u" < /dev/null || [ "$(sha256sum < "$f" | cut -d ' ' -f 1)" != "$h" ]; then rm -f -- "$f"; echo "REFUSE $t: the download failed, or it is not this release (sha256 $h): nothing unpacked"; exit 1; fi; b=; l=$(tar -tvzf "$f" 2> /dev/null) && m=$(tar -tzf "$f" 2> /dev/null) || b=1; while IFS= read -r x; do case $x in -*|d*) ;; *) b=1 ;; esac; done <<< "$l"; while IFS= read -r x; do case $x in "$v"/*) ;; *) b=1 ;; esac; case /$x/ in */../*) b=1 ;; esac; done <<< "$m"; if [ -n "$b" ]; then rm -f -- "$f"; echo "REFUSE $t: the tarball holds a member that is not a plain file or a folder under $v/ (a link, a device, a FIFO, a .. or an absolute path): nothing unpacked"; exit 1; fi; d=$(mktemp -d "$HOME/.release-unpack.XXXXXXXX") && tar -xzf "$f" -C "$d" --no-same-owner --no-same-permissions < /dev/null && [ -f "$d/$v/linux-docker/setup/install-release.sh" ] || { rm -f -- "$f"; [ -z "${d-}" ] || rm -rf -- "$d"; echo "REFUSE $t: the tarball could not be unpacked, or holds no $v/linux-docker/setup/install-release.sh: nothing installed"; exit 1; }; rm -f -- "$f"; exec bash "$d/$v/linux-docker/setup/install-release.sh" "$t" "$h" "$d" "$@" < /dev/null
