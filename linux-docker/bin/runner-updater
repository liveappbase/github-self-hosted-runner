#!/bin/bash
# runner-updater status | on | off | pass | build VERSION — the runner-image updater on the Linux host (PLAN D1, D2, D6,
# D7, D11): ONE program for the host's two users, and the user it runs as decides its ROLE: RS_USER's (status, on, off,
# pass) or RUN_USER's (status, on, off, pass, build VERSION); any other user: REFUSE (RS_USER's comes first, so a host
# config that names one user twice runs RS_USER's). The Studio's twin is bin/runner-updater (zsh) with
# bin/runner-updater-release; what DIFFERS from it is named below. Install: linux-docker/README.md, "The updater:
# status, on, off, pass, build" (each user's ~/bin/runner-updater, a link to ~/build/bin/runner-updater, so it always
# runs with this release's ~/build: its setup/runner-facts.sh, setup/runner-release.sh and core/). ITS TIMER is this
# release's: config/runner-updater.timer runs config/runner-updater.service, one `~/bin/runner-updater pass`, every 10
# minutes as each user (both files' headers say when and why, and the service's TimeoutStartSec bound); Install step
# 11, setup/04-timer.sh, installs and starts it as each user. A fresh install is OFF (D11): a pass while OFF measures
# nothing and builds nothing, and the updater itself asks the core and GitHub nothing; but RS_USER's runs RECOVER
# FIRST, THE APPLY STEP and THE OUTAGE RULE first (below: it may end a window a cut left, start runscaler and write the
# state, and it exits 1 while a window journal stays): RECOVER may validate a config (runner-start validate checks the
# GitHub API) and start runscaler, which both reach GitHub (B2a review r2, Opus F3).
#
# THIS RELEASE STARTS NO WINDOW (S2b-3c-1: every way a switch ENDS; the switch is S2b-3c-2's, the rollback B2b's).
# RS_USER's pass, and its on and off, end a window journal a cut left open (RECOVER FIRST, below: pool-image.sh's
# RECOVER as their child may start or restart runscaler and put a rollback's backup back), apply a closed one to the
# state (THE APPLY STEP) and archive it; a pass then holds or clears POOL DOWN (THE OUTAGE RULE), measures, asks the
# decision core (core/README.md) and prints what it WOULD do, and which runner release it would switch to (DUE, below).
# With no journal at WINDOW, it runs no pool-image.sh and no `systemctl --user start|stop|restart`, and changes no
# config. RUN_USER's pass builds the image of the release DUE waits for (THE BUILD PASS, below), with 02-d1.sh, and
# changes nothing of the pool. Each user's writes: under STATEDIR, the state (by rename), a pass's files (PASSDIR) and
# the lock file, RS_USER's archive of a closed journal (WINDOW renamed into WINDOWS) and what its RECOVER writes
# (pool-image.sh's header), and RUN_USER's BUILDOUT (their modes: runner-release.sh's rr_lock, THE MODES, by the
# user's role); under runner-release.sh's RR_DIR
# (~/.cache/liveapp-ci), the filtered CA bundle and the private copy of each build record it reads; and RUN_USER's
# 02-d1.sh build what that writes (its header). status writes nothing.
#
# THE STATE, STATE (STATEDIR/state.json): ONE JSON object per user, written by rename after a sync to disk (STATE.new,
# `dd conv=notrunc,fsync`, then a rename over STATE; a write, sync or rename that fails is a STOP, and STATE is as it
# was), read under the updater lock (status alone reads it with no lock: ONE read, so a rename while it runs gives it
# the old state or the new one, whole). A missing STATE is a fresh install: OFF, nothing held (D11), for each user.
# RS_USER's members are the Studio's that apply on this host, with the same names and shapes:
#   format     1. A state of another format (or none): every command prints "runner-updater: WAIT ..." and exits 4,
#              and nothing is written. Format 1 that is not the shape below: REFUSE, exit 1, and it is left as it is.
#   on         true | false
#   families   {"hz-docker": {
#                candidate   {version: "N.N.N", lines: {SET: IMAGE, ...}, closed_at: EPOCH} | null: the release under
#                            observation (switched, not accepted; closed_at: when its switch window closed)
#                previous    {SET: IMAGE, ...} | null: the lines it ran before its candidate
#                back_until  EPOCH | null: after an ACCEPT, the end of the 7 days `back` restores `previous`
#                rejected    ["N.N.N", ...]: the versions the updater never switches it to again
#                stops       [{family: "hz-docker", stop: NAME, version, user, detail}]: the STOPs it holds
#                            (core/README.md, facts.stops)}}
#              an absent member reads as null or []. SET: a scale set name; IMAGE: a digest reference, NAME@sha256:<64
#              hex> (what 03-runscaler.sh renders).
#   core       the decision core's own state (the `state` idle.jq and r1.jq return) | absent: a fresh core
#   restart    {from: {pid, start}, to: {pid, start}, stopped: {inode: "N", offset: N, sha}} | absent: the updater's own
#              restart of runscaler (THE APPLY STEP writes it from a window journal: THE OWN RESTART), handed to the
#              core ONCE as facts.restart and then removed
#   last_window "YYYYmmddHHMMSS-PID" | absent: the ID of the last window journal THE APPLY STEP applied (S2b-3c-1 D-b):
#              written in the same state write, so a journal whose ID it is (a run cut after its write, before the
#              archive) is only archived, never applied twice
#   A MEMBER THIS RELEASE DOES NOT READ (at the top, a family other than hz-docker, in hz-docker, in its candidate, in a
#   STOP, in the restart): every command WAITs (exit 4), names it, and writes nothing. So a later release may add one
#   under format 1, and an older one (a rollback across it) never writes a state that drops it or hides a STOP.
# RUN_USER's state is its own (one record per user, and no channel from RS_USER to RUN_USER: PLAN D1), with the same
#   format rule, REFUSE and WAIT. It goes by the build records' channel, so RS_USER's status can print it (PLAN D1,
#   11-05): 0640, group RUN_USER, its folders open to that group for search only; RS_USER's stays 0600 in a 0700
#   folder. runner-release.sh's rr_lock sets those modes, by this run's ROLE, at every lock take (THE MODES, its header),
#   and put_state writes the state with the mode it named (RR_STATE_MODE):
#   on         true | false: RUN_USER's own key (its pass builds nothing while it is OFF; D11: the install sets both)
#   stops      [{stop: NAME, version, user, detail}]: the STOPs it holds. Its build PASS writes one (`build VERSION`
#              writes no STOP): `check failed` of a version whose build failed, user and detail.build_user RUN_USER,
#              detail {text: THE CAUSE 02-d1.sh printed (THE BUILD PASS) by RUN_TEXT's one rule (printable ASCII, each
#              other character "?", at most 900 characters), step: "build"} (core/README.md, facts.stops),
#              ONE per version (a pass builds no version that such a STOP holds). A pass that finds the build record of
#              that version (and this release's recipe), and a `build VERSION` that passes, clear it
#   A member it does not read (at the top, in a STOP): WAIT, exit 4, as RS_USER's.
# DIFFERS from the Studio's state: no `images` (this host has no host pin), no `recipe` (the BASELINE is RUN_USER's
#   build record of the image config.toml runs: DUE, step 4), no protected list (this host deletes no image), and so no
#   LOST state: a missing state is a fresh one. ONE family, hz-docker (the watchdog's name): its provider is docker and
#   its sets are the host config's MAIN_SET and SMALL_SET; another family in the state is a member it does not read
#   (WAIT). Two users, each with its own state, key and lock; RUN_USER builds, RS_USER switches.
#
# COMMANDS. on, off, pass and build hold THE UPDATER LOCK (runner-release.sh's rr_lock: RR_LOCK on fd 9, one per user)
#   for their whole run: on, off and build wait for it (a WAIT line first); a pass only tries it. RS_USER's on, off and
#   pass run RECOVER FIRST and THE APPLY STEP (below) right after they read the state, before ON or OFF is read.
#   status   no lock, and it writes no file anywhere (the core's inputs come through pipes). ONE read of STATE; the jq
#            check (below); status.jq with facts from the state (RS_USER's: the family's candidate and back_until, the
#            STOPs it holds; RUN_USER's: its STOPs, of hz-docker) and RS_USER's `core`. It prints ON or OFF; RS_USER's
#            also the family's candidate (or "no candidate"), back_until and rejected versions, and which of three a
#            journal at WINDOW is (status_window, by THE APPLY STEP's own reader, with no write: open, with its last
#            `stop` line and whether a runscaler RUNS, by runner-facts.sh's runs with its /healthz pair kept in memory;
#            closed and not applied; applied and not archived, its ID the state's last_window). It promises that a run
#            ends a journal only when one can (B2a review r1): a closed one the apply step cannot read, or one it
#            cannot read at all, is named with linux-docker/README.md "An unfinished window the updater cannot end";
#            an open one with what the next pass's RECOVER does, and that section for when RECOVER cannot read or act
#            on it (status runs no RECOVER, so it cannot know that ahead); then status.jq's verdict and lines, on the
#            core's state with no entry of a family that has no candidate (STATUS AFTER A ROLLBACK, the r3 FOLD: a
#            departed candidate's R1 and KEEP evidence is no current work; the state is not edited) (RUN_USER's
#            `check failed` line names `runner-updater build V` as RUN_USER, its retry: D7); per STOP its D7
#            properties (`known false` and "unknown" for a STOP this core does not know: never guessed). status.jq's
#            answer is checked as a pass
#            checks it (`decided`): a `wait` is its lines, then "runner-updater: WAIT the decision core waits ...",
#            exit 4; another answer is "runner-updater: STOP core could not decide (status)", exit 1.
#            RS_USER's status then prints RUN_USER's record (PLAN D7: both users' records), after ALL of its own lines,
#            whatever they end with (its own lines run in a subshell: a WAIT or REFUSE on its own state, a core that
#            could not decide or waits, a clock it cannot read; do_status), and then exits with its own code
#            (run_record): RUN_USER's STATE (RUN_STATE) read as hostile (PLAN D1: ONE open by runner-release.sh's
#            rr_read, at most RUN_MAX bytes, never sourced; RUN_USER's own format, shape and member rules), and shown
#            ONLY in the shape RUN_USER's own writer makes (RUN_SHOWN: each STOP a `check failed` of a build, version
#            N.N.N of 1 to 9 digits each (VERSION_RE), detail {text, step, build_user}, its text by RUN_TEXT), each
#            line "runner-updater: as RUN_USER: ...": ON or OFF (no file: a fresh install, OFF), then status.jq's lines
#            of its STOPs, each with the STOP, its version and its next step, never its text: in place of the cause, a
#            fixed text of this program says that RUN_USER's own `runner-updater status` shows it (status_facts; a
#            text of the writer's own shape can read as an instruction, and RUN_USER controls its ~/build), and the
#            user each names is the host config's RUN_USER (a `check failed` of a build: `runner-updater build V`, as
#            RUN_USER); or ONE
#            line that names why it is not shown, a fixed text of this program that holds no text of the record (no
#            member name, no value), and RUN_USER's own `runner-updater status`. Under an untested jq no record is
#            parsed: its STOP untested jq line (exit 3) says so, with no line of RUN_USER's; an earlier end (its own
#            state) is followed by ONE such line. Its exit code is RS_USER's own:
#            nothing of RUN_USER's record changes it, as no STOP of RS_USER's own does (status reports; the watchdog
#            reads only the lines). A host config whose RUN_USER is RS_USER has one record: none is printed twice.
#   on       on = true; RS_USER's: a journal that stays at WINDOW after RECOVER FIRST is its STOP line, exit 1, and on
#            is as it was.
#   off      refuses while a window journal stays at WINDOW after RECOVER FIRST (off never strands a window: D11, D-f;
#            RECOVER never waits for idle, so a switch that waits stays open and off names it): on stays as it was,
#            and the line says "nothing changed" only when nothing did (RECOVER changed nothing by its own exit: 1, 3,
#            4, 6, or 0 with the journal's bytes as they were; and no state write), else that what RECOVER and the
#            apply step did stays (B2a review r2, Codex F3 = Opus F2); else on = false.
#   pass     the timer's entry (config/runner-updater.timer). The lock held: "another run holds the updater lock",
#            exit 0 at once. ONE CLOCK PER PASS (B2a review r1): now = the UTC clock, read ONCE, first, before RECOVER
#            FIRST (which may wait for a drain) and THE OUTAGE RULE (its /healthz pair takes 3 s): every decision of the
#            pass (the core's: R1's settling and NOT SERVING, KEEP's deadline; DUE's release age) uses that one value,
#            so none depends on how long a step before it took (core/README.md compares `now` only with an earlier
#            `now`, never with a log time). RS_USER's: RECOVER FIRST and THE APPLY STEP, then THE OUTAGE RULE, OFF too;
#            a journal that stays at WINDOW is then its STOP line, exit 1, and nothing else. OFF: "the updater is OFF",
#            exit 0: the updater itself asks the core and GitHub nothing (THE OUTAGE RULE's /healthz pair is
#            runscaler's, on 127.0.0.1); RECOVER FIRST, before it, may validate a config and start runscaler, which
#            both reach GitHub. ON:
#            the jq check, the FACTS (below) into PASSDIR, then idle.jq, r1.jq, keep.jq and status.jq with the same
#            five inputs (state, facts, log, healthz, --arg now). The state they read is PASSDIR/state.json, a copy of
#            the state's `core`, written back by rename after idle and after r1, so a later program reads it; only when
#            all four decided does it go into STATE (`core`, with the `restart` member removed in the same write: it is
#            handed over once). A program that exits non-zero, or prints no JSON object with lines and a verdict
#            core/README.md names for it (idle: idle or not-idle; r1, keep, status: ok; or wait): "runner-updater: core
#            could not decide (PROGRAM)", exit 1, and the core's own state is as it was. A program that answers `wait`
#            (the core's own state is of a format it does not read: core/README.md) decided nothing: "runner-updater:
#            WAIT the decision core waits ...", exit 4, and the core's own state is as it was (the `restart` member
#            too). Each line says "the pass did nothing: STATE is as it was" only when the pass did nothing before the
#            core either (no RECOVER ran, no state write: core_nothing); else that what it did before the core stays
#            (B2a review r1, Codex F3: RECOVER's, the apply step's or THE OUTAGE RULE's write). Then what it WOULD
#            do: "would roll back hz-docker" (r1's rollback), "would accept hz-docker" (keep's accept), "would hold
#            hz-docker: STOP JOBS FAIL ON THE NEW IMAGE" or "... STOP NO EVIDENCE" (keep); then DUE's ONE line for
#            hz-docker. Each program's output stays in PASSDIR/PROGRAM.json, the latest release's lines in
#            PASSDIR/release.out and .err. RUN_USER's: THE BUILD PASS (below).
#   build VERSION   RUN_USER's only (a person's path, D7's retry of a build's `check failed`): it waits for the lock and
#            runs 02-d1.sh build VERSION as its child (as the build pass does), while OFF too. Exit 0 of 02-d1.sh clears
#            the `check failed` STOP of VERSION (by rename); 75 (GitHub's rate limit) is "WAIT ...", exit 4, and the
#            state stays; any other is a line with THE CAUSE 02-d1.sh printed, exit 1, and it writes no STOP (one that
#            is there stays): the person sees why, and a typo of a version would hold a STOP nothing clears.
# THE JQ CHECK: `jq --version` must be a row of core/TESTED_JQ for the area core (runner-facts.sh's tested_jq), else
#   "STOP untested jq" and exit 3: no core program runs (status, and a pass that is ON, of either user: RUN_USER's pass
#   reads its STOPs with the core's lib/stops.jq; an OFF pass ends before it). `build VERSION` runs no core program.
#
# RECOVER FIRST (S2b-3c-1 D-b (c), D-f; the Studio's run_recover): when a journal is at WINDOW (a window holds the
#   lock for its whole run, so a run that holds it and finds one found a window a cut left open, or one closed and not
#   archived), RS_USER's on, off and pass run `~/build/setup/pool-image.sh recover --unattended` as their CHILD (it gets
#   the lock on fd 9: pool-image.sh's THE UPDATER'S CHILD), its output shown, then THE APPLY STEP. Its exits: 0 the
#   journal is closed; 3 none; 4 WAIT (a person's pool-image.sh run holds that script's own lock: RECOVER read and
#   changed nothing): a line, no STOP, and a closed journal is applied all the same; 5 it stays open (RECOVER's line
#   says why: a STOP of its own, a wait for idle, a start that did not run yet); 6 a record RECOVER cannot read or act
#   on: a STOP that names linux-docker/README.md "An unfinished window the updater cannot end", nothing written; 1
#   RECOVER's REFUSE; any other: a STOP that names it. A journal that stays (open, or one THE APPLY STEP cannot read or
#   archive): its STOP or REFUSE line, exit 1, and nothing else starts (a pass: after THE OUTAGE RULE, whose POOL DOWN
#   text says how it stays: README's section when no run of the updater can end it, else what the next run does). A
#   pass makes at most ONE restart of runscaler (D-g): this release's only one is RECOVER's (RECOVER_STARTED).
# THE APPLY STEP (S2b-3c-1 D-b (b) and the r3 FOLD), under the lock: a journal at WINDOW whose last line is `closed E`,
#   read ONCE, by its keys and fields, never a line's text; it reads no config.toml, no build record and no clock (the
#   closer journaled what it installed: `installed SHA CONTENT CLASS`, pool-image.sh's THE CLOSING LINES). Its ID is
#   the state's last_window: it is only archived. A journal with no `kind` line (cut right after its first; RECOVER can
#   close it with `stop CI DISABLED`, HAND CHANGE or POOL DOWN): its `stop` lines by THE STOP RULE (below), of no
#   version, and no candidate change, in the ONE state write below (B2a review r1, Opus F1); with no `stop` line, only
#   archived (no write). Else THE CLOSE RULE, then ONE state write (load_state's jq: an untested jq does not stop
#   it) that also sets last_window, then the archive: WINDOW renamed to WINDOWS/ID (one that is there already: a STOP).
#   A closed journal it cannot read (no `window ID` first line, a line that is not KEY VALUE, a STOP name the window's
#   grammar has not, an `installed` line of another shape, a CLASS its kind has not, a needed line missing): a STOP that
#   names README's section, nothing written. A closed journal in WINDOWS is never applied.
#   THE CLOSE RULE, by the kind and the CLASS (T: the window's first `target` line, its lines {SET: IMAGE}):
#   - no `target` line (the shortcuts: `up` already names and runs the image, `back` already is the backup): only its
#     STOPs.
#   - switch, target-running | target-idle | target-old: candidate = {version, lines: T's, closed_at: `closed`}; when
#     its `backup` names config.toml.prev: previous = `old` on T's sets and back_until = null (a backup in the window's
#     own folder, 3c-2's --keep-prev, leaves both). POOL DOWN too (PLAN D6 :354).
#   - switch, pre | none: no candidate change; when its `backup` names config.toml.prev, its LAST `prev` (a line that
#     may come twice) is `config-sha` (the backup replaced the keep) and there is no candidate: previous = null and
#     back_until = null, and the line says the keep is gone (r1 Opus F19).
#   - rollback, target-running | target-idle: candidate, previous and back_until = null (rolled back: target-idle is a
#     person's `disable --now`, its TARGET runs at the person's start); THE REJECTION is B2b's (apply_rejection, its one
#     place).
#   - rollback, target-old (a person's `disable` without --now: an older runscaler runs the candidate's image): the
#     candidate stays, CI DISABLED held. target-failed (RECOVER's: the rollback DECIDED as failed and its TARGET still
#     installed): the candidate stays, ROLLBACK FAILED held, never "rolled back". pre | none: no change.
#   - other (a person's file the closer found): no candidate (a switch's is not set, a rollback's stays), HAND CHANGE
#     held.
#   - a switch's target-failed: a CLASS its kind has not (a STOP, above).
#   A close's STOP the journal has no line of gets a fixed text. LEGACY JOURNALS (the r3 FOLD; a journal an earlier
#   release closed, cut before its rename, has no `installed` line): its CLASS from its own lines: `running` after its
#   `target`: target-running; a `stop` or `end` before any `rename-start`: pre; anything else: a STOP (above). A
#   rollback with no `why`: a person's back, old-version none (nothing rejected), and its line says so.
#   THE STOP RULE (the Studio's, runner-updater-window :127-139): the journal's `stop` lines, each NAME held once (its
#   last line of that name), but DISK, untested jq and NO IDLE (the pass checks the first two again; NO IDLE's restart
#   came); each replaces the family's held STOP of its name, and the family's other STOPs stay, but a switch or
#   rollback close that sets or clears the candidate drops JOBS FAIL ON THE NEW IMAGE and NO EVIDENCE (they judged the
#   candidate it replaced). Each STOP is of the switch's `version`, a rollback's `old-version` (else the candidate's),
#   a journal with no `kind`'s of no version (null); its detail {text} (POOL DOWN's also hand: journalctl --user -u
#   runscaler).
#   THE OWN RESTART (core/README.md :68-121; the r3 FOLD): `restart` = {from, to: `running`, stopped} only from a
#   journal with no `recover-start` (an uninterrupted window), its own `from` (a process), `stopped` (a position) and
#   `running`, whose start is within 20 s of its `starting` (RestartSec=30: no Restart=always retry came between),
#   while the state holds no unconsumed `restart`; any other applied journal removes the member (a gap: the safe
#   default).
# THE OUTAGE RULE (S2b-3c-1 B1 DECISIONS r4 and B2a DECISIONS; operator (1): the unit enabled means CI on), RS_USER's
#   pass, ON or OFF, after RECOVER FIRST: a PURE LEVEL, computed anew by each pass, never latched. ONE unit_read: the
#   unit not enabled and no POOL DOWN held, nothing can change (a CI DISABLED is cleared only with the unit enabled),
#   and it ends there; else ONE runner-facts.sh `runs` of config.toml's sets, of a runscaler of ANY start (never one
#   `active` read; its /healthz pair kept in memory), then the unit read AGAIN: that read, AFTER the RUNS check,
#   decides (a person's `systemctl --user disable --now runscaler` during the pair is CI off by hand: B2a review r1,
#   Codex F1), and it must agree with RUNS: active, with the MainPID of RUNS's own process, else no runscaler RUNS (a
#   person's plain `systemctl --user stop` after RUNS's last read: B2a review r2, Codex F1). The unit enabled and no
#   runscaler RUNS: STOP POOL DOWN in the state, its text naming the open window
#   journal's last line and how it stays when there is one (README's section when no run of the updater can end it),
#   else what the pass saw (the unit's state), held ONCE (a held one stays as it is: no new STOP each pass). Else (a
#   runscaler RUNS, whenever it started, or the unit not enabled: B2a review r1, Opus F2): POOL DOWN cleared. For
#   POOL DOWN the install time proves only WHICH file a process runs (a close's CLASS), never whether CI is up (B2a
#   DECISIONS): a runscaler older than config.toml's install that serves (a person's `03-runscaler.sh real` after a
#   pool.env change restarts nothing: PLAN D2) is CI up. CI DISABLED is cleared ONLY by the unit enabled AND a runscaler
#   that RUNS and started after config.toml's install time (facts 4's install_time, read after the RUNS check: the safe
#   direction) (the plan's CORRECTION, Opus r1 F6): a rollback closed target-old (a person's `disable` without --now,
#   the older runscaler serving the candidate's image) holds it as its only line that its TARGET does not run yet, and
#   a person's `enable` without --now does not clear it. A unit it cannot read, at either read: nothing raised or
#   cleared. It never fails the pass. A journal's CI-down words are text for the person, never the guarantee: this rule
#   is.
# DUE (RS_USER's pass, after the core: which release hz-docker would switch to; the Studio's rl_pass, adapted).
#   hz-docker is due when the eligible release is newer than its current version, it has no open candidate and no STOP
#   holds it. A STOP of its list holds it when it names no version, or a newer release does not proceed alone past it
#   (asked of the core's lib/stops.jq, S::newer_proceeds, never a table here: a name it does not know does not proceed),
#   or it is of the eligible version. It prints ONE line, the first of these that holds, in this order (what needs no
#   network first, so a family held for a local reason asks GitHub nothing):
#   1. an open candidate: "hz-docker is not due: an open candidate (runner V): ..." (the 7 days `back` keeps `previous`
#      after an ACCEPT are no open release: PLAN D6, AFTER ACCEPT);
#   2. a STOP that holds whatever the release is (no version, or a newer release does not proceed alone past it), or
#      STOPs jq cannot read (fail closed): "STOP NAME (runner V): why; `runner-updater status` names its next step";
#   3. this release's image recipe (runner-release.sh's rr_recipe of ~/build/image) cannot be computed;
#   4. "STOP NO BASELINE": config.toml's lines of the family's two sets do not name one image, or not exactly ONE build
#      record of RUN_USER (rr_record_of, BUILDS) has its digest;
#   5. "STOP recipe changed": that record's recipe is not this release's;
#   6. (the family's current version is that record's version);
#   7. the latest release (runner-release.sh's rr_eligible, once per pass): "WAIT ..." (403, 429), or why it is not
#      eligible (under 2 days old, or an answer it refuses);
#   8. a STOP of that release's version: "STOP NAME (runner V): it is of the eligible release; ...";
#   9. "release vV is rejected for hz-docker"; 10. "release vV is not newer than its runner C";
#   11. no build record of (V, this release's recipe) (rr_record): "it waits for RUN_USER's build of runner V ...";
#   12. else "would switch hz-docker to V (this release takes no action)".
#   NO BASELINE and recipe changed are printed, never written into the state, and a later pass prints them again while
#   they hold; DUE writes nothing into the state and never fails the pass: every line is "runner-updater: pass: ...".
#   It downloads no tarball: RUN_USER's build checked the tarball's digest.
# THE BUILD PASS (RUN_USER's pass; ON, the jq check passed): the latest release (rr_eligible: "WAIT ..." or why it is
#   not eligible, exit 0, nothing built); a version VERSION_RE refuses (a part of 10 digits or more): "no build",
#   exit 0, nothing built (a STOP of it would hold a version RS_USER's status cannot show and `build VERSION` cannot
#   retry); this release's recipe of ~/build/image (it cannot be computed: REFUSE,
#   exit 1); the build record of (V, recipe) (rr_record, BUILDS) is there: "runner V is built ...", exit 0, and a
#   `check failed` STOP of V is cleared (by rename: a person's `02-d1.sh build V` passed); a STOP that holds V (DUE's
#   rule: a `check failed` of V; a newer release proceeds alone past one of an older version, so a version whose build
#   failed is never built again by a pass): its line, exit 0, nothing built. Else it runs `~/build/setup/02-d1.sh build
#   V` as its CHILD, its output shown and kept in BUILDOUT, on the lock it holds: fd 9, which the child inherits and so
#   shares (rr_lock's rule: 02-d1.sh's own rr_lock takes it there at once; a new open would wait for its own parent).
#   02-d1.sh's exit 0: "built runner V", exit 0; 75 (GitHub's rate limit): "WAIT ...", exit 0, no STOP; 129, 141 or 143
#   (SIGHUP, SIGPIPE, SIGTERM: an ssh drop, a reboot, a stop): "CUT ...", exit 0, no STOP, and the next pass builds V
#   again. systemd's stop of the timer's unit (its TimeoutStartSec, a shutdown, `systemctl --user stop`) is SIGTERM to
#   every process of the unit, this run too: around the build, this run has a TERM trap (not an ignore, which the
#   child would inherit), so it waits for 02-d1.sh's 143 and prints that CUT; anywhere else in a pass a TERM ends it at
#   once (STATE is written by rename: it is the old state or the new one). THE TERM WINDOW: the trap is set before
#   build_child's rm and its fork, so it records a TERM (TERMED: set empty at the program's start, for every command,
#   so an inherited TERMED never skips a build), and a TERM that came before the fork starts no 02-d1.sh: "CUT ... (no
#   build started)", exit 0, no STOP, the state as it was. The residual, a TERM between that check and the fork:
#   systemd's TERM reaches only the processes that exist when it sends it, so that 02-d1.sh runs on. When it ends
#   before systemd's SIGKILL at TimeoutStopSec, this run (TERMED) prints a CUT and writes no STOP, whatever it exited
#   with (but 0: built; 75: WAIT, no STOP either); else that SIGKILL ends this run too, with no CUT line
#   (config/runner-updater.service names what that leaves: no STOP, the state valid, a build context that may stay, the
#   lock free once every holder has exited). Any other (137 too, SIGKILL or an OOM kill, when no TERM reached this run:
#   a build that fails each time must not loop): STOP `check failed` of V with THE CAUSE 02-d1.sh printed (the state,
#   by rename), exit 1. THE CAUSE: the REFUSE line right before its last FAIL line (that FAIL line then says only "the
#   REFUSE line above says why"), else that FAIL line; with no FAIL line, its last REFUSE line (a host config it
#   refuses); with neither, what it exited with.
# THE FACTS (core/README.md, "facts", host "hz"), RS_USER's pass, in this ORDER (the Studio's, bin/runner-updater-lib's
# ru_collect):
#   1. proc before: runscaler as systemd reports it, in ONE `systemctl --user show` read (runner-facts.sh's
#      proc_now): {pid, start} (MainPID, ActiveEnterTimestamp), or null when its unit is not active. An answer it
#      cannot read: no facts.
#   2. the position: runner.log opened ONCE (runner-facts.sh's log_pos): its inode, its size (the offset) and the
#      sha256 of the 64 bytes before it; and the log TEXT from the boundary the last pass left (the core state's
#      boundary.position) to it, read through that open file (no byte past the position), and `continuous`: the
#      same file, or runner.log.1 after ONE rotation, and the boundary's sha still there; else false and the text is
#      runner.log from 0, which the core reads as an evidence gap. No runner.log: no facts.
#   3. proc after: as 1, after the capture (core/README.md, "Ownership by position").
#   4. config: config.toml through ONE open (runner-facts.sh's config_read): `sets` (every [[scaleset]] block's name)
#      and lines {SET: IMAGE}; a config whose lines the core would read wrongly is no facts. installed = the `renamed`
#      epoch of the newest closed window journal (WINDOWS) that renamed a file of config.toml's sha into place, unless
#      config.toml's mtime is later (the same bytes written again after that window: `03-runscaler.sh real DIGEST`
#      restarts nothing), else config.toml's mtime (a hand install: pool-image.sh's hand path restarts only after that
#      second) (runner-facts.sh's install_time; PLAN D1, the Hetzner install time). It is never earlier than the file's
#      own mtime, and it is read after the process: a config installed after the process started has a later time
#      then, which proves nothing (the safe direction).
#   5. families: {"hz-docker": {provider: "docker", sets: [MAIN_SET, SMALL_SET], candidate, back_until}}, the last two
#      the state's; stops: the state's STOPs of hz-docker; restart: the state's `restart` member, or null.
#   6. healthz: runscaler's /healthz read twice, 3 s apart (runner-facts.sh's healthz_pair), one JSON line each.
#   A fact it cannot read: "runner-updater: REFUSE no facts: WHY", exit 1, and no core program runs.
# DIFFERS from the Studio's pass: no protected list to rewrite, no report command and no observe file; DUE's baseline is
#   RUN_USER's build record of the image config.toml runs (found by its digest), not a recipe in the state, and the
#   family's current version is that record's (no `images`); DUE's last check is the build record of the release, not a
#   download of its tarball (RUN_USER's build checked its digest); the release is built by RUN_USER's own pass (THE
#   BUILD PASS), not in a window; the process is systemd's MainPID and ActiveEnterTimestamp (one read), not ps; /healthz
#   is the host config's port on 127.0.0.1, as pool-image.sh reads it, not the config's health keys; no pool-size rule
#   (a Tart rule); the install time is a window's journaled `renamed` epoch when a window installed config.toml (and
#   nothing wrote it later); a log-level other than info or debug is no facts (runscaler then logs no finished job); no
#   rule for a folder it cannot search (the Studio's guards the protected list and the pins, which this host has none
#   of: here a state behind such a folder reads as fresh, OFF, and what an OFF pass runs, RECOVER FIRST, THE APPLY STEP
#   and THE OUTAGE RULE, reads no protected list and no pin); the lock is flock(1) on
#   fd 9; a decision core that answers `wait` is a WAIT (exit 4), in a pass and in status, and this updater takes only the
#   verdicts core/README.md names for each program (idle: idle or not-idle; r1, keep and status: ok; or wait), where
#   the Studio's takes any string as a decision.
#
# Exit codes:
#   0  done; also a pass that finds the lock held or the updater OFF, and a pass whose DUE line or build pass says why
#      nothing is due or built (a WAIT of GitHub's, or of 02-d1.sh in a pass, too; a build CUT by a signal)
#   1  a REFUSE (a state it does not read, a fact it cannot read, a recipe it cannot compute, off while a window journal
#      stays, RECOVER's own REFUSE, a user other than RS_USER and RUN_USER, build as RS_USER) or a STOP (a state it
#      cannot write, the core could not decide, a window journal that stays at WINDOW after RECOVER FIRST, a pass's
#      build that failed: check failed); a `build VERSION` that failed
#   2  usage
#   3  STOP untested jq
#   4  WAIT: a state of another format, or with a member this release does not read; a pass, or status, whose decision
#      core waits; a `build VERSION` whose 02-d1.sh waits (GitHub's rate limit)
# Constants:
#   PATH        its own, the system folders, set first: a caller's PATH (the watchdog's `ssh RS_USER@HOST PATH=...
#               runner-updater status`, a timer, a terminal) changes nothing, and its #! line names /bin/bash, so no
#               PATH is read even to find bash. To FIND it by its bare name, a caller's PATH names ~/bin (the
#               watchdog's --hz line: linux-docker/README.md)
#   ROLE ME     rs | run, decided by ME, the user it runs as (above)
#   B           this release's linux-docker/, ~/build (pool-image.sh's): CORE = B/core, and the sourced
#               B/setup/runner-release.sh (RR_LOCK, rr_lock, rr_eligible, rr_recipe, rr_record, rr_record_of) and
#               B/setup/runner-facts.sh (the measuring helpers)
#   R CFG       runscaler's folder, ~/.config/runner (runner.log, runner.log.1), and its config.toml
#   STATEDIR    RR_LOCK's folder, ~/.local/state/runner-updater: STATE (state.json), PASSDIR (pass/: a pass's
#               facts.json, log.txt, healthz.json, the core state copy state.json, each program's PROGRAM.json and
#               PROGRAM.err, the latest release's release.out and release.err), WINDOW (window: pool-image.sh's open
#               window journal), WINDOWS (windows/: its closed ones), BUILDOUT (build.out: RUN_USER's last 02-d1.sh
#               build's output)
#   RUN_STATE RUN_MAX  RUN_USER's STATE as RS_USER's status reads it: /home/RUN_USER plus this STATE's path in the home;
#               at most 262144 bytes of it (a larger one is not shown)
#   BUILDS      RUN_USER's build records (02-d1.sh's ~/run/builds): /home/RUN_USER/run/builds as RS_USER (RS_USER reads
#               them through RUN_USER's group), ~/run/builds as RUN_USER
#   FAMILY      hz-docker, the one family of this host
set -uo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH LC_ALL=C TZ=UTC
umask 077
# A RUNNER VERSION: N.N.N, each part 1 to 9 digits, the ONE pattern of this program (fix round 2 of S2b-3b-3). A real
# runner's parts have at most 3 digits (2.339.0); 9 bounds a version at 29 characters, so a line that shows one is
# bounded, and each part stays exact in bash's arithmetic (newer). `build VERSION`'s usage, THE BUILD PASS (it builds
# no version the pattern refuses, so a STOP it writes holds a version RS_USER's status shows, and `build VERSION` can
# retry) and RUN_SHOWN (the version RS_USER's status shows) use it. No backslash: the same text in bash and in jq
VERSION_RE='[0-9]{1,9}[.][0-9]{1,9}[.][0-9]{1,9}'
TERMED=   # THE TERM WINDOW's record of a TERM (do_build_pass): empty at the start of every command, never inherited
EARLIER=  # this run ran RECOVER or wrote the state (core_nothing): empty at the start of every command, never inherited
WROTE=    # this run wrote the state (put_state; off's refusal): empty at the start of every command, never inherited

usage() { echo "runner-updater: usage: runner-updater status | on | off | pass | build VERSION${1:+ ($1)}" >&2; exit 2; }
[ "$#" -ge 1 ] || usage "no command"
cmd=$1
shift
case $cmd in
  status|on|off|pass) [ "$#" = 0 ] || usage "$cmd takes no argument" ;;
  build) { [ "$#" = 1 ] && [[ $1 =~ ^${VERSION_RE}$ ]]; } || usage "build takes one runner version, N.N.N of 1 to 9 digits each" ;;
  *) usage "unknown command '$cmd'" ;;
esac

# THE HOST CONFIG: every value of this host (users, ports, addresses, names) is in HOST_CONF, root's file, never in
# this script; linux-docker/host.conf.example names each key. Absent, not root's, writable by another user, a line that
# is not KEY=value, any key twice (read or not) or a key missing: REFUSE on stderr, exit 1, before anything else runs.
HOST_CONF=/etc/liveapp-ci/host.conf
host_conf() {   # host_conf SCRIPT KEY...: each named KEY's line in HOST_CONF sets that variable
  local me=$1 l k o seen=" "; shift
  o=$(stat -c '%a %U' "$HOST_CONF" 2>/dev/null) || { echo "$me: REFUSE no host config $HOST_CONF (linux-docker/README.md)" >&2; exit 1; }
  [[ $o =~ ^[0-7][0145][0145]\ root$ ]] || { echo "$me: REFUSE $HOST_CONF must be root's and writable by root only: [$o]" >&2; exit 1; }
  while IFS= read -r l || [ -n "$l" ]; do
    case $l in ''|'#'*) continue ;; esac
    [[ $l =~ ^([A-Z][A-Z0-9_]*)=([A-Za-z0-9][A-Za-z0-9._:/-]*)$ ]] || { echo "$me: REFUSE $HOST_CONF: want KEY=value, got [$l]" >&2; exit 1; }
    k=${BASH_REMATCH[1]}; [[ $seen != *" $k "* ]] || { echo "$me: REFUSE $HOST_CONF names $k twice" >&2; exit 1; }
    seen="$seen$k "; [[ " $* " == *" $k "* ]] || continue
    printf -v "$k" %s "${BASH_REMATCH[2]}"
  done < "$HOST_CONF"
  for k in "$@"; do [[ $seen == *" $k "* ]] || { echo "$me: REFUSE $HOST_CONF lacks $k (linux-docker/host.conf.example)" >&2; exit 1; }; done
}
host_conf runner-updater RS_USER RUN_USER RS_HEALTH_PORT MAIN_SET SMALL_SET

say() { echo "runner-updater: $*"; }
refuse() { echo "runner-updater: REFUSE $*"; exit 1; }
stop() { echo "runner-updater: STOP $*"; exit 1; }
wait4() { echo "runner-updater: WAIT $*"; exit 4; }

# THE ROLE (the header): the user it runs as
ME=$(id -un)
if [ "$ME" = "${RS_USER}" ]; then ROLE=rs
elif [ "$ME" = "${RUN_USER}" ]; then ROLE=run
else refuse "run me as ${RS_USER} or ${RUN_USER}"; fi
[ "$cmd" != build ] || [ "$ROLE" = run ] || refuse "build is a command of RUN_USER (${RUN_USER}): run it as ${RUN_USER}"
B=$HOME/build
R=$HOME/.config/runner
CFG=$R/config.toml
CORE=$B/core
FAMILY=hz-docker
# shellcheck source=../setup/runner-release.sh
. "$B/setup/runner-release.sh" || refuse "cannot read $B/setup/runner-release.sh (is this release's linux-docker/ ~/build?)"
# shellcheck source=../setup/runner-facts.sh
. "$B/setup/runner-facts.sh" || refuse "cannot read $B/setup/runner-facts.sh (is this release's linux-docker/ ~/build?)"
STATEDIR=${RR_LOCK%/*}
STATE=$RR_STATE   # STATEDIR/state.json: its mode is rr_lock's (RR_STATE_MODE)
PASSDIR=$STATEDIR/pass
WINDOW=$STATEDIR/window
WINDOWS=$STATEDIR/windows
BUILDOUT=$STATEDIR/build.out
if [ "$ROLE" = rs ]; then BUILDS=/home/${RUN_USER}/run/builds; else BUILDS=$HOME/run/builds; fi
RUN_STATE=/home/${RUN_USER}${STATE#"$HOME"}   # RUN_USER's STATE, as RS_USER's status reads it (run_record)

# ---- the state
FRESH='{"format":1,"on":false,"families":{}}'
# format 1, member by member (the members it reads; MEMBERS lists any other)
CHECK='
def set_ok: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$");
def image_ok: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$");
def version_ok: type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+$");
def epoch_ok: type == "number" and . >= 0 and . == floor;
def lines_ok: type == "object" and length > 0 and all(to_entries[]; (.key | set_ok) and (.value | image_ok));
def proc_ok: type == "object" and (.pid | type) == "number" and .pid >= 1 and .pid == (.pid | floor) and (.start | epoch_ok);
def position_ok: type == "object" and (.inode | type) == "string" and (.inode | test("^[0-9]+$")) and (.offset | epoch_ok)
  and (.sha | type) == "string" and (.sha | test("^[0-9a-f]{64}$"));
def stop_ok: type == "object" and .family == "hz-docker" and (.stop | type) == "string" and (.stop | length) > 0
  and (.version == null or (.version | type) == "string") and (.user == null or (.user | type) == "string")
  and (.detail == null or (.detail | type) == "object");
def family_ok: type == "object"
  and (.candidate == null or (.candidate | type == "object" and (.version | version_ok) and (.lines | lines_ok)
                              and (.closed_at | epoch_ok)))
  and (.previous == null or (.previous | lines_ok))
  and (.back_until == null or (.back_until | epoch_ok))
  and (.rejected == null or (.rejected | type == "array" and all(.[]; version_ok)))
  and (.stops == null or (.stops | type == "array" and all(.[]; stop_ok)));
if type == "object" and .format == 1 and (.on | type) == "boolean" and (.families | type) == "object"
   and (.families["hz-docker"] == null or (.families["hz-docker"] | family_ok))
   and (.core == null or (.core | type) == "object")
   and (.restart == null or (.restart | type == "object" and (.from | proc_ok) and (.to | proc_ok) and (.stopped | position_ok)))
   and (.last_window == null or (.last_window | type == "string" and test("^[0-9]{14}-[0-9]+$")))
then . else error("not a state of format 1") end'
# the members of a checked state that this release does not read, at each level it reads ("" when none); a name that
# is not plain is shown as JSON (no raw newline reaches the WAIT line)
MEMBERS='
def shown: if test("^[A-Za-z_][A-Za-z0-9_-]{0,40}$") then . else tojson end;
[(keys - ["format", "on", "families", "core", "restart", "last_window"])[] | shown]
+ [(.families | keys - ["hz-docker"])[] | "families.\(shown)"]
+ (if (.families["hz-docker"] | type) == "object" then .families["hz-docker"] as $h
     | [($h | keys - ["candidate", "previous", "back_until", "rejected", "stops"])[] | "families.hz-docker.\(shown)"]
       + (if ($h.candidate | type) == "object" then [($h.candidate | keys - ["version", "lines", "closed_at"])[]
            | "families.hz-docker.candidate.\(shown)"] else [] end)
       + [($h.stops // []) | to_entries[] | .key as $i | .value | (keys - ["family", "stop", "version", "user", "detail"])[]
            | "families.hz-docker.stops[\($i)].\(shown)"]
   else [] end)
+ (if (.restart | type) == "object" then .restart as $r
     | [($r | keys - ["from", "to", "stopped"])[] | "restart.\(shown)"]
       + [("from", "to") as $k | ($r[$k] | keys - ["pid", "start"])[] | "restart.\($k).\(shown)"]
       + [($r.stopped | keys - ["inode", "offset", "sha"])[] | "restart.stopped.\(shown)"]
   else [] end)
| join(", ")'
# RUN_USER's state (the header): its own FRESH, shape and members; ONE copy, which RS_USER's status reads RUN_USER's
# record by too
RUN_FRESH='{"format":1,"on":false,"stops":[]}'
RUN_CHECK='
def stop_ok: type == "object" and (.stop | type) == "string" and (.stop | length) > 0
  and (.version == null or (.version | type) == "string") and (.user == null or (.user | type) == "string")
  and (.detail == null or (.detail | type) == "object");
if type == "object" and .format == 1 and (.on | type) == "boolean"
   and (.stops == null or (.stops | type == "array" and all(.[]; stop_ok)))
then . else error("not a state of format 1") end'
RUN_MEMBERS='
def shown: if test("^[A-Za-z_][A-Za-z0-9_-]{0,40}$") then . else tojson end;
[(keys - ["format", "on", "stops"])[] | shown]
+ [(.stops // []) | to_entries[] | .key as $i | .value | (keys - ["stop", "version", "user", "detail"])[]
     | "stops[\($i)].\(shown)"]
| join(", ")'
[ "$ROLE" != run ] || { FRESH=$RUN_FRESH CHECK=$RUN_CHECK MEMBERS=$RUN_MEMBERS; }
# THE TEXT OF A `check failed` STOP, ONE rule for RUN_USER's writer (check_failed makes the text by it) and RS_USER's
# reader (RUN_SHOWN: a text it would change is not the writer's): printable ASCII, each other character "?", at most
# 900 characters. A character outside 0x20-0x7e is never shown by RS_USER: the writer never stores one, so a record that
# holds one is not its writer's, and it is not shown at all (a reader that replaced it would show a record its writer
# never made)
RUN_TEXT='def run_text: explode | map(if . < 32 or . > 126 then 63 else . end) | implode | .[:900];'
# THE SHAPE RS_USER's status shows of RUN_USER's record (fix round 1 of S2b-3b-3; RUN_USER's files are hostile, PLAN
# D1): only what RUN_USER's own writer (check_failed) makes, beyond RUN_CHECK and RUN_MEMBERS: `on` a boolean; each STOP
# exactly {stop, version, user, detail}, stop `check failed`, version by VERSION_RE (the whole string), user a string,
# detail exactly {text, step, build_user}, step `build`, build_user a string, text by RUN_TEXT. status.jq puts a STOP's
# version, detail.hand and detail.jq.path into its "Next" commands: none of a record of another shape reaches a line.
# Its text is never shown either (fix round 2: status_facts puts a fixed text in its place)
RUN_SHOWN=$RUN_TEXT'
def writer_stop: type == "object" and keys == ["detail", "stop", "user", "version"] and .stop == "check failed"
  and (.version | type == "string" and test("\\A'"$VERSION_RE"'\\z")) and (.user | type) == "string"
  and (.detail | type == "object" and keys == ["build_user", "step", "text"] and .step == "build"
       and (.build_user | type) == "string" and (.text | type == "string" and run_text == .));
(.on | type) == "boolean" and ((.stops // []) | type == "array" and all(.[]; writer_stop))'

# TEXT CHECK MEMBERS: a state's text read by the rules of one user's state (its format, CHECK's shape, MEMBERS' list
# of the members this release does not read). 0 + REPLY = the state, compact JSON; 1: not one JSON object (or no jq
# reads it); 2 + REPLY = its format, another than 1 (JSON: `null` when it names none); 3: not CHECK's shape; 5 +
# REPLY = the members it does not read; 6: jq could not list them. ONE copy: load_state and RUN_USER's record
# (status as RS_USER) both read by it
parse_state() {
  local fmt s m
  fmt=$(printf '%s' "$1" | jq -s -r 'if length == 1 and (.[0] | type) == "object" then .[0].format | tojson
                                      else error("not one object") end' 2> /dev/null) || return 1
  [ "$fmt" = 1 ] || { REPLY=$fmt; return 2; }
  s=$(printf '%s' "$1" | jq -c "$2" 2> /dev/null) && [ -n "$s" ] || return 3
  m=$(printf '%s\n' "$s" | jq -r "$3" 2> /dev/null) || return 6
  [ -z "$m" ] || { REPLY=$m; return 5; }
  REPLY=$s
}

# STATE, read ONCE -> ST (compact JSON); a missing one is FRESH. WAIT (exit 4) on another format or a member this
# release does not read, REFUSE on one it does not read: in each case nothing is written
load_state() {
  local text
  if [ ! -e "$STATE" ] && [ ! -L "$STATE" ]; then ST=$FRESH; return 0; fi
  { [ -f "$STATE" ] && [ ! -L "$STATE" ] && [ -r "$STATE" ]; } || refuse "$STATE is not a readable regular file: it is left as it is"
  text=$(cat -- "$STATE" && echo .) || refuse "$STATE cannot be read: it is left as it is"
  text=${text%.}
  parse_state "$text" "$CHECK" "$MEMBERS"
  case $? in
    0) ST=$REPLY ;;
    1) refuse "$STATE is not one JSON object (or no jq reads it): it is left as it is" ;;
    2) wait4 "the state $STATE has format $REPLY; this updater reads format 1: it waits and changes nothing" ;;
    3) refuse "$STATE is not a state of format 1 this reads: it is left as it is" ;;
    5) wait4 "the state $STATE holds members this release does not read ($REPLY): a later release wrote them, and they may hold a STOP; it waits and changes nothing" ;;
    *) refuse "jq could not list the members of $STATE: it is left as it is" ;;
  esac
}

# JSON: the new state into STATE by rename, after a sync to disk; a STOP when it cannot (STATE is then as it was)
put_state() {
  local out
  rm -f -- "$STATE.new" 2> /dev/null
  { printf '%s\n' "$1" > "$STATE.new"; } 2> /dev/null || { rm -f -- "$STATE.new"; stop "the state cannot be written ($STATE.new): $STATE is as it was"; }
  chmod "$RR_STATE_MODE" -- "$STATE.new" 2> /dev/null \
    || { rm -f -- "$STATE.new"; stop "the state's mode cannot be set (rr_lock's, [$RR_STATE_MODE]): $STATE is as it was"; }
  out=$(dd if=/dev/null of="$STATE.new" conv=notrunc,fsync 2>&1 < /dev/null) \
    || { rm -f -- "$STATE.new"; stop "the state cannot be synced to disk (dd: ${out%%$'\n'*}): $STATE is as it was"; }
  mv -f -- "$STATE.new" "$STATE" || { rm -f -- "$STATE.new"; stop "the state cannot be renamed into place: $STATE is as it was"; }
  EARLIER=1 WROTE=1   # this run wrote the state (core_nothing; off's refusal)
}
# JQFILTER [JQ OPTION...]: ST changed by it, written by put_state
change_state() {
  local new
  new=$(printf '%s\n' "$ST" | jq -c "$@") && [ -n "$new" ] || stop "jq could not change the state: $STATE is as it was"
  put_state "$new"
  ST=$new
}

# THE JQ CHECK (the header): exit 3 when the jq is not one core/TESTED_JQ lists for the core. [MORE]: a sentence the
# STOP line ends with (status as RS_USER: RUN_USER's record is not read either)
jq_check() {
  local more=${1:+ ($1)}
  tested_jq && return 0
  if [ "$JQV" = "no jq" ]; then
    echo "runner-updater: STOP untested jq: no jq answers \`jq --version\` here: install one that $CORE/TESTED_JQ lists for core (the jq package of Ubuntu 26.04 and of 24.04 is one); no new work starts$more"
  else
    echo "runner-updater: STOP untested jq: jq here prints [$JQV], which is no core row of $CORE/TESTED_JQ: the decision core is not tested with it, and no new work starts. Next, in the repository: \`JQ=$(command -v jq) python3 -I -B -m unittest discover -s tests/core -t .\`, then add its row to core/TESTED_JQ when they pass$more"
  fi
  exit 3
}

window_open() { [ -e "$WINDOW" ] || [ -L "$WINDOW" ]; }

# ---- status: no lock, no write; ONE read of the state, and the facts status.jq needs come from it
# ROLE [USER] (stdin: a checked state of ROLE's shape) -> the facts status.jq reads. RS_USER's: the family's
# candidate, back_until and STOPs; RUN_USER's: its STOPs, of hz-docker (no family: it observes none). With USER
# (RUN_USER's record, as RS_USER reads it): each STOP's user, and its detail's build_user, are USER, so a line names the
# host config's user, never one the record names (PLAN D1: RUN_USER's files are hostile to RS_USER); and its text (the
# cause, which status.jq puts into the STOP line) is a FIXED text of this program that names RUN_USER's own status, so
# no text of the record reaches a line (fix round 2 of S2b-3b-3: a text of the writer's own shape can read as an
# instruction, and RUN_USER controls its own ~/build, so no reader check can tell). RUN_USER's own status shows it all
status_facts() {
  jq -c --arg role "$1" --arg u "${2-}" --arg f "$FAMILY" --arg m "$MAIN_SET" --arg s "$SMALL_SET" '
    {format: 1, host: "hz", sets: [], proc: null, position: null, continuous: false, restart: null, config: null}
    + (if $role == "rs" then (.families[$f] // {}) as $h
         | {families: {($f): {provider: "docker", sets: [$m, $s], candidate: ($h.candidate // null),
                              back_until: ($h.back_until // null)}},
            stops: ($h.stops // [])}
       else {families: {}, stops: [(.stops // [])[] | {family: $f} + .
                                   | if $u == "" then .
                                     else .user = $u
                                          | if (.detail | type) == "object"
                                            then .detail.build_user = $u
                                                 | .detail.text = "its cause: as \($u), `runner-updater status` shows it"
                                            else . end
                                     end]} end)'
}
# CORE FACTS NOW -> status.jq's answer, its stderr with it (anything but one decision is "could not decide"), and its
# exit code. The inputs come through process substitutions: pipes, no file
status_jq() {
  jq -n -L "$CORE/lib" -f "$CORE/status.jq" --slurpfile state <(printf '%s' "$1") \
    --slurpfile facts <(printf '%s\n' "$2") --arg now "$3" 2>&1 < /dev/null
}
# status.jq's answer (stdin) -> its lines (jq -r --arg pre PREFIX): the verdict, its lines, then each STOP's D7
# properties. PREFIX "": the user's own status, as it always printed it. Another PREFIX (RUN_USER's record) starts EVERY
# line, and each control character of a line is "?": a record's text never makes a line of its own
STATUS_LINES='def yn: if . == true then "yes" elif . == false then "no" elif . == null then "unknown" else tostring end;
  def clean: tostring | explode | map(if . < 32 or (. >= 127 and . < 160) then 63 else . end) | implode;
  def mine: if $pre == "" then . else $pre + clean end;
  (("status: \(.verdict) (\(.reason))", .lines[]) | mine),
  (.stops[]? | "STOP \(.family) \(.stop): known \(.known); candidate closed: \(.closes_candidate | yn); version rejected: \(.rejects | yn); a newer release proceeds alone: \(.newer_proceeds | yn)"
   | if $pre == "" then "runner-updater: " + . else mine end)'

# THE RECORD OF RUN_USER (status as RS_USER, after its own lines; PLAN D7: `status` prints both users' records, each
# STOP's line with its user). NOW. RUN_USER's state.json is read as HOSTILE (PLAN D1): ONE open, runner-release.sh's
# rr_read (it never blocks and never follows a symlink; a plain file only), at most RUN_MAX bytes, never sourced; a
# text with a byte no JSON text holds (a NUL; a control byte but tab, newline and CR) is none; then RUN_USER's own rules
# (parse_state with RUN_CHECK and RUN_MEMBERS: its format, shape and members); no file is a fresh install, OFF, as
# RUN_USER reads it. EVERY line starts with "runner-updater: as RUN_USER: ": ON or OFF, then status.jq's lines of its
# STOPs (status_facts: the user each names is the host config's RUN_USER); or ONE line that names why it is not shown
# and RUN_USER's own `runner-updater status` as the way to read it. It writes nothing, takes no lock, and changes no
# exit code. A host config whose RUN_USER is RS_USER: no second record (the one above is that user's)
RUN_MAX=262144
# WHY: RUN_USER's record is not shown, the ONE line that says so (WHY is a fixed text of this program)
run_not_shown() {
  local why=${1:0:400}
  echo "runner-updater: as ${RUN_USER}: status: its record $RUN_STATE is not shown: ${why//[[:cntrl:]]/?}; as ${RUN_USER}, \`runner-updater status\` reads it"
}
run_record() {
  local pre="runner-updater: as ${RUN_USER}: " raw tail body st= why= fresh= facts out rc
  [ "${RUN_USER}" != "$ME" ] || return 0
  [[ ${1-} =~ ^[0-9]+$ ]] || { run_not_shown "the clock gave no time"; return 0; }
  raw=$({ rr_read "$RUN_STATE" "$((RUN_MAX + 1))"; printf '\n%s %s' "$?" "$RR_WHY"; } | tr '\000' '\001')
  tail=${raw##*$'\n'} body=${raw%$'\n'*}
  if [[ ! $tail =~ ^([0-9]+)\ (.*)$ ]]; then why="it cannot be read"
  elif [ "${BASH_REMATCH[1]}" != 0 ]; then
    if [ "${BASH_REMATCH[2]}" = "there is none" ]; then st=$RUN_FRESH fresh=1; else why=${BASH_REMATCH[2]:-it cannot be read}; fi
  elif [ "${#body}" -gt "$RUN_MAX" ]; then why="it is larger than $RUN_MAX bytes"
  elif [[ ${body//[$'\t\n\r']/} == *[$'\001'-$'\037']* ]]; then
    why="it holds a byte no JSON text holds (a NUL or another control byte)"
  else
    parse_state "$body" "$RUN_CHECK" "$RUN_MEMBERS"
    case $? in      # each why is a fixed text: none holds a text of the record (no member name, no value)
      0) st=$REPLY ;;
      1) why="it is not one JSON object" ;;
      2) why="it has another format; this release reads format 1" ;;
      3) why="it is not a state of format 1 this release reads" ;;
      5) why="it holds members this release does not read" ;;
      *) why="jq could not list its members" ;;
    esac
  fi
  if [ -z "$why" ] && ! printf '%s\n' "$st" | jq -e "$RUN_SHOWN" > /dev/null 2>&1; then
    why="its STOPs are not what its own updater writes (only a \`check failed\` of a build: a version N.N.N of 1 to 9 digits each and a text of at most 900 printable ASCII characters)"
  fi
  if [ -z "$why" ]; then
    facts=$(printf '%s\n' "$st" | status_facts run "${RUN_USER}") || why="jq could not build its facts"
  fi
  if [ -z "$why" ]; then
    out=$(status_jq "" "$facts" "$1")
    rc=$?
    { [ "$rc" = 0 ] && printf '%s\n' "$out" | decided status && [ "$(printf '%s\n' "$out" | jq -r '.verdict')" = ok ]; } \
      || why="the decision core did not render it (status.jq, exit $rc)"
  fi
  if [ -n "$why" ]; then run_not_shown "$why"; return 0; fi
  if [ -n "$fresh" ]; then echo "${pre}status: the updater is OFF (no record: $RUN_STATE is not there: a fresh install)"
  else echo "${pre}status: the updater is $(printf '%s\n' "$st" | jq -r 'if .on then "ON" else "OFF" end') (its record: $RUN_STATE)"; fi
  printf '%s\n' "$out" | jq -r --arg pre "$pre" "$STATUS_LINES"
}

# RS_USER's status (and RUN_USER's own): its own lines, its own exit code. As RS_USER with another RUN_USER, they run in
# a subshell, so that every end of them (a WAIT or REFUSE on its own state, a core that could not decide or waits, a
# clock it cannot read, or exit 0) is followed by RUN_USER's record (run_record; PLAN D7: status prints both users'
# records), and then that exit code. Under an untested jq no record is parsed: when its own STOP untested jq ended it
# (exit 3), that line says so and no line of RUN_USER's follows; when an earlier end came first, ONE line of RUN_USER's
# says so
do_status() {
  local rc
  if [ "$ROLE" = rs ] && [ "${RUN_USER}" != "$ME" ]; then
    ( status_own "${RUN_USER}'s record is not read either: no record parse runs under an untested jq" )
    rc=$?
    if tested_jq; then run_record "$(date +%s)"
    elif [ "$rc" != 3 ]; then run_not_shown "the jq here is untested (no core/TESTED_JQ row for core): no record is read under it"
    fi
    exit "$rc"
  fi
  status_own
}
# A JOURNAL AT WINDOW, as status names it (the header: status; D-g): read by THE APPLY STEP's own reader (apply_read,
# and apply_decide for a closed one), no lock, no write. Open (its last line is not `closed`): its last `stop` line (NO
# IDLE with its hand line, as it is journaled), and whether a runscaler RUNS (runner-facts.sh's runs, the /healthz pair
# kept in memory: no file); closed and not applied; applied and not archived (its ID is the state's last_window). A run
# is promised to end it only when one can (B2a review r1, Opus F4): a closed journal the apply step cannot read names
# README's section; status runs no RECOVER, so an open one names it as what a person does when RECOVER cannot end it
status_window() {
  local text lw st sets cr s
  window_open || return 0
  apply_read
  case $? in
    0) lw=$(printf '%s\n' "$ST" | jq -r '.last_window // empty')
       if [ -n "$lw" ] && [ "$AJ_ID" = "$lw" ]; then
         say "status: a window journal is applied and not archived: $WINDOW (the next pass, on or off archives it)"
       elif apply_decide "$(printf '%s\n' "$ST" | jq -c --arg f "$FAMILY" '.families[$f].candidate // null')" || [ "$?" = 3 ]; then
         say "status: a window journal is closed and not applied: $WINDOW (the next pass, on or off applies it)"
       else
         say "status: a window journal is closed, and the apply step cannot read it: $WINDOW ($REPLY): each run stops on it, and no run of the updater can end it: $README_SECTION"
       fi
       return 0 ;;
    1) ;;
    *) say "status: a window journal is there, and the updater cannot read it: $WINDOW ($REPLY): no run of the updater can end it: $README_SECTION"
       return 0 ;;
  esac
  text=$(cat -- "$WINDOW" 2> /dev/null && echo .); text=${text%.}
  say "status: a window journal is open: $WINDOW (a window that runs holds the updater lock; when none does, the next pass's RECOVER tries to end it, and when RECOVER cannot read or act on it, that pass's STOP names $README_SECTION)"
  st=$(printf '%s' "$text" | grep '^stop ' | tail -n 1)
  if [ -n "$st" ]; then st=${st#stop }; say "status: the window journal's last STOP: ${st//[[:cntrl:]]/?}"
  else say "status: the window journal holds no STOP"; fi
  sets="${MAIN_SET} ${SMALL_SET}"
  if cr=$(config_read "$CFG") && s=$(printf '%s\n' "${cr#*$'\n'}" | jq -r '.sets | join(" ")' 2> /dev/null) && [ -n "$s" ]; then
    sets=$s
  fi
  # shellcheck disable=SC2086
  if runs 0 - $sets; then say "status: runscaler RUNS (pid ${RUNS_PROC% *}, started ${RUNS_PROC#* })"
  else say "status: no runscaler RUNS: $RUNS_WHY"; fi
}
status_own() {   # [MORE]: jq_check's
  local now core facts out rc
  load_state
  jq_check "${1-}"
  now=$(date +%s)
  [[ $now =~ ^[0-9]+$ ]] || refuse "the clock gave '$now'"
  # the core's state as status.jq reads it: with no line of a family that has no candidate (a departed candidate's R1
  # and KEEP evidence is no current work: STATUS AFTER A ROLLBACK); the core's own state is not edited
  core=$(printf '%s\n' "$ST" | jq -c --arg f "$FAMILY" '(.families[$f].candidate // null) as $c | .core // empty
          | if $c == null and (.families | type) == "object" then del(.families[$f]) else . end') \
    && facts=$(printf '%s\n' "$ST" | status_facts "$ROLE") \
    || refuse "jq could not build the facts of the state"
  say "status: the updater is $(printf '%s\n' "$ST" | jq -r 'if .on then "ON" else "OFF" end')"
  [ "$ROLE" != rs ] || printf '%s\n' "$ST" | jq -r --arg f "$FAMILY" 'def utc: strftime("%Y-%m-%d %H:%M UTC");
    (.families[$f] // {}) as $h
    | ("runner-updater: family \($f): "
       + (if $h.candidate == null then "no candidate"
          else "candidate runner \($h.candidate.version) (\($h.candidate.lines | to_entries | sort_by(.key)
                | map("\(.key)=\(.value)") | join(", "))), switched \($h.candidate.closed_at | utc)" end)
       + "; " + (if $h.back_until == null then "back: none" else "back until \($h.back_until | utc)" end)
       + "; rejected: " + (if ($h.rejected // []) == [] then "none" else ($h.rejected | join(", ")) end))' \
    || refuse "jq could not print the state"
  [ "$ROLE" != rs ] || status_window
  out=$(status_jq "$core" "$facts" "$now")
  rc=$?
  if [ "$rc" != 0 ] || ! printf '%s\n' "$out" | decided status; then
    stop "core could not decide (status): exit $rc: ${out%%$'\n'*}"
  fi
  printf '%s\n' "$out" | jq -r --arg pre "" "$STATUS_LINES"
  [ "$(printf '%s\n' "$out" | jq -r '.verdict')" != wait ] \
    || wait4 "the decision core waits ($(printf '%s\n' "$out" | waits_why status)): status decides nothing, and it writes nothing"
  exit 0
}

# ---- on, off (D11), under the lock
do_on() {
  load_state
  [ "$ROLE" != rs ] || { recover_first; [ -z "$WSTOP" ] || { echo "$WSTOP"; exit 1; }; }
  change_state '.on = true'
  say "on: the updater is ON"
  exit 0
}
do_off() {
  load_state
  [ "$ROLE" != rs ] || recover_first
  if [ -n "$WSTOP" ] || window_open; then
    [ -z "$WSTOP" ] || echo "$WSTOP"
    # never "nothing changed" after RECOVER or a state write acted (B2a review r2, Codex F3)
    if [ -n "$RECOVER_ACTED$WROTE" ]; then
      refuse "a window journal stays open ($WINDOW): off never strands a window, so the updater stays $(printf '%s\n' "$ST" | jq -r 'if .on then "ON" else "OFF" end'), and what RECOVER and the apply step did in this run stays (their lines above). Run off again once \`runner-updater status\` shows no window journal"
    fi
    refuse "a window journal stays open ($WINDOW): off never strands a window, so nothing changed. Run off again once \`runner-updater status\` shows no window journal"
  fi
  change_state '.on = false'
  say "off: the updater is OFF"
  exit 0
}

# ---- RECOVER FIRST, THE APPLY STEP, THE OUTAGE RULE (RS_USER's; the header)
KEEPP=$R/config.toml.prev   # a switch's backup when it replaces the keep (pool-image.sh's KEEPP)
README_SECTION='linux-docker/README.md "An unfinished window the updater cannot end"'
WSTOP=              # the STOP or REFUSE line a run ends with (a pass: after THE OUTAGE RULE): the journal stays
W_HOW=              # with WSTOP: how the journal stays, for POOL DOWN's text (B2a review r1, Opus F4): README's section
                    # when no run of the updater can end it, else what the next run does
RECOVER_STARTED=0   # this run's RECOVER journaled a `starting` or `stopping` (D-g: a pass's one restart of runscaler;
                    # S2b-3c-1 B2b's rollback reads it: a pass whose RECOVER started or restarted runscaler starts none)
RECOVER_ACTED=      # this run's RECOVER may have changed something (off's refusal, B2a review r2: Codex F3, Opus F2):
                    # not by its own contract when it exits 1, 3, 4 or 6, nor exit 0 with the journal's bytes as they
                    # were; 5 (open: a resumed start writes no line) and any other exit may have

# RECOVER FIRST (the header): pool-image.sh's RECOVER as this run's CHILD, only when a journal is at WINDOW (it holds
# the updater lock on fd 9, which the child inherits: THE UPDATER'S CHILD), then THE APPLY STEP. RECOVER's exits: 0 the
# journal is closed: applied; 3 none there; 4 WAIT (a person's pool-image.sh run holds that script's own lock: it read
# and changed nothing): a line, no STOP, and a closed journal is applied all the same; 5 it stays open (its line says
# why); 6 one it cannot read or act on: README's section, nothing written; 1 a REFUSE; any other: a STOP that names it.
# A journal that stays at WINDOW (open, or one the apply step cannot read or archive) sets WSTOP: nothing else starts;
# and W_HOW, how it stays (POOL DOWN's text names it: a promise that a run ends it only when one can)
recover_first() {
  local rc n0 s0
  window_open || return 0
  EARLIER=1   # RECOVER runs (core_nothing)
  n0=$(wc -l < "$WINDOW" 2> /dev/null) && [[ $n0 =~ ^[0-9]+$ ]] || n0=0
  s0=$(sha256sum < "$WINDOW" 2> /dev/null) || s0=
  bash "$B/setup/pool-image.sh" recover --unattended < /dev/null
  rc=$?
  [ "$(tail -n +"$((n0 + 1))" -- "$WINDOW" 2> /dev/null | grep -c -E '^(starting|stopping) ')" = 0 ] || RECOVER_STARTED=1
  case $rc in
    1|3|4|6) ;;
    0) [ "$(sha256sum < "$WINDOW" 2> /dev/null)" = "$s0" ] || RECOVER_ACTED=1 ;;
    *) RECOVER_ACTED=1 ;;
  esac
  case $rc in
    0|5) ;;
    3) return 0 ;;
    4) say "RECOVER waits: another pool-image.sh run (a person's) holds its own lock, so RECOVER read and changed nothing; the next run tries it again" ;;
    6) WSTOP="runner-updater: STOP RECOVER cannot read or act on the window journal $WINDOW (its line above says why): $README_SECTION; nothing is written, and nothing else starts"
       W_HOW="RECOVER cannot read or act on it, so no run of the updater can end it: $README_SECTION"
       return 0 ;;
    1) WSTOP="runner-updater: REFUSE RECOVER did not run (pool-image.sh recover --unattended, exit 1: its line above says why): the window journal $WINDOW is as it was, and nothing else starts"
       W_HOW="RECOVER did not run (its REFUSE line says why), and the next run tries again"
       return 0 ;;
    *) WSTOP="runner-updater: STOP RECOVER exited $rc (pool-image.sh recover --unattended; its lines above): the window journal $WINDOW is as RECOVER left it, and nothing else starts"
       W_HOW="RECOVER exited $rc, and the next run tries again"
       return 0 ;;
  esac
  apply_step
  if [ -z "$WSTOP" ] && window_open; then
    WSTOP="runner-updater: STOP the window journal $WINDOW stays open (RECOVER's line above says why): the next run's RECOVER tries again, and nothing else starts"
    W_HOW="RECOVER keeps it open (its line says why), and the next run's RECOVER tries again"
  fi
}

# THE APPLY STEP's reader: the journal at WINDOW read ONCE, by its keys and fields (never a line's text: a `stop`
# line's NAME is its field, its TEXT is kept as it is). 0 and AJ_*: closed (its last line, a whole one, `closed E`); 1:
# open (RECOVER's); 2 + REPLY: a closed journal it cannot read
apply_read() {
  local text l k v n=0
  AJ_ID= AJ_KIND= AJ_VERSION= AJ_OLD= AJ_CSHA= AJ_T= AJ_TN=0 AJ_BACKUP= AJ_PREV= AJ_INST= AJ_RS=0 AJ_RSTART=0 AJ_FROM=
  AJ_STOPPED= AJ_STARTING= AJ_RUNNING= AJ_RUNN=0 AJ_SE=0 AJ_WHY= AJ_OLDV= AJ_CLOSED= AJ_STOPS=()
  { [ -f "$WINDOW" ] && [ ! -L "$WINDOW" ] && [ -r "$WINDOW" ]; } || { REPLY="it is not a readable plain file"; return 2; }
  text=$(cat -- "$WINDOW" && echo .) || { REPLY="it cannot be read"; return 2; }
  text=${text%.}
  [[ $text =~ (^|$'\n')closed\ [0-9]{1,12}$'\n'$ ]] || return 1
  mapfile -t AJ_L <<< "${text%$'\n'}"
  for l in "${AJ_L[@]}"; do
    n=$((n + 1))
    [[ $l =~ ^([a-z][a-z-]{0,30})\ (.*)$ ]] || { REPLY="line $n is not 'KEY VALUE'"; return 2; }
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    case $k in
      window) [ "$n" = 1 ] && [[ $v =~ ^[0-9]{14}-[0-9]+$ ]] || { REPLY="line $n is no first line \`window ID\`"; return 2; }
              AJ_ID=$v ;;
      kind) [ -n "$AJ_KIND" ] || AJ_KIND=$v ;;
      version) [ -n "$AJ_VERSION" ] || AJ_VERSION=$v ;;
      old) [ -n "$AJ_OLD" ] || AJ_OLD=$v ;;
      config-sha) [ -n "$AJ_CSHA" ] || AJ_CSHA=$v ;;
      target) [ -n "$AJ_T" ] || { AJ_T=$v AJ_TN=$n; } ;;   # the window's first: the TARGET
      backup) [ -n "$AJ_BACKUP" ] || AJ_BACKUP=$v ;;
      prev) AJ_PREV=$v ;;                                    # the LAST counts (RECOVER's close writes it again)
      installed) AJ_INST=$v ;;
      rename-start) [ "$AJ_RS" != 0 ] || AJ_RS=$n ;;
      recover-start) AJ_RSTART=1 ;;
      from) AJ_FROM=$v ;;
      stopped) AJ_STOPPED=$v ;;
      starting) AJ_STARTING=$v ;;
      running) AJ_RUNNING=$v AJ_RUNN=$n ;;
      stop|end) [ "$AJ_SE" != 0 ] || AJ_SE=$n
                if [ "$k" = stop ]; then
                  [[ ${v%%: *} =~ ^(check\ failed|DISK|untested\ jq|HAND\ CHANGE|ROLLBACK\ FAILED|POOL\ DOWN|CI\ DISABLED|NO\ IDLE)$ ]] && [[ $v == *': '* ]] \
                    || { REPLY="line $n: a STOP this release does not know"; return 2; }
                  AJ_STOPS+=("$v")
                fi ;;
      why) [ -n "$AJ_WHY" ] || AJ_WHY=$v ;;
      old-version) [ -n "$AJ_OLDV" ] || AJ_OLDV=$v ;;
      closed) AJ_CLOSED=$v ;;
    esac
  done
  [ -n "$AJ_ID" ] || { REPLY="its first line is not \`window ID\`"; return 2; }
}

# THE CLOSE RULE (the header) of the journal read (AJ_*): 0 and what the ONE state write does (A_CAND set | clear |
# keep, A_PREVOP old | null | keep, A_LINES, A_DROP, A_NEW the STOPs it holds, A_RS the `restart` member or null,
# A_WHAT its line); 1 + REPLY: a closed journal it cannot read. CAND: the state's candidate (JSON or null)
close_rule() {
  local cand=$1 sv= hold= htext= s fp fs si so sh e tp ts
  A_CAND=keep A_PREVOP=keep A_LINES='{}' A_DROP=false A_RS=null A_WHAT= A_NOTE=
  [[ $AJ_KIND =~ ^(switch|rollback)$ ]] || { REPLY="its kind is not switch or rollback"; return 1; }
  if [ -n "$AJ_INST" ]; then
    [[ $AJ_INST =~ ^([0-9a-f]{64}|none)\ ([0-9a-f]{64}|none)\ (target-running|target-idle|target-old|target-failed|pre|other|none)$ ]] \
      || { REPLY="its installed line is not 'SHA CONTENT CLASS'"; return 1; }
    A_CLASS=${BASH_REMATCH[3]}
  elif [ -z "$AJ_T" ] || { [ "$AJ_RUNN" != 0 ] && [ "$AJ_RUNN" -gt "$AJ_TN" ]; }; then
    A_CLASS=target-running A_NOTE=" (a journal of an earlier release, with no installed line: \`running\` after its target)"
    [ -n "$AJ_T" ] || A_CLASS=pre A_NOTE=" (a journal of an earlier release, with no installed line)"
  elif [ "$AJ_SE" != 0 ] && { [ "$AJ_RS" = 0 ] || [ "$AJ_SE" -lt "$AJ_RS" ]; }; then
    A_CLASS=pre A_NOTE=" (a journal of an earlier release, with no installed line: a STOP or an end before its rename)"
  else
    REPLY="it has no installed line (a journal of an earlier release), and no line of it says what it installed"
    return 1
  fi
  if [ "$AJ_KIND" = rollback ] && [ -z "$AJ_WHY" ]; then
    AJ_WHY=back AJ_OLDV=none
    A_NOTE="$A_NOTE (a rollback with no \`why\`: a person's back, old-version none: nothing rejected)"
  fi
  # the version its STOPs are of: a switch's `version`; a rollback's `old-version`, else the candidate's
  if [ "$AJ_KIND" = switch ]; then [[ $AJ_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && sv=$AJ_VERSION
  elif [[ $AJ_OLDV =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then sv=$AJ_OLDV
  else sv=$(printf '%s\n' "$cand" | jq -r '.version // empty' 2> /dev/null); fi
  if [ -z "$AJ_T" ]; then
    A_WHAT="no target line (the window's shortcut): no candidate change, only its STOPs"
  elif [ "$AJ_KIND" = switch ]; then
    case $A_CLASS in
      target-running|target-idle|target-old)
        [ -n "$sv" ] || { REPLY="a switch's close of CLASS $A_CLASS with no version line"; return 1; }
        A_LINES=$(target_json "$AJ_T") || { REPLY="its target line is not SET=IMAGE ..."; return 1; }
        A_CAND=set A_DROP=true
        if [ "$AJ_BACKUP" = "$KEEPP" ]; then
          [[ $AJ_OLD =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64}$ ]] || { REPLY="its old line is no image"; return 1; }
          A_PREVOP=old
        fi
        A_WHAT="the candidate is runner $AJ_VERSION, its TARGET's lines (switched at $AJ_CLOSED)" ;;
      pre|none)
        if [ "$AJ_BACKUP" = "$KEEPP" ] && [ -n "$AJ_CSHA" ] && [ "$AJ_PREV" = "$AJ_CSHA" ] && [ "$cand" = null ]; then
          A_PREVOP=null
          A_WHAT="no candidate change; its backup replaced config.toml.prev, so the keep of an earlier switch is gone: no previous image, no back_until"
        else A_WHAT="no candidate change"; fi ;;
      other) A_WHAT="config.toml is a file the window did not write: no candidate"
             hold="HAND CHANGE" htext="config.toml is a file the window $AJ_ID did not write: check it" ;;
      *) REPLY="a switch's close of CLASS $A_CLASS, a class only a rollback has"; return 1 ;;
    esac
  else
    case $A_CLASS in
      target-running|target-idle)
        A_CAND=clear A_DROP=true
        A_WHAT="rolled back: no candidate, no previous image, no back_until (its TARGET installed, $A_CLASS)" ;;
      target-old) A_WHAT="the candidate stays: its TARGET is installed, but a runscaler that started before its install runs the image before"
                  hold="CI DISABLED" htext="the rollback's TARGET is installed, but a runscaler that started before its install still runs the image of the candidate (the window $AJ_ID): CI is disabled by a person" ;;
      target-failed) A_WHAT="the candidate stays: the rollback failed, and its TARGET is installed"
                     hold="ROLLBACK FAILED" htext="the rollback's TARGET is installed and the rollback failed (the window $AJ_ID): the candidate stays" ;;
      pre|none) A_WHAT="no candidate change, nothing rejected" ;;
      other) A_WHAT="config.toml is a file the window did not write: the candidate stays"
             hold="HAND CHANGE" htext="config.toml is a file the window $AJ_ID did not write: check it" ;;
    esac
  fi
  stop_rule "$sv" "$hold" "$htext" || return 1
  # THE OWN RESTART: only an uninterrupted window's own (no `recover-start`), its `running` started within 20 s of its
  # `starting` (RestartSec=30: no Restart=always retry came between), and no unconsumed `restart` in the state
  if [ "$AJ_RSTART" = 0 ] && [[ $AJ_FROM =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
    fp=${BASH_REMATCH[1]} fs=${BASH_REMATCH[2]}
    if [[ $AJ_STOPPED =~ ^([0-9]+)\ ([0-9]+)\ ([0-9a-f]{64})$ ]]; then
      si=${BASH_REMATCH[1]} so=${BASH_REMATCH[2]} sh=${BASH_REMATCH[3]}
      if [[ $AJ_STARTING =~ ^([0-9]{1,12})$ ]] && e=${BASH_REMATCH[1]} && [[ $AJ_RUNNING =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
        tp=${BASH_REMATCH[1]} ts=${BASH_REMATCH[2]}
        if [ "$fp" -ge 1 ] && [ "$tp" -ge 1 ] && [ "$ts" -ge "$e" ] && [ "$((ts - e))" -le 20 ] \
          && [ "$(printf '%s\n' "$ST" | jq -r 'has("restart")')" = false ]; then
          A_RS="{\"from\":{\"pid\":$fp,\"start\":$fs},\"to\":{\"pid\":$tp,\"start\":$ts},\"stopped\":{\"inode\":\"$si\",\"offset\":$so,\"sha\":\"$sh\"}}"
        fi
      fi
    fi
  fi
  return 0
}
# THE STOP RULE (the header) of the journal read (AJ_STOPS) -> A_NEW: each name held once (its last line), but DISK,
# untested jq and NO IDLE; HOLD (a name the close rule holds, or "") with HTEXT when the journal has none of it; each of
# VERSION ("": null). 1 + REPLY: jq could not read them
stop_rule() {
  A_NEW=$(jq -n -c --arg f "$FAMILY" --arg v "$1" --arg hold "$2" --arg htext "$3" '
    [$ARGS.positional[] | capture("^(?<n>[^:]+): (?<t>.*)$"; "s") | select(.n != "DISK" and .n != "untested jq" and .n != "NO IDLE")]
    | reduce .[] as $s ({}; .[$s.n] = $s.t)
    | if $hold != "" and has($hold) == false then .[$hold] = $htext else . end
    | [to_entries[] | {family: $f, stop: .key, version: (if $v == "" then null else $v end), user: null,
                       detail: ({text: .value} + (if .key == "POOL DOWN" then {hand: "journalctl --user -u runscaler"} else {} end))}]' \
    --args "${AJ_STOPS[@]}" 2> /dev/null) && [ -n "$A_NEW" ] || { REPLY="jq could not read its STOP lines"; return 1; }
}
# THE APPLY STEP's decision of the journal read (AJ_*), CAND the state's candidate: 0 and A_* (THE CLOSE RULE; or, for
# a journal with no `kind` line, its `stop` lines by THE STOP RULE, of no version, and no candidate change: B2a review
# r1, Opus F1: RECOVER can close it with `stop CI DISABLED`); 3: no kind and no `stop` line (only archived); 1 + REPLY:
# a closed journal it cannot read. It writes nothing: status reads a closed journal by it too
apply_decide() {
  if [ -n "$AJ_KIND" ]; then close_rule "$1"; return; fi
  [ "${#AJ_STOPS[@]}" != 0 ] || return 3
  A_CAND=keep A_PREVOP=keep A_LINES='{}' A_DROP=false A_RS=null A_CLASS=none A_NOTE=
  A_WHAT="it names no kind (a window cut right after its first line): no candidate change, only its STOPs"
  stop_rule "" "" ""
}
# "SET=IMAGE SET=IMAGE" (a `target` line's value) -> {SET: IMAGE, ...}; 1 when a part is no SET=IMAGE
target_json() {
  jq -n -c '[$ARGS.positional[] | capture("^(?<k>[A-Za-z0-9][A-Za-z0-9._-]{0,99})=(?<v>[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[0-9a-f]{64})$")
            // error("no SET=IMAGE")] | map({(.k): .v}) | add' --args $1 2> /dev/null
}
# THE REJECTION (S2b-3c-1 D-e) is B2b's, and THIS is its one place: a rollback's close that rolled back (CLASS
# target-running or target-idle) rejects by the journal's `why`, `old-version`, `target-version` and `verdict` (a
# legacy one with no `why`: why back, old-version none), its rejected file written BEFORE the state write. B2a's:
# nothing is rejected: REPLY = the jq the ONE state write runs after THE CLOSE RULE ('.'), and no file is written
apply_rejection() { REPLY=.; }

# THE APPLY STEP (the header): under the lock, a CLOSED journal at WINDOW -> THE CLOSE RULE -> ONE state write that
# also sets `last_window` = its ID -> the archive (a rename to WINDOWS/ID); a journal whose ID is `last_window` is only
# archived, one with no kind (cut right after its first line) and no `stop` line too (one with no kind and a `stop`
# line: its STOPs, apply_decide). It reads no config.toml, no build record and no clock. A closed journal it cannot
# read, or cannot archive: WSTOP (and W_HOW), nothing written
APPLY_JQ='.last_window = $id
  | .families[$f] = ((.families[$f] // {})
      | if $cand == "set" then .candidate = {version: $v, lines: $tl, closed_at: $closed}
          | (if $prevop == "old" then .previous = ($tl | with_entries(.value = $old)) | .back_until = null else . end)
        elif $cand == "clear" then .candidate = null | .previous = null | .back_until = null
        elif $prevop == "null" then .previous = null | .back_until = null
        else . end
      | .stops = ([(.stops // [])[] | .stop as $s | select(([$new[] | .stop] | index($s)) == null)
                   | select(($drop | not) or ($s != "JOBS FAIL ON THE NEW IMAGE" and $s != "NO EVIDENCE"))] + $new))
  | if $rs == null then del(.restart) else .restart = $rs end'
apply_step() {
  local cand
  window_open || return 0
  apply_read
  case $? in
    0) ;;
    1) return 0 ;;
    *) apply_cannot "$REPLY"; return 0 ;;
  esac
  if [ "$AJ_ID" = "$(printf '%s\n' "$ST" | jq -r '.last_window // empty')" ]; then
    say "apply: the window journal $AJ_ID was applied already (the state's last_window): it is only archived"
    apply_archive; return 0
  fi
  cand=$(printf '%s\n' "$ST" | jq -c --arg f "$FAMILY" '.families[$f].candidate // null')
  apply_decide "$cand"
  case $? in
    0) ;;
    3) say "apply: the window journal $AJ_ID names no kind (a window cut right after its first line) and holds no STOP: it changed nothing, and it is only archived"
       apply_archive; return 0 ;;
    *) apply_cannot "$REPLY"; return 0 ;;
  esac
  REPLY=.
  if [ "$AJ_KIND" = rollback ] && [ "$A_CAND" = clear ]; then apply_rejection "$AJ_WHY" "$AJ_OLDV"; fi
  change_state "$APPLY_JQ | $REPLY" --arg id "$AJ_ID" --arg f "$FAMILY" --arg cand "$A_CAND" --arg prevop "$A_PREVOP" \
    --arg v "$AJ_VERSION" --arg old "$AJ_OLD" --argjson tl "$A_LINES" --argjson closed "$AJ_CLOSED" \
    --argjson new "$A_NEW" --argjson drop "$A_DROP" --argjson rs "$A_RS"
  say "apply: the window journal $AJ_ID (${AJ_KIND:-no kind}, $A_CLASS) is applied: $A_WHAT$A_NOTE"
  printf '%s\n' "$A_NEW" | jq -r '.[] | "runner-updater: apply: it holds STOP \(.stop): \(.detail.text)"'
  [ "$A_RS" = null ] || say "apply: its own restart of runscaler goes to the core once (the state's restart)"
  apply_archive
}
apply_cannot() {   # WHY: a closed journal the apply step cannot read: WSTOP and W_HOW, nothing written
  WSTOP="runner-updater: STOP the window journal $WINDOW is closed, but the apply step cannot read it ($1): $README_SECTION; nothing is written, and nothing else starts"
  W_HOW="it is closed, but the apply step cannot read it ($1), so no run of the updater can end it: $README_SECTION"
}
apply_archive() {
  if [ -e "$WINDOWS/$AJ_ID" ] || [ -L "$WINDOWS/$AJ_ID" ]; then
    WSTOP="runner-updater: STOP the window journal $WINDOW cannot be archived: $WINDOWS/$AJ_ID is there already: $README_SECTION; nothing else starts"
    W_HOW="it is closed, but $WINDOWS/$AJ_ID is there already, so no run of the updater can archive it: $README_SECTION"
    return 0
  fi
  install -d -m 700 "$WINDOWS" 2> /dev/null && mv -T -- "$WINDOW" "$WINDOWS/$AJ_ID" \
    || { WSTOP="runner-updater: STOP the window journal $WINDOW cannot be renamed to $WINDOWS/$AJ_ID: it stays, and the next run archives it (the state's last_window names it); nothing else starts"
         W_HOW="it is closed and cannot be renamed to $WINDOWS/$AJ_ID, and the next run tries again"
         return 0; }
  say "apply: the window journal is archived: $WINDOWS/$AJ_ID"
}

# THE OUTAGE RULE (the header), a PURE LEVEL each pass computes anew: ONE unit_read (when the unit is not enabled and no
# POOL DOWN is held, nothing can change: it ends), ONE runs of any start (runner-facts.sh: never one `active` read),
# then the unit read AGAIN, after the RUNS check: THAT read decides (a person's `disable --now` during the pair is CI
# off by hand, never CI down), and RUNS holds only when it shows the unit active with RUNS's own MainPID (a plain stop
# after RUNS's last read). The unit enabled and no runscaler RUNS -> STOP POOL DOWN, held once (a held one stays as
# it is); else (a runscaler RUNS, whenever it started, or the unit not enabled) POOL DOWN is cleared. CI DISABLED is
# cleared only by the unit enabled AND a runscaler that RUNS and started after config.toml's install time (facts 4's
# install_time, read after the RUNS check: a file installed during the pair is not the one that process runs), so a
# rollback closed target-old keeps it until its TARGET runs (the plan's CORRECTION). A unit it cannot read raises and
# clears nothing. It never fails the pass
outage() {
  local held pd cd cr s sets="${MAIN_SET} ${SMALL_SET}" ran p text last inst
  unit_read || { say "pass: runscaler's unit cannot be read (systemctl --user show runscaler): THE OUTAGE RULE raises and clears nothing"; return 0; }
  held=$(printf '%s\n' "$ST" | jq -r --arg f "$FAMILY" '[(.families[$f].stops // [])[] | .stop] as $s
           | "\($s | index("POOL DOWN") != null) \($s | index("CI DISABLED") != null)"') || held="false false"
  pd=${held% *} cd=${held#* }
  [ "$UNIT_FILE" = enabled ] || [ "$pd" = true ] || return 0   # CI DISABLED's clear needs the unit enabled
  if cr=$(config_read "$CFG"); then
    s=$(printf '%s\n' "${cr#*$'\n'}" | jq -r '.sets | join(" ")' 2> /dev/null) && [ -n "$s" ] && sets=$s
  fi
  # shellcheck disable=SC2086
  runs 0 - $sets; ran=$?   # any start: the install time proves WHICH file a process runs, never whether CI is up
  p=$RUNS_PROC
  unit_read || { say "pass: runscaler's unit cannot be read after the RUNS check (systemctl --user show runscaler): THE OUTAGE RULE raises and clears nothing"; return 0; }
  # the deciding read agrees with RUNS (B2a review r2, Codex F1): a runscaler that ended after RUNS's last process read
  # (a person's plain `systemctl --user stop`) is no runscaler that RUNS
  if [ "$ran" = 0 ] && { [ "$UNIT_ACTIVE" != active ] || [ "$UNIT_PID" != "${p% *}" ]; }; then
    ran=1 RUNS_WHY="runscaler ($p) ended after the RUNS check"
  fi
  if [ "$ran" = 0 ]; then
    if [ "$pd" = true ]; then
      change_state '.families[$f].stops = [.families[$f].stops[] | select(.stop != "POOL DOWN")]' --arg f "$FAMILY"
      say "pass: STOP POOL DOWN is cleared: runscaler RUNS (pid ${p% *}, started ${p#* })"
    fi
    if [ "$cd" = true ] && [ "$UNIT_FILE" = enabled ]; then
      inst=$(install_of "$CFG")
      if [ "$inst" != none ] && [ "${p#* }" -gt "$inst" ]; then
        change_state '.families[$f].stops = [.families[$f].stops[] | select(.stop != "CI DISABLED")]' --arg f "$FAMILY"
        say "pass: STOP CI DISABLED is cleared: runscaler's unit is enabled and runscaler RUNS (pid ${p% *}, started ${p#* }, after config.toml's install at $inst)"
      else
        say "pass: STOP CI DISABLED stays: a runscaler RUNS (pid ${p% *}, started ${p#* }), but not one that started after config.toml's install ($inst): it may run the file before (a rollback's TARGET that does not run yet)"
      fi
    fi
    return 0
  fi
  if [ "$UNIT_FILE" != enabled ]; then
    if [ "$pd" = true ]; then
      change_state '.families[$f].stops = [.families[$f].stops[] | select(.stop != "POOL DOWN")]' --arg f "$FAMILY"
      say "pass: STOP POOL DOWN is cleared: runscaler's unit is not enabled ($UNIT_FILE): CI is off by a person, not down"
    fi
    return 0
  fi
  if [ "$pd" = true ]; then say "pass: STOP POOL DOWN held: no runscaler RUNS ($RUNS_WHY)"; return 0; fi
  if window_open; then
    last=$(tail -n 1 -- "$WINDOW" 2> /dev/null); last=${last//[[:cntrl:]]/?}
    [ -n "$W_HOW" ] || W_HOW="the next run's RECOVER tries again"
    text="runscaler's unit is enabled (CI on), and no runscaler RUNS ($RUNS_WHY): CI is down. The window journal $WINDOW stays ($W_HOW); its last line: ${last:0:300}"
  else
    text="runscaler's unit is enabled (CI on), and no runscaler RUNS (systemd: $UNIT_ACTIVE, pid $UNIT_PID; $RUNS_WHY): CI is down. Read journalctl --user -u runscaler, fix what it names, then systemctl --user restart runscaler; the updater's next pass sees it run"
  fi
  text=${text//[[:cntrl:]]/?}
  change_state '.families[$f] = ((.families[$f] // {}) | .stops = ((.stops // []) + [{family: $f, stop: "POOL DOWN",
                  version: null, user: null, detail: {text: $t, hand: "journalctl --user -u runscaler"}}]))' \
    --arg f "$FAMILY" --arg t "${text:0:900}"
  say "pass: STOP POOL DOWN: $text"
}

# FILE -> config.toml's install time (facts 4's: runner-facts.sh's install_time of FILE's sha and mtime), or none when
# it cannot be read
install_of() {
  local cr head i
  cr=$(config_read "$1") || { echo none; return 0; }
  head=${cr%%$'\n'*}
  [[ $head =~ ^([0-9]+)\ ([0-9a-f]{64})$ ]] || { echo none; return 0; }
  i=$(install_time "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}" "$WINDOWS"); i=${i%% *}
  [[ $i =~ ^[0-9]+$ ]] && echo "$i" || echo none
}

# ---- the pass

pj() { if [ "$1" = none ]; then echo null; else echo "{\"pid\":${1% *},\"start\":${1#* }}"; fi; }   # "PID START" | none

# THE FACTS (the header), in their order, into PASSDIR: 0, or 1 + REPLY = why there are none
collect() {
  local d=$PASSDIR b before after o inode offset psha cont why cr head js mtime sha inst
  local re='^([0-9]+) ([0-9]+) ([0-9a-f]{64})'$'\n''(true|false) (.*)$'
  b=$(jq -r 'if (.boundary.position | type) == "object" then .boundary.position
             | "\(.inode | tostring) \(.offset | tostring) \(.sha | tostring)" else "" end' "$d/state.json" 2> /dev/null) || b=
  [[ $b =~ ^[0-9]+\ [0-9]+\ [0-9a-f]{64}$ ]] || b=
  # 1-3: proc before, the position (and the text through the same open file), proc after
  before=$(proc_now) || { REPLY="systemd's answer for runscaler cannot be read (systemctl --user show runscaler)"; return 1; }
  # shellcheck disable=SC2086
  o=$(log_pos "$d/log.txt" $b) || { REPLY="cannot read runscaler's log $R/runner.log"; return 1; }
  after=$(proc_now) || { REPLY="systemd's answer for runscaler cannot be read (systemctl --user show runscaler)"; return 1; }
  [[ $o =~ $re ]] || { REPLY="cannot read runscaler's log $R/runner.log"; return 1; }
  inode=${BASH_REMATCH[1]} offset=${BASH_REMATCH[2]} psha=${BASH_REMATCH[3]} cont=${BASH_REMATCH[4]} why=${BASH_REMATCH[5]}
  if [ "$before" = none ]; then say "runscaler: none running (its unit is not active)"
  elif [ "$before" = "$after" ]; then say "runscaler: pid ${before% *}, started ${before#* }"
  else say "runscaler: $before before the log position, $after after it: the position is no boundary of one process"; fi
  say "log: runner.log at offset $offset; $why"
  # 4: the config, after the process reads
  cr=$(config_read "$CFG") || { REPLY=${cr:-cannot read $CFG}; return 1; }
  head=${cr%%$'\n'*} js=${cr#*$'\n'}
  [[ $head =~ ^([0-9]+)\ ([0-9a-f]{64})$ ]] || { REPLY="cannot read $CFG"; return 1; }
  mtime=${BASH_REMATCH[1]} sha=${BASH_REMATCH[2]}
  inst=$(install_time "$sha" "$mtime" "$WINDOWS")
  [[ $inst =~ ^([0-9]+)\ (.+)$ ]] || { REPLY="cannot read the install time of $CFG"; return 1; }
  inst=${BASH_REMATCH[1]}
  say "config: installed at $inst (${BASH_REMATCH[2]})"
  # 6: the /healthz pair
  : > "$d/healthz.json" || { REPLY="cannot write $d/healthz.json"; return 1; }
  healthz_pair "$d/healthz.json"
  say "healthz: $(grep -c . "$d/healthz.json") of 2 reads (http://127.0.0.1:${RS_HEALTH_PORT}/healthz)"
  # 5 and the file: the family, the state's candidate, back_until, STOPs and restart
  printf '%s\n' "$ST" | jq -c --argjson before "$(pj "$before")" --argjson after "$(pj "$after")" --arg inode "$inode" \
      --argjson offset "$offset" --arg sha "$psha" --argjson continuous "$cont" --argjson installed "$inst" \
      --argjson cfg "$js" --arg f "$FAMILY" --arg m "$MAIN_SET" --arg s "$SMALL_SET" '(.families[$f] // {}) as $h
      | {format: 1, host: "hz", sets: $cfg.sets, proc: {before: $before, after: $after},
         position: {inode: $inode, offset: $offset, sha: $sha}, continuous: $continuous, restart: (.restart // null),
         config: {installed: $installed, lines: $cfg.lines},
         families: {($f): {provider: "docker", sets: [$m, $s], candidate: ($h.candidate // null),
                           back_until: ($h.back_until // null)}},
         stops: ($h.stops // [])}' > "$d/facts.json" 2> /dev/null || { REPLY="jq could not write $d/facts.json"; return 1; }
}

# PROGRAM's answer (stdin) is one answer: one JSON object with lines and a verdict core/README.md names for that
# program ("The programs' outputs"): its decisions, or `wait` (which is none: the caller WAITs). ONE copy of these
# sets: a pass and status both check by it
decided() {
  local v="ok wait"
  [ "$1" != idle ] || v="idle not-idle wait"
  jq -e -s --arg v "$v" 'length == 1 and (.[0] | type) == "object" and (.[0].lines | type) == "array"
            and (.[0].verdict as $x | ($x | type) == "string" and any($v | split(" ")[]; . == $x))' > /dev/null 2>&1
}
# PROGRAM's answer (stdin), a `wait`: why, for the WAIT line (its first line, else "PROGRAM: its reason")
waits_why() { jq -r --arg p "$1" '.lines[0] // "\($p): \(.reason)" | tostring' 2> /dev/null | head -n 1; }

# [more]: the end of the line a pass prints when the core decided nothing (B2a review r1, Codex F3): "the pass did
# nothing: STATE is as it was" only when it did nothing before the core either (EARLIER empty: no RECOVER ran and the
# state was not written); else the core's own state is unchanged, and what the pass did before the core stays. MORE:
# the form that follows "this pass decides nothing more" (the WAIT line's)
core_nothing() {
  if [ -z "$EARLIER" ]; then echo "the pass did nothing: $STATE is as it was"
  elif [ -n "${1-}" ]; then echo "the core's own state in $STATE is unchanged; what this pass did before the core stays (the lines above)"
  else echo "the core decided nothing, and its own state in $STATE is unchanged; what this pass did before the core stays (the lines above)"; fi
}

# NOW: idle, r1, keep and status on PASSDIR's five inputs (the header: pass); each one's verdict and reason printed (r1
# and keep: each family's too), then status.jq's lines
run_core() {
  local d=$PASSDIR prog rc why
  for prog in idle r1 keep status; do
    jq -n -L "$CORE/lib" -f "$CORE/$prog.jq" --slurpfile state "$d/state.json" --slurpfile facts "$d/facts.json" \
      --rawfile log "$d/log.txt" --slurpfile healthz "$d/healthz.json" --arg now "$1" > "$d/$prog.json" 2> "$d/$prog.err" < /dev/null
    rc=$?
    if [ "$rc" != 0 ] || ! decided "$prog" < "$d/$prog.json"; then
      say "core could not decide ($prog): exit $rc$(head -n 1 "$d/$prog.err" 2> /dev/null | sed 's/^/: /')"
      say "$(core_nothing)"
      exit 1
    fi
    if [ "$(jq -r '.verdict' "$d/$prog.json")" = wait ]; then   # its own state is of another format: no decision
      why=$(waits_why "$prog" < "$d/$prog.json")
      if [ -z "$EARLIER" ]; then wait4 "the decision core waits ($why): this pass decides nothing, and $STATE is as it was"
      else wait4 "the decision core waits ($why): this pass decides nothing more; $(core_nothing more)"; fi
    fi
    if [ "$prog" = idle ] || [ "$prog" = r1 ]; then   # the new core state, for the next program of this pass: by rename
      jq -e '.state | if type == "object" then . else error("no state") end' "$d/$prog.json" > "$d/state.json.new" 2> /dev/null \
        && mv -f -- "$d/state.json.new" "$d/state.json" \
        || { say "core could not decide ($prog): its output has no state"; say "$(core_nothing)"; exit 1; }
    fi
    if [ "$prog" = status ]; then
      jq -r '"status: \(.verdict) (\(.reason))", .lines[]' "$d/$prog.json"
    else
      jq -r --arg p "$prog" '"\($p): \(.verdict) (\(.reason))",
          ((.families // {}) | to_entries[] | "\($p) \(.key): \(.value.verdict) (\(.value.reason))")' "$d/$prog.json"
    fi
  done
}

# what this pass WOULD do (the header: pass): it does none of it. The switch, or why not, is DUE's line (below)
would_do() {
  local d=$PASSDIR
  jq -r '(.families // {}) | to_entries[] | select(.value.verdict == "rollback")
         | "runner-updater: pass: would roll back \(.key) (this release takes no action)"' "$d/r1.json"
  jq -r '(.families // {}) | to_entries[] | .key as $f | .value.verdict
         | if . == "accept" then "runner-updater: pass: would accept \($f) (this release takes no action)"
           elif . == "jobs-fail" then "runner-updater: pass: would hold \($f): STOP JOBS FAIL ON THE NEW IMAGE (this release takes no action)"
           elif . == "no-evidence" then "runner-updater: pass: would hold \($f): STOP NO EVIDENCE (this release takes no action)"
           else empty end' "$d/keep.json"
}

# [VERSION] -> 0 + REPLY: the first STOP of this user's state that holds a release (the header, DUE; the Studio's
# rl_stop): it names no version, or a newer release does not proceed alone past it (the core's lib/stops.jq: a name it
# does not know does not), or it is of VERSION. 1: none holds. 2 + REPLY: jq could not read them (the caller holds:
# fail closed). With no VERSION only the first two hold
stop_holds() {
  local out
  out=$(printf '%s\n' "$ST" | jq -r -L "$CORE/lib" --arg role "$ROLE" --arg f "$FAMILY" --arg v "${1-}" '
    import "stops" as S;
    def shown: if type == "string" and test("^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$") then . else tojson end;
    def noversion: (.version | type) != "string" or .version == "";
    [(if $role == "rs" then .families[$f].stops else .stops end // [])[]
     | . + {proceeds: S::newer_proceeds(.stop), known: (S::props(.stop) != null)}]
    | [.[] | select(noversion or ($v != "" and .version == $v) or (.proceeds | not))]
    | first // empty
    | "STOP \(.stop | shown) (\(if noversion then "no runner version" else "runner \(.version | shown)" end)): "
      + (if noversion then "a STOP that names no version holds every release"
         elif .proceeds | not then
           (if .known then "a newer release does not proceed alone past it"
            else "a STOP this release does not know holds every release" end)
         else "it is of the eligible release" end)
      + "; `runner-updater status` names its next step"' 2> /dev/null) \
    || { REPLY="jq could not read the STOPs of the state; a family is never due while they cannot be read"; return 2; }
  [ -n "$out" ] || return 1
  REPLY=$out
}

# A B (N.N.N) -> 0 when A is newer than B
newer() {
  local a b i
  IFS=. read -r -a a <<< "$1"
  IFS=. read -r -a b <<< "$2"
  for i in 0 1 2; do
    if [ "$((10#${a[i]}))" != "$((10#${b[i]}))" ]; then [ "$((10#${a[i]}))" -gt "$((10#${b[i]}))" ]; return; fi
  done
  return 1
}

# NOW: the latest release (runner-release.sh's rr_eligible), its lines into PASSDIR/release.out and .err: 0 (RR_ facts
# set), 75 or 1 + REPLY = its WAIT line, or why it is not eligible
latest() {
  local rc l
  rr_eligible "$1" > "$PASSDIR/release.out" 2> "$PASSDIR/release.err"
  rc=$?
  [ "$rc" != 0 ] || return 0
  l=$(grep '^runner-release: ' "$PASSDIR/release.err" | tail -n 1)
  l=${l#runner-release: }
  REPLY=${l#REFUSE }
  [ -n "$REPLY" ] || REPLY="the latest release cannot be read (runner-release.sh, exit $rc: $PASSDIR/release.err)"
  return "$rc"
}

# DUE (the header): ONE line for the family, the first of the twelve steps that holds; it never fails the pass and
# writes nothing into the state
due() {
  local now=$1 d=$PASSDIR v rec a b dg base cur brec rc
  dnot() { say "pass: $FAMILY is not due: $1"; }
  # 1. an open candidate (a `previous` kept until back_until is none: PLAN D6, AFTER ACCEPT)
  v=$(printf '%s\n' "$ST" | jq -r --arg f "$FAMILY" '.families[$f].candidate.version // empty')
  [ -z "$v" ] || { dnot "an open candidate (runner $v): one open release per family"; return 0; }
  # 2. a STOP that holds whatever the release is
  stop_holds; [ "$?" = 1 ] || { dnot "$REPLY"; return 0; }
  # 3. this release's image recipe
  rr_recipe "$B/image" || { dnot "this release's image recipe cannot be computed: $RR_WHY"; return 0; }
  rec=$RR_RECIPE
  # 4. NO BASELINE: the family's two lines in config.toml name ONE image, and ONE build record of RUN_USER has its
  # digest
  a=$(jq -r --arg s "$MAIN_SET" '.config.lines[$s] // "none"' "$d/facts.json" 2> /dev/null) || a=none
  b=$(jq -r --arg s "$SMALL_SET" '.config.lines[$s] // "none"' "$d/facts.json" 2> /dev/null) || b=none
  if [ "$a" = none ] || [ "$a" != "$b" ]; then
    dnot "STOP NO BASELINE: its sets (${MAIN_SET}, ${SMALL_SET}) do not name one image in config.toml ($a, $b); $(baseline_next)"
    return 0
  fi
  dg=${a##*@}
  if [[ ! $dg =~ ^sha256:[0-9a-f]{64}$ ]] || ! rr_record_of "$BUILDS" "$dg"; then
    if [ "${RR_COUNT:-0}" -gt 1 ]; then
      dnot "STOP NO BASELINE: $RR_COUNT build records of RUN_USER ($BUILDS) name its image's digest $dg: $RR_WHY; $(baseline_next)"
    else
      dnot "STOP NO BASELINE: no build record of RUN_USER ($BUILDS) names its image's digest $dg ($a); $(baseline_next)"
    fi
    return 0
  fi
  base=$RR_REC_RECIPE cur=$RR_REC_VERSION brec=$RR_RECORD
  # 5. recipe changed
  if [ "$base" != "$rec" ]; then
    dnot "STOP recipe changed: this release's image recipe is $rec, the build record of its running image ($brec) names $base (image/'s files changed); $(baseline_next)"
    return 0
  fi
  # 6. its current version: cur, that record's. 7. the latest release (the first step that asks GitHub)
  latest "$now"; rc=$?
  [ "$rc" = 0 ] || { dnot "$REPLY"; return 0; }
  v=$RR_VERSION
  # 8. a STOP of that version
  stop_holds "$v"; [ "$?" = 1 ] || { dnot "$REPLY"; return 0; }
  # 9. rejected
  if printf '%s\n' "$ST" | jq -e --arg f "$FAMILY" --arg v "$v" '(.families[$f].rejected // []) | any(.[]; . == $v)' > /dev/null; then
    dnot "release v$v is rejected for $FAMILY"; return 0
  fi
  # 10. not newer
  newer "$v" "$cur" || { dnot "release v$v is not newer than its runner $cur"; return 0; }
  # 11. RUN_USER's build of it
  rr_record "$BUILDS" "$v" "$rec" \
    || { dnot "it waits for ${RUN_USER}'s build of runner $v (no usable build record of runner $v for this release's image, recipe ${rec:0:12}…, $BUILDS/$v-$rec: $RR_WHY)"; return 0; }
  # 12.
  say "pass: would switch $FAMILY to $v (this release takes no action)"
}
baseline_next() {
  echo "a person's release update sets it (linux-docker/README.md, \"A new runner release\": an image with its build record into the pool), and so will \`runner-updater rebuild $FAMILY\` (a later release)"
}

# the timer's entry, under the lock it tried (the header: pass)
do_pass() {
  local now
  now=$(date +%s) # ONE CLOCK PER PASS (the header: pass): read once, first; RECOVER and THE OUTAGE RULE take seconds
  load_state
  recover_first   # RECOVER FIRST and THE APPLY STEP, before ON/OFF is read (OFF too)
  outage          # THE OUTAGE RULE: every pass, ON or OFF, after them
  [ -z "$WSTOP" ] || { echo "$WSTOP"; exit 1; }
  [ "$(printf '%s\n' "$ST" | jq -r '.on')" = true ] || { say "pass: the updater is OFF: nothing to do"; exit 0; }
  jq_check
  [[ $now =~ ^[0-9]+$ ]] || refuse "the clock gave '$now'"
  install -d -m 700 "$PASSDIR" || refuse "cannot create $PASSDIR"
  rm -f -- "$PASSDIR"/facts.json "$PASSDIR"/log.txt "$PASSDIR"/healthz.json "$PASSDIR"/{idle,r1,keep,status}.json \
    "$PASSDIR"/{idle,r1,keep,status}.err "$PASSDIR"/release.out "$PASSDIR"/release.err
  printf '%s\n' "$ST" | jq -c '.core // empty' > "$PASSDIR/state.json" || refuse "cannot copy the core's state into $PASSDIR"
  say "pass: one pass at $(date -u -d "@$now" '+%Y-%m-%d %H:%M:%S UTC') ($now); it takes no action"
  collect || refuse "no facts: $REPLY"
  run_core "$now"
  change_state '.core = $c[0] | del(.restart)' --slurpfile c "$PASSDIR/state.json"   # the restart: handed over once
  would_do
  due "$now"
  exit 0
}

# ---- RUN_USER: THE BUILD PASS, build VERSION (the header)
# VERSION: ~/build/setup/02-d1.sh build VERSION as this run's CHILD, on the updater lock it holds (fd 9, inherited:
# rr_lock's rule), its output shown and kept in BUILDOUT; its exit code. REPLY = its last WAIT line (exit 75), or THE
# CAUSE it printed (another exit): the REFUSE line right before its last FAIL line (that FAIL line then says only "the
# REFUSE line above says why"), else that FAIL line; with no FAIL line, its last REFUSE line; or what it exited with
build_child() {
  local rc
  FORKED=
  rm -f -- "$BUILDOUT"
  [ -z "${TERMED-}" ] || return 0      # THE TERM WINDOW (do_build_pass): a TERM came first, so no 02-d1.sh starts
  FORKED=1
  /bin/bash "$B/setup/02-d1.sh" build "$1" < /dev/null 2>&1 | tee "$BUILDOUT" 9>&-
  rc=${PIPESTATUS[0]}
  if [ "$rc" = 75 ]; then
    REPLY=$(grep '^WAIT ' "$BUILDOUT" 2> /dev/null | tail -n 1)
    [ -n "$REPLY" ] || REPLY="02-d1.sh build $1 exited $rc and printed no WAIT line (its output: $BUILDOUT)"
  else
    REPLY=$(awk '/^FAIL / { fail = $0; before = prev } /^[A-Za-z0-9._-]+: REFUSE / { refuse = $0 } { prev = $0 }
                 END { if (fail != "") print (before ~ /^[A-Za-z0-9._-]+: REFUSE / ? before : fail)
                       else if (refuse != "") print refuse }' "$BUILDOUT" 2> /dev/null)
    [ -n "$REPLY" ] || REPLY="02-d1.sh build $1 exited $rc and printed no FAIL or REFUSE line (its output: $BUILDOUT)"
  fi
  return "$rc"
}
# VERSION WHO: a `check failed` STOP of VERSION is cleared (by rename), and WHO's line says so; none: nothing is written
clear_check_failed() {
  printf '%s\n' "$ST" | jq -e --arg v "$1" 'any((.stops // [])[]; .stop == "check failed" and .version == $v)' \
    > /dev/null || return 0
  change_state '.stops = [(.stops // [])[] | select(.stop != "check failed" or .version != $v)]' --arg v "$1"
  say "$2: the STOP check failed of runner $1 is cleared"
}
# VERSION LINE: the STOP `check failed` of VERSION (ONE per version: it replaces an older one's text), by rename; exit 1.
# LINE is cut in bash before jq gets it (fix round 2 of S2b-3b-3): an argument over Linux's limit for one (128 KiB,
# MAX_ARG_STRLEN) starts no jq, and then no STOP would be written and every pass would build again. The cut keeps 3600
# bytes, 900 characters of UTF-8's longest (4 bytes): every character RUN_TEXT keeps is in them, so its rule is unchanged
check_failed() {
  local text
  text=$(jq -nr --arg t "${2:0:3600}" "$RUN_TEXT"' $t | run_text' < /dev/null) \
    || stop "jq could not make the text of the STOP check failed (runner $1): $STATE is as it was"
  change_state '.stops = [(.stops // [])[] | select(.stop != "check failed" or .version != $v)]
                 + [{stop: "check failed", version: $v, user: $u, detail: {text: $t, step: "build", build_user: $u}}]' \
    --arg v "$1" --arg u "$ME" --arg t "$text"
  echo "runner-updater: STOP check failed (runner $1): $text; \`runner-updater status\` names its next step (as $ME: \`runner-updater build $1\`)"
  exit 1
}
do_build_pass() {
  local now v rec rc
  load_state
  [ "$(printf '%s\n' "$ST" | jq -r '.on')" = true ] || { say "pass: the updater is OFF: nothing to do"; exit 0; }
  jq_check
  now=$(date +%s)
  [[ $now =~ ^[0-9]+$ ]] || refuse "the clock gave '$now'"
  install -d -m 700 "$PASSDIR" || refuse "cannot create $PASSDIR"
  rm -f -- "$PASSDIR"/release.out "$PASSDIR"/release.err
  latest "$now"
  case $? in
    0) ;;
    75) say "pass: $REPLY"; exit 0 ;;
    *) say "pass: no build: $REPLY"; exit 0 ;;
  esac
  v=$RR_VERSION
  [[ $v =~ ^${VERSION_RE}$ ]] \
    || { say "pass: no build: the latest release's version is not N.N.N of 1 to 9 digits each (VERSION_RE; it is ${#v} characters): nothing is built"; exit 0; }
  rr_recipe "$B/image" || refuse "this release's image recipe cannot be computed: $RR_WHY"
  rec=$RR_RECIPE
  if rr_record "$BUILDS" "$v" "$rec"; then
    say "pass: runner $v is built for this release's image (its build record: $RR_RECORD): nothing to build"
    clear_check_failed "$v" pass      # a person's build of V passed (02-d1.sh build V): its STOP has no cause left
    exit 0
  fi
  stop_holds "$v"; [ "$?" = 1 ] || { say "pass: no build of runner $v: $REPLY"; exit 0; }
  say "pass: building runner $v for this release's image (recipe $rec): 02-d1.sh build $v, its output also in $BUILDOUT"
  # systemd's stop of the timer's unit (TimeoutStartSec, a shutdown) is SIGTERM to EVERY process of the unit, this one
  # too: a trap (not an ignore, which the child would inherit) keeps this run alive until 02-d1.sh, which got it too,
  # has exited (143), so the CUT below says so. Only around the build: elsewhere a TERM ends a pass at once.
  # THE TERM WINDOW: the trap is set before build_child's rm and its fork of 02-d1.sh, so it RECORDS a TERM (TERMED,
  # empty at the program's start: an inherited one is none), and build_child checks it right before the fork: a TERM
  # that came first starts no build (the CUT "no build started", exit 0, no STOP, the state as it was). The residual: a
  # TERM between that check and the fork. systemd's TERM reaches only the processes of the unit that exist when it
  # sends it, so a 02-d1.sh forked after it runs on. When it ends before systemd's SIGKILL at TimeoutStopSec (the
  # unit's, or the manager's default), this run, which recorded the TERM, prints a CUT and writes no STOP, whatever it
  # exited with (but 0, built, and 75, WAIT: no STOP either): a stop of the unit never holds a version (in a shutdown its
  # `docker info` fails). Else that SIGKILL ends this run too: no CUT line, no STOP (nothing is written), a build
  # context that 02-d1.sh's own trap did not remove, and the lock free once every holder has exited
  trap 'TERMED=1' TERM
  build_child "$v"
  rc=$?
  trap - TERM
  if [ -z "$FORKED" ]; then
    say "pass: CUT 02-d1.sh build $v by SIGTERM before it started (no build started): no STOP; the next pass builds it again"
    exit 0
  fi
  case $rc in
    0) say "pass: built runner $v"; exit 0 ;;
    75) say "pass: WAIT 02-d1.sh build $v waits (exit 75): $REPLY; no STOP: a later pass builds it"; exit 0 ;;
    129|141|143)   # SIGHUP, SIGPIPE, SIGTERM: an ssh drop, a reboot, a stop; no check failed
       say "pass: CUT 02-d1.sh build $v ended by SIG$(kill -l "$((rc - 128))") (exit $rc): no STOP;" \
         "the next pass builds it again"
       exit 0 ;;
  esac
  if [ -n "$TERMED" ]; then   # a TERM reached this run while 02-d1.sh ran, and not 02-d1.sh (the residual above)
    say "pass: CUT 02-d1.sh build $v exited $rc after a SIGTERM reached this run (a stop of its unit): no STOP;" \
      "the next pass builds it again"
    exit 0
  fi
  check_failed "$v" "$REPLY"
}
do_build() {
  local v=$1
  load_state
  say "build: runner $v: 02-d1.sh build $v, its output also in $BUILDOUT"
  build_child "$v"
  case $? in
    0) say "build: built runner $v"; clear_check_failed "$v" build; exit 0 ;;
    75) wait4 "02-d1.sh build $v waits (exit 75): $REPLY; the state is as it was: run it again later" ;;
    *) say "build: runner $v is not built: ${REPLY//[[:cntrl:]]/?}; the state is as it was (only a pass holds" \
         "\`check failed\`: you see why here). Fix the cause, then run it again"
       exit 1 ;;
  esac
}

[ "$cmd" != status ] || do_status
if [ "$cmd" = pass ]; then   # a timer pass only TRIES the lock: held, and it ends at once
  rr_lock "$ROLE" -n
  case $? in
    0) if [ "$ROLE" = rs ]; then do_pass; else do_build_pass; fi ;;
    75) say "pass: another run holds the updater lock $RR_LOCK; this pass ends"; exit 0 ;;
    *) refuse "cannot take the updater lock $RR_LOCK (runner-release.sh said why, above)" ;;
  esac
fi
rr_lock "$ROLE" || refuse "cannot take the updater lock $RR_LOCK (runner-release.sh said why, above)"
case $cmd in
  on) do_on ;;
  off) do_off ;;
  build) do_build "$1" ;;
esac
