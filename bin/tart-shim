#!/bin/zsh -f
# liveapp-ci tart shim — installed root-owned as /usr/local/libexec/liveapp-ci/tart by 02-wall.sh. runner-start puts
# that directory first on runscaler's PATH, so every `tart` runscaler runs comes here.
# Plan: ~/projects/liveapp/plans/PLAN-2026-10-18-mac-ci-host.md §1.3. Cells: test/shim.test.zsh (S1).
#
# REFUSES BY DEFAULT. A VM start is admitted only for runscaler's exact call `run runner-<8 hex> --no-graphics`, and
# only after every input was read, parsed and matched:
#   - the wall stamp (written only by n1-driver after a FULL PASS) holds the sha256 of REAL, SOFTNET and this file;
#   - free disk where Tart keeps its VMs (TART_HOME when set, an absolute path, else /Users/ci/.tart) >= the floor
#     in CONF.
# Then `tart set <vm> --random-mac`, one admission line in ADMLOG, and exec of REAL with the softnet wall FLAGS.
# `--liveapp-check` runs the stamp + disk check alone and never calls REAL (exit 0 + OK text, or a refusal).
# The other subcommands runscaler and the host scripts use (list pull clone set get stop delete exec prune ip, and a
# bare --version) pass through to REAL verbatim; anything else is refused (`create --from-ipsw` boots a VM).
# Every child runs under `env -i`, so no RUNNER_TOKEN_*, TRACEPARENT, PERL5OPT or other caller variable reaches Tart
# or the tools; Tart gets HOME, PATH and (when set) TART_HOME. `-f` above: no startup file from the caller's HOME runs;
# LC_ALL=C: the caller's locale cannot change what a pattern matches.
# Every refusal: "liveapp-ci-shim: REFUSE <reason>" on stderr, exit 1.
#
# The constants below are the ONLY lines a test copy may change (S1's diff test enforces it). real-run reads FLAGS and
# PATH from this file's text, so each stays on one line.
REAL=/Users/ci/Applications/tart.app/Contents/MacOS/tart
STAMP=/Users/ci/.config/runner/wall-stamp
CONF=/usr/local/libexec/liveapp-ci/shim.conf
DF=/bin/df
SHASUM=/usr/bin/shasum
SOFTNET=/usr/local/bin/softnet
ADMLOG=/Users/ci/Library/Logs/mac-runner/admissions.log
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
FLAGS=(--net-softnet-block=@host,224.0.0.0/4 --no-clipboard --no-audio)

set -u
umask 077
export PATH
export LC_ALL=C   # every pattern below in the C locale: a caller's collation must not widen [0-9a-f]
SELF=${0:A}
TOOLENV=(/usr/bin/env -i PATH=$PATH LC_ALL=C)
TARTENV=(/usr/bin/env -i HOME=/Users/ci PATH=$PATH)
VMSTORE=/Users/ci/.tart

refuse() { print -u2 -r -- "liveapp-ci-shim: REFUSE $*"; exit 1 }

if [[ -n ${TART_HOME-} ]]; then
  [[ $TART_HOME == /* ]] || refuse "TART_HOME must be an absolute path: '$TART_HOME'"
  TARTENV+=(TART_HOME=$TART_HOME); VMSTORE=$TART_HOME
fi

sha256_of() { # FILE -> REPLY = its sha256
  local out
  [[ -f $1 && -r $1 ]] || refuse "hashed file absent or unreadable: $1"
  out=$("${TOOLENV[@]}" $SHASUM -a 256 $1) || refuse "shasum failed on $1"
  [[ $out =~ '^[0-9a-f]{64}  ' ]] || refuse "shasum output not understood for $1"
  REPLY=${out[1,64]}
}

read_stamp() { # -> st[real|softnet|shim|macos]; exactly these four fields, each once, nothing else
  local line
  typeset -gA st=()
  [[ -f $STAMP && -r $STAMP && -s $STAMP ]] || refuse "wall stamp absent, empty or unreadable: $STAMP"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ '^(real|softnet|shim) ([0-9a-f]{64})$' || $line =~ '^(macos) ([0-9A-Za-z.]{1,32})$' ]] \
      || refuse "wall stamp line not understood: $line"
    (( ! ${+st[$match[1]]} )) || refuse "wall stamp field repeated: $match[1]"
    st[$match[1]]=$match[2]
  done < $STAMP
  for line in real softnet shim macos; do (( ${+st[$line]} )) || refuse "wall stamp field missing: $line"; done
}

read_floor() { # -> floor_gib from CONF: one `floor-gib N` line (N >= 1); blank and '#' lines ignored
  local line
  floor_gib=
  [[ -f $CONF && -r $CONF ]] || refuse "conf absent or unreadable: $CONF"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == '#'* ]] && continue
    [[ $line =~ '^floor-gib ([1-9][0-9]{0,5})$' ]] || refuse "conf line not understood: $line"
    [[ -z $floor_gib ]] || refuse "conf floor-gib repeated"
    floor_gib=$match[1]
  done < $CONF
  [[ -n $floor_gib ]] || refuse "conf has no floor-gib line: $CONF"
}

read_free() { # -> free_kib on VMSTORE's volume, from `df -Pk` (header + one row; field 4 = available KiB)
  local out
  local -a rows row
  out=$("${TOOLENV[@]}" $DF -Pk $VMSTORE) || refuse "df failed"
  rows=("${(@f)out}")
  # the header names the unit: exactly 1024-blocks (df -P alone prints 512-blocks, twice the figure)
  (( ${#rows} == 2 )) && [[ ${(j: :)${=rows[1]}} == 'Filesystem 1024-blocks Used Available Capacity Mounted on' ]] \
    || refuse "df output not understood"
  row=(${=rows[2]})
  (( ${#row} >= 6 )) && [[ $row[4] =~ '^[0-9]{1,15}$' ]] || refuse "df available field not a number: ${row[4]-}"
  free_kib=$row[4]
}

check() { # the wall stamp matches REAL, SOFTNET and this file; free disk >= the floor
  read_stamp
  sha256_of $REAL;    [[ $REPLY == $st[real] ]]    || refuse "REAL changed since the wall stamp: run n1-driver"
  sha256_of $SOFTNET; [[ $REPLY == $st[softnet] ]] || refuse "SOFTNET changed since the wall stamp: run n1-driver"
  sha256_of $SELF;    [[ $REPLY == $st[shim] ]]    || refuse "the shim changed since the wall stamp: run n1-driver"
  read_floor
  read_free
  (( free_kib >= floor_gib * 1048576 )) || refuse "free disk below the floor: $(( free_kib / 1048576 )) GiB < $floor_gib GiB"
}

case ${1-} in
  (--liveapp-check)
    (( $# == 1 )) || refuse "--liveapp-check takes no arguments"
    check
    print -r -- "liveapp-ci-shim: OK wall stamp matches; free $(( free_kib / 1048576 )) GiB >= floor $floor_gib GiB"
    exit 0 ;;
  (run)
    (( $# == 3 )) && [[ $3 == --no-graphics && $2 =~ '^runner-[0-9a-f]{8}$' ]] \
      || refuse "run admits only: run runner-<8 hex> --no-graphics"
    vm=$2
    check
    "${TARTENV[@]}" $REAL set $vm --random-mac >/dev/null || refuse "tart set $vm --random-mac failed"
    now=$("${TOOLENV[@]}" /bin/date -u +%Y-%m-%dT%H:%M:%SZ) || refuse "date failed"
    print -r -- "$now admit $vm pid $$" >> $ADMLOG || refuse "cannot append the admission line to $ADMLOG"
    exec "${TARTENV[@]}" $REAL run $vm --no-graphics "${FLAGS[@]}" ;;
  (--version)
    (( $# == 1 )) || refuse "--version takes no arguments"
    exec "${TARTENV[@]}" $REAL --version ;;
  (list|pull|clone|set|get|stop|delete|exec|prune|ip)
    exec "${TARTENV[@]}" $REAL "$@" ;;
  (*)
    refuse "not a Tart subcommand this shim passes: '${1-}'" ;;
esac
