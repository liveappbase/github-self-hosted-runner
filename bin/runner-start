#!/bin/zsh -f
# runner-start run | runner-start validate [CONFIG] — the one way runscaler starts; the LaunchAgent sh.liveapp.mac-runner
# runs `runner-start run`. `validate CONFIG` checks and validates CONFIG (an absolute path to a regular file) in place of
# the configured one, with the same checks: the updater validates a temporary copy of its target config that way while
# runscaler runs. `run` takes no CONFIG.
# Design: docs/design.md ("The service"). Refuses (and never starts runscaler) when a token file the config names
# (env:RUNNER_TOKEN_X -> token-x; a comment line names none) is missing, empty or not 0600; when `tart` on its PATH is
# not the shim; or when a configured runner-image is not on this host. `run` also refuses when the wall stamp's macOS
# build is not this Mac's (sw_vers -buildVersion): the frozen shim never compares it, so a build change while the
# agent is enabled (a security response, an update) stops here at runscaler's next start, until wall-check proves the
# wall again; launchd retries every 300 s (ThrottleInterval). Bounds the LaunchAgent's two log files at 10 MB.
umask 077
RUNNER=/Users/ci/bin/runner
CONFIG=/Users/ci/.config/runner/config.toml
TOKEN_DIR=/Users/ci/.config/runner
LOGDIR=/Users/ci/Library/Logs/mac-runner
ERRLOG=$LOGDIR/runner-start.err
OUTLOG=$LOGDIR/runscaler.log   # runscaler logs to stdout
SHIM=/usr/local/libexec/liveapp-ci/tart
STAMP=/Users/ci/.config/runner/wall-stamp
export PATH=/usr/local/libexec/liveapp-ci:/Users/ci/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C
die() { print -u2 -r -- "runner-start: REFUSE $*"; exit 1 }
stamp_macos() { # -> 0 when the wall stamp's macos line is this Mac's build; else REPLY = what differs (as runner-enable)
  local b p
  b=$(/usr/bin/sw_vers -buildVersion 2>/dev/null)
  p=$(/usr/bin/awk '$1 == "macos" {print $2}' $STAMP 2>/dev/null)
  [[ -n $b && $p == $b ]] && return 0
  REPLY="the wall was proven on macOS build ${p:-(none in the stamp)}; this Mac runs ${b:-(sw_vers gave nothing)}"
  return 1
}
usage='usage: runner-start run | runner-start validate [CONFIG]'
mode=${1-}
case $mode in
  (run) (( $# == 1 )) || die $usage ;;
  (validate)
    (( $# <= 2 )) || die $usage
    if (( $# == 2 )); then
      [[ $2 == /* && -f $2 && ! -L $2 ]] || die "CONFIG must be an absolute path to a regular file: '$2'"
      CONFIG=$2
    fi ;;
  (*) die $usage ;;
esac
[[ -r $CONFIG ]] || die "no config: $CONFIG"
for log in $ERRLOG $OUTLOG; do
  if [[ -f $log ]] && (( $(stat -f %z $log) > 10485760 )); then : > $log; fi
done
if [[ $mode == run ]] && ! stamp_macos; then
  die "$REPLY: runscaler does not start. Run /Users/ci/bin/runner-disable, then /Users/ci/bin/wall-check, then /Users/ci/bin/runner-enable"
fi
for name in ${(u)${(f)"$(grep -vE '^[[:space:]]*#' $CONFIG | grep -oE 'env:RUNNER_TOKEN_[A-Z0-9_]+' | sed 's/^env://')"}}; do
  f=$TOKEN_DIR/token-${${name#RUNNER_TOKEN_}:l}
  [[ -f $f && -s $f ]] || die "token file missing or empty: $f"
  [[ $(stat -f %Lp $f) == 600 ]] || die "token file is not 0600: $f"
  export $name="$(<$f)"
done
[[ $(command -v tart) == $SHIM ]] || die "tart on PATH is not the shim: $(command -v tart)"
have=(${(f)"$(tart list --source local -q)"})
for i in ${(u)${(f)"$(grep -oE '^runner-image = "[^"]+"' $CONFIG | cut -d'"' -f2)"}}; do
  (( ${have[(Ie)$i]} )) || die "configured runner-image is not on this host: $i"
done
exec $RUNNER $mode --config $CONFIG
