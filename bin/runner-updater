#!/bin/zsh -f
# runner-updater status | on | off | pass [--log FILE] | protect | rebuild FAMILY | switch-now FAMILY | back FAMILY | retry FAMILY
#                | report [--observe FAMILY]... [--observe-clear FAMILY]...
# The runner-image updater on the Studio, as ci. Design: docs/operations.md ("The updater: status, on, off, pass,
# protect", "The switch window: rebuild and switch-now", "RECOVER", "Rollback: back and retry" and "The updater's
# report mode (no action)"); the decision core's contract: core/README.md. `rebuild` and `switch-now` act on CI: each
# runs ONE switch window (bin/runner-updater-window: it disables CI, builds, edits config.toml and enables CI); `back`
# runs ONE rollback window (it disables CI, edits config.toml back to the previous image, enables CI and deletes the
# image it left). A pass ACTS on its verdicts (below, pass): R1's rollback, KEEP's ACCEPT and STOPs, the 7-day
# deletion, a due release's switch window. Every other write is under STATEDIR (the state, the pins, the
# protected list, the journals, the pass folders). RECOVER (bin/runner-updater-window, ru_recover) ends an interrupted
# window first: it disables, restores the config and enables CI as the window's journal says (below, RECOVER FIRST).
#
# THE STATE, STATE (STATEDIR/state.json): ONE JSON object, written by rename (STATE.new, then a rename over STATE), read
# under the updater lock (status alone reads it with no lock: ONE read, so a rename while it runs gives it the old or
# the new state, whole). A missing STATE is a fresh install: OFF, no family, nothing held; but beside a protected
# list that is not an empty regular file it is a LOST state (the updater writes a name into the list only from a
# state): every command that reads the state refuses, and writes nothing. Its members:
#   format     1. A state of another format (or none): every command prints "runner-updater: WAIT ..." and exits 4,
#              and nothing is written. A state of format 1 that is not the shape below: REFUSE, exit 1, left as it is.
#   on         true | false (D11: a fresh install is OFF)
#   families   {FAMILY: {
#                candidate   {version: "N.N.N", lines: {SET: IMAGE, ...}, closed_at: EPOCH[, recipe: "<sha256>"]} |
#                            null: the release under observation (switched, not accepted; closed_at = when its switch
#                            window closed; recipe = the recipe its window built with, which its ACCEPT writes)
#                previous    {SET: IMAGE, ...} | null: the lines the family ran before its candidate: the rollback
#                            target until ACCEPT, then what `back` restores until back_until
#                back_until  EPOCH | null: after an ACCEPT, the end of the 7 days `back` restores `previous`
#                rejected    ["N.N.N", ...]: the versions the updater never switches this family to again
#                recipe      "<sha256>" | null: the recipe baseline; null = NO BASELINE
#                stops       [{family: FAMILY, stop: NAME, version, user, detail}]: the STOPs it holds
#                            (core/README.md, facts.stops)
#                r1_since    EPOCH: the first pass whose R1 said rollback (the 2-h bound), counted only while a try
#                            could start (pass_r1: CI disabled by a person, a pending hand edit, a wait behind another
#                            family's window and `off` remove it); absent when R1 says other
#                due         {version, since}: the first pass that found the family due for that release (NO IDLE's
#                            3 days); absent while the family has a candidate
#                connect_only {VERSION: {n, at}}: the family's connect-only rollbacks of each version (n) and the
#                            last one's time (the 1-h retry); `retry` never resets it}}
#              absent members read as null or [].
#   images     {IMAGE: "N.N.N"}: each image the updater built or adopted, and its runner version (D2's pin rule)
#   core       the decision core's own state (the `state` that idle.jq and r1.jq return) | absent: a fresh core.
#              report's core state is apart from it, in REPORT.
#   restart    {from: {pid, start}, to: {pid, start}, stopped: {inode: "N", offset: N, sha}} | absent: the switch
#              window's own restart of runscaler (bin/runner-updater-window, THE OWN RESTART), kept for the next pass,
#              which passes it to the core as facts.restart once and then removes it.
#   A MEMBER THIS RELEASE DOES NOT READ (at the top, in a family, in a candidate or in a STOP): every command WAITs
#   (exit 4), names it, and writes nothing. A later member that names an image or holds a STOP needs this rule: an
#   older release (a rollback across one) then waits, and never writes a shorter protected list or prints a status that
#   hides a STOP. So a later release may add such a member under format 1.
#
# COMMANDS. Every command but status holds the updater lock, LOCKFILE (zsh's zsystem flock, held by this process
# until it exits): a command waits for it; a pass (the timer's) only tries it.
#   status   no lock, and it writes no file anywhere (the core gets its inputs through pipes). It reads STATE once
#            and calls status.jq with facts from it (each family's candidate and back_until, the STOPs it holds) and
#            its core state; a status.jq that does not decide is a STOP. It prints ON or OFF; each family: its candidate
#            or "no candidate", back_until, its rejected versions; an open window journal (one RECOVER cannot read or
#            act on: the README section, below, RECOVER FIRST); each family of BUILDERS in
#            the state: its host pin (`host pin V`, or none: D2's ONE RULE removes a pin whose version is not known);
#            status.jq's verdict and lines (the STOP lines with their next step, the evidence lines, each back_until);
#            and per STOP its D7 properties, `known false` and "unknown" for a STOP this core does not know (never
#            guessed). With no STATEDIR it creates nothing.
#   on       sets on = true. It refuses, and changes nothing, a warm pool (PLAN D6): a set of the families file that the
#            config has, with a [tart] pool-size > 0 or a pool-size line the lib does not read (ru_pools); so it also
#            refuses a config or families file it cannot read (it cannot check them).
#   off      runs RECOVER first; refuses while WINDOW still exists (an open window's journal: off never strands a
#            window), and then changes nothing. Else it sets on = false and removes each family's r1_since (time while
#            OFF never counts against a rollback's 2-h bound), then removes every file of PINDIR (golden-build's host pins), each one
#            journaled FIRST with runner-journal into ACTIONS (`pin-remove NAME VERSION SHA256`, or `pin-remove NAME
#            (not one line VERSION SHA256)`): a journal it cannot write is a STOP before that removal (the pin stays;
#            run off again). A PINDIR entry that is not a file, a PINDIR that is not a folder, or one it cannot read and
#            search (it would list as empty): STOP, and the pins stay.
#   pass     the timer's entry: install loads config/sh.liveapp.runner-updater.plist, which runs `pass --log FILE`
#            every 600 s. --log FILE (pass only; another command: usage, exit 2): FILE over 1 MiB is renamed to FILE.1
#            first; the pass's output goes to FILE, after a line `=== pass <UTC> pid N`, and its last line is `=== end rc
#            N <UTC>` (also when it finds the lock held). A FILE it cannot rename or open never stops the pass (RECOVER
#            must run): its output stays where it was (the plist's .err). Its one writer is the timer: a person runs
#            `pass` without --log. It TRIES the lock: held, "another run holds the
#            updater lock", exit 0 at once. Then RECOVER FIRST (below), even while OFF. OFF: "the updater is OFF", exit 0
#            (1 when RECOVER held a STOP) at once, no core call. ON: the jq check
#            (as report's step 2), RECOVER's no-action CI DISABLED and a window's POOL DOWN cleared when no journal is
#            open, FLAG is present and one runscaler runs (pass_ci_up), then the facts (ru_collect, with each family's candidate and back_until
#            and the STOPs from the state, never --observe's, less the recipe STOPs of a family with a candidate;
#            facts.restart = the state's `restart` member) into PASSDIR,
#            idle / r1 / keep / status (report's steps 4 and 5, on the core state of the state's `core` member), then
#            the new core state written into STATE by rename (the `restart` member removed in the same write: it is
#            passed once; each family's r1_since kept or removed), then the protected list rewritten (as protect).
#            A program that could not decide: STATE and the list stay as they were; a program that waits: exit 4, the
#            same. Then it ACTS (pass_act), in order, with at most ONE window per pass (a call that opened a window
#            journal uses it): KEEP's verdicts (pass_keep: ACCEPT, STOP JOBS FAIL ON THE NEW IMAGE, STOP NO EVIDENCE),
#            the 7-day deletions (pass_delete), R1's STOP PINNED RUNNER RETIRED (pass_retired: the candidate closed with
#            no restart, its version rejected), R1's rollback (pass_r1: ru_rollback; the 2-h bound counts only time a
#            try could start), the connect-only retry after 1 h (pass_connect_retry), the release hook
#            (bin/runner-updater-release, rl_pass), the recipe STOPs (pass_recipe), a due family's switch window
#            (pass_switch: ru_window; NO IDLE after 3 days), and the protected list once more. Each function's comment
#            has its rule. Exit 0; 1 when RECOVER or a window held a STOP or left its journal open, or the pass held a
#            STOP anew; 4 WAIT.
#            RESIDUALS, named (S3b-4b r2): time with no pass at all (the host off or asleep, or no timer, for more than
#            2 h while a rollback is pending) still counts against the 2-h rollback bound, as a pass that found the
#            lock held does: the first pass after it holds ROLLBACK FAILED with no try (`retry FAMILY` starts the 2 h
#            again). After PINNED RUNNER RETIRED the family runs the retired image, so the next release's window
#            journals it as its old image, and an R1 rollback of that release goes back to it (PLAN D5 FAMILY LINES:
#            no rule; ROLLED BACK and the watchdog's STALE ask a person).
#   protect  writes the protected list PROTECTED from the state (bin/runner-updater-lib, ru_protect: each family's
#            candidate; its `previous` while it has a candidate and until back_until, which is until ACCEPT + 7 days
#            or until the family's next switch window has closed (that close supersedes it), whichever comes first; an
#            open window's `image NAME` lines), by rename, after a sync to disk (DD): one image name per line, the format golden-prune reads.
#            A list it cannot write: STOP, the old list stays. It is how to get a lost list back without emptying it,
#            so it and pass run when the list is missing or is not a readable regular file.
#   report   one pass that measures, asks the core and prints, with its own state (below).
#   rebuild FAMILY     ONE switch window (bin/runner-updater-window, ru_window: its header has the order, the journal
#            and the STOPs) that builds FAMILY's CURRENT runner version anew: the version of the image its sets run
#            (the state's image record, else the version golden-build's log printed for it; else REFUSE), its sha256
#            the host pin's or the release literal's (else REFUSE), with the idle pair. It is the D10 rehearsal and the
#            recipe baseline's path: the candidate keeps the recipe it was built with, and its ACCEPT writes it. Only the families of BUILDERS have a builder wired: another is "no builder wired".
#   switch-now FAMILY  the same window with no idle pair (D5 NO IDLE's override), and it says so; its release is the
#            one FAMILY's NO IDLE STOP holds (its version and sha256), else FAMILY's current version (as rebuild).
#            Both refuse while the updater is OFF. Their release is due from now, so they never raise NO IDLE (a pass
#            of a later release gives ru_window the release's eligibility date). Exit 0 switched (the window closed on
#            the new image), 1 a STOP or a REFUSE, 5 not now (START STATE or IDLE: nothing changed).
#   back FAMILY        ONE rollback window started by a person (bin/runner-updater-window, ru_rb_window, its header):
#            FAMILY's sets go back to its `previous` image, before an ACCEPT (the candidate: the D10 rehearsal) or after
#            it while back_until holds; else REFUSE. It rejects the version it leaves only when that is newer than the
#            restored image's, and holds no ROLLED BACK. It refuses while the updater is OFF. Exit 0 rolled back, 1 a
#            STOP or a REFUSE, 5 pending (CI disabled by a person, or the target's validate UNKNOWN: nothing changed).
#   retry FAMILY       clears the family's rejection and every STOP it holds whose line (status.jq's: D7's lines) names
#            `runner-updater retry FAMILY`: check failed, ROLLED BACK, JOBS FAIL ON THE NEW IMAGE, NO EVIDENCE, and
#            ROLLBACK FAILED (its hand line, whatever step raised it; clearing it also removes r1_since, so the 2-h
#            bound starts again). A JOBS FAIL ON THE NEW IMAGE of the family's candidate that it clears IS the person's
#            ACCEPT (PLAN D7, 11-04): the same writes as KEEP's ACCEPT (accept_jq) in the same state write, the
#            protected list, and while ON the pin by D2's ONE RULE (pass_pin, which reads the families file: a pin
#            that follows the rule stays byte-equal). NO EVIDENCE accepts nothing (the candidate stays under
#            observation), and neither does a JOBS FAIL where KEEP's own accept would not, apart from that STOP: the
#            core state's evidence of the candidate's window (never r1_since) read through core/lib/core.jq's r1_bar,
#            the ONE predicate keep.jq reads too (S3b-4b r3 P2-1): R1's rollback verdict stands (the next pass with CI
#            up rolls back; r2 P1-1), r1's own STOP stands in the window (SHIM REFUSED), or the open window's counted
#            failures are not all settled (`pending`: the pass that settles them rolls back when R1 comes). Then it
#            clears the STOPs and says why it accepts nothing. A STOP whose line names another step, and another
#            family's, stay; a version a PINNED RUNNER RETIRED STOP still holds stays rejected; the connect-only count
#            stays. It starts nothing, says the next pass may proceed only when no STOP of the family is left (else it
#            names them), and it runs while the updater is OFF too.
# RECOVER FIRST: an open window journal (WINDOW) that no run holds (the window holds the updater lock for its whole run,
# so a run that took the lock and finds one found an interrupted window): pass, rebuild, switch-now, back, retry, on and
# off end it
# first with RECOVER (bin/runner-updater-window's header, "RECOVER"), after the state is loaded and before the jq check
# (it needs no tested jq). It closed: the command goes on; a pass whose RECOVER held a STOP exits 1. It stays open (CI
# DISABLED, a person's file that fails validate, a journal it cannot read, a state it cannot write): STOP, exit 1, and
# nothing else starts. status only names it (no lock); report takes no action and runs no RECOVER; protect writes the
# list (it reads an open journal's names) and runs no RECOVER.
# A RECORD RECOVER CANNOT READ OR ACT ON (S3b-5 A5; PLAN D1): a line no pattern reads or a key it does not know, or a
# record that is not complete (its backup gone or changed). No tool ends it: RECOVER's STOP, this file's last line for
# it, `status`'s window line (it reads the record by RECOVER's own route, ru_rc_route, which writes nothing) and a state
# WAIT or REFUSE that comes before RECOVER while a record is open each name the README section
# "An unfinished window the updater cannot end" (the lib's ru_hand_readme): its hand steps bring CI back, and the
# maintainer clears the record. Every other RECOVER STOP names its cause, and fixing it lets the next pass end the
# window.
#
# REPORT: ONE pass that measures, asks the decision core (core/) and prints. It TAKES NO ACTION: it stops, starts,
# edits, pins, deletes and enables nothing, and it runs none of runner-disable, runner-enable, golden-build,
# golden-gate, tart, launchctl or kill. The pass, in order:
#   1. The updater lock. A second report WAITS for it.
#   2. The jq it runs (JQ) must print a `jq --version` that core/TESTED_JQ lists for the area `core`. Else the STOP
#      "untested jq" and exit 3: no core program runs. (status checks it too.)
#   3. now = the UTC clock (date -u +%s). The facts (bin/runner-updater-lib, ru_collect: its header says what each
#      fact is and the order they are read in) go into the pass folder REPORT/pass: facts.json, log.txt, healthz.json.
#      A fact it cannot read: a REFUSE line, exit 1, no core program runs.
#   4. idle.jq, r1.jq, keep.jq and status.jq run with the same five inputs (state, facts, log, healthz, --arg now). The
#      state is the pass's copy, REPORT/pass/state.json, written back by rename after idle and after r1, so a later
#      program reads it. Only when all four decided is it renamed to REPORT/state.json, the report's state; a program
#      that exits non-zero, or prints no JSON object with a verdict: "runner-updater: core could not decide
#      (PROGRAM)", exit 1, and REPORT/state.json stays as it was (the pass did nothing). Each program's output stays in
#      REPORT/pass/PROGRAM.json.
#   5. It prints each program's verdict and reason (r1 and keep: each family's too), then status.jq's lines.
# --observe FAMILY: from this pass on, FAMILY's CURRENT config lines are its candidate (version "observed", closed_at =
# this pass's now), in REPORT/observe.json, until `report --observe-clear FAMILY`. A family already observed keeps its
# record. Repeat the option for more families.
#
# THE STATE FOLDER. When STATEDIR does not exist, every command but status creates it with an EMPTY (0-byte) protected
# list in it: golden-prune reads an existing STATEDIR as "the updater is on this host" and refuses without a protected
# list, and an empty list protects nothing, so golden-prune prints what it printed before.
# The folder (0700) and its list (0600) come into being in ONE step, a rename, so a kill at any point leaves no
# STATEDIR or STATEDIR with its list; a kill before the rename can leave the new folder beside STATEDIR,
# runner-updater.new.XXXXXXXX, which nothing reads (remove it). Two runs that both find no STATEDIR: one makes it,
# and the other leaves it as it is. A STATEDIR without its list is a REFUSE (report, on, off) that says what to do, and
# so is a list that is not a readable regular file: never an empty list, which in place of a lost one would let
# golden-prune print an image the updater keeps, but `protect`, which writes it from the state. REPORT is made under
# the lock.
# A folder on the path to STATEDIR's files (STATEDIR, or one above it) that exists but cannot be searched: every
# command, status too, refuses before it reads anything (the lib's ru_reach, ONE rule): behind it the state would read
# as fresh (OFF), the list as missing and a pin as absent.
# Exit: 0 done; 1 a REFUSE (the state folder or its list, a state it does not read, a fact it cannot read, an --observe
# it cannot do, off while a window is open) or a STOP (a write that failed, the core could not decide, a window's STOP,
# RECOVER's STOP or a journal it leaves open); 2 usage; 3 STOP untested jq; 4 WAIT (a state of another format, or with a member this release does
# not read, or a core program that waits); 5 not now (rebuild, switch-now). A pass that finds the lock held, or the
# updater OFF: 0.
# Constants:
#   RUNNER       runscaler, as runner-start execs it ("RUNNER run --config CONFIG" is the process it looks for)
#   CONFIG       runscaler's config; RUNLOG, runscaler's own log, is runner.log beside the config: the config pins
#                it there (`log-file`; ru_config refuses any other spelling, and a config with none: runscaler 0.10.0
#                and later write elsewhere without it); at 10 MiB runscaler renames it to runner.log.1, one backup
#                (0.9.5 and 0.12.0 alike)
#   STATEDIR     the updater's state folder; in it: STATE (state.json, above); REPORT = report/ (report's own state and
#                pass folder); PASSDIR = pass/ (a pass's facts, log text, /healthz reads, core state copy and each
#                program's output); LOCKFILE = lock (the updater lock); PROTECTED = protected (golden-prune reads it);
#                PINDIR = pin/ (golden-build's host pins, one file per image family); WINDOW = window (the open
#                window's journal, S3b-3's: absent when no window is open); ACTIONS = actions (the updater's action
#                journal, written only through runner-journal)
#   FAMILIES     the host's families file (bin/runner-updater-lib, ru_families)
#   PATH         its own, set at the top (the system folders): it never depends on the caller's PATH, so the weekly
#                watchdog's `runner-updater status` over a non-interactive ssh runs it as the timer does
#   JQ PS CURL DD the tools it runs (each by its absolute path; DD syncs a file to disk before its rename); CORE, the
#                release's core/ beside this file's bin/; RELBIN, this file's bin/ (runner-updater-lib,
#                runner-updater-window, runner-journal, validate-class, and the tools the window runs: runner-disable,
#                runner-enable (this release's: it has --check), runner-start, golden-build, golden-gate, all of the same
#                release); INVOKED, this file as it was run (the refusal texts name it)
#   HEALTHZ_GAP  seconds between the two /healthz reads
#   the window's: FLAG (the agent's flag), REAL (tart), REALRUN, LOGDIR (golden-build's logs), TARTDIR (Tart's home:
#                its volume's free disk, TARTDIR/vms/IMAGE's size), BIN (the installed tools: the hand lines), LOCK (the
#                runner lock: the config edit holds it), DF DU, FLOOR_GIB (golden-build's floor), VALIDATE_GAP,
#                CLOSE_WAIT, CLOSE_POLL, MTIME_WAIT (seconds), WINDOWS (STATEDIR/windows: the closed journals, and each
#                window's folder ID.d), BUILDERS (the families whose builder is wired)
#   RECOVER's:   RECOVER_WAIT (its one bound, 75 min), RECOVER_POLL (seconds between its reads), LSOF (it reads every
#                open file of ci's processes; runner-lock-free sets the same)
#   the rollback window's: ROLLBACK_BOUND (2 h: a rollback that cannot start, or whose target validates UNKNOWN, is
#                tried again while R1's verdict holds, then STOP ROLLBACK FAILED)
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin   # its own, never the caller's (the watchdog runs status over ssh)
export LC_ALL=C
export TZ=UTC   # ps prints start times in TZ, and the lib reads them back in it; the core's clock is UTC
umask 077
RUNNER=/Users/ci/bin/runner
CONFIG=/Users/ci/.config/runner/config.toml
STATEDIR=/Users/ci/.local/state/runner-updater
FAMILIES=/Users/ci/.config/runner-updater/families
JQ=/usr/bin/jq
PS=/bin/ps
CURL=/usr/bin/curl
HEALTHZ_GAP=3
CORE=${0:A:h:h}/core
RUNLOG=${CONFIG:h}/runner.log
REPORT=$STATEDIR/report
LOCKFILE=$STATEDIR/lock
PROTECTED=$STATEDIR/protected
STATE=$STATEDIR/state.json
PASSDIR=$STATEDIR/pass
PINDIR=$STATEDIR/pin
WINDOW=$STATEDIR/window
ACTIONS=$STATEDIR/actions
DD=/bin/dd
RELBIN=${0:A:h}
INVOKED=${0:a}
# the switch window's (bin/runner-updater-window): the host's paths, and its bounds
FLAG=/Users/ci/.config/runner/enabled
REAL=/Users/ci/Applications/tart.app/Contents/MacOS/tart
REALRUN=/Users/ci/bin/real-run
LOGDIR=/Users/ci/Library/Logs/mac-runner
TARTDIR=/Users/ci/.tart
BIN=/Users/ci/bin
LOCK=/tmp/runner.lock
DF=/bin/df
DU=/usr/bin/du
# golden-build's free-disk floor (release-check: one value across the scripts)
FLOOR_GIB=200
VALIDATE_GAP=20     # seconds between two validate tries (the ONE VALIDATE RULE)
CLOSE_WAIT=600      # seconds the window waits for its target to run (D1: 10 min)
CLOSE_POLL=5        # seconds between two reads of that wait
MTIME_WAIT=10       # seconds the window waits for the clock to pass the config's mtime; further ahead: STOP
ROLLBACK_BOUND=7200 # seconds a rollback that cannot start (or whose target validates UNKNOWN) is tried again: 2 h
RECOVER_WAIT=4500   # seconds RECOVER waits (one bound, 75 min) for the window's tools, VMs and the runner lock
RECOVER_POLL=10     # seconds between two of RECOVER's reads in that wait
LSOF=/usr/sbin/lsof # RECOVER reads every open file of ci's processes with it (as runner-lock-free does)
WINDOWS=$STATEDIR/windows
BUILDERS=(mac-golden)   # the families whose builder is wired (mac-golden: golden-build)

say() { print -r -- "runner-updater: $*" }
refuse() { print -r -- "runner-updater: REFUSE $*"; exit 1 }
stop() { print -r -- "runner-updater: STOP $*"; exit 1 }
usage() {
  print -u2 -r -- "runner-updater: usage: runner-updater status | on | off | pass [--log FILE] | protect | rebuild FAMILY | switch-now FAMILY | back FAMILY | retry FAMILY | report [--observe FAMILY]... [--observe-clear FAMILY]...${1:+ ($1)}"
  exit 2
}

# ---- arguments
(( $# >= 1 )) || usage "no command"
cmd=$1
shift
logf=
case $cmd in
  (pass)
    if [[ ${1-} == --log ]]; then
      (( $# == 2 )) && [[ $2 == /?* ]] || usage "pass --log takes one absolute FILE"
      logf=$2
      shift 2
    fi
    (( $# == 0 )) || usage "pass takes no argument but --log FILE" ;;
  (status|on|off|protect) (( $# == 0 )) || usage "$cmd takes no argument" ;;
  (rebuild|switch-now|back|retry)
    (( $# == 1 )) || usage "$cmd takes one FAMILY"
    [[ $1 =~ '^[a-z][a-z0-9-]{0,40}$' ]] || usage "not a family name: '$1'"
    family=$1
    shift ;;
  (report) ;;
  (*) usage "unknown command '$cmd'" ;;
esac
# pass --log FILE (the timer's: config/sh.liveapp.runner-updater.plist; a person runs pass without it): FILE over 1 MiB
# is renamed to FILE.1 first, then this pass's output goes to FILE, between its start and end lines. A FILE it cannot
# rename or open never stops the pass (RECOVER must run): zsh says why and goes on, and the output stays where it was
# (the plist's .err). So no `|| exit` after the exec
if [[ -n $logf ]]; then
  zmodload zsh/datetime
  zmodload -F zsh/stat b:zstat
  typeset -A logst
  if [[ -f $logf ]] && zstat -H logst -- $logf 2> /dev/null && (( logst[size] > 1048576 )); then
    /bin/mv -f -- $logf $logf.1 2> /dev/null \
      || print -u2 -r -- "runner-updater: pass: cannot rename $logf to $logf.1: this pass writes on"
  fi
  exec >> $logf 2>&1
  print -r -- "=== pass $(strftime '%Y-%m-%d %H:%M:%S UTC' $EPOCHSECONDS) pid $$"
  trap 'logrc=$?; print -r -- "=== end rc $logrc $(strftime "%Y-%m-%d %H:%M:%S UTC" $EPOCHSECONDS)"' EXIT
fi
source $RELBIN/runner-updater-lib || refuse "cannot load $RELBIN/runner-updater-lib"
# every folder on the path to STATEDIR's files must be one it can search (the lib's ru_reach), before any command reads
# one: behind a folder it cannot search, the state would read as fresh (OFF), the list as missing, a pin as absent
ru_reach $STATE || refuse "$REPLY, so the files in $STATEDIR would look absent (a state as a fresh one: OFF). Look at its mode (ci must be able to search it), then run $cmd again"

# the state, under the lock (status: with no lock, ONE read) -> ru_state; WAIT (exit 4) on a state of another format
# or with a member this release does not read, REFUSE on one it does not read, and on a missing state beside a list
# that is not empty (a lost state): in each case nothing is written
load_state() {
  local open=
  # a WAIT or REFUSE here comes before RECOVER: while a window record is open, no pass can end it, so the line names the
  # README's hand steps (S3b-5 A5); with no record it does not
  [[ -e $WINDOW || -L $WINDOW ]] && open="; an updater window is unfinished ($WINDOW): $ru_hand_readme"
  ru_state_load $STATE
  case $? in
    (0) ;;
    (2) print -r -- "runner-updater: WAIT $REPLY$open"; exit 4 ;;
    (*) refuse "$REPLY: it is left as it is$open" ;;
  esac
  # a missing state is fresh, but the updater writes a name into the list only from a state: a list that is not an
  # empty regular file says a state existed and is lost, and a fresh state would drop what the list protects
  if (( ru_state_absent )) && [[ -e $PROTECTED || -L $PROTECTED ]] \
     && ! [[ -f $PROTECTED && ! -L $PROTECTED && ! -s $PROTECTED ]]; then
    refuse "there is no state $STATE, but the protected list $PROTECTED is not empty: a state existed and is lost, and a fresh one would drop what the list protects. Put the state back; or, when no image in the list must be kept, move the list aside and run $cmd again$open"
  fi
}
# JQFILTER [JQ OPTION...]: the state changed by it, written by rename
change_state() {
  local new f=$1
  shift
  new=$(print -r -- $ru_state | $JQ -c "$@" $f) && [[ -n $new ]] || stop "jq could not change the state: $STATE is as it was"
  ru_write $STATE "$new"$'\n' || stop "the state cannot be written ($REPLY): $STATE is as it was"
  ru_state=$new
}

# the jq under the core must be one core/TESTED_JQ lists for the area core; else the STOP "untested jq" and exit 3
jq_tested() {
  local jqv l tested=0
  jqv=$($JQ --version 2>/dev/null) || jqv='(no version)'
  if [[ -f $CORE/TESTED_JQ && -r $CORE/TESTED_JQ ]]; then
    for l in "${(@f)$(<$CORE/TESTED_JQ)}"; do
      [[ $l =~ '^([^#[:space:]]+)[[:space:]]+([a-z,]+)[[:space:]]+([^[:space:]]+)[[:space:]]*$' ]] || continue
      [[ $match[1] == "$jqv" && ,$match[2], == *,core,* ]] && tested=1
    done
  fi
  if (( ! tested )); then
    print -r -- "runner-updater: STOP untested jq: $JQ prints '$jqv', which core/TESTED_JQ does not list for the core; no new work starts. Next, in the repository: \`JQ=$JQ python3 -I -m unittest discover -s tests/core -t .\`, then add its row to core/TESTED_JQ when they pass"
    exit 3
  fi
}

# DIR PROGRAM: its output DIR/PROGRAM.json is one decision: one JSON object with lines, and a verdict core/README.md
# gives that program ("The programs' outputs": idle: idle | not-idle | wait; r1, keep, status: ok | wait). Any other
# verdict, or none, is not one: the core could not decide
decided() {
  $JQ -e -s --arg p $2 'length == 1 and (.[0] | type) == "object" and (.[0].lines | type) == "array"
             and (.[0].verdict as $v | (if $p == "idle" then ["idle", "not-idle", "wait"] else ["ok", "wait"] end)
                  | any(.[]; . == $v))' $1/$2.json > /dev/null 2>&1
}

# DIR STATEREF NOW: idle, r1, keep and status on DIR's facts.json, log.txt, healthz.json and state.json (the pass's
# copy of the core state: written back by rename after idle and after r1, so a later program reads it). A program
# that exits non-zero or decides nothing (decided): "core could not decide", "the pass did nothing: STATEREF is as it
# was", exit 1. A program whose verdict is `wait` (a core state of another format): "WAIT the core waits", the same
# line, exit 4: STATEREF is byte-equal. It prints each program's verdict and reason (r1 and keep: each family's too),
# then status.jq's lines.
run_core() {
  local dir=$1 ref=$2 now=$3 prog rc
  for prog in idle r1 keep status; do
    $JQ -n -L $CORE/lib -f $CORE/$prog.jq --slurpfile state $dir/state.json --slurpfile facts $dir/facts.json \
        --rawfile log $dir/log.txt --slurpfile healthz $dir/healthz.json --arg now $now > $dir/$prog.json 2> $dir/$prog.err
    rc=$?
    if (( rc != 0 )) || ! decided $dir $prog; then
      say "core could not decide ($prog): exit $rc${$(/usr/bin/head -n 1 $dir/$prog.err 2>/dev/null):+: $(/usr/bin/head -n 1 $dir/$prog.err)}"
      say "the pass did nothing: $ref is as it was"
      exit 1
    fi
    if [[ $($JQ -r '.verdict' $dir/$prog.json) == wait ]]; then
      say "WAIT the core waits ($prog): $($JQ -r '"\(.reason): \(.lines[0] // "")"' $dir/$prog.json)"
      say "the pass did nothing: $ref is as it was"
      exit 4
    fi
    if [[ $prog == (idle|r1) ]]; then   # the new state, for the next program of this pass: by rename
      $JQ -e '.state | if type == "object" then . else error("no state") end' $dir/$prog.json > $dir/state.json.new \
        && /bin/mv -f -- $dir/state.json.new $dir/state.json \
        || { say "core could not decide ($prog): its output has no state"; say "the pass did nothing: $ref is as it was"; exit 1 }
    fi
    if [[ $prog == status ]]; then
      $JQ -r '"status: \(.verdict) (\(.reason))", .lines[]' $dir/$prog.json
    else
      $JQ -r --arg p $prog '"\($p): \(.verdict) (\(.reason))",
          ((.families // {}) | to_entries[] | "\($p) \(.key): \(.value.verdict) (\(.value.reason))")' $dir/$prog.json
    fi
  done
}

# ---- status: no lock, no write. ONE read of the state; the facts status.jq needs come from it (each family's
# candidate and back_until, the STOPs it holds), and the core's own state is its `core` member
do_status() {
  local now core facts out rc
  load_state   # ONE read of the renamed file: everything status prints comes from it
  jq_tested
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  core=$(print -r -- $ru_state | $JQ -c '.core // empty') \
    && facts=$(print -r -- $ru_state | $JQ -c '{format: 1, host: "studio", sets: [], proc: null, position: null,
         continuous: false, restart: null, config: null,
         families: (.families | map_values({provider: "tart", sets: ((.candidate.lines // {}) | keys),
                                             candidate: (.candidate // null), back_until: (.back_until // null)})),
         stops: [.families[] | (.stops // [])[]]}') \
    || refuse "jq could not build the facts of the state"
  print -r -- $ru_state | $JQ -r 'def utc: strftime("%Y-%m-%d %H:%M UTC");
    "runner-updater: status: the updater is \(if .on then "ON" else "OFF" end)",
    if (.families | length) == 0 then "runner-updater: status: no family in the state"
    else .families | to_entries | sort_by(.key)[] | .key as $f | .value
      | "runner-updater: family \($f): "
        + (if .candidate == null then "no candidate"
           else "candidate runner \(.candidate.version) (\(.candidate.lines | to_entries | sort_by(.key)
                 | map("\(.key)=\(.value)") | join(", "))), switched \(.candidate.closed_at | utc)" end)
        + "; " + (if .back_until == null then "back: none" else "back until \(.back_until | utc)" end)
        + "; rejected: " + (if (.rejected // []) == [] then "none" else (.rejected | join(", ")) end)
    end' || refuse "jq could not print the state"
  status_window
  # the core's inputs come through process substitutions (pipes, no file): status writes nothing anywhere. Its
  # stderr goes with its output: anything but one decision is "could not decide"
  out=$($JQ -n -L $CORE/lib -f $CORE/status.jq --slurpfile state <(print -rn -- $core) \
          --slurpfile facts <(print -r -- $facts) --arg now $now 2>&1)
  rc=$?
  if (( rc != 0 )) || ! print -r -- $out | $JQ -e -s 'length == 1 and (.[0] | type) == "object"
       and (.[0].verdict == "ok" or .[0].verdict == "wait") and (.[0].lines | type) == "array"' > /dev/null 2>&1; then
    stop "core could not decide (status): exit $rc${${out%%$'\n'*}:+: ${out%%$'\n'*}}"
  fi
  print -r -- $out | $JQ -r 'def yn: if . == true then "yes" elif . == false then "no" elif . == null then "unknown" else tostring end;
    "status: \(.verdict) (\(.reason))", .lines[],
    (.stops[]? | "runner-updater: STOP \(.family) \(.stop): known \(.known); candidate closed: \(.closes_candidate | yn); version rejected: \(.rejects | yn); a newer release proceeds alone: \(.newer_proceeds | yn)")'
  exit 0
}

# status's window lines: an open window journal, and each family's host pin (D2's ONE RULE removes a pin when the
# version of the image the family runs is not known: status says so). It reads, and writes nothing. An open journal is
# read by RECOVER's own route (bin/runner-updater-window, ru_rc_route: read only): one RECOVER cannot read or act on
# names the README's hand steps (S3b-5 A5), since no pass ends it
status_window() {
  local f c
  if [[ -e $WINDOW || -L $WINDOW ]]; then
    if source $RELBIN/runner-updater-window && ru_rc_route && [[ $REPLY == (unreadable|cannot-act) ]]; then
      say "status: a window journal is open: $WINDOW, and RECOVER cannot read or act on it ($ru_rc_why): $ru_hand_readme"
    else
      say "status: a window journal is open: $WINDOW (its run holds the updater lock; when no run does, the next pass's RECOVER ends it)"
    fi
  fi
  for f in ${(f)"$(print -r -- $ru_state | $JQ -r '.families | keys[]')"}; do
    (( ${BUILDERS[(Ie)$f]} )) || continue
    if [[ -f $PINDIR/$f && ! -L $PINDIR/$f && -r $PINDIR/$f ]]; then
      c=$(/bin/cat -- $PINDIR/$f 2>/dev/null)
      if [[ $c =~ '^([0-9]+\.[0-9]+\.[0-9]+) [0-9a-f]{64}$' ]]; then say "family $f: host pin $match[1]"
      else say "family $f: host pin: $PINDIR/$f is not one line VERSION SHA256 (golden-build stops on it)"; fi
    elif [[ -e $PINDIR/$f || -L $PINDIR/$f ]]; then say "family $f: host pin: $PINDIR/$f is not a readable file (golden-build stops on it)"
    else say "family $f: host pin: none (a hand golden-build uses the release literal)"; fi
  done
}

# RECOVER FIRST (bin/runner-updater-window, ru_recover): an open window journal that no run holds (the window holds the
# updater lock for its whole run, so a run that took the lock and finds one found an interrupted window) is ended
# before anything else starts. It closed: the command goes on (recovered=1 when it held a STOP: a pass then exits 1).
# It stays open: STOP, exit 1, and nothing else starts. It needs no tested jq (the jq check guards new work only)
recovered=0
run_recover() {
  [[ -e $WINDOW || -L $WINDOW ]] || return 0
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  ru_recover
  case $? in
    (0) ;;
    (1) recovered=1 ;;
    (*) if (( ru_rc_cannot )); then
          print -r -- "runner-updater: STOP the window journal $WINDOW stays open, and RECOVER cannot read or act on it: $ru_hand_readme. Nothing else starts"
        else
          print -r -- "runner-updater: STOP the window journal $WINDOW stays open: the next run's RECOVER tries again; nothing else starts"
        fi
        exit 1 ;;
  esac
}

# ---- rebuild FAMILY, switch-now FAMILY: ONE switch window (bin/runner-updater-window, ru_window), under the lock
do_window() {
  local now since v= s= mode=idle rc rec
  load_state
  run_recover
  [[ $(print -r -- $ru_state | $JQ -r '.on') == true ]] \
    || refuse "the updater is OFF: $cmd runs only while it is ON (\`$INVOKED on\`); nothing changed"
  (( ${BUILDERS[(Ie)$family]} )) \
    || refuse "no builder wired for $family: this release builds only ${(j:, :)BUILDERS} (the Studio Linux families come with their builder's move)"
  jq_tested
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  now=$EPOCHSECONDS
  since=$now   # the commands' release is due from now: never NO IDLE (a pass gives its eligibility)
  ru_config && ru_families && ru_pools || refuse "$REPLY: no window"
  (( ${+ru_fam[$family]} )) || refuse "no family $family in $FAMILIES: no window"
  if [[ $cmd == switch-now ]]; then
    mode=now
    if ru_w_due $family; then v=$reply[1] s=$reply[2]; say "switch-now $family: the release of its NO IDLE STOP: runner $v"; fi
  fi
  if [[ -z $v ]]; then
    ru_w_current $family
    case $? in
      (0) v=$reply[1] s=$reply[2] ;;
      (2) ru_w_fam=$family ru_w_ver= ru_w_sha= ru_w_open=0 ru_w_stops=()
          ru_w_stop "check failed" "pre-window: $REPLY"
          ru_w_hold_stops
          exit 1 ;;
      (*) refuse "$REPLY: no window" ;;
    esac
  fi
  # the recipe it builds with (bin/runner-updater-release, rl_recipe), kept in the candidate: its ACCEPT writes the
  # family's baseline (PLAN D2: NO BASELINE until `rebuild FAMILY` once; its ACCEPT writes the recipe)
  source $RELBIN/runner-updater-release || refuse "cannot load $RELBIN/runner-updater-release"
  if rl_recipe $family ${RELBIN:h}; then rec=$REPLY
  else rec=; say "$cmd $family: $REPLY: the candidate keeps no recipe, so its ACCEPT writes no baseline"; fi
  ru_window $family $v $s $mode $since $cmd $rec
  rc=$?
  if (( rc == 0 )); then say "$cmd $family: switched to $ru_w_out (runner $v); the window closed"; exit 0; fi
  (( rc == 2 )) && exit 5
  exit 1
}

# ---- back FAMILY: ONE rollback window started by a person (bin/runner-updater-window, ru_rb_window: the header has
# its rules): FAMILY's sets go back to its `previous` image, before an ACCEPT (the candidate) or after it while
# back_until holds. It rejects the version it leaves only when that is newer than the restored image's
do_back() {
  local rc
  load_state
  run_recover
  [[ $(print -r -- $ru_state | $JQ -r '.on') == true ]] \
    || refuse "the updater is OFF: back runs only while it is ON (\`$INVOKED on\`); nothing changed"
  jq_tested
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  ru_rb_window $family back '' $EPOCHSECONDS
  rc=$?
  if (( rc == 0 )); then say "back $family: the family runs $ru_w_rbt again; the window closed"; exit 0; fi
  (( rc == 2 )) && exit 5
  exit 1
}

# ---- retry FAMILY: the family's rejection, and every STOP it holds whose line (status.jq's: D7's lines column) names
# `runner-updater retry FAMILY`, are cleared; a STOP whose line does not (a hand line, rebuild, switch-now), and another
# family's, stay. A version a PINNED RUNNER RETIRED STOP still holds stays rejected (its line names no retry). A JOBS
# FAIL ON THE NEW IMAGE of the candidate it clears is the person's ACCEPT (below). It starts nothing: the next pass may
# proceed. It needs no window, and runs while the updater is OFF too
do_retry() {
  local core facts out n idx acc why now on r1v cv
  load_state
  run_recover
  jq_tested
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  print -r -- $ru_state | $JQ -e --arg f $family '.families | has($f)' > /dev/null 2>&1 \
    || { say "retry $family: the state holds nothing for $family: nothing to clear"; exit 0 }
  core=$(print -r -- $ru_state | $JQ -c '.core // empty') \
    && facts=$(print -r -- $ru_state | $JQ -c --arg f $family '{format: 1, host: "studio", sets: [], proc: null,
         position: null, continuous: false, restart: null, config: null,
         families: (.families | map_values({provider: "tart", sets: ((.candidate.lines // {}) | keys),
                                             candidate: (.candidate // null), back_until: (.back_until // null)})),
         stops: (.families[$f].stops // [])}') \
    && n=$(print -r -- $ru_state | $JQ -r --arg f $family '.families[$f].stops // [] | length') \
    || refuse "jq could not read the STOPs of $family"
  out=$($JQ -n -L $CORE/lib -f $CORE/status.jq --slurpfile state <(print -rn -- $core) \
          --slurpfile facts <(print -r -- $facts) --arg now $EPOCHSECONDS 2>&1) \
    && idx=$(print -r -- $out | $JQ -c --arg f $family --argjson n $n \
               '[.stops[:$n] | to_entries[] | select(.value.line | contains("runner-updater retry \($f)`")) | .key]') \
    || stop "core could not decide (status): ${out%%$'\n'*}: nothing was cleared"
  # a JOBS FAIL ON THE NEW IMAGE of the candidate that it clears IS the person's ACCEPT (PLAN D7, 11-04: failing jobs are
  # a person's call): the same writes as KEEP's ACCEPT (accept_jq), in the same state write, so keep.jq never sees the
  # old counts again. A JOBS FAIL of another version, or another STOP, accepts nothing (NO EVIDENCE: the candidate stays
  # under observation). Nor does it where KEEP's own accept would not, apart from that STOP: core/lib/core.jq's r1_bar,
  # the ONE predicate keep.jq reads too (S3b-4b r3 P2-1), on the core state (`core`: r1.jq's evidence of the
  # candidate's window, same_window; never r1_since, which a pass removes while no try could start: r2 P1-1). Its kinds:
  # `rollback`, R1's verdict stands (no STOP disarms R1 while a candidate is live: PLAN D6), and the next pass with CI
  # up rolls back; `stop`, r1's own STOP in the window (SHIM REFUSED); `pending`, the open window's counted failures
  # are not all settled (R1 may still come), and the pass that settles them rolls back when R1 comes. The STOPs it
  # names are cleared, the candidate stays, and it says why. A jq that fails: nothing is accepted
  acc=$(print -r -- $ru_state | $JQ -r -L $CORE/lib --arg f $family --argjson i $idx 'import "core" as C;
          .families[$f] as $x | ($x.candidate // null) as $c | (((.core // {}).families // {})[$f] // null) as $e
          | if $c == null or (any(($x.stops // [])[$i[]]; .stop == "JOBS FAIL ON THE NEW IMAGE" and .version == $c.version)
                              | not) then "false"
            else (C::r1_bar($e; $c) | if . == null then "true" else "\(.kind)\t\(.reason | gsub("[\t\n]"; " "))" end)
            end') \
    && [[ ${acc%%$'\t'*} == (true|false|rollback|stop|pending) ]] || acc=false
  why=${acc#*$'\t'} acc=${acc%%$'\t'*}
  # a ROLLBACK FAILED it clears restarts R1's SINCE (S3b-4a r2 P3-a): the 2-h bound is measured anew from the next
  # pass that sees the verdict, else the next try would fail again at once
  change_state "$accept_jq"' .families[$f] |= (((.stops // []) | to_entries | map(select(.key as $k | $i | index($k) | not))
        | map(.value)) as $left
      | (if any((.stops // [])[$i[]]; .stop == "ROLLBACK FAILED") then del(.r1_since) else . end)
      | .stops = $left
      | .rejected = [(.rejected // [])[] | select(. as $v | any($left[]; .stop == "PINNED RUNNER RETIRED" and .version == $v))]
      | if $acc then accept($now) else . end)' \
      --arg f $family --argjson i $idx --argjson acc $([[ $acc == true ]] && print true || print false) --argjson now $now
  if [[ $acc == (rollback|stop|pending) ]]; then
    cv=$(print -r -- $ru_state | $JQ -r --arg f $family '.families[$f].candidate.version')
    case $acc in
      (rollback)
        r1v=$(print -r -- $ru_state | $JQ -r --arg f $family '.core.families[$f].verdict | (.failures | length) as $n
                | "set \(.set), \($n) counted failure\(if $n == 1 then "" else "s" end)\(if .connect_only == true then ", connect-class only" else "" end)"') \
          || r1v="its verdict cannot be read"
        say "retry $family: runner $cv is not accepted: R1's rollback is due for it ($r1v), and no STOP cancels it: the next pass with CI up rolls it back" ;;
      (stop)
        say "retry $family: runner $cv is not accepted: r1's STOP stands in its window ($why), and KEEP does not accept while it stands: \`runner-updater status\` names its next step" ;;
      (pending)
        say "retry $family: runner $cv is not accepted: $why: the pass that settles them rolls it back when R1 comes, else KEEP judges it again" ;;
    esac
  fi
  if [[ $acc == true ]]; then
    say "retry $family: accepted runner $(print -r -- $out | $JQ -r --argjson i $idx '[.stops[$i[]] | select(.stop == "JOBS FAIL ON THE NEW IMAGE")][0].version'): JOBS FAIL ON THE NEW IMAGE is your call, and retry keeps the image; \`runner-updater back $family\` restores $(print -r -- $ru_state | $JQ -r --arg f $family '[(.families[$f].previous // {})[]] | unique | join(", ")') until $(strftime '%Y-%m-%d %H:%M UTC' $(( now + 604800 )))"
    write_protected $now
    # the pin by D2's ONE RULE, as KEEP's ACCEPT (pass_pin); while the updater is OFF no pin is written (off removed
    # them, and OFF writes none)
    on=$(print -r -- $ru_state | $JQ -r '.on')
    if [[ $on == true ]]; then
      source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
      pass_pin $family
    fi
  fi
  # it says the next pass may proceed only when the family holds no STOP any more (S3b-4a r3 P3-b)
  print -r -- $out | $JQ -r --arg f $family --argjson i $idx --argjson n $n --argjson rej "$(print -r -- $ru_state | $JQ -c --arg f $family '.families[$f].rejected // []')" \
      --argjson left "$(print -r -- $ru_state | $JQ -c --arg f $family '[.families[$f].stops // [] | .[].stop]')" \
      '"runner-updater: retry \($f): cleared " + (if ($i | length) == 0 then "no STOP" else ([.stops[:$n] as $s | $i[] | $s[.].stop] | join(", ")) end)
       + "; rejected now: " + (if $rej == [] then "none" else ($rej | join(", ")) end)
       + (if $left == [] then "; the next pass may proceed"
          else "; still held: \($left | join(", ")) (`runner-updater status` names the next step of each)" end)'
  exit 0
}

# ---- on, off (D11), under the lock
do_on() {
  load_state
  run_recover
  # PLAN D6: `on` refuses a Tart set with a warm pool (the lib's ru_pools, after the config and the families file)
  ru_config && ru_families && ru_pools || refuse "on: $REPLY: the updater is as it was"
  change_state '.on = true'
  say "on: the updater is ON"
  exit 0
}

# off: never while a window is open (it would strand it); then OFF, then every pin of PINDIR removed, each one
# journaled first (runner-journal into ACTIONS: `pin-remove NAME VERSION SHA256`, or `pin-remove NAME (not one line
# VERSION SHA256)`); a journal it cannot write is a STOP before that removal
do_off() {
  local p c v
  load_state
  run_recover
  [[ ! -e $WINDOW && ! -L $WINDOW ]] \
    || refuse "a window is open ($WINDOW): off never strands a window, so nothing changed. Run off again when the window has ended"
  # OFF means nothing: the time it is OFF never counts against a rollback's 2-h bound, so each family's r1_since goes
  # (S3b-4b r1 P1-1: the first pass after `on` that sees R1's verdict starts the 2 h anew)
  change_state '.on = false | .families |= map_values(del(.r1_since))'
  say "off: the updater is OFF"
  [[ -e $PINDIR || -L $PINDIR ]] || exit 0
  [[ -d $PINDIR && ! -L $PINDIR ]] || stop "$PINDIR is not a folder: off removes the pins in it; look at what it is"
  # it lists PINDIR: one it cannot read lists as empty, one it cannot search hides each pin
  [[ -r $PINDIR && -x $PINDIR ]] \
    || stop "$PINDIR cannot be read and searched: off removes the pins in it, and would not see them. The updater is OFF; the pins stay. Look at its mode (ci must be able to read and search it), then run off again"
  for p in $PINDIR/*(DN); do
    [[ -f $p || -L $p ]] || stop "$p is not a file: off removes only pin files; look at what it is"
    c=
    if [[ -f $p && ! -L $p && -r $p ]]; then c=$(/bin/cat -- $p 2>/dev/null && print -rn -- .); c=${${c%.}%$'\n'}; fi
    if [[ $c =~ '^[0-9]+\.[0-9]+\.[0-9]+ [0-9a-f]{64}$' && $c == "$MATCH" ]]; then v="${p:t} $c"
    else v="${p:t} (not one line VERSION SHA256)"; fi
    /bin/zsh -f $RELBIN/runner-journal $ACTIONS pin-remove $v \
      || stop "the action journal could not record the removal of $p (above): the pin stays. The updater is OFF; run off again when the journal can be written"
    /bin/rm -f -- $p || stop "cannot remove the pin $p (its removal is journaled in $ACTIONS)"
    say "off: removed the pin $p (journaled first in $ACTIONS)"
  done
  exit 0
}

# ---- protect: the protected list, written from the state (PLAN D6; bin/runner-updater-lib, ru_protect)
write_protected() { # NOW
  ru_protect $ru_state $1 || stop "the protected list cannot be written ($REPLY): $PROTECTED is as it was"
}
do_protect() {
  local now
  load_state
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  write_protected $now
  say "protect: $PROTECTED holds $ru_protected_n image name${${ru_protected_n:#1}:+s}"
  exit 0
}

# ---- pass: the timer's entry (it tried the lock: a held lock ended it). OFF: nothing, at once. ON: the facts from
# the state, the core, the core state written back into the state, the protected list rewritten; then it acts on the
# verdicts (pass_act; the header's `pass` has the order)
do_pass() {
  local now held on l
  load_state
  run_recover
  on=$(print -r -- $ru_state | $JQ -r '.on')
  [[ $on == true ]] || { say "pass: the updater is OFF: nothing to do"; exit $recovered }
  jq_tested
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  [[ -d $PASSDIR ]] || /bin/mkdir -m 700 $PASSDIR || refuse "cannot create $PASSDIR"
  print -r -- $ru_state | $JQ -c '.core // empty' > $PASSDIR/state.json || refuse "cannot copy the core's state into $PASSDIR"
  /bin/rm -f -- $PASSDIR/{idle,r1,keep,status}.json
  pass_ci_up
  # the STOPs the core reads: a family with a candidate holds no NO BASELINE or recipe changed (a rebuild's candidate:
  # its ACCEPT writes the baseline; pass_recipe drops them from the state)
  held=$(print -r -- $ru_state | $JQ -c '{families: (.families | map_values({candidate: (.candidate // null),
           back_until: (.back_until // null)})),
           stops: [.families[] | . as $x | (.stops // [])[] | select(($x.candidate != null
                     and (.stop == "NO BASELINE" or .stop == "recipe changed")) | not)],
           restart: (.restart // null)}') \
    || refuse "jq could not read the families of the state"
  say "pass: one pass at $(strftime '%Y-%m-%d %H:%M:%S UTC' $now) ($now)"
  ru_collect $PASSDIR $PASSDIR/state.json '' $now $held || refuse "no facts: $REPLY"
  run_core $PASSDIR $STATE $now
  # the core's state back; the restart passed once (removed); each family's R1 SINCE (r1_since): the first pass whose
  # R1 said rollback keeps its clock, and a family whose R1 says anything else has none
  change_state '.core = $c[0] | del(.restart)
      | .families |= with_entries(.key as $f
          | if (($r1[0].families // {})[$f].verdict // "") == "rollback" then .value.r1_since //= $now
            else .value |= del(.r1_since) end)' \
    --slurpfile c $PASSDIR/state.json --slurpfile r1 $PASSDIR/r1.json --argjson now $now
  for l in $pass_ci_msg; do say $l; done
  write_protected $now
  pass_act $now   # the pass acts on its verdicts
  exit $(( recovered || pass_rc ))
}
# RECOVER's no-action STOP CI DISABLED (S3b-4a r3 P3-b; bin/runner-updater-window, RECOVER step 0) holds the family
# until a window of it disables CI again: CI was down, and the journal showed no runner-disable of its own. POOL DOWN
# (a window's second pre-close failure: CI down on the host; S3b-4b r1 P3-3) names runner-enable by hand as its next
# step. When no window journal is open, CI's flag is present and ONE runscaler runs (ru_proc), CI is up again (a person
# ran runner-enable): the pass removes every CI DISABLED and every POOL DOWN, before the core reads the STOPs
# (RECOVER's 75-min CI DISABLED is held only while its journal is open; a POOL DOWN window's journal is closed). In the
# pass's copy of the state (ru_state): the core's write after it keeps it, and a core that could not decide leaves
# STATE as it was (pass_ci_msg, one line per STOP name, is printed after that write)
pass_ci_msg=()
pass_ci_up() {
  local fams new s
  [[ ! -e $WINDOW && ! -L $WINDOW && -e $FLAG ]] || return 0
  ru_proc && [[ $REPLY == '{"pid":'* ]] || return 0
  for s in "CI DISABLED" "POOL DOWN"; do
    fams=$(print -r -- $ru_state | $JQ -r --arg s $s '[.families | to_entries[] | select(any((.value.stops // [])[]; .stop == $s))
             | .key] | join(" ")') || continue
    [[ -n $fams ]] || continue
    new=$(print -r -- $ru_state | $JQ -c --arg s $s '.families |= map_values(.stops = [(.stops // [])[] | select(.stop != $s)])') \
      && [[ -n $new ]] || continue
    ru_state=$new
    pass_ci_msg+=("pass: CI is enabled and runscaler runs: STOP $s of ${fams// /, } is cleared")
  done
}
# what the pass does on its verdicts, in order
pass_act() {
  local now=$1
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  pass_keep $now
  pass_delete $now
  pass_retired
  pass_r1 $now
  pass_connect_retry $now
  # which release each family may switch to, or why not: bin/runner-updater-release (its header: THE PASS HOOK). A
  # window of this pass read another config (its backup): the config and the families are read again first
  source $RELBIN/runner-updater-release || refuse "cannot load $RELBIN/runner-updater-release"
  if ru_config && ru_families; then
    rl_pass $now
    pass_recipe
    pass_switch $now
  else
    say "pass: no family is checked for a release: $REPLY"; pass_rc=1
  fi
  write_protected $now   # what the pass changed (an accept, a deletion, a window's close) is in the list
}
# THE RECIPE STOPs (PLAN D2 :143): NO BASELINE and recipe changed, as rl_pass decided them for a family with no
# candidate (rl_rstop: the STOP, or "" none; rl_rtext: its text), are HELD, so status shows them with `rebuild FAMILY`;
# each replaces the family's other one. A family with a candidate holds neither (a rebuild's candidate: its ACCEPT
# writes the baseline). A STOP it holds anew: the pass exits 1
pass_recipe() {
  local f j="{}" new
  for f in ${(k)rl_rstop}; do
    j=$(print -r -- $j | $JQ -c --arg f $f --arg s "$rl_rstop[$f]" --arg t "$rl_rtext[$f]" '.[$f] = {s: $s, t: $t}') \
      || { say "pass: jq could not read the recipe STOPs"; pass_rc=1; return }
  done
  new=$(print -r -- $ru_state | $JQ -r --argjson d $j '[.families | to_entries[] | .key as $f | select(($d[$f].s // "") != "")
          | select(any((.value.stops // [])[]; .stop == $d[$f].s) | not) | "pass: \($f) holds STOP \($d[$f].s)"] | .[]') \
    || { say "pass: jq could not read the recipe STOPs"; pass_rc=1; return }
  change_state '.families |= with_entries(.key as $f | .value |= (
      def recipe: .stop == "NO BASELINE" or .stop == "recipe changed";
      if .candidate != null then .stops = [(.stops // [])[] | select(recipe | not)]
      elif $d | has($f) then
        ([(.stops // [])[] | select(recipe and .stop == $d[$f].s and .detail.text == $d[$f].t)] | first) as $same
        | .stops = [(.stops // [])[] | select(recipe | not)]
          + (if $d[$f].s == "" then [] elif $same != null then [$same]
             else [{family: $f, stop: $d[$f].s, version: null, user: null, detail: {text: $d[$f].t}}] end)
      else . end))' --argjson d $j
  [[ -z $new ]] || { print -r -- ${(F)${(f)new}/#/runner-updater: }; pass_rc=1 }
}
# DUE -> THE SWITCH WINDOW (bin/runner-updater-window, ru_window FAMILY V SHA idle SINCE pass): rl_pass's due families
# (rl_due: "FAMILY V SHA RECIPE", families-file order). ONE window per pass (pass_windowed: an R1 rollback or a due
# family's switch opened a window journal; a call that ended before its journal, not now or a STOP, leaves the window
# to the next family), and only when no window journal is open. SINCE (D5 NO IDLE, 3 days from eligibility): the
# first pass that found the family due for that version, kept in the state (`due`: {version, since}); the window gets
# EPOCHSECONDS less how long that is by the pass's clock. `due` stays while the family is not due (held by a STOP) and
# while the updater is OFF: those days count, so the first "not now" after them can be NO IDLE at once (the plan's 3
# days from eligibility). A family with a candidate has no `due`
pass_switch() {
  local now=$1 d f v s since rc j="{}"
  local -a w
  for d in $rl_due; do
    w=(${=d})
    j=$(print -r -- $j | $JQ -c --arg f $w[1] --arg v $w[2] '.[$f] = $v') || { say "pass: jq could not record the due families"; pass_rc=1; return }
  done
  change_state '.families |= with_entries(.key as $f | .value |= (
      if .candidate != null then del(.due)
      elif $d | has($f) then (if .due.version == $d[$f] then . else .due = {version: $d[$f], since: $now} end)
      else . end))' --argjson d $j --argjson now $now
  for d in $rl_due; do
    w=(${=d}) f=$w[1] v=$w[2] s=$w[3]
    if (( pass_windowed )); then say "pass: $f: one window per pass: the next pass switches it to $v"; continue; fi
    [[ ! -e $WINDOW && ! -L $WINDOW ]] || { say "pass: $f: a window journal is open ($WINDOW): no switch; the next pass's RECOVER ends it"; continue }
    (( ${BUILDERS[(Ie)$f]} )) || { say "pass: $f: no builder wired for it: no switch"; continue }
    since=$(print -r -- $ru_state | $JQ -r --arg f $f '.families[$f].due.since // empty')
    [[ $since =~ '^[0-9]+$' ]] && (( since <= now )) || since=$now
    ru_window $f $v $s idle $(( EPOCHSECONDS - (now - since) )) pass $w[4]
    rc=$?
    (( ru_w_began )) && pass_windowed=1
    case $rc in
      (0) say "pass: switched $f to $ru_w_out (runner $v)" ;;
      (2) ;;   # not now: the window said why; nothing changed
      (*) pass_rc=1 ;;
    esac
  done
}
# R1 -> THE ROLLBACK WINDOW (bin/runner-updater-window, ru_rollback FAMILY REASON SINCE): each family whose R1 says
# rollback, in r1's order, with ONE window per pass (pass_windowed: set only by a call that opened a window journal,
# ru_w_began; a call that ended before it, pending or a STOP, leaves the pass's window to the next family). REASON:
# r1's verdict of the family {set, failures, connect_only, reason}. SINCE (the 2-h bound): the window measures it with
# its own clock, so it gets EPOCHSECONDS less how long the verdict has held by the pass's clock (now - r1_since). THE
# BOUND COUNTS ONLY TIME A TRY COULD START (S3b-4b r1 P1-1): a family that waits behind another family's window, or
# whose call found CI disabled by a person or a pending hand edit (ru_rb_nocount), has its r1_since removed, so the
# next pass that sees the verdict starts the 2 h anew; `off` removes it too (time while OFF never counts); a pass that
# found the updater lock held ends before this (that time counts). A family that holds ROLLBACK FAILED starts none
# (`retry FAMILY` clears it). Returns: 0 rolled back; 1 a STOP or a REFUSE; 2 pending (R1 stays armed: the next pass
# calls again); 3 the journal stays open (the next pass's RECOVER ends it)
pass_windowed=0 pass_rc=0
pass_r1() {
  local now=$1 f since verdict rc
  for f in ${(f)"$($JQ -r '(.families // {}) | to_entries[] | select(.value.verdict == "rollback") | .key' \
                   $PASSDIR/r1.json)"}; do
    if (( pass_windowed )); then
      say "pass: $f: R1's rollback is due; one window per pass: the next pass starts it (its 2 h start then)"
      change_state '.families[$f] |= del(.r1_since)' --arg f $f
      continue
    fi
    ru_rb_state $f || { say "pass: $f: R1's rollback is due, but $REPLY"; pass_rc=1; continue }
    if (( ru_rb_rf )); then
      say "pass: $f: R1's rollback is due, but ROLLBACK FAILED holds it: \`runner-updater retry $f\`"
      continue
    fi
    since=$(print -r -- $ru_state | $JQ -r --arg f $f '.families[$f].r1_since // empty')
    [[ $since =~ '^[0-9]+$' ]] && (( since <= now )) || since=$now
    verdict=$($JQ -c --arg f $f '.families[$f] | {set, failures, connect_only, reason}' $PASSDIR/r1.json) \
      || { say "pass: $f: jq could not read R1's verdict: no rollback"; pass_rc=1; continue }
    ru_rollback $f "$verdict" $(( EPOCHSECONDS - (now - since) ))
    rc=$?
    (( ru_w_began )) && pass_windowed=1
    if [[ -n $ru_rb_nocount ]]; then   # no try could start: the 2 h start at the next pass that sees the verdict
      change_state '.families[$f] |= del(.r1_since)' --arg f $f
      say "pass: $f: no try of R1's rollback could start (${${ru_rb_nocount:#hand}:+CI disabled by a person}${${ru_rb_nocount:#flag}:+a pending hand edit}): its 2 h start at the next pass that can try"
    fi
    case $rc in
      (0) say "pass: rolled back $f: it runs $ru_w_rbt again" ;;
      (2) ;;   # pending: ru_rb_window said why; the next pass calls again while R1's verdict holds
      (*) pass_rc=1 ;;
    esac
  done
}
# PINNED RUNNER RETIRED (PLAN D6 "on the candidate: STOP PINNED RUNNER RETIRED, no restart"; D7: the candidate closed,
# the version rejected, a newer release proceeds alone; S3b-4b r1 P2-2): R1's verdict `stop` for a family whose evidence
# holds PINNED RUNNER RETIRED (GitHub refuses the candidate's runner version). No window and no restart: the config still
# names the candidate's image (golden-prune keeps a configured image). The pass holds the STOP (the candidate's version,
# r1's reason; one of the same version is replaced), closes the candidate (its observation STOPs, JOBS FAIL ON THE NEW
# IMAGE and NO EVIDENCE, go with it) and adds the version to rejected, so a newer release is due alone. `previous` stays
# in the state, no longer protected (no candidate and no back_until, so `back` refuses); the family's next switch window
# replaces it with its own old image (the retired one: the residual named in the header, PLAN D5 FAMILY LINES) and
# deletes nothing (it supersedes only a keep: bin/runner-updater-window, ru_w_close). The STOP clears itself when a newer
# version's switch window closes switched (ru_w_close; PLAN D7, 11-04); a window that goes back to its backup leaves it.
# Another verdict `stop` (SHIM REFUSED) keeps the candidate (D7: not closed). A STOP it holds anew: the pass exits 1
pass_retired() {
  local l f v r
  for l in ${(f)"$($JQ -r '(.families // {}) | to_entries[] | select(.value.verdict == "stop")
                   | (first((.value.stops // [])[] | select(.stop == "PINNED RUNNER RETIRED")) // null) as $s
                   | select($s != null) | "\(.key)\t\($s.reason // "" | gsub("[\t\n]"; " "))"' $PASSDIR/r1.json)"}; do
    f=${l%%$'\t'*} r=${l#*$'\t'}
    v=$(print -r -- $ru_state | $JQ -r --arg f $f '.families[$f].candidate.version // empty')
    [[ -n $v ]] || continue
    change_state '.families[$f] |= (.candidate.version as $v | .candidate = null
        | .rejected = (((.rejected // []) + [$v]) | unique)
        | .stops = [(.stops // [])[] | select(.stop != "JOBS FAIL ON THE NEW IMAGE" and .stop != "NO EVIDENCE")
                                     | select((.stop == "PINNED RUNNER RETIRED" and .version == $v) | not)]
          + [{family: $f, stop: "PINNED RUNNER RETIRED", version: $v, user: null, detail: {reason: $r}}])' \
      --arg f $f --arg r $r
    say "pass: $f holds STOP PINNED RUNNER RETIRED (runner $v): the candidate is closed with no restart, and runner $v is rejected: a newer release is due alone"
    pass_rc=1
  done
}
# CONNECT-ONLY's ONE RETRY (PLAN D6 :320): a ROLLED BACK of version V whose failures were all connect-class rejected
# nothing, and it holds V (rl_stop: it is of the eligible release). When the state counts exactly one connect-only
# rollback of V (the family's `connect_only`: {V: {n, at}}) and it is 1 h old or more by the pass's clock, the pass
# removes that STOP: V may be due again, once. The count stays (`retry` never resets it), so the next connect-only
# rollback of V is the second: it rejects V (ru_rb_state), counts 2, and its ROLLED BACK stays
typeset -g pass_co_retry='def co_retry($c; $now): .stop == "ROLLED BACK" and .detail.connect_only == true
  and (.version | type) == "string" and ($c[.version].n // 0) == 1 and $now - $c[.version].at >= 3600;'
pass_connect_retry() {
  local now=$1 out l
  out=$(print -r -- $ru_state | $JQ -r --argjson now $now "$pass_co_retry"' .families | to_entries[] | .key as $f
          | .value | (.connect_only // {}) as $c | (.stops // [])[] | select(co_retry($c; $now)) | "\($f) \(.version)"') \
    || { say "pass: jq could not read the connect-only rollbacks"; pass_rc=1; return }
  [[ -n $out ]] || return 0
  change_state "$pass_co_retry"' .families |= map_values((.connect_only // {}) as $c
      | .stops = [(.stops // [])[] | select(co_retry($c; $now) | not)])' --argjson now $now
  for l in ${(f)out}; do
    say "pass: ${l%% *}: its connect-only rollback of runner ${l#* } was 1 h ago or more: the one retry of ${l#* } may start (a second rollback rejects it)"
  done
}
# KEEP's verdicts (core/keep.jq; PLAN D6 :324, :330), per family:
#   accept       ACCEPT: the family's recipe baseline = its candidate's recipe (the one its window built with; a
#                candidate with none keeps the baseline: D2 :143), back_until = now + 7 days, the candidate cleared,
#                `previous` kept until back_until (the protected list keeps it, `back` restores it), a held NO
#                EVIDENCE gone (it healed), and the pin by D2's ONE RULE (pass_pin)
#   jobs-fail    STOP JOBS FAIL ON THE NEW IMAGE of the candidate's version, held once, with the job counts (its
#                status line: `back FAMILY` until the keep date, or `retry FAMILY` to keep it); the candidate stays
#   no-evidence  STOP NO EVIDENCE of the candidate's version, held once; it heals itself: a later success accepts
# A STOP it holds anew: the pass exits 1
# THE ACCEPT, ONE copy (accept_jq: KEEP's accept here, and `retry FAMILY` on a JOBS FAIL ON THE NEW IMAGE of the
# candidate, which IS the person's ACCEPT: PLAN D7, 11-04): on one family, at $now
typeset -g accept_jq='def accept($now): .recipe = (.candidate.recipe // .recipe) | .back_until = $now + 604800
  | .candidate = null | .stops = [(.stops // [])[] | select(.stop != "NO EVIDENCE")];'
pass_keep() {
  local now=$1 f l v
  for l in ${(f)"$($JQ -r '(.families // {}) | to_entries[]
                   | select(.value.verdict == "accept" or .value.verdict == "jobs-fail" or .value.verdict == "no-evidence")
                   | "\(.key) \(.value.verdict)"' $PASSDIR/keep.json)"}; do
    f=${l%% *} v=${l#* }
    case $v in
      (accept)
        change_state "$accept_jq"' .families[$f] |= accept($now)' --arg f $f --argjson now $now
        say "pass: accepted $f: $($JQ -r --arg f $f '.families[$f].reason' $PASSDIR/keep.json); \`runner-updater back $f\` restores $(print -r -- $ru_state | $JQ -r --arg f $f '[(.families[$f].previous // {})[]] | unique | join(", ")') until $(strftime '%Y-%m-%d %H:%M UTC' $(( now + 604800 )))"
        pass_pin $f ;;
      (jobs-fail|no-evidence)
        local name=${${v:#jobs-fail}:+NO EVIDENCE}${${v:#no-evidence}:+JOBS FAIL ON THE NEW IMAGE} held
        held=$(print -r -- $ru_state | $JQ -r --arg f $f --arg s $name '.families[$f] as $x
                 | any(($x.stops // [])[]; .stop == $s and .version == ($x.candidate.version // null))') || held=true
        [[ $held == false ]] || continue
        change_state '.families[$f] |= (.candidate.version as $cv | .stops = (.stops // []) + [{family: $f, stop: $s,
              version: $cv, user: null, detail: ({text: $k.reason}
                + (if $s == "JOBS FAIL ON THE NEW IMAGE" then {counts: {completions: $k.completions,
                     succeeded: $k.succeeded, failed: $k.failed, canceled: $k.canceled}} else {} end))}])' \
          --arg f $f --arg s $name --argjson k "$($JQ -c --arg f $f '.families[$f]' $PASSDIR/keep.json)"
        say "pass: $f holds STOP $name: $($JQ -r --arg f $f '.families[$f].reason' $PASSDIR/keep.json) (\`runner-updater status\` names its next step)"
        pass_rc=1 ;;
    esac
  done
}
# D2's ONE RULE after an ACCEPT (no window journal closes there): FAMILY's pin names the version of the image the
# family's lines name in the config (the state's image record, else golden-build's log: ru_w_version), its sha the
# pin's own for that version, else the release literal's or the family's closed journals' (ru_w_sha_for); none known:
# the pin is removed. A pin it writes or removes is journaled first in ACTIONS (`pin-write FAMILY V SHA`, `pin-remove
# FAMILY`); a pin that is that already is left. Only a family with a builder has a pin. The family's sets are the
# families file's (ru_fam): a pass read it with its facts; `retry` did not, so it is read here (S3b-4b r2 P2-1: with no
# lookup the family named no set, its version read as not known, and a right pin was removed); a file it cannot read:
# the pin stays. Its lines name the command that runs it ($cmd: pass, retry)
pass_pin() {
  local f=$1 img= l v= sh= cur
  (( ${BUILDERS[(Ie)$f]} )) || return 0
  ru_w_fam=$f ru_w_out= ru_w_ver= ru_w_sha=
  ru_w_pin_read $f || { say "$cmd: $f: $REPLY: the pin stays (golden-build stops on it)"; pass_rc=1; return }
  cur=$REPLY ru_w_pinbefore=${REPLY:#none}
  if [[ ${(t)ru_fam-} != association* ]]; then
    ru_families || { say "$cmd: $f: $REPLY: the pin stays (its version is not decided)"; pass_rc=1; return }
  fi
  if ru_config; then
    for l in $ru_sets; do
      (( ${${(s: :)ru_fam[$f]-}[(Ie)$l]} && ${+ru_lines[$l]} )) || continue
      if [[ -z $img ]]; then img=$ru_lines[$l]; elif [[ $img != "$ru_lines[$l]" ]]; then img='?'; fi
    done
  fi
  if [[ -n $img && $img != '?' ]] && ru_w_version $img; then v=$REPLY; ru_w_sha_for $v && sh=$REPLY; fi
  if [[ -n $v && -n $sh ]]; then
    [[ $cur != "$v $sh" ]] || return 0
    /bin/zsh -f $RELBIN/runner-journal $ACTIONS pin-write "$f $v $sh" \
      || { say "$cmd: $f: the action journal could not record the pin (above): the pin stays"; pass_rc=1; return }
    ru_w_pin_write $f "$v $sh" || { say "$cmd: $f: cannot write the pin $PINDIR/$f: $REPLY"; pass_rc=1; return }
    say "$cmd: the pin $PINDIR/$f: $v (the version of $img, which the config runs)"
  else
    [[ $cur != none ]] || return 0
    /bin/zsh -f $RELBIN/runner-journal $ACTIONS pin-remove $f \
      || { say "$cmd: $f: the action journal could not record the pin's removal (above): the pin stays"; pass_rc=1; return }
    /bin/rm -f -- $PINDIR/$f || { say "$cmd: $f: cannot remove the pin $PINDIR/$f"; pass_rc=1; return }
    say "$cmd: the pin $PINDIR/$f is removed: the version of what the family runs is not known; a hand golden-build uses the release literal"
  fi
}
# DELETION (PLAN D6 :332): after back_until (the pass's clock), a family's `previous` image is deleted by its recorded
# name: only when the state records it (its image record: an image the updater built or adopted; a person's image is
# never deleted), no non-comment line of the config names it, and no window journal is open (so no open window's
# backup names it); journaled first in ACTIONS (`delete NAME`), then `tart delete`. The family's previous and
# back_until go when each of its images is deleted, gone from tart's list, named by a config line (it is in use: no
# longer the updater's to keep) or not recorded; a delete that fails (or tart's list) keeps them for the next pass.
# Every family of the state, also one the families file no longer names. The protected list then drops it
pass_delete() {
  local now=$1 f img t cfg l named done_all
  local -a fams have cl
  fams=(${(f)"$(print -r -- $ru_state | $JQ -r --argjson now $now '.families | to_entries[]
                  | select(.value.candidate == null and .value.previous != null and .value.back_until != null
                           and $now >= .value.back_until) | .key')"})
  (( ${#fams} )) || return 0
  [[ ! -e $WINDOW && ! -L $WINDOW ]] || { say "pass: a window journal is open: no previous image is deleted"; return 0 }
  t=$(ru_tart list --source local -q 2>/dev/null) || { say "pass: tart list failed: no previous image is deleted (the next pass tries again)"; return 0 }
  have=(${(f)t})
  ru_w_bytes $CONFIG || { say "pass: cannot read $CONFIG: no previous image is deleted"; return 0 }
  cl=("${(@f)REPLY}")
  for f in $fams; do
    done_all=1
    for img in ${(f)"$(print -r -- $ru_state | $JQ -r --arg f $f '[(.families[$f].previous // {})[]] | unique | .[]')"}; do
      named=0
      for l in $cl; do
        [[ $l =~ '^[[:space:]]*#' ]] && continue
        [[ $l == *"$img"* ]] && { named=1; break }
      done
      if (( named )); then say "pass: $img stays: a line of $CONFIG names it (the previous image of $f; the updater keeps it no longer)"; continue; fi
      if ! print -r -- $ru_state | $JQ -e --arg i $img '(.images // {}) | has($i)' > /dev/null 2>&1; then
        say "pass: $img stays: the updater has no record of it (a person's image is never deleted)"; continue
      fi
      (( ${have[(Ie)$img]} )) || { say "pass: $img, the previous image of $f, is not on this host any more"; continue }
      if ! /bin/zsh -f $RELBIN/runner-journal $ACTIONS delete $img; then
        say "pass: the action journal could not record the delete of $img (above): it stays"; done_all=0; continue
      fi
      if ru_tart delete $img > /dev/null 2>&1; then
        say "pass: deleted $img (the previous image of $f, kept for \`back\` until $(strftime '%Y-%m-%d %H:%M UTC' $(print -r -- $ru_state | $JQ -r --arg f $f '.families[$f].back_until')))"
      else
        say "pass: cannot delete $img (tart delete failed): the next pass tries again"; done_all=0
      fi
    done
    (( done_all )) && change_state '.families[$f] |= (.previous = null | .back_until = null)' --arg f $f
  done
}

[[ $cmd == status ]] && do_status

# ---- report's arguments
ru_observe_add=() ru_observe_clear=()
while (( $# )); do
  case $1 in
    (--observe|--observe-clear)
      (( $# >= 2 )) || usage "$1 needs a FAMILY"
      [[ $2 =~ '^[a-z][a-z0-9-]{0,40}$' ]] || usage "not a family name: '$2'"
      if [[ $1 == --observe ]]; then ru_observe_add+=($2); else ru_observe_clear+=($2); fi
      shift 2 ;;
    (*) usage "unknown argument '$1'" ;;
  esac
done
for f in $ru_observe_add; do (( ${ru_observe_clear[(Ie)$f]} == 0 )) || usage "--observe and --observe-clear of $f"; done
ru_observe_add=(${(u)ru_observe_add}) ru_observe_clear=(${(u)ru_observe_clear})

# ---- the state folder (see the header). STATEDIR and its empty list come into being in ONE step, a rename. They are
# made as NEW/runner-updater/protected (MADE = NEW/runner-updater), in a new folder NEW beside STATEDIR, and
# `mv -n MADE PARENT/` gives MADE its name. With a folder as its last operand, mv's destination is PARENT/runner-updater,
# STATEDIR itself, so nothing can nest. When another report made STATEDIR first, nothing moves: -n leaves an existing
# STATEDIR as it is, and rename(2) does not replace a folder that holds a file. One command per line: the tests kill
# a copy before each one in turn.
if [[ ! -e $STATEDIR && ! -L $STATEDIR ]]; then
  /bin/mkdir -p -- ${STATEDIR:h} || refuse "cannot create ${STATEDIR:h}"
  new=$(/usr/bin/mktemp -d $STATEDIR.new.XXXXXXXX) || refuse "cannot create a new folder beside $STATEDIR"
  made=$new/${STATEDIR:t}
  /bin/mkdir -m 700 -- $made || { /bin/rmdir -- $new; refuse "cannot create $made" }
  : > $made/protected || { /bin/rmdir -- $made $new; refuse "cannot create the empty protected list $made/protected" }
  /bin/mv -n -- $made ${STATEDIR:h}/ 2> /dev/null
  if [[ -e $made ]]; then   # not moved: another report made STATEDIR, and its list stays as it is
    /bin/rm -f -- $made/protected
    /bin/rmdir -- $made
  else
    say "created $STATEDIR, with an empty protected list $PROTECTED (it protects nothing)"
  fi
  /bin/rmdir -- $new
fi
[[ -d $STATEDIR && ! -L $STATEDIR ]] || refuse "$STATEDIR is not a folder"
# the list: protect and pass write it from the state, so they go on without one; the others refuse with how to get it
# back without emptying it (an empty list in place of a lost one would let golden-prune print an image the updater
# keeps)
if [[ $cmd != (protect|pass) ]]; then
  back="\`$INVOKED protect\` writes it from the updater's state (a pass does too, while the updater is ON); then run $cmd again"
  if [[ ! -e $PROTECTED && ! -L $PROTECTED ]]; then
    refuse "$STATEDIR has no protected list $PROTECTED, and golden-prune refuses until it has one. Do not create it empty: it lists the images the updater keeps. $back"
  fi
  [[ -f $PROTECTED && ! -L $PROTECTED && -r $PROTECTED ]] \
    || refuse "$PROTECTED is not a readable regular file, and golden-prune refuses it too. Do not make it an empty file: it lists the images the updater keeps. Look at what it is and move it aside, then $back"
fi

# ---- 1. the updater lock, held by THIS process until it exits: never redirect to LOCKFILE or print to its fd here.
# REPORT is made only under it: two reports that found no REPORT would race to make it.
zmodload zsh/system || refuse "zsh/system cannot be loaded: the lock cannot be taken"
[[ -e $LOCKFILE ]] || ( : >> $LOCKFILE ) || refuse "cannot create the lock file $LOCKFILE"
if [[ $cmd == pass ]]; then   # a timer pass TRIES the lock: held (2), and it ends at once
  zsystem flock -t 0.01 -f lockfd $LOCKFILE 2> /dev/null
  rc=$?
  (( rc != 2 )) || { say "pass: another run holds the updater lock; this pass ends"; exit 0 }
  (( rc == 0 )) || refuse "cannot take the updater lock $LOCKFILE"
else
  zsystem flock -f lockfd $LOCKFILE || refuse "cannot take the updater lock $LOCKFILE"
fi
case $cmd in
  (pass) do_pass ;;
  (on) do_on ;;
  (off) do_off ;;
  (protect) do_protect ;;
  (rebuild|switch-now) do_window ;;
  (back) do_back ;;
  (retry) do_retry ;;
esac
[[ -d $REPORT ]] || /bin/mkdir -m 700 $REPORT || refuse "cannot create $REPORT"

# ---- 2. the jq
jq_tested

# ---- 3. the facts
now=$(/bin/date -u +%s)
[[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
pass=$REPORT/pass
[[ -d $pass ]] || /bin/mkdir -m 700 $pass || refuse "cannot create $pass"
[[ -e $REPORT/state.json ]] || : > $REPORT/state.json || refuse "cannot create $REPORT/state.json"
/bin/cp -f -- $REPORT/state.json $pass/state.json || refuse "cannot copy the state into $pass"
/bin/rm -f -- $pass/{idle,r1,keep,status}.json
say "report: one pass at $(strftime '%Y-%m-%d %H:%M:%S UTC' $now) ($now); it takes no action"
ru_collect $pass $REPORT/state.json $REPORT/observe.json $now || refuse "no facts: $REPLY"

# ---- 4, 5. the core
run_core $pass $REPORT/state.json $now
/bin/mv -f -- $pass/state.json $REPORT/state.json || refuse "cannot write $REPORT/state.json"
exit 0
