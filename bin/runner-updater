#!/bin/zsh -f
# runner-updater status | on | off | pass | protect | rebuild FAMILY | switch-now FAMILY
#                | report [--observe FAMILY]... [--observe-clear FAMILY]...
# The runner-image updater on the Studio, as ci. Design: docs/operations.md ("The updater: status, on, off, pass,
# protect", "The switch window: rebuild and switch-now" and "The updater's report mode (no action)"); the decision
# core's contract: core/README.md. Only `rebuild` and `switch-now` act on CI: each runs ONE switch window
# (bin/runner-updater-window: it disables CI, builds, edits config.toml and enables CI). Nothing in this release rolls
# back or deletes an image, and a pass takes no action. Every other write is under STATEDIR (the state, the pins, the
# protected list, the journals, the pass folders). RECOVER (bin/runner-updater-window, ru_recover) ends an interrupted
# window first: it disables, restores the config and enables CI as the window's journal says (below, RECOVER FIRST).
#
# THE STATE, STATE (STATEDIR/state.json): ONE JSON object, written by rename (STATE.new, then a rename over STATE), read
# under the updater lock (status alone reads it with no lock: ONE read, so a rename while it runs gives it the old or
# the new state, whole). A missing STATE is a fresh install: OFF, no family, nothing held; but beside a protected
# list that is not an empty regular file it is a LOST state (the updater writes a name into the list only from a
# state): every command that reads the state refuses, and writes nothing. Its members:
#   format     1. A state of another format (or none): every command prints "runner-updater: WAIT ..." and exits 4,
#              and nothing is written. A state of format 1 that is not the shape below: REFUSE, exit 1, left as it is.
#   on         true | false (D11: a fresh install is OFF)
#   families   {FAMILY: {
#                candidate   {version: "N.N.N", lines: {SET: IMAGE, ...}, closed_at: EPOCH} | null: the release under
#                            observation (switched, not accepted; closed_at = when its switch window closed)
#                previous    {SET: IMAGE, ...} | null: the lines the family ran before its candidate: the rollback
#                            target until ACCEPT, then what `back` restores until back_until
#                back_until  EPOCH | null: after an ACCEPT, the end of the 7 days `back` restores `previous`
#                rejected    ["N.N.N", ...]: the versions the updater never switches this family to again
#                recipe      "<sha256>" | null: the recipe baseline; null = NO BASELINE
#                stops       [{family: FAMILY, stop: NAME, version, user, detail}]: the STOPs it holds
#                            (core/README.md, facts.stops)}}
#              absent members read as null or [].
#   images     {IMAGE: "N.N.N"}: each image the updater built or adopted, and its runner version (D2's pin rule)
#   core       the decision core's own state (the `state` that idle.jq and r1.jq return) | absent: a fresh core.
#              report's core state is apart from it, in REPORT.
#   restart    {from: {pid, start}, to: {pid, start}, stopped: {inode: "N", offset: N, sha}} | absent: the switch
#              window's own restart of runscaler (bin/runner-updater-window, THE OWN RESTART), kept for the next pass,
#              which passes it to the core as facts.restart once and then removes it.
#   A MEMBER THIS RELEASE DOES NOT READ (at the top, in a family, in a candidate or in a STOP): every command WAITs
#   (exit 4), names it, and writes nothing. A later member that names an image or holds a STOP needs this rule: an
#   older release (a rollback across one) then waits, and never writes a shorter protected list or prints a status that
#   hides a STOP. So a later release may add such a member under format 1.
#
# COMMANDS. Every command but status holds the updater lock, LOCKFILE (zsh's zsystem flock, held by this process
# until it exits): a command waits for it; a pass (the timer's) only tries it.
#   status   no lock, and it writes no file anywhere (the core gets its inputs through pipes). It reads STATE once
#            and calls status.jq with facts from it (each family's candidate and back_until, the STOPs it holds) and
#            its core state; a status.jq that does not decide is a STOP. It prints ON or OFF; each family: its candidate
#            or "no candidate", back_until, its rejected versions; an open window journal; each family of BUILDERS in
#            the state: its host pin (`host pin V`, or none: D2's ONE RULE removes a pin whose version is not known);
#            status.jq's verdict and lines (the STOP lines with their next step, the evidence lines, each back_until);
#            and per STOP its D7 properties, `known false` and "unknown" for a STOP this core does not know (never
#            guessed). With no STATEDIR it creates nothing.
#   on       sets on = true. It refuses, and changes nothing, a warm pool (PLAN D6): a set of the families file that the
#            config has, with a [tart] pool-size > 0 or a pool-size line the lib does not read (ru_pools); so it also
#            refuses a config or families file it cannot read (it cannot check them).
#   off      runs RECOVER first; refuses while WINDOW still exists (an open window's journal: off never strands a
#            window), and then changes nothing. Else it sets on = false, then removes every file of PINDIR (golden-build's host pins), each one
#            journaled FIRST with runner-journal into ACTIONS (`pin-remove NAME VERSION SHA256`, or `pin-remove NAME
#            (not one line VERSION SHA256)`): a journal it cannot write is a STOP before that removal (the pin stays;
#            run off again). A PINDIR entry that is not a file, a PINDIR that is not a folder, or one it cannot read and
#            search (it would list as empty): STOP, and the pins stay.
#   pass     the timer's entry (its LaunchAgent comes later). It TRIES the lock: held, "another run holds the
#            updater lock", exit 0 at once. Then RECOVER FIRST (below), even while OFF. OFF: "the updater is OFF", exit 0
#            (1 when RECOVER held a STOP) at once, no core call. ON: the jq check
#            (as report's step 2), then the facts (ru_collect, with each family's candidate and back_until and the
#            STOPs from the state, never --observe's; facts.restart = the state's `restart` member) into PASSDIR,
#            idle / r1 / keep / status (report's steps 4 and 5, on the core state of the state's `core` member), then
#            the new core state written into STATE by rename (the `restart` member removed in the same write: it is
#            passed once),
#            then the protected list rewritten (as protect), then what it WOULD do: "would roll back FAMILY" (r1),
#            "would accept FAMILY", "would hold FAMILY: STOP JOBS FAIL ON THE NEW IMAGE" or "... STOP NO EVIDENCE"
#            (keep). It does none of it. A program that could not decide: STATE and the list stay as they were.
#   protect  writes the protected list PROTECTED from the state (bin/runner-updater-lib, ru_protect: each family's
#            candidate; its `previous` while it has a candidate and until back_until; an open window's `image NAME`
#            lines), by rename, after a sync to disk (DD): one image name per line, the format golden-prune reads.
#            A list it cannot write: STOP, the old list stays. It is how to get a lost list back without emptying it,
#            so it and pass run when the list is missing or is not a readable regular file.
#   report   one pass that measures, asks the core and prints, with its own state (below).
#   rebuild FAMILY     ONE switch window (bin/runner-updater-window, ru_window: its header has the order, the journal
#            and the STOPs) that builds FAMILY's CURRENT runner version anew: the version of the image its sets run
#            (the state's image record, else the version golden-build's log printed for it; else REFUSE), its sha256
#            the host pin's or the release literal's (else REFUSE), with the idle pair. It is the D10 rehearsal and the
#            recipe baseline's path. Only the families of BUILDERS have a builder wired: another is "no builder wired".
#   switch-now FAMILY  the same window with no idle pair (D5 NO IDLE's override), and it says so; its release is the
#            one FAMILY's NO IDLE STOP holds (its version and sha256), else FAMILY's current version (as rebuild).
#            Both refuse while the updater is OFF. Their release is due from now, so they never raise NO IDLE (a pass
#            of a later release gives ru_window the release's eligibility date). Exit 0 switched (the window closed on
#            the new image), 1 a STOP or a REFUSE, 5 not now (START STATE or IDLE: nothing changed).
# RECOVER FIRST: an open window journal (WINDOW) that no run holds (the window holds the updater lock for its whole run,
# so a run that took the lock and finds one found an interrupted window): pass, rebuild, switch-now, on and off end it
# first with RECOVER (bin/runner-updater-window's header, "RECOVER"), after the state is loaded and before the jq check
# (it needs no tested jq). It closed: the command goes on; a pass whose RECOVER held a STOP exits 1. It stays open (CI
# DISABLED, a person's file that fails validate, a journal it cannot read, a state it cannot write): STOP, exit 1, and
# nothing else starts. status only names it (no lock); report takes no action and runs no RECOVER; protect writes the
# list (it reads an open journal's names) and runs no RECOVER.
#
# REPORT: ONE pass that measures, asks the decision core (core/) and prints. It TAKES NO ACTION: it stops, starts,
# edits, pins, deletes and enables nothing, and it runs none of runner-disable, runner-enable, golden-build,
# golden-gate, tart, launchctl or kill. The pass, in order:
#   1. The updater lock. A second report WAITS for it.
#   2. The jq it runs (JQ) must print a `jq --version` that core/TESTED_JQ lists for the area `core`. Else the STOP
#      "untested jq" and exit 3: no core program runs. (status checks it too.)
#   3. now = the UTC clock (date -u +%s). The facts (bin/runner-updater-lib, ru_collect: its header says what each
#      fact is and the order they are read in) go into the pass folder REPORT/pass: facts.json, log.txt, healthz.json.
#      A fact it cannot read: a REFUSE line, exit 1, no core program runs.
#   4. idle.jq, r1.jq, keep.jq and status.jq run with the same five inputs (state, facts, log, healthz, --arg now). The
#      state is the pass's copy, REPORT/pass/state.json, written back by rename after idle and after r1, so a later
#      program reads it. Only when all four decided is it renamed to REPORT/state.json, the report's state; a program
#      that exits non-zero, or prints no JSON object with a verdict: "runner-updater: core could not decide
#      (PROGRAM)", exit 1, and REPORT/state.json stays as it was (the pass did nothing). Each program's output stays in
#      REPORT/pass/PROGRAM.json.
#   5. It prints each program's verdict and reason (r1 and keep: each family's too), then status.jq's lines.
# --observe FAMILY: from this pass on, FAMILY's CURRENT config lines are its candidate (version "observed", closed_at =
# this pass's now), in REPORT/observe.json, until `report --observe-clear FAMILY`. A family already observed keeps its
# record. Repeat the option for more families.
#
# THE STATE FOLDER. When STATEDIR does not exist, every command but status creates it with an EMPTY (0-byte) protected
# list in it: golden-prune reads an existing STATEDIR as "the updater is on this host" and refuses without a protected
# list, and an empty list protects nothing, so golden-prune prints what it printed before.
# The folder (0700) and its list (0600) come into being in ONE step, a rename, so a kill at any point leaves no
# STATEDIR or STATEDIR with its list; a kill before the rename can leave the new folder beside STATEDIR,
# runner-updater.new.XXXXXXXX, which nothing reads (remove it). Two runs that both find no STATEDIR: one makes it,
# and the other leaves it as it is. A STATEDIR without its list is a REFUSE (report, on, off) that says what to do, and
# so is a list that is not a readable regular file: never an empty list, which in place of a lost one would let
# golden-prune print an image the updater keeps, but `protect`, which writes it from the state. REPORT is made under
# the lock.
# A folder on the path to STATEDIR's files (STATEDIR, or one above it) that exists but cannot be searched: every
# command, status too, refuses before it reads anything (the lib's ru_reach, ONE rule): behind it the state would read
# as fresh (OFF), the list as missing and a pin as absent.
# Exit: 0 done; 1 a REFUSE (the state folder or its list, a state it does not read, a fact it cannot read, an --observe
# it cannot do, off while a window is open) or a STOP (a write that failed, the core could not decide, a window's STOP,
# RECOVER's STOP or a journal it leaves open); 2 usage; 3 STOP untested jq; 4 WAIT (a state of another format, or with a member this release does
# not read); 5 not now (rebuild, switch-now). A pass that finds the lock held, or the updater OFF: 0.
# Constants:
#   RUNNER       runscaler, as runner-start execs it ("RUNNER run --config CONFIG" is the process it looks for)
#   CONFIG       runscaler's config; RUNLOG, runscaler's own log, is runner.log beside it (runscaler 0.9.5 writes it
#                there when the config sets no log-file; at 10 MiB it renames it to runner.log.1, one backup)
#   STATEDIR     the updater's state folder; in it: STATE (state.json, above); REPORT = report/ (report's own state and
#                pass folder); PASSDIR = pass/ (a pass's facts, log text, /healthz reads, core state copy and each
#                program's output); LOCKFILE = lock (the updater lock); PROTECTED = protected (golden-prune reads it);
#                PINDIR = pin/ (golden-build's host pins, one file per image family); WINDOW = window (the open
#                window's journal, S3b-3's: absent when no window is open); ACTIONS = actions (the updater's action
#                journal, written only through runner-journal)
#   FAMILIES     the host's families file (bin/runner-updater-lib, ru_families)
#   PATH         its own, set at the top (the system folders): it never depends on the caller's PATH, so the weekly
#                watchdog's `runner-updater status` over a non-interactive ssh runs it as the timer does
#   JQ PS CURL DD the tools it runs (each by its absolute path; DD syncs a file to disk before its rename); CORE, the
#                release's core/ beside this file's bin/; RELBIN, this file's bin/ (runner-updater-lib,
#                runner-updater-window, runner-journal, validate-class, and the tools the window runs: runner-disable,
#                runner-enable (this release's: it has --check), runner-start, golden-build, golden-gate, all of the same
#                release); INVOKED, this file as it was run (the refusal texts name it)
#   HEALTHZ_GAP  seconds between the two /healthz reads
#   the window's: FLAG (the agent's flag), REAL (tart), REALRUN, LOGDIR (golden-build's logs), TARTDIR (Tart's home:
#                its volume's free disk, TARTDIR/vms/IMAGE's size), BIN (the installed tools: the hand lines), LOCK (the
#                runner lock: the config edit holds it), DF DU, FLOOR_GIB (golden-build's floor), VALIDATE_GAP,
#                CLOSE_WAIT, CLOSE_POLL, MTIME_WAIT (seconds), WINDOWS (STATEDIR/windows: the closed journals, and each
#                window's folder ID.d), BUILDERS (the families whose builder is wired)
#   RECOVER's:   RECOVER_WAIT (its one bound, 75 min), RECOVER_POLL (seconds between its reads), LSOF (it reads every
#                open file of ci's processes; runner-lock-free sets the same)
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin   # its own, never the caller's (the watchdog runs status over ssh)
export LC_ALL=C
export TZ=UTC   # ps prints start times in TZ, and the lib reads them back in it; the core's clock is UTC
umask 077
RUNNER=/Users/ci/bin/runner
CONFIG=/Users/ci/.config/runner/config.toml
STATEDIR=/Users/ci/.local/state/runner-updater
FAMILIES=/Users/ci/.config/runner-updater/families
JQ=/usr/bin/jq
PS=/bin/ps
CURL=/usr/bin/curl
HEALTHZ_GAP=3
CORE=${0:A:h:h}/core
RUNLOG=${CONFIG:h}/runner.log
REPORT=$STATEDIR/report
LOCKFILE=$STATEDIR/lock
PROTECTED=$STATEDIR/protected
STATE=$STATEDIR/state.json
PASSDIR=$STATEDIR/pass
PINDIR=$STATEDIR/pin
WINDOW=$STATEDIR/window
ACTIONS=$STATEDIR/actions
DD=/bin/dd
RELBIN=${0:A:h}
INVOKED=${0:a}
# the switch window's (bin/runner-updater-window): the host's paths, and its bounds
FLAG=/Users/ci/.config/runner/enabled
REAL=/Users/ci/Applications/tart.app/Contents/MacOS/tart
REALRUN=/Users/ci/bin/real-run
LOGDIR=/Users/ci/Library/Logs/mac-runner
TARTDIR=/Users/ci/.tart
BIN=/Users/ci/bin
LOCK=/tmp/runner.lock
DF=/bin/df
DU=/usr/bin/du
# golden-build's free-disk floor (release-check: one value across the scripts)
FLOOR_GIB=200
VALIDATE_GAP=20     # seconds between two validate tries (the ONE VALIDATE RULE)
CLOSE_WAIT=600      # seconds the window waits for its target to run (D1: 10 min)
CLOSE_POLL=5        # seconds between two reads of that wait
MTIME_WAIT=10       # seconds the window waits for the clock to pass the config's mtime; further ahead: STOP
RECOVER_WAIT=4500   # seconds RECOVER waits (one bound, 75 min) for the window's tools, VMs and the runner lock
RECOVER_POLL=10     # seconds between two of RECOVER's reads in that wait
LSOF=/usr/sbin/lsof # RECOVER reads every open file of ci's processes with it (as runner-lock-free does)
WINDOWS=$STATEDIR/windows
BUILDERS=(mac-golden)   # the families whose builder is wired (mac-golden: golden-build)

say() { print -r -- "runner-updater: $*" }
refuse() { print -r -- "runner-updater: REFUSE $*"; exit 1 }
stop() { print -r -- "runner-updater: STOP $*"; exit 1 }
usage() {
  print -u2 -r -- "runner-updater: usage: runner-updater status | on | off | pass | protect | rebuild FAMILY | switch-now FAMILY | report [--observe FAMILY]... [--observe-clear FAMILY]...${1:+ ($1)}"
  exit 2
}

# ---- arguments
(( $# >= 1 )) || usage "no command"
cmd=$1
shift
case $cmd in
  (status|on|off|pass|protect) (( $# == 0 )) || usage "$cmd takes no argument" ;;
  (rebuild|switch-now)
    (( $# == 1 )) || usage "$cmd takes one FAMILY"
    [[ $1 =~ '^[a-z][a-z0-9-]{0,40}$' ]] || usage "not a family name: '$1'"
    family=$1
    shift ;;
  (report) ;;
  (*) usage "unknown command '$cmd'" ;;
esac
source $RELBIN/runner-updater-lib || refuse "cannot load $RELBIN/runner-updater-lib"
# every folder on the path to STATEDIR's files must be one it can search (the lib's ru_reach), before any command reads
# one: behind a folder it cannot search, the state would read as fresh (OFF), the list as missing, a pin as absent
ru_reach $STATE || refuse "$REPLY, so the files in $STATEDIR would look absent (a state as a fresh one: OFF). Look at its mode (ci must be able to search it), then run $cmd again"

# the state, under the lock (status: with no lock, ONE read) -> ru_state; WAIT (exit 4) on a state of another format
# or with a member this release does not read, REFUSE on one it does not read, and on a missing state beside a list
# that is not empty (a lost state): in each case nothing is written
load_state() {
  ru_state_load $STATE
  case $? in
    (0) ;;
    (2) print -r -- "runner-updater: WAIT $REPLY"; exit 4 ;;
    (*) refuse "$REPLY: it is left as it is" ;;
  esac
  # a missing state is fresh, but the updater writes a name into the list only from a state: a list that is not an
  # empty regular file says a state existed and is lost, and a fresh state would drop what the list protects
  if (( ru_state_absent )) && [[ -e $PROTECTED || -L $PROTECTED ]] \
     && ! [[ -f $PROTECTED && ! -L $PROTECTED && ! -s $PROTECTED ]]; then
    refuse "there is no state $STATE, but the protected list $PROTECTED is not empty: a state existed and is lost, and a fresh one would drop what the list protects. Put the state back; or, when no image in the list must be kept, move the list aside and run $cmd again"
  fi
}
# JQFILTER [JQ OPTION...]: the state changed by it, written by rename
change_state() {
  local new f=$1
  shift
  new=$(print -r -- $ru_state | $JQ -c "$@" $f) && [[ -n $new ]] || stop "jq could not change the state: $STATE is as it was"
  ru_write $STATE "$new"$'\n' || stop "the state cannot be written ($REPLY): $STATE is as it was"
  ru_state=$new
}

# the jq under the core must be one core/TESTED_JQ lists for the area core; else the STOP "untested jq" and exit 3
jq_tested() {
  local jqv l tested=0
  jqv=$($JQ --version 2>/dev/null) || jqv='(no version)'
  if [[ -f $CORE/TESTED_JQ && -r $CORE/TESTED_JQ ]]; then
    for l in "${(@f)$(<$CORE/TESTED_JQ)}"; do
      [[ $l =~ '^([^#[:space:]]+)[[:space:]]+([a-z,]+)[[:space:]]+([^[:space:]]+)[[:space:]]*$' ]] || continue
      [[ $match[1] == "$jqv" && ,$match[2], == *,core,* ]] && tested=1
    done
  fi
  if (( ! tested )); then
    print -r -- "runner-updater: STOP untested jq: $JQ prints '$jqv', which core/TESTED_JQ does not list for the core; no new work starts. Next, in the repository: \`JQ=$JQ python3 -I -m unittest discover -s tests/core -t .\`, then add its row to core/TESTED_JQ when they pass"
    exit 3
  fi
}

# PROGRAM's output in DIR/PROGRAM.json is one decision: one JSON object with a verdict and lines
decided() {
  $JQ -e -s 'length == 1 and (.[0] | type) == "object" and (.[0].verdict | type) == "string"
             and (.[0].lines | type) == "array"' $1/$2.json > /dev/null 2>&1
}

# DIR STATEREF NOW: idle, r1, keep and status on DIR's facts.json, log.txt, healthz.json and state.json (the pass's
# copy of the core state: written back by rename after idle and after r1, so a later program reads it). A program
# that exits non-zero or decides nothing: "core could not decide", "the pass did nothing: STATEREF is as it was", exit
# 1. It prints each program's verdict and reason (r1 and keep: each family's too), then status.jq's lines.
run_core() {
  local dir=$1 ref=$2 now=$3 prog rc
  for prog in idle r1 keep status; do
    $JQ -n -L $CORE/lib -f $CORE/$prog.jq --slurpfile state $dir/state.json --slurpfile facts $dir/facts.json \
        --rawfile log $dir/log.txt --slurpfile healthz $dir/healthz.json --arg now $now > $dir/$prog.json 2> $dir/$prog.err
    rc=$?
    if (( rc != 0 )) || ! decided $dir $prog; then
      say "core could not decide ($prog): exit $rc${$(/usr/bin/head -n 1 $dir/$prog.err 2>/dev/null):+: $(/usr/bin/head -n 1 $dir/$prog.err)}"
      say "the pass did nothing: $ref is as it was"
      exit 1
    fi
    if [[ $prog == (idle|r1) ]]; then   # the new state, for the next program of this pass: by rename
      $JQ -e '.state | if type == "object" then . else error("no state") end' $dir/$prog.json > $dir/state.json.new \
        && /bin/mv -f -- $dir/state.json.new $dir/state.json \
        || { say "core could not decide ($prog): its output has no state"; say "the pass did nothing: $ref is as it was"; exit 1 }
    fi
    if [[ $prog == status ]]; then
      $JQ -r '"status: \(.verdict) (\(.reason))", .lines[]' $dir/$prog.json
    else
      $JQ -r --arg p $prog '"\($p): \(.verdict) (\(.reason))",
          ((.families // {}) | to_entries[] | "\($p) \(.key): \(.value.verdict) (\(.value.reason))")' $dir/$prog.json
    fi
  done
}

# ---- status: no lock, no write. ONE read of the state; the facts status.jq needs come from it (each family's
# candidate and back_until, the STOPs it holds), and the core's own state is its `core` member
do_status() {
  local now core facts out rc
  load_state   # ONE read of the renamed file: everything status prints comes from it
  jq_tested
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  core=$(print -r -- $ru_state | $JQ -c '.core // empty') \
    && facts=$(print -r -- $ru_state | $JQ -c '{format: 1, host: "studio", sets: [], proc: null, position: null,
         continuous: false, restart: null, config: null,
         families: (.families | map_values({provider: "tart", sets: ((.candidate.lines // {}) | keys),
                                             candidate: (.candidate // null), back_until: (.back_until // null)})),
         stops: [.families[] | (.stops // [])[]]}') \
    || refuse "jq could not build the facts of the state"
  print -r -- $ru_state | $JQ -r 'def utc: strftime("%Y-%m-%d %H:%M UTC");
    "runner-updater: status: the updater is \(if .on then "ON" else "OFF" end)",
    if (.families | length) == 0 then "runner-updater: status: no family in the state"
    else .families | to_entries | sort_by(.key)[] | .key as $f | .value
      | "runner-updater: family \($f): "
        + (if .candidate == null then "no candidate"
           else "candidate runner \(.candidate.version) (\(.candidate.lines | to_entries | sort_by(.key)
                 | map("\(.key)=\(.value)") | join(", "))), switched \(.candidate.closed_at | utc)" end)
        + "; " + (if .back_until == null then "back: none" else "back until \(.back_until | utc)" end)
        + "; rejected: " + (if (.rejected // []) == [] then "none" else (.rejected | join(", ")) end)
    end' || refuse "jq could not print the state"
  status_window
  # the core's inputs come through process substitutions (pipes, no file): status writes nothing anywhere. Its
  # stderr goes with its output: anything but one decision is "could not decide"
  out=$($JQ -n -L $CORE/lib -f $CORE/status.jq --slurpfile state <(print -rn -- $core) \
          --slurpfile facts <(print -r -- $facts) --arg now $now 2>&1)
  rc=$?
  if (( rc != 0 )) || ! print -r -- $out | $JQ -e -s 'length == 1 and (.[0] | type) == "object"
       and (.[0].verdict | type) == "string" and (.[0].lines | type) == "array"' > /dev/null 2>&1; then
    stop "core could not decide (status): exit $rc${${out%%$'\n'*}:+: ${out%%$'\n'*}}"
  fi
  print -r -- $out | $JQ -r 'def yn: if . == true then "yes" elif . == false then "no" elif . == null then "unknown" else tostring end;
    "status: \(.verdict) (\(.reason))", .lines[],
    (.stops[]? | "runner-updater: STOP \(.family) \(.stop): known \(.known); candidate closed: \(.closes_candidate | yn); version rejected: \(.rejects | yn); a newer release proceeds alone: \(.newer_proceeds | yn)")'
  exit 0
}

# status's window lines: an open window journal, and each family's host pin (D2's ONE RULE removes a pin when the
# version of the image the family runs is not known: status says so). It reads, and writes nothing
status_window() {
  local f c
  [[ ! -e $WINDOW && ! -L $WINDOW ]] \
    || say "status: a window journal is open: $WINDOW (its run holds the updater lock; when no run does, the next pass's RECOVER ends it)"
  for f in ${(f)"$(print -r -- $ru_state | $JQ -r '.families | keys[]')"}; do
    (( ${BUILDERS[(Ie)$f]} )) || continue
    if [[ -f $PINDIR/$f && ! -L $PINDIR/$f && -r $PINDIR/$f ]]; then
      c=$(/bin/cat -- $PINDIR/$f 2>/dev/null)
      if [[ $c =~ '^([0-9]+\.[0-9]+\.[0-9]+) [0-9a-f]{64}$' ]]; then say "family $f: host pin $match[1]"
      else say "family $f: host pin: $PINDIR/$f is not one line VERSION SHA256 (golden-build stops on it)"; fi
    elif [[ -e $PINDIR/$f || -L $PINDIR/$f ]]; then say "family $f: host pin: $PINDIR/$f is not a readable file (golden-build stops on it)"
    else say "family $f: host pin: none (a hand golden-build uses the release literal)"; fi
  done
}

# RECOVER FIRST (bin/runner-updater-window, ru_recover): an open window journal that no run holds (the window holds the
# updater lock for its whole run, so a run that took the lock and finds one found an interrupted window) is ended
# before anything else starts. It closed: the command goes on (recovered=1 when it held a STOP: a pass then exits 1).
# It stays open: STOP, exit 1, and nothing else starts. It needs no tested jq (the jq check guards new work only)
recovered=0
run_recover() {
  [[ -e $WINDOW || -L $WINDOW ]] || return 0
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  ru_recover
  case $? in
    (0) ;;
    (1) recovered=1 ;;
    (*) print -r -- "runner-updater: STOP the window journal $WINDOW stays open: the next run's RECOVER tries again; nothing else starts"
        exit 1 ;;
  esac
}

# ---- rebuild FAMILY, switch-now FAMILY: ONE switch window (bin/runner-updater-window, ru_window), under the lock
do_window() {
  local now since v= s= mode=idle rc
  load_state
  run_recover
  [[ $(print -r -- $ru_state | $JQ -r '.on') == true ]] \
    || refuse "the updater is OFF: $cmd runs only while it is ON (\`$INVOKED on\`); nothing changed"
  (( ${BUILDERS[(Ie)$family]} )) \
    || refuse "no builder wired for $family: this release builds only ${(j:, :)BUILDERS} (the Studio Linux families come with their builder's move)"
  jq_tested
  source $RELBIN/runner-updater-window || refuse "cannot load $RELBIN/runner-updater-window"
  now=$EPOCHSECONDS
  since=$now   # the commands' release is due from now: never NO IDLE (a pass gives its eligibility)
  ru_config && ru_families && ru_pools || refuse "$REPLY: no window"
  (( ${+ru_fam[$family]} )) || refuse "no family $family in $FAMILIES: no window"
  if [[ $cmd == switch-now ]]; then
    mode=now
    if ru_w_due $family; then v=$reply[1] s=$reply[2]; say "switch-now $family: the release of its NO IDLE STOP: runner $v"; fi
  fi
  if [[ -z $v ]]; then
    ru_w_current $family
    case $? in
      (0) v=$reply[1] s=$reply[2] ;;
      (2) ru_w_fam=$family ru_w_ver= ru_w_sha= ru_w_open=0 ru_w_stops=()
          ru_w_stop "check failed" "pre-window: $REPLY"
          ru_w_hold_stops
          exit 1 ;;
      (*) refuse "$REPLY: no window" ;;
    esac
  fi
  ru_window $family $v $s $mode $since $cmd
  rc=$?
  if (( rc == 0 )); then say "$cmd $family: switched to $ru_w_out (runner $v); the window closed"; exit 0; fi
  (( rc == 2 )) && exit 5
  exit 1
}

# ---- on, off (D11), under the lock
do_on() {
  load_state
  run_recover
  # PLAN D6: `on` refuses a Tart set with a warm pool (the lib's ru_pools, after the config and the families file)
  ru_config && ru_families && ru_pools || refuse "on: $REPLY: the updater is as it was"
  change_state '.on = true'
  say "on: the updater is ON"
  exit 0
}

# off: never while a window is open (it would strand it); then OFF, then every pin of PINDIR removed, each one
# journaled first (runner-journal into ACTIONS: `pin-remove NAME VERSION SHA256`, or `pin-remove NAME (not one line
# VERSION SHA256)`); a journal it cannot write is a STOP before that removal
do_off() {
  local p c v
  load_state
  run_recover
  [[ ! -e $WINDOW && ! -L $WINDOW ]] \
    || refuse "a window is open ($WINDOW): off never strands a window, so nothing changed. Run off again when the window has ended"
  change_state '.on = false'
  say "off: the updater is OFF"
  [[ -e $PINDIR || -L $PINDIR ]] || exit 0
  [[ -d $PINDIR && ! -L $PINDIR ]] || stop "$PINDIR is not a folder: off removes the pins in it; look at what it is"
  # it lists PINDIR: one it cannot read lists as empty, one it cannot search hides each pin
  [[ -r $PINDIR && -x $PINDIR ]] \
    || stop "$PINDIR cannot be read and searched: off removes the pins in it, and would not see them. The updater is OFF; the pins stay. Look at its mode (ci must be able to read and search it), then run off again"
  for p in $PINDIR/*(DN); do
    [[ -f $p || -L $p ]] || stop "$p is not a file: off removes only pin files; look at what it is"
    c=
    if [[ -f $p && ! -L $p && -r $p ]]; then c=$(/bin/cat -- $p 2>/dev/null && print -rn -- .); c=${${c%.}%$'\n'}; fi
    if [[ $c =~ '^[0-9]+\.[0-9]+\.[0-9]+ [0-9a-f]{64}$' && $c == "$MATCH" ]]; then v="${p:t} $c"
    else v="${p:t} (not one line VERSION SHA256)"; fi
    /bin/zsh -f $RELBIN/runner-journal $ACTIONS pin-remove $v \
      || stop "the action journal could not record the removal of $p (above): the pin stays. The updater is OFF; run off again when the journal can be written"
    /bin/rm -f -- $p || stop "cannot remove the pin $p (its removal is journaled in $ACTIONS)"
    say "off: removed the pin $p (journaled first in $ACTIONS)"
  done
  exit 0
}

# ---- protect: the protected list, written from the state (PLAN D6; bin/runner-updater-lib, ru_protect)
write_protected() { # NOW
  ru_protect $ru_state $1 || stop "the protected list cannot be written ($REPLY): $PROTECTED is as it was"
}
do_protect() {
  local now
  load_state
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  write_protected $now
  say "protect: $PROTECTED holds $ru_protected_n image name${${ru_protected_n:#1}:+s}"
  exit 0
}

# ---- pass: the timer's entry (it tried the lock: a held lock ended it). OFF: nothing, at once. ON: the facts from
# the state, the core, the core state written back into the state, the protected list rewritten; what it WOULD do is
# printed, and nothing is done (this release takes no action)
do_pass() {
  local now held on
  load_state
  run_recover
  on=$(print -r -- $ru_state | $JQ -r '.on')
  [[ $on == true ]] || { say "pass: the updater is OFF: nothing to do"; exit $recovered }
  jq_tested
  now=$(/bin/date -u +%s)
  [[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
  [[ -d $PASSDIR ]] || /bin/mkdir -m 700 $PASSDIR || refuse "cannot create $PASSDIR"
  print -r -- $ru_state | $JQ -c '.core // empty' > $PASSDIR/state.json || refuse "cannot copy the core's state into $PASSDIR"
  /bin/rm -f -- $PASSDIR/{idle,r1,keep,status}.json
  held=$(print -r -- $ru_state | $JQ -c '{families: (.families | map_values({candidate: (.candidate // null),
           back_until: (.back_until // null)})), stops: [.families[] | (.stops // [])[]], restart: (.restart // null)}') \
    || refuse "jq could not read the families of the state"
  say "pass: one pass at $(strftime '%Y-%m-%d %H:%M:%S UTC' $now) ($now); it takes no action"
  ru_collect $PASSDIR $PASSDIR/state.json '' $now $held || refuse "no facts: $REPLY"
  run_core $PASSDIR $STATE $now
  change_state '.core = $c[0] | del(.restart)' --slurpfile c $PASSDIR/state.json   # the restart: passed once
  write_protected $now
  pass_would   # what this pass would do: no action in this release
  # which release each family may switch to, or why not: bin/runner-updater-release (its header: THE PASS HOOK)
  source $RELBIN/runner-updater-release || refuse "cannot load $RELBIN/runner-updater-release"
  rl_pass $now
  exit $recovered
}
pass_would() {
  $JQ -r '(.families // {}) | to_entries[] | select(.value.verdict == "rollback")
          | "runner-updater: pass: would roll back \(.key) (this release takes no action)"' $PASSDIR/r1.json
  $JQ -r '(.families // {}) | to_entries[] | .key as $f | .value.verdict
          | if . == "accept" then "runner-updater: pass: would accept \($f) (this release takes no action)"
            elif . == "jobs-fail" then "runner-updater: pass: would hold \($f): STOP JOBS FAIL ON THE NEW IMAGE (this release takes no action)"
            elif . == "no-evidence" then "runner-updater: pass: would hold \($f): STOP NO EVIDENCE (this release takes no action)"
            else empty end' $PASSDIR/keep.json
}

[[ $cmd == status ]] && do_status

# ---- report's arguments
ru_observe_add=() ru_observe_clear=()
while (( $# )); do
  case $1 in
    (--observe|--observe-clear)
      (( $# >= 2 )) || usage "$1 needs a FAMILY"
      [[ $2 =~ '^[a-z][a-z0-9-]{0,40}$' ]] || usage "not a family name: '$2'"
      if [[ $1 == --observe ]]; then ru_observe_add+=($2); else ru_observe_clear+=($2); fi
      shift 2 ;;
    (*) usage "unknown argument '$1'" ;;
  esac
done
for f in $ru_observe_add; do (( ${ru_observe_clear[(Ie)$f]} == 0 )) || usage "--observe and --observe-clear of $f"; done
ru_observe_add=(${(u)ru_observe_add}) ru_observe_clear=(${(u)ru_observe_clear})

# ---- the state folder (see the header). STATEDIR and its empty list come into being in ONE step, a rename. They are
# made as NEW/runner-updater/protected (MADE = NEW/runner-updater), in a new folder NEW beside STATEDIR, and
# `mv -n MADE PARENT/` gives MADE its name. With a folder as its last operand, mv's destination is PARENT/runner-updater,
# STATEDIR itself, so nothing can nest. When another report made STATEDIR first, nothing moves: -n leaves an existing
# STATEDIR as it is, and rename(2) does not replace a folder that holds a file. One command per line: the tests kill
# a copy before each one in turn.
if [[ ! -e $STATEDIR && ! -L $STATEDIR ]]; then
  /bin/mkdir -p -- ${STATEDIR:h} || refuse "cannot create ${STATEDIR:h}"
  new=$(/usr/bin/mktemp -d $STATEDIR.new.XXXXXXXX) || refuse "cannot create a new folder beside $STATEDIR"
  made=$new/${STATEDIR:t}
  /bin/mkdir -m 700 -- $made || { /bin/rmdir -- $new; refuse "cannot create $made" }
  : > $made/protected || { /bin/rmdir -- $made $new; refuse "cannot create the empty protected list $made/protected" }
  /bin/mv -n -- $made ${STATEDIR:h}/ 2> /dev/null
  if [[ -e $made ]]; then   # not moved: another report made STATEDIR, and its list stays as it is
    /bin/rm -f -- $made/protected
    /bin/rmdir -- $made
  else
    say "created $STATEDIR, with an empty protected list $PROTECTED (it protects nothing)"
  fi
  /bin/rmdir -- $new
fi
[[ -d $STATEDIR && ! -L $STATEDIR ]] || refuse "$STATEDIR is not a folder"
# the list: protect and pass write it from the state, so they go on without one; the others refuse with how to get it
# back without emptying it (an empty list in place of a lost one would let golden-prune print an image the updater
# keeps)
if [[ $cmd != (protect|pass) ]]; then
  back="\`$INVOKED protect\` writes it from the updater's state (a pass does too, while the updater is ON); then run $cmd again"
  if [[ ! -e $PROTECTED && ! -L $PROTECTED ]]; then
    refuse "$STATEDIR has no protected list $PROTECTED, and golden-prune refuses until it has one. Do not create it empty: it lists the images the updater keeps. $back"
  fi
  [[ -f $PROTECTED && ! -L $PROTECTED && -r $PROTECTED ]] \
    || refuse "$PROTECTED is not a readable regular file, and golden-prune refuses it too. Do not make it an empty file: it lists the images the updater keeps. Look at what it is and move it aside, then $back"
fi

# ---- 1. the updater lock, held by THIS process until it exits: never redirect to LOCKFILE or print to its fd here.
# REPORT is made only under it: two reports that found no REPORT would race to make it.
zmodload zsh/system || refuse "zsh/system cannot be loaded: the lock cannot be taken"
[[ -e $LOCKFILE ]] || ( : >> $LOCKFILE ) || refuse "cannot create the lock file $LOCKFILE"
if [[ $cmd == pass ]]; then   # a timer pass TRIES the lock: held (2), and it ends at once
  zsystem flock -t 0.01 -f lockfd $LOCKFILE 2> /dev/null
  rc=$?
  (( rc != 2 )) || { say "pass: another run holds the updater lock; this pass ends"; exit 0 }
  (( rc == 0 )) || refuse "cannot take the updater lock $LOCKFILE"
else
  zsystem flock -f lockfd $LOCKFILE || refuse "cannot take the updater lock $LOCKFILE"
fi
case $cmd in
  (pass) do_pass ;;
  (on) do_on ;;
  (off) do_off ;;
  (protect) do_protect ;;
  (rebuild|switch-now) do_window ;;
esac
[[ -d $REPORT ]] || /bin/mkdir -m 700 $REPORT || refuse "cannot create $REPORT"

# ---- 2. the jq
jq_tested

# ---- 3. the facts
now=$(/bin/date -u +%s)
[[ $now =~ '^[0-9]+$' ]] || refuse "the clock gave '$now'"
pass=$REPORT/pass
[[ -d $pass ]] || /bin/mkdir -m 700 $pass || refuse "cannot create $pass"
[[ -e $REPORT/state.json ]] || : > $REPORT/state.json || refuse "cannot create $REPORT/state.json"
/bin/cp -f -- $REPORT/state.json $pass/state.json || refuse "cannot copy the state into $pass"
/bin/rm -f -- $pass/{idle,r1,keep,status}.json
say "report: one pass at $(strftime '%Y-%m-%d %H:%M:%S UTC' $now) ($now); it takes no action"
ru_collect $pass $REPORT/state.json $REPORT/observe.json $now || refuse "no facts: $REPLY"

# ---- 4, 5. the core
run_core $pass $REPORT/state.json $now
/bin/mv -f -- $pass/state.json $REPORT/state.json || refuse "cannot write $REPORT/state.json"
exit 0
