#!/bin/zsh -f
# runner-updater-lib — the facts collector of the runner-image updater on the Studio: zsh functions that
# bin/runner-updater sources (never run on its own; it reads no argument). ONE copy. It measures and writes; it acts on
# nothing. The format it writes is the decision core's contract: core/README.md ("The call", "facts (format 1)").
#
# The caller sets, before it calls a function of it (bin/runner-updater's header has the values):
#   RUNNER CONFIG RUNLOG FAMILIES JQ PS CURL HEALTHZ_GAP (ru_collect), DD (ru_write), PROTECTED WINDOW (ru_protect), and
#   exports TZ=UTC and LC_ALL=C (ps prints its start times in TZ; this file reads them back in the same zone).
#
# ru_collect PASSDIR STATEFILE OBSERVEFILE NOW [HELD] — ONE pass's facts. It writes, into PASSDIR:
#   facts.json    format 1, exactly as core/README.md says; host "studio"; restart null; stops: HELD's (report: []).
#   log.txt       runscaler's log text from the state's boundary to this pass's captured position, no byte past it.
#   healthz.json  the /healthz reads of this pass, oldest first, one JSON object per line (a read that fails, or is
#                 not one JSON object, is not added).
#   It returns 0, or 1 with REPLY = why there are no facts (the caller prints it as a REFUSE line; it calls no core
#   program then). It prints its own status lines ("runner-updater: ...") on stdout.
#   The globals ru_observe_add and ru_observe_clear (arrays of family names) are the caller's --observe and
#   --observe-clear: they change OBSERVEFILE in this pass (below).
#
# ru_reach PATH — THE RULE for every folder on the path to a file whose absence means something: each one that exists
#   must be a folder this process can search, else a name behind it looks absent. 0, or 1 + REPLY (that folder). Every
#   reader below calls it before it tests a name: ru_state_load, ru_protect (WINDOW), ru_families, ru_observe.
# ru_state_load FILE — the updater's state (its layout: bin/runner-updater's header) into ru_state, compact JSON: 0;
#   a missing FILE is a fresh state (OFF, no family), but a folder on its path it cannot search is 1 (ru_reach): FILE
#   would look absent there. 1 + REPLY: FILE is not a state of format 1 this reads. 2 + REPLY
#   (the wait line): its format is not 1. It opens FILE once: a rename over FILE while it reads gives it one whole state.
# ru_write FILE TEXT — TEXT, byte for byte, into FILE by rename: written to FILE.new, synced to disk (DD, as
#   runner-journal does: so a power cut after the rename cannot leave FILE empty), then renamed over FILE. 1 + REPLY
#   when it cannot (FILE is then as it was). A kill before the rename leaves FILE as it was and a FILE.new that the next
#   write replaces. Named residual: macOS fsync does not flush the drive's own cache (runner-journal's header).
# ru_protect STATE NOW — the protected list (PLAN D6), from the state at NOW and the open window's journal WINDOW,
#   into PROTECTED by ru_write; its rule is at the function.
#
# What it measures, in this order (the order is the rule):
#   1. proc before: the runscaler process. The Studio runs ONE: the RUNNER binary that runner-start execs, so its ps
#      args are exactly "RUNNER run --config CONFIG", run by this user. Read with `PS -ax -ww -o pid=,uid=,lstart=,args=`
#      (one call: the pid and its start time come from the same read). start = lstart as epoch seconds (TZ=UTC). No
#      such process: null. Two or more, or a ps output it cannot read: no facts.
#   2. position: RUNLOG is opened once; through that open file: its inode (a string), its size (= the offset) and the
#      sha256 of the 64 bytes before the offset (all of them when there are fewer). No RUNLOG: no facts. Everything
#      this pass reads of RUNLOG it reads through that open file, so a rotation after the capture changes nothing.
#   3. proc after: as 1, after the capture (core/README.md, "Ownership by position").
#   4. continuous and log.txt, against the state's boundary (STATEFILE's .boundary.position, the position the last
#      pass captured):
#      - the boundary's inode is RUNLOG's, its offset is not past the position, and the sha of the 64 bytes before it
#        still matches: true; the text is RUNLOG from the boundary to the position.
#      - RUNLOG.1 is the boundary's inode (runscaler rotated ONCE: it renames runner.log to runner.log.1 and starts a
#        new one) and its sha matches: true; the text is the rest of RUNLOG.1 from the boundary, then RUNLOG from 0 to
#        the position.
#      - anything else (two rotations, a cut or rewritten file, a missing file): false; the text is only what can be
#        read, RUNLOG from 0 to the position, and the core reads it as a gap.
#      - no boundary (a first pass, or a state that holds none it can read): false, and the text is empty.
#   5. config: CONFIG's mtime (installed, epoch seconds), its inode and size read before and after the text (a change
#      in between: no facts). It reads the TOML subset that config/config.toml.example uses, and no more: top-level
#      health-address and health-port (above the first table); each [[scaleset]] block's `name` and its non-comment
#      `runner-image` line, both plain "..." strings. lines = {SET: IMAGE} for each block with an image; sets = every
#      block's name. No facts on: a block with two names or two images, or with no name; two blocks with one name; a
#      runner-image line outside a [[scaleset]] block; a name or runner-image line it cannot read; a top-level
#      log-file key (runscaler then writes elsewhere, or nowhere, and runner.log reads as a quiet log); a top-level
#      log-format that is not exactly `log-format = "text"` (the core reads only the text format). Either of the
#      last two would leave R1 blind while the facts look normal.
#      It reads CONFIG after the process reads: a config installed after the process started then has a later mtime,
#      which proves nothing (the safe direction).
#   6. families: FAMILIES, one line per family "FAMILY tart SET [SET ...]" (FAMILY [a-z][a-z0-9-]{0,40}, SET
#      [A-Za-z0-9][A-Za-z0-9._-]{0,99}, one space between), lines that start with # and empty lines skipped. Read as
#      hostile: never sourced, every line must match exactly. No facts on any other line, a family named twice, a set
#      named twice in a family, or a set in two families. No FAMILIES file: no family (a status line says so); a
#      folder on its path it cannot search (ru_reach): no facts.
#      facts.families.F = {provider: "tart", sets, candidate, back_until}, both from step 7.
#   7. With HELD (a pass: JSON {families: {FAMILY: {candidate, back_until}}, stops: [...]}, from the updater's state):
#      each family's candidate and back_until, and the STOPs, are HELD's. A family that HELD gives a candidate or a
#      back_until and FAMILIES does not name: no facts. OBSERVEFILE is not read.
#      Without HELD (report): back_until null, no STOP, and the candidates are OBSERVEFILE's (JSON {FAMILY: {version:
#      "observed", lines: {SET: IMAGE}, closed_at: EPOCH}}), or null. In this pass, each
#      ru_observe_add family is added with its CURRENT config lines and closed_at = NOW (a family already observed
#      keeps its record: one window); each ru_observe_clear family is removed. A family that is not in FAMILIES, or a
#      set of it with no config line: no facts. The file is written by rename. An OBSERVEFILE it cannot read, or one
#      behind a folder it cannot search (ru_reach): no facts.
#   8. healthz: two reads, HEALTHZ_GAP seconds apart: `CURL -fsS --noproxy '*' --max-time 5
#      http://ADDRESS:PORT/healthz`, ADDRESS and PORT from the config's top-level health-address and health-port
#      (runscaler's defaults when absent: 127.0.0.1 and 8080). A health-port of 0 (no health server), or an address or
#      port it does not read: no reads. A status line says how many reads came.
set -u

zmodload zsh/system || { print -r -- "runner-updater-lib: zsh/system cannot be loaded"; return 1 }
zmodload -F zsh/stat b:zstat || { print -r -- "runner-updater-lib: zsh/stat cannot be loaded"; return 1 }
zmodload zsh/datetime || { print -r -- "runner-updater-lib: zsh/datetime cannot be loaded"; return 1 }

ru_say() { print -r -- "runner-updater: $*" }

# ru_reach PATH: 0 when every folder on the path to PATH that exists is a folder this process can search. A test of a
# name behind a folder it cannot search fails as if nothing were there, so a state would read as fresh (OFF), a list
# or a window's journal as absent, a pin as absent: every reader of a file whose absence means something calls this
# first. 1 + REPLY = "FOLDER cannot be searched" (the first one from PATH up). PATH is absolute. ONE rule: golden-prune
# and golden-build's pin() hold the same loop.
ru_reach() {
  local d=$1
  [[ $d == /* ]] || { REPLY="$d is not an absolute path"; return 1 }
  while [[ $d != / ]]; do
    d=${d:h}
    [[ ! -e $d && ! -L $d ]] || [[ -d $d && -x $d ]] || { REPLY="$d cannot be searched"; return 1 }
  done
  return 0
}

# ---- the process
# -> REPLY = {"pid":N,"start":EPOCH} or null; return 1 with REPLY = why it cannot be read
ru_proc() {
  local out l want="$RUNNER run --config $CONFIG" st e parsed=0
  local -a found
  out=$($PS -ax -ww -o pid=,uid=,lstart=,args= 2>/dev/null) || { REPLY="ps failed"; return 1 }
  local re='^ *([0-9]+) +([0-9]+) +((Mon|Tue|Wed|Thu|Fri|Sat|Sun) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) ( [1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9] [0-9]{4}) +(.*)$'
  for l in "${(@f)out}"; do
    [[ $l =~ $re && $l == "$MATCH" ]] || continue
    parsed=1
    (( match[2] == UID )) && [[ $match[8] == "$want" ]] && found+=("$match[1] $match[3]")
  done
  (( parsed )) || { REPLY="ps printed no line this reads"; return 1 }
  (( ${#found} <= 1 )) || { REPLY="${#found} runscaler processes run ($want)"; return 1 }
  if (( ${#found} == 0 )); then REPLY=null; return 0; fi
  st=${found[1]#* }
  e=$(strftime -r '%a %b %e %H:%M:%S %Y' "$st" 2>/dev/null)
  [[ $e =~ '^[0-9]+$' ]] || { REPLY="cannot read the start time '$st'"; return 1 }
  REPLY="{\"pid\":${found[1]%% *},\"start\":$e}"
}

# ---- the log
# FD START LEN OUTFD: copy LEN bytes of FD from byte START to OUTFD; 1 when they are not all there
ru_copy() {
  local fd=$1 left=$3 out=$4 n
  sysseek -u $fd $2 || return 1
  while (( left > 0 )); do
    sysread -c n -i $fd -o $out -s $(( left < 65536 ? left : 65536 )) || return 1
    (( n > 0 )) || return 1
    (( left -= n ))
  done
  return 0
}

# FD OFFSET -> REPLY = the sha256 of the 64 bytes before OFFSET (all of them when there are fewer); 1 when unreadable
ru_sha() {
  local fd=$1 off=$2 n o tmp=$ru_pass/sha.bytes
  (( n = off < 64 ? off : 64 ))
  exec {o}> $tmp || return 1
  if ! ru_copy $fd $(( off - n )) $n $o; then exec {o}>&-; return 1; fi
  exec {o}>&-
  o=$(/usr/bin/shasum -a 256 < $tmp) || return 1
  /bin/rm -f -- $tmp
  [[ $o =~ '^[0-9a-f]{64}  -$' ]] || return 1
  REPLY=${o[1,64]}
}

# LOG -> ru_fd (open), ru_inode, ru_offset, ru_sha; 1 with REPLY = why
ru_capture() {
  typeset -gA ru_st
  ru_st=()
  [[ -f $1 ]] || { REPLY="no runscaler log $1"; return 1 }
  # the 2>/dev/null is on a group: on `exec` itself it would send the shell's own stderr to /dev/null for good
  { exec {ru_fd}< $1 } 2>/dev/null || { REPLY="cannot open the runscaler log $1"; return 1 }
  zstat -H ru_st -f $ru_fd || { REPLY="cannot stat the runscaler log $1"; return 1 }
  ru_inode=$ru_st[inode] ru_offset=$ru_st[size]
  ru_sha $ru_fd $ru_offset || { REPLY="cannot read the runscaler log $1"; return 1 }
  ru_sha_now=$REPLY
}

# STATEFILE -> ru_b=(inode offset sha) or () when the state holds no boundary it can read
ru_boundary() {
  local b
  ru_b=()
  [[ -s $1 ]] || return 0
  b=$($JQ -r 'if (.boundary.position | type) == "object" then .boundary.position
              | "\(.inode | tostring) \(.offset | tostring) \(.sha | tostring)" else "" end' $1 2>/dev/null) || return 0
  [[ $b =~ '^([0-9]+) ([0-9]+) ([0-9a-f]{64})$' ]] || return 0
  ru_b=($match[1] $match[2] $match[3])
}

# OUTFILE: the text and ru_continuous (true|false) from ru_b to the captured position; ru_why says which case
ru_text() {
  local o bfd ok=0
  typeset -A st1
  exec {o}> $1 || { REPLY="cannot write $1"; return 1 }
  ru_continuous=false
  if (( ${#ru_b} == 0 )); then
    ru_why="first pass: no boundary in the state yet, so no text"
    exec {o}>&-; return 0
  fi
  if [[ $ru_b[1] == "$ru_inode" ]]; then
    if (( ru_b[2] <= ru_offset )) && ru_sha $ru_fd $ru_b[2] && [[ $REPLY == "$ru_b[3]" ]]; then
      ru_copy $ru_fd $ru_b[2] $(( ru_offset - ru_b[2] )) $o && ok=1
      ru_continuous=true ru_why="continuous: the same file since the last pass"
    else
      ru_why="NOT continuous: the log file was cut or rewritten at the last pass's position"
    fi
  elif [[ -f $RUNLOG.1 ]] && { exec {bfd}< $RUNLOG.1 } 2>/dev/null; then   # a group, as in ru_capture
    if zstat -H st1 -f $bfd && [[ $st1[inode] == "$ru_b[1]" ]]; then
      if (( ru_b[2] <= st1[size] )) && ru_sha $bfd $ru_b[2] && [[ $REPLY == "$ru_b[3]" ]]; then
        ru_copy $bfd $ru_b[2] $(( st1[size] - ru_b[2] )) $o && ru_copy $ru_fd 0 $ru_offset $o && ok=1
        ru_continuous=true ru_why="continuous: the log rotated once (the rest of ${RUNLOG:t}.1, then ${RUNLOG:t})"
      else
        ru_why="NOT continuous: ${RUNLOG:t}.1 was cut or rewritten at the last pass's position"
      fi
    else
      ru_why="NOT continuous: the last pass's log file is gone (the log rotated more than once, or it was removed)"
    fi
    exec {bfd}<&-
  else
    ru_why="NOT continuous: the last pass's log file is gone (no ${RUNLOG:t}.1)"
  fi
  if [[ $ru_continuous == true ]]; then
    exec {o}>&-
    (( ok )) || { REPLY="cannot read the log text"; return 1 }
    return 0
  fi
  # not continuous: only what can be read, the current file to the position; the core makes it a gap
  if ! ru_copy $ru_fd 0 $ru_offset $o; then exec {o}>&-; REPLY="cannot read the log text"; return 1; fi
  exec {o}>&-
}

# ---- the config
# -> ru_installed, ru_sets (names in file order), ru_lines (assoc SET -> IMAGE), ru_haddr, ru_hport; 1 + REPLY
ru_config() {
  typeset -gA ru_lines
  typeset -ga ru_sets
  local text l n=0 top=1 inblock=0 bname= bimage= ws='[[:space:]]*' tail='[[:space:]]*(#.*)?$'
  typeset -A s1 s2
  ru_lines=() ru_sets=() ru_haddr= ru_hport= ru_installed=
  [[ -f $CONFIG && -r $CONFIG ]] || { REPLY="no readable config $CONFIG"; return 1 }
  zstat -H s1 $CONFIG || { REPLY="cannot stat $CONFIG"; return 1 }
  text=$(<$CONFIG) || { REPLY="cannot read $CONFIG"; return 1 }
  zstat -H s2 $CONFIG || { REPLY="cannot stat $CONFIG"; return 1 }
  [[ $s1[inode] == $s2[inode] && $s1[mtime] == $s2[mtime] && $s1[size] == $s2[size] ]] \
    || { REPLY="$CONFIG changed while it was read"; return 1 }
  ru_installed=$s1[mtime]
  ru_endblock() {
    (( inblock )) || return 0
    [[ -n $bname ]] || { REPLY="$CONFIG: a [[scaleset]] block has no name"; return 1 }
    (( ${ru_sets[(Ie)$bname]} == 0 )) || { REPLY="$CONFIG: two [[scaleset]] blocks are named '$bname'"; return 1 }
    ru_sets+=($bname)
    [[ -z $bimage ]] || ru_lines[$bname]=$bimage
    inblock=0 bname= bimage=
  }
  for l in "${(@f)text}"; do
    (( n++ ))
    [[ $l =~ "^${ws}(#.*)?\$" ]] && continue
    if [[ $l =~ "^${ws}\\[\\[${ws}scaleset${ws}\\]\\]${tail}" ]]; then
      ru_endblock || return 1
      inblock=1 top=0
    elif [[ $l =~ "^${ws}\\[" ]]; then
      ru_endblock || return 1
      top=0
    elif [[ $l =~ "^${ws}[\"']?runner-image[\"']?${ws}[.=]" ]]; then
      (( inblock )) || { REPLY="$CONFIG line $n: a runner-image line outside a [[scaleset]] block"; return 1 }
      [[ -z $bimage ]] || { REPLY="$CONFIG line $n: a [[scaleset]] block has two runner-image lines"; return 1 }
      [[ $l =~ "^${ws}runner-image${ws}=${ws}\"([^\"\\\\[:cntrl:]]+)\"${tail}" && $l == "$MATCH" ]] \
        || { REPLY="$CONFIG line $n: a runner-image line this does not read (a plain \"...\" string)"; return 1 }
      bimage=$match[1]
    elif (( inblock )) && [[ $l =~ "^${ws}[\"']?name[\"']?${ws}[.=]" ]]; then
      [[ -z $bname ]] || { REPLY="$CONFIG line $n: a [[scaleset]] block has two names"; return 1 }
      [[ $l =~ "^${ws}name${ws}=${ws}\"([A-Za-z0-9][A-Za-z0-9._-]{0,99})\"${tail}" && $l == "$MATCH" ]] \
        || { REPLY="$CONFIG line $n: a scale set name this does not read ([A-Za-z0-9][A-Za-z0-9._-], at most 100)"; return 1 }
      bname=$match[1]
    elif (( top )) && [[ $l =~ "^${ws}[\"']?log-file[\"']?${ws}[.=]" ]]; then
      REPLY="$CONFIG line $n: a top-level log-file key: runscaler then writes its log elsewhere or nowhere, and runner.log beside the config reads as a quiet, continuous log, so R1 would be blind while the facts look normal; remove the key"
      return 1
    elif (( top )) && [[ $l =~ "^${ws}[\"']?log-format[\"']?${ws}[.=]" ]]; then
      [[ $l =~ "^${ws}log-format${ws}=${ws}\"text\"${tail}" && $l == "$MATCH" ]] || {
        REPLY="$CONFIG line $n: log-format is not \"text\": runscaler then writes records that the core's log reader ignores, so R1 would be blind while the facts look normal; set log-format = \"text\" or remove the line"
        return 1
      }
    elif (( top )) && [[ $l =~ "^${ws}health-address${ws}=${ws}\"([^\"\\\\[:cntrl:]]*)\"${tail}" && $l == "$MATCH" ]]; then
      ru_haddr=$match[1]
    elif (( top )) && [[ $l =~ "^${ws}health-address${ws}=" ]]; then
      ru_haddr='?'
    elif (( top )) && [[ $l =~ "^${ws}health-port${ws}=${ws}([0-9]{1,5})${tail}" && $l == "$MATCH" ]]; then
      ru_hport=$match[1]
    elif (( top )) && [[ $l =~ "^${ws}health-port${ws}=" ]]; then
      ru_hport='?'
    fi
  done
  ru_endblock || return 1
  return 0
}

# ---- the families
# -> ru_fam (assoc FAMILY -> "SET SET ..."), ru_fam_order; 1 + REPLY
ru_families() {
  typeset -gA ru_fam
  typeset -ga ru_fam_order
  local text l n=0 f s
  local -A owner
  local -a sets
  ru_fam=() ru_fam_order=()
  ru_reach $FAMILIES || { REPLY="$REPLY: the families file $FAMILIES would look absent"; return 1 }
  if [[ ! -e $FAMILIES && ! -L $FAMILIES ]]; then
    ru_say "families: no families file $FAMILIES: no family is observed"
    return 0
  fi
  [[ -f $FAMILIES && ! -L $FAMILIES && -r $FAMILIES ]] || { REPLY="$FAMILIES is not a readable regular file"; return 1 }
  text=$(<$FAMILIES) || { REPLY="cannot read $FAMILIES"; return 1 }
  local set_re='[A-Za-z0-9][A-Za-z0-9._-]{0,99}'
  for l in "${(@f)text}"; do
    (( n++ ))
    [[ -z $l || $l == '#'* ]] && continue
    [[ $l =~ "^([a-z][a-z0-9-]{0,40}) tart (${set_re}( ${set_re})*)\$" && $l == "$MATCH" ]] \
      || { REPLY="$FAMILIES line $n is not 'FAMILY tart SET [SET ...]'"; return 1 }
    f=$match[1]
    sets=(${(s: :)match[2]})
    (( ${+ru_fam[$f]} == 0 )) || { REPLY="$FAMILIES line $n: the family $f is named twice"; return 1 }
    (( ${#${(@u)sets}} == ${#sets} )) || { REPLY="$FAMILIES line $n: a set is named twice in the family $f"; return 1 }
    for s in $sets; do
      (( ${+owner[$s]} == 0 )) || { REPLY="$FAMILIES line $n: the set $s is in two families ($owner[$s], $f)"; return 1 }
      owner[$s]=$f
    done
    ru_fam[$f]="$sets"
    ru_fam_order+=($f)
  done
  return 0
}

# ---- the observed families: OBSERVEFILE NOW -> ru_observed (a JSON object); 1 + REPLY
ru_observe() {
  local file=$1 now=$2 f s obs i
  local -a pairs shown
  ru_reach $file || { REPLY="$REPLY: the observe file $file would look absent"; return 1 }
  if [[ -e $file || -L $file ]]; then
    [[ -f $file && ! -L $file ]] || { REPLY="$file is not a regular file: remove it (rm $file)"; return 1 }
    obs=$($JQ -c 'if type == "object" and all(.[]; type == "object" and .version == "observed"
                     and (.closed_at | type) == "number" and (.lines | type) == "object"
                     and all(.lines[]; type == "string")) then . else error("not an observe file") end' $file 2>/dev/null) \
      || { REPLY="$file is not an observe file this reads: remove it (rm $file)"; return 1 }
  else
    obs='{}'
  fi
  for f in $ru_observe_clear; do
    if print -r -- $obs | $JQ -e --arg f $f 'has($f)' > /dev/null; then ru_say "observe: $f is no longer observed"
    else ru_say "observe: $f was not observed"; fi
    obs=$(print -r -- $obs | $JQ -c --arg f $f 'del(.[$f])') || { REPLY="cannot change the observe file"; return 1 }
  done
  for f in $ru_observe_add; do
    (( ${+ru_fam[$f]} )) || { REPLY="--observe $f: no family $f in $FAMILIES"; return 1 }
    if print -r -- $obs | $JQ -e --arg f $f 'has($f)' > /dev/null; then
      ru_say "observe: $f is observed already (its record stays: --observe-clear $f first for the current lines)"
      continue
    fi
    pairs=()
    for s in ${(s: :)ru_fam[$f]}; do
      (( ${+ru_lines[$s]} )) || { REPLY="--observe $f: the set $s has no runner-image line in $CONFIG"; return 1 }
      pairs+=($s $ru_lines[$s])
    done
    obs=$(print -r -- $obs | $JQ -c --arg f $f --argjson now $now '. + {($f): {version: "observed", closed_at: $now,
            lines: ([$ARGS.positional as $a | range(0; $a | length; 2) | {($a[.]): $a[. + 1]}] | add)}}' \
            --args $pairs) || { REPLY="cannot change the observe file"; return 1 }
    shown=()
    for (( i = 1; i < ${#pairs}; i += 2 )); do shown+=("$pairs[i]=$pairs[i+1]"); done
    ru_say "observe: $f is observed from now on, on its current lines: ${(j:, :)shown}"
  done
  if (( ${#ru_observe_add} + ${#ru_observe_clear} )); then
    print -r -- $obs > $file.new && /bin/mv -f -- $file.new $file || { REPLY="cannot write $file"; return 1 }
  fi
  ru_observed=$obs
}

# ---- /healthz: OUTFILE -> REPLY = the number of reads
ru_healthz() {
  local out=$1 i body one addr=${ru_haddr:-127.0.0.1} port=${ru_hport:-8080} reads=0
  : > $out || return 1
  if [[ ! $addr =~ '^(localhost|[0-9]{1,3}(\.[0-9]{1,3}){3})$' ]]; then
    ru_say "healthz: 0 of 2 reads (health-address '$addr' is not one this reads)"; REPLY=0; return 0
  fi
  if [[ ! $port =~ '^[0-9]{1,5}$' ]] || (( port < 1 || port > 65535 )); then
    ru_say "healthz: 0 of 2 reads (health-port '$port': no health server this reads)"; REPLY=0; return 0
  fi
  for i in 1 2; do
    (( i == 1 )) || /bin/sleep $HEALTHZ_GAP
    body=$($CURL -fsS --noproxy '*' --max-time 5 "http://$addr:$port/healthz" 2>/dev/null) || continue
    one=$(print -r -- $body | $JQ -c -s 'if length == 1 and (.[0] | type) == "object" then .[0] else error("not one object") end' \
            2>/dev/null) || continue
    [[ -n $one && $one != *$'\n'* ]] || continue
    print -r -- $one >> $out || return 1
    (( reads++ ))
  done
  ru_say "healthz: $reads of 2 reads (http://$addr:$port/healthz)"
  REPLY=$reads
}

# ---- the updater's state (STATE in bin/runner-updater; its header has the layout)
# a fresh install: OFF, no family, no image record, no core state
ru_fresh='{"format":1,"on":false,"families":{},"images":{}}'
# format 1, checked member by member (the members it reads; ru_state_members lists any other)
ru_state_check='
def fam_ok: type == "string" and test("^[a-z][a-z0-9-]{0,40}$");
def set_ok: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$");
def image_ok: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$");
def version_ok: type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+$");
def epoch_ok: type == "number" and . >= 0 and . == floor;
def lines_ok: type == "object" and length > 0 and all(to_entries[]; (.key | set_ok) and (.value | image_ok));
def stop_ok($f): type == "object" and .family == $f and (.stop | type) == "string" and (.stop | length) > 0
  and (.version == null or (.version | type) == "string") and (.user == null or (.user | type) == "string")
  and (.detail == null or (.detail | type) == "object");
def family_ok($f): type == "object"
  and (.candidate == null or (.candidate | type == "object" and (.version | version_ok) and (.lines | lines_ok)
                              and (.closed_at | epoch_ok)))
  and (.previous == null or (.previous | lines_ok))
  and (.back_until == null or (.back_until | epoch_ok))
  and (.rejected == null or (.rejected | type == "array" and all(.[]; version_ok)))
  and (.recipe == null or (.recipe | type == "string" and test("^[0-9a-f]{64}$")))
  and (.stops == null or (.stops | type == "array" and all(.[]; stop_ok($f))));
if type == "object" and .format == 1 and (.on | type) == "boolean"
   and (.families | type) == "object" and all(.families | to_entries[]; .key as $f | ($f | fam_ok) and (.value | family_ok($f)))
   and (.images | type) == "object" and all(.images | to_entries[]; (.key | image_ok) and (.value | version_ok))
   and (.core == null or (.core | type) == "object")
then . else error("not a state of format 1") end'
# the members of a checked state that this release does not read, at each level it reads: the top, a family, its
# candidate, each STOP ("" when none). A later member that names an image or holds a STOP needs this rule: the older
# release (a rollback across one) then WAITs, and never writes a shorter protected list or prints a status that hides
# a STOP. A name that is not plain is shown as JSON (no raw newline reaches the WAIT line)
ru_state_members='
def shown: if test("^[A-Za-z_][A-Za-z0-9_-]{0,40}$") then . else tojson end;
[(keys - ["format", "on", "families", "images", "core"])[] | shown]
+ [.families | to_entries[] | .key as $f | .value
   | ((keys - ["candidate", "previous", "back_until", "rejected", "recipe", "stops"])[] | "families.\($f).\(shown)"),
     (if (.candidate | type) == "object" then (.candidate | keys - ["version", "lines", "closed_at"])[]
        | "families.\($f).candidate.\(shown)" else empty end),
     ((.stops // []) | to_entries[] | .key as $i | .value | (keys - ["family", "stop", "version", "user", "detail"])[]
        | "families.\($f).stops[\($i)].\(shown)")]
| join(", ")'

# ru_state_load FILE -> ru_state (the state, compact JSON) and 0; a missing FILE is ru_fresh. 1 + REPLY when FILE is
# not a state this reads; 2 + REPLY (the wait line) when it is of another format, or holds a member this release does
# not read (ru_state_members). FILE is opened ONCE, so a reader that runs while a writer renames a new state in gets
# one of the two whole.
ru_state_load() {
  local f=$1 text fmt st members
  # behind a folder it cannot search, a state would look absent (fresh: OFF): not read as fresh
  ru_reach $f || { REPLY="$REPLY: a state behind it would look absent"; return 1 }
  if [[ ! -e $f && ! -L $f ]]; then ru_state=$ru_fresh; return 0; fi
  [[ -f $f && ! -L $f && -r $f ]] || { REPLY="$f is not a readable regular file"; return 1 }
  text=$(/bin/cat -- $f && print -rn -- .) || { REPLY="$f cannot be read"; return 1 }
  text=${text%.}
  fmt=$(print -rn -- $text | $JQ -s -r 'if length == 1 and (.[0] | type) == "object" then .[0].format | tojson
                                         else error("not one object") end' 2>/dev/null) \
    || { REPLY="$f is not one JSON object"; return 1 }
  [[ $fmt == 1 ]] || { REPLY="the state $f has format $fmt; this updater reads format 1: it waits and changes nothing"; return 2 }
  st=$(print -rn -- $text | $JQ -c $ru_state_check 2>/dev/null) && [[ -n $st ]] \
    || { REPLY="$f is not a state of format 1 this reads"; return 1 }
  members=$(print -r -- $st | $JQ -r $ru_state_members 2>/dev/null) \
    || { REPLY="$f: jq could not list its members"; return 1 }
  [[ -z $members ]] || { REPLY="the state $f holds members this release does not read ($members): a later release wrote them, and they may name an image to keep or hold a STOP; it waits and changes nothing"; return 2 }
  ru_state=$st
}

# ru_write FILE TEXT: TEXT, byte for byte, into FILE by rename (FILE.new, synced to disk with DD as runner-journal does,
# then a rename over FILE). 1 + REPLY when it cannot; FILE is then as it was.
ru_write() {
  local f=$1 out
  [[ ! -d $f ]] || { REPLY="$f is a folder"; return 1 }
  /bin/rm -f -- $f.new 2>/dev/null
  { print -rn -- $2 > $f.new } 2>/dev/null || { /bin/rm -f -- $f.new 2>/dev/null; REPLY="cannot write $f.new"; return 1 }
  out=$($DD if=/dev/null of=$f.new conv=notrunc,fsync 2>&1) \
    || { /bin/rm -f -- $f.new; REPLY="cannot sync $f.new to disk${${out%%$'\n'*}:+: ${out%%$'\n'*}}"; return 1 }
  /bin/mv -f -- $f.new $f || { /bin/rm -f -- $f.new; REPLY="cannot rename $f.new to $f"; return 1 }
}

# ---- the protected list (PLAN D6)
# ru_protect STATE NOW: the list, from the state STATE (JSON) at NOW and the open window's journal WINDOW, written to
# PROTECTED by ru_write: one image name per line, in byte order, each once (no name: an empty file). ru_protected_n =
# how many. 1 + REPLY when it cannot (PROTECTED is then as it was). The names:
#   - each family's candidate lines (a candidate in the state is a checked one);
#   - each family's `previous` lines (the window's old image) while it has a candidate, and after an ACCEPT while NOW is
#     before its back_until: until ACCEPT + 7 days;
#   - an open window's journaled names: each `image NAME` line of WINDOW (the window journals every image name it
#     makes or needs kept on such a line, BEFORE it makes it). An `image` line whose NAME is not an image name: 1.
#     A folder on WINDOW's path it cannot search: 1 (ru_reach), never "no window".
ru_protect() {
  local names text l v
  local -a list
  names=$(print -r -- $1 | $JQ -r --argjson now $2 '.families[] | (.candidate.lines // {} | .[]),
            (if .candidate != null or (.back_until != null and $now < .back_until) then .previous // {} | .[]
             else empty end)') \
    || { REPLY="jq could not read the images of the state"; return 1 }
  list=(${(f)names})
  ru_reach $WINDOW || { REPLY="$REPLY: an open window's journal $WINDOW would look absent"; return 1 }
  if [[ -e $WINDOW || -L $WINDOW ]]; then
    [[ -f $WINDOW && ! -L $WINDOW && -r $WINDOW ]] || { REPLY="$WINDOW is not a readable regular file"; return 1 }
    text=$(/bin/cat -- $WINDOW && print -rn -- .) || { REPLY="$WINDOW cannot be read"; return 1 }
    for l in "${(@f)${text%.}}"; do
      if [[ $l == image ]]; then v=
      elif [[ $l == 'image '* ]]; then v=${l#image }
      else continue; fi
      [[ $v =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' && $v == "$MATCH" ]] \
        || { REPLY="$WINDOW holds an image line that is not an image name"; return 1 }
      list+=($v)
    done
  fi
  list=(${(ou)list})
  ru_protected_n=${#list}
  if (( ${#list} )); then text="${(F)list}"$'\n'; else text=; fi
  ru_write $PROTECTED "$text"
}

# ---- the pass
ru_collect() {
  local pass=$1 statefile=$2 obsfile=$3 now=$4 held=${5-} before after f names lines_json sets_json fam_json
  local -a fargs
  ru_pass=$pass
  ru_boundary $statefile
  ru_proc || return 1;               before=$REPLY
  ru_capture $RUNLOG || return 1
  ru_proc || return 1;               after=$REPLY
  ru_text $pass/log.txt || return 1
  if [[ $before == null ]]; then ru_say "runscaler: none running ($RUNNER run --config $CONFIG)"
  elif [[ $before == "$after" ]]; then ru_say "runscaler: $before"
  else ru_say "runscaler: $before before the log position, $after after it: the position is no boundary of one process"; fi
  ru_say "log: ${RUNLOG:t} at offset $ru_offset; $ru_why"
  ru_config || return 1
  ru_families || return 1
  if [[ -n $held ]]; then   # a pass: the candidates, back_untils and STOPs the updater's state holds
    names=$(print -r -- $held | $JQ -r '.families | to_entries[]
              | select(.value.candidate != null or .value.back_until != null) | .key') \
      || { REPLY="jq could not read the families of the state"; return 1 }
    for f in ${(f)names}; do
      (( ${+ru_fam[$f]} )) \
        || { REPLY="the state holds a candidate or a back_until for the family $f, which $FAMILIES does not name"; return 1 }
    done
  else                      # report: the observed families, no back_until, no STOP
    ru_observe $obsfile $now || return 1
    held=$(print -r -- $ru_observed | $JQ -c '{families: map_values({candidate: ., back_until: null}), stops: []}') \
      || { REPLY="jq could not read the observed families"; return 1 }
  fi
  ru_healthz $pass/healthz.json || { REPLY="cannot write $pass/healthz.json"; return 1 }
  local -a pairs
  for f in ${(k)ru_lines}; do pairs+=($f $ru_lines[$f]); done
  lines_json=$($JQ -n -c '[$ARGS.positional as $a | range(0; $a | length; 2) | {($a[.]): $a[. + 1]}] | add // {}' \
                 --args $pairs) || { REPLY="jq failed on the config lines"; return 1 }
  sets_json=$($JQ -n -c '$ARGS.positional' --args $ru_sets) || { REPLY="jq failed on the sets"; return 1 }
  for f in $ru_fam_order; do fargs+=("$f|$ru_fam[$f]"); done
  fam_json=$($JQ -n -c --argjson held $held '[$ARGS.positional[] | split("|") | {(.[0]): {provider: "tart",
                 sets: (.[1] | split(" ")), candidate: ($held.families[.[0]].candidate // null),
                 back_until: ($held.families[.[0]].back_until // null)}}] | add // {}' \
                 --args $fargs) || { REPLY="jq failed on the families"; return 1 }
  $JQ -n --argjson before $before --argjson after $after --arg inode $ru_inode --argjson offset $ru_offset \
      --arg sha $ru_sha_now --argjson continuous $ru_continuous --argjson installed $ru_installed \
      --argjson lines $lines_json --argjson sets $sets_json --argjson families $fam_json --argjson held $held \
      '{format: 1, host: "studio", sets: $sets, proc: {before: $before, after: $after},
        position: {inode: $inode, offset: $offset, sha: $sha}, continuous: $continuous, restart: null,
        config: {installed: $installed, lines: $lines}, families: $families, stops: $held.stops}' > $pass/facts.json \
    || { REPLY="jq could not write $pass/facts.json"; return 1 }
  exec {ru_fd}<&-
  return 0
}
