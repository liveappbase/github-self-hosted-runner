#!/bin/zsh -f
# runner-updater-window — the switch window of the runner-image updater on the Studio (PLAN D5, "STUDIO WINDOW"): zsh
# functions that bin/runner-updater sources for `rebuild` and `switch-now` (never run on its own; it reads no argument),
# and RECOVER (ru_recover), which ends an interrupted window, and THE ROLLBACK WINDOW (ru_rollback, ru_rb_window; `back`).
# ONE copy. The pass (bin/runner-updater, pass_act) calls ru_recover first, then ru_rollback FAMILY REASON SINCE on an
# R1 verdict, or ru_window with a due release's version (one window per pass).
#
# The caller holds the updater lock for the whole window, has loaded the state (ru_state), sourced
# bin/runner-updater-lib, exports TZ=UTC and LC_ALL=C, and sets (bin/runner-updater's header has the values): RUNNER
# CONFIG RUNLOG FAMILIES JQ PS CURL HEALTHZ_GAP DD CORE STATE PROTECTED WINDOW WINDOWS PINDIR RELBIN FLAG REAL REALRUN
# LOGDIR TARTDIR BIN LOCK DF DU FLOOR_GIB VALIDATE_GAP CLOSE_WAIT CLOSE_POLL MTIME_WAIT, for RECOVER RECOVER_WAIT
# RECOVER_POLL LSOF, and for the rollback window ROLLBACK_BOUND ACTIONS.
#
# ru_window FAMILY VERSION SHA256 MODE SINCE COMMAND [RECIPE] — ONE switch window: FAMILY's sets go from the image they
#   run (the old image) to a new image its builder makes with runner VERSION (the tarball's SHA256). MODE: idle (the
#   idle pair before runner-disable) | now (switch-now: no idle pair, and it says so). SINCE: when the release became
#   due (the commands: now): a window that waits at START STATE or IDLE 3 days (NO_IDLE_S) from SINCE is STOP NO IDLE.
#   COMMAND (rebuild | switch-now | pass) is journaled. RECIPE: the family's recipe (bin/runner-updater-release,
#   rl_recipe) as the window builds with it: a window that switches keeps it in the candidate (`recipe`), which KEEP's
#   ACCEPT writes as the family's baseline (PLAN D2 :143); none given (or a RECOVER close): none kept. It prints its steps ("runner-updater: window: ...") and every STOP line.
#   Returns 0: the window closed on the new image (switched). 1: a STOP (held in the state, the window ended) or a
#   REFUSE (nothing changed, nothing held). 2: not now (START STATE or IDLE; nothing changed, nothing held). 3: the
#   window journal stays open: a failure the window cannot end itself; RECOVER ends it.
#
# THE ORDER. Before runner-disable (each failure: no journal, no runner-disable, NO drain):
#   1. FAMILY LINES: the config is copied once (the window's BACKUP, WDIR/config.toml.backup); every set of the family
#      that the copy has must name ONE image, the old image, on a non-comment runner-image line; else STOP check failed.
#      The old image must be on this host (tart list), and the builder's output must not be: an existing output that no
#      open window journals as ours = no window (STOP check failed). The host pin must be absent or one line.
#   2. START STATE: FLAG present, one runscaler running, the config installed (its mtime) before that runscaler
#      started (whole seconds), and every family set ready on one /healthz read (a set not ready for 24 h by the core
#      state's not_ready_since is excused). Else not now.
#   3. DISK: free disk on TARTDIR's volume (df -Pk, GiB rounded down) >= FLOOR_GIB (golden-build's) + the old image's
#      size (du -sk of TARTDIR/vms/OLD, GiB rounded up). Else, or a size it cannot read: STOP DISK.
#   4. `runner-enable --check` (the release's own runner-enable: it has --check) passes; else STOP check failed.
#   5. PRE-VALIDATE: the backup (the current config: a switch's target image does not exist yet) as a temp copy,
#      `runner-start validate BACKUP`, under the ONE VALIDATE RULE (below); else STOP check failed.
#   6. FROM: the runscaler the window will stop, read once (ps). It is the window's `from` (THE OWN RESTART, below)
#      only when it is the state's boundary process (the one the last pass saw at its position); else `from none`.
#      Then the idle pair LAST (MODE idle): two /healthz reads HEALTHZ_GAP apart, decided by core/idle.jq over EVERY set
#      of the config; not idle = not now. MODE now skips it and says so. Every host read and check comes before it.
#   7. The window's start: the journal's header (below), the protected list rewritten (it holds the old image and the
#      builder's names from here on), then the config's sha once more: another sha than the backup's = no window (the
#      journal closes; REFUSE). After the last /healthz read only these local writes come before runner-disable.
# The window (each step's journal line BEFORE its side effect; a journal write that fails stops before it, and the
# journal stays open: return 3):
#   8. runner-disable. A failure: the journal stays open (return 3). Then `stopped`: when no runscaler runs (ps), the
#      log position (RUNLOG's inode, offset and the sha of the 64 bytes before it, as a pass captures it), and no
#      runscaler runs after it either; else `stopped none`.
#   9. The pin: PINDIR/FAMILY = "VERSION SHA256" by rename (D2: the window writes it before its build), then
#      `golden-build --print-runner` must say "host pin VERSION".
#  10. `golden-build --date DATE` (DATE: the window's UTC day, journaled): exit 0, exactly one DONE line naming the
#      output, and the runner line naming VERSION.
#  11. `golden-gate OUTPUT --journal WINDOW` (it journals its clone): GREEN (exit 0) only.
#  12. `runner-enable --check` again.
#  13. The target: the backup with the family's runner-image lines set to the output (ru_w_edit: those lines and no
#      other change), validated as a temp copy under the ONE VALIDATE RULE.
#  14. CONFIG EDIT, under the runner lock (LOCK, zsystem flock: no install, golden-build or golden-gate runs meanwhile):
#      the config's sha compared with the backup's again: another = A HAND CHANGE UNDER THE RUNNER LOCK (below): no
#      edit, STOP HAND CHANGE, CI on the file as found only when a copy of it validates. Else the target is installed by
#      rename (FILE.new, synced, renamed: its mtime is the install time), then `runner-start validate` under the ONE
#      VALIDATE RULE; a STOP class = the backup back (by rename), STOP check failed, CI enabled on the backup. CI is
#      never enabled on a config that just failed validate. Before and after each try, the config's sha must still be
#      the edit's: another = a HAND CHANGE AFTER THE INSTALL (below).
#  15. ENABLE: the clock's second past the config's mtime (equal is not proven; an mtime more than MTIME_WAIT s ahead of
#      the clock: A FUTURE MTIME, below), the config's sha still the one the window chose (on this path the edit's;
#      else a HAND CHANGE AFTER THE INSTALL), `enable-start`, runner-enable, `enable-done`, then the TARGET runs: FLAG
#      present, one runscaler started after the config's mtime, and the config's family lines = the last TARGET,
#      within CLOSE_WAIT seconds (polled every CLOSE_POLL; ru_w_wait_target). That read is `to`. EVERY runner-enable
#      of the window passes the sha of the file it chose (ru_w_enable EXPECT; S3b-3 review r2 carry (1)): the edit; the
#      backup after it went back; the file as found after a HAND CHANGE under the runner lock that validated. Another
#      sha at that point is A HAND CHANGE AFTER THE INSTALL. `installed` journals the mtime and the sha of that file.
#      A PRE-CLOSE FAILURE (runner-enable refuses, or the target does not run in time) happens at most ONCE per journal:
#      the first time, runner-disable, the backup back when the config is the window's edit, a STOP check failed (a
#      switch's; a rollback's: ROLLBACK FAILED), and CI enabled again on the file it chose (the backup when it went
#      back; a new TARGET); the second time, STOP POOL DOWN with the hand line, and no runner-disable follows.
# A failure in 9-13 (and 14's validate): STOP check failed, the backup back when the config is the window's edit, CI
# enabled on the config (15). The window waits for its last TARGET to run (15) and closes in the same run: a later pass
# could close it, but this release's pass ends at an open journal ("RECOVER needed"), so every switch would stop there.
# A HAND CHANGE AFTER THE INSTALL (the config's sha changes before, during or between the post-edit validate tries, or
# after the window chose the file to enable CI on): a person's file. Nothing goes over it and CI is not enabled on it
# (it failed validate, or was never validated): STOP HAND CHANGE, CI stays down, and the journal stays open (return 3)
# for RECOVER, which enables CI on that file only when it validates first.
# A HAND CHANGE UNDER THE RUNNER LOCK (14; PLAN :236-243 as amended, S3b-4a r1 F6; ru_w_hand_lock, both windows): the
# config's sha under the lock is not the backup's: a person's file. No edit, STOP HAND CHANGE (`hand-change`). ONE RULE
# for a file the updater did not write, wherever it is found (here, AFTER THE INSTALL, RECOVER): CI only after it
# validates. A copy (WDIR/config.toml.hand) is validated under the ONE VALIDATE RULE (step `hand`): PASS (or API-ONLY
# three times) = CI on that file (ru_w_enable on its sha), the window closes held; NON-API or UNKNOWN = no
# runner-enable, CI stays down (FLAG absent), the journal stays open with its `hand-change` line (return 3), and the
# STOP tells the person to check the file and run runner-enable by hand; RECOVER validates it again. A rollback that
# puts back its OWN journaled backup (a known sha) is not this case. RESIDUAL (named by the plan owner): a hand edit
# after the last sha check (ru_w_enable's, just before runner-enable) and before runner-start reads the file cannot be
# closed by any check before the start; it is seen after the start (the close's TARGET read, RECOVER step 1's sha
# compare, the next window's FAMILY LINES).
# A FUTURE MTIME (the config's mtime more than MTIME_WAIT s ahead of the clock: clock skew, a hand `touch`): the window
# cannot prove that runscaler read the file, and does not wait for it. The window's failure STOP (check failed; a
# rollback's: ROLLBACK FAILED, S3b-4a r1 P3-4); the file as found is copied
# to WDIR/config.toml.found (`found`), the backup goes back (`restore`) and CI is enabled on it. A second one in the
# same window: the journal stays open (return 3).
# THE OWN RESTART (PLAN D6; core/README.md, facts.restart): a window that read `from` (6), captured `stopped` (8), saw
# its target run (`to`, 15) and had no pre-close failure records {from, to, stopped} in the state's `restart` member at
# its close; the next pass passes it as facts.restart once and clears it, so the window's own restart is no evidence
# gap. Every other window that ran runner-disable removes the member (a gap is the safe default). A pre-close failure
# records none: the text between its two runner-disables may be a third runscaler's.
# CLOSE: the pin by D2's ONE RULE (the version of the image the family's lines name in the config that runs: the
#   state's image record, this window's output, else the version golden-build's log printed for that image; its sha:
#   this window's, the pre-window pin's or the release literal's (RELBIN/golden-build), whichever is of that version,
#   else the sha the family's pin had for that version in its newest closed journal that names one (a `pin-write`,
#   `pin-rule` or `pin-before` line: a rollback's restored version; S3b-4a r1 F4); none found: the pin is REMOVED, and
#   status shows "none"); the state (switched: the family's candidate = {VERSION,
#   the new lines, closed_at[, recipe]}, previous = the old image's lines (but an OPEN candidate's `previous` stays,
#   below), back_until null, images: the output's VERSION and the
#   old image's when known; `restart` (THE OWN RESTART); the STOPs by THE STOP RULE, and a PINNED RUNNER RETIRED of an
#   older version cleared (below)); `closed`; the journal renamed to WINDOWS/ID; the protected list rewritten.
#   SUPERSEDE (PLAN D6 AFTER ACCEPT, 11-04): a switched close of a family that holds a KEEP (no candidate and a
#   back_until, from before the window) ends that keep: the old image (the accepted one) is the `back` target until
#   the new candidate's ACCEPT + 7 days, and each image the old `previous` named that is not the old image leaves the
#   protected list with the rewrite and is deleted by its recorded name after the journal closed (ru_w_delete: in the
#   image record, no non-comment config line names it, no journal open; `delete NAME` in ACTIONS first). Until the
#   close, the list keeps it (the state still names it). It supersedes ONLY a keep (S3b-4b r2 P2-2): a switched close
#   of an OPEN candidate whose lines the family ran at the start (a rebuild or switch-now of the image under
#   observation) keeps `previous`, the image before the candidate's version (the rollback target and `back`'s), and
#   deletes nothing; the old candidate's image leaves the protected list (golden-prune may delete it). A held close
#   supersedes nothing.
#   PINNED RUNNER RETIRED (PLAN D7, 11-04): a switched close to a version newer than a held RETIRED STOP's clears that
#   STOP, and says so (the family runs the newer image); a held close (the backup back, or no edit) leaves it.
#   THE OBSERVATION STOPs (S3b-4b r3 P3-1): a switched close drops the family's JOBS FAIL ON THE NEW IMAGE and NO
#   EVIDENCE, as a rolled-back close and PINNED RUNNER RETIRED's do: they judged the candidate this window replaced,
#   and KEEP judges the new one (HAND CHANGE's line is `rebuild FAMILY`, so a rebuild of an open candidate is a
#   supported path). A held close keeps them.
#   A held close whose gate did not pass (no `gate green 0` line) first deletes the builder's names (the output, the
#   work VM) that tart lists, each journaled first (`delete`), and only when no non-comment line of the config names it
#   (PLAN D5, RECOVER step 3): golden-prune would keep a gate-RED image as the way back. The old image is never one.
# THE STOP RULE: a window's STOPs replace the family's held STOPs of the same names. A STOP before runner-disable
# replaces nothing else: a held POOL DOWN, NO IDLE (its release) or DISK still holds, and it proved nothing about them.
# A window that ran runner-disable also replaces the family's other window STOPs (check failed, HAND CHANGE, NO IDLE,
# DISK), and a held POOL DOWN (CI is down on the host) only when it saw its target run (`running`). A STOP that no
# window raises stays, except where the CLOSE's own rules drop it (above: PINNED RUNNER RETIRED, THE OBSERVATION
# STOPs).
#
# THE ONE VALIDATE RULE (PLAN D5), ru_w_validate: up to 3 tries VALIDATE_GAP seconds apart, each classified by
# bin/validate-class: PASS ends it; API-ONLY tries again, and after the third counts as PASS; NON-API or UNKNOWN is a
# STOP class at once. Each try's whole output is WDIR/validate-STEP-N.out.
# A journal value made from a tool's text (`build-failed`, `pre-close-failure`, `stop`) goes through ru_w_clean: one
# line, each control character a `?`, at most 900 bytes. runner-journal refuses a control character or more than 1000
# bytes, and a refused line would end the window before the step it names. The state keeps a STOP's text whole.
#
# THE WINDOW JOURNAL, WINDOW (STATEDIR/window; absent = no window open). One `KEY VALUE` line per fact, appended and
# synced by bin/runner-journal BEFORE its side effect. The window's folder WDIR = WINDOWS/ID.d keeps its files; a
# closed journal is renamed to WINDOWS/ID. RECOVER reads only this file, and each line only by these patterns (ru_rc_pat
# holds them: ONE copy; V = [0-9]+\.[0-9]+\.[0-9]+, H = [0-9a-f]{64}, I = [A-Za-z0-9][A-Za-z0-9._-]*, S =
# [A-Za-z0-9][A-Za-z0-9._-]{0,99}, P = an absolute path with no space), in this order (a key in [] may be absent; |
# = one of):
#   window ID                 ^window [0-9]{14}-[0-9]+$                      (UTC yyyymmddHHMMSS-pid)
#   family FAMILY             ^family [a-z][a-z0-9-]{0,40}$
#   kind switch | rollback    ^kind (switch|rollback)$     (a rollback: THE ROLLBACK WINDOW, below; its own keys too)
#   command C                 ^command (rebuild|switch-now|pass|back)$
#   version V | none          ^version (V|none)$  (a rollback: the version it leaves, none when not known)
#   [reason TEXT]             ^reason .+$         (a rollback: R1's reason, or "back by a person")
#   [verdict H]               ^verdict H$         (an automatic rollback: the sha of WDIR/verdict.json, R1's verdict
#                                            whole, written before; RECOVER's ROLLED BACK reads it only by this sha)
#   [reject V | none]         ^reject (V|none)$   (a rollback: the version its close rejects, decided before it starts)
#   runner-sha H              ^runner-sha H$
#   date D                    ^date [0-9]{8}$                                 (golden-build --date D)
#   image I                   ^image I$     (three: the old image, the builder's work VM gold-D, its output; ru_protect
#                                            and golden-prune keep every one while the journal is open)
#   tool NAME DEV INODE P     ^tool (golden-build|golden-emudhra|golden-gate|real-run) [0-9]+ [0-9]+ P$
#                                           (each tool script the builder and the gate run, resolved through links)
#   pin-before none | V H     ^pin-before (none|V H)$
#   target S=I...             ^target S=I( S=I)*$   (the family's lines a TARGET config names, sets in config order;
#                                            appended, never rewritten: the LAST one is what must run)
#   validate STEP N CLASS     ^validate (pre|target|post|recover|hand) [1-3] (PASS|API-ONLY|NON-API|UNKNOWN)$
#                                            (WDIR/validate-STEP-N.out; `recover`: RECOVER's validate of a copy of a
#                                            rollback's installed lines; `hand`: of a person's file, the window's or
#                                            RECOVER's)
#   idle idle | skipped       ^idle (idle|skipped)$
#   from PID START | none     ^from ([0-9]+ [0-9]+|none)$   (the runscaler read before the idle pair, when it is the
#                                            state's boundary process: THE OWN RESTART's `from`)
#   config-sha H              ^config-sha H$                                  (the pre-window config = the backup)
#   backup P                  ^backup P$
#   disable-start             ^disable-start $                               (before runner-disable)
#   [disable-failed RC]       ^disable-failed [0-9]+$                         (the journal stays open)
#   disable-done              ^disable-done $
#   stopped INODE OFFSET H | none   ^stopped ([0-9]+ [0-9]+ H|none)$  (the log position after the first
#                                            runner-disable, no runscaler running: THE OWN RESTART's `stopped`)
#   pin-write V H             ^pin-write V H$                                 (before the pin's rename)
#   build-start D             ^build-start [0-9]{8}$                          (before golden-build)
#   build-failed WHY          ^build-failed .+$  |  build-done I              ^build-done I$
#   gate-start I              ^gate-start I$                                  (before golden-gate)
#   gate-clone NAME           (golden-gate's own line, before its clone)
#   gate RESULT RC            ^gate (green|red|stop|other) [0-9]+$
#   enable-check pass|fail    ^enable-check (pass|fail)$
#   edited-sha H              ^edited-sha H$       (the target's sha, before it is installed; the config may be it;
#                                            a rollback journals it before runner-disable)
#   [hand-change H]           ^hand-change (H|unreadable)$  (the config's sha found under the runner lock: no edit,
#                                            CI only after a `validate hand` PASS; or after the install: the journal
#                                            stays open, CI down)
#   [found P]                 ^found P$            (A FUTURE MTIME: before the file as found is copied to P)
#   [restore P]               ^restore P$          (before the backup goes back over the config)
#   installed EPOCH H C       ^installed [0-9]+( H( H)?)?$  (the config's mtime, the install time the start must
#                                            pass; its sha: the file runner-enable starts; and the sha of its CONTENT
#                                            (ru_w_shas, the same read: RECOVER step 1 compares it, S3b-4a r2 P3-c). An
#                                            older window's line has no sha, or no content sha)
#   enable-start              ^enable-start $      (BEFORE runner-enable)
#   [enable-refused RC]       ^enable-refused [0-9]+$
#   enable-done               ^enable-done $
#   [pre-close-failure WHY]   ^pre-close-failure .+$   (at most once followed by runner-disable; the second: POOL DOWN)
#   running PID START         ^running [0-9]+ [0-9]+$  (the last TARGET runs)
#   stop NAME: TEXT           ^stop (check failed|HAND CHANGE|POOL DOWN|DISK|NO IDLE|ROLLBACK FAILED|CI DISABLED|
#                                    ROLLED BACK): .*$
#   [delete I]                ^delete I$           (a held close whose gate did not pass: before tart deletes I)
#   pin-rule V H | removed    ^pin-rule (removed|V H)$ (D2's ONE RULE, before the pin is written or removed)
#   state-write switched|rolled|held  ^state-write (switched|rolled|held)$ (before the state is written: the
#                                            family's new candidate, a rollback's end, or only this window's STOPs)
#   closed EPOCH              ^closed [0-9]+$      (before the journal is renamed to WINDOWS/ID)
#   RECOVER's own lines, after the window's:
#   [recover-start EPOCH]     ^recover-start [0-9]+$  (RECOVER's FIRST line, once per journal, when it acts on it: the
#                                            lines before it are the WINDOW's own; S3b-4a r2 N1)
#   [recover-wait EPOCH]      ^recover-wait [0-9]+$  (before its first wait: the one bound starts here)
#   [recover-target H S=I...] ^recover-target H S=I( S=I)*$  (RECOVER's own TARGET, BEFORE its `enable-start`: the sha
#                                            and the family's lines of the config it leaves installed)
# After a failure in the window, the steps from `disable-start` (a pre-close failure: no `stopped` follows its
# runner-disable) or from `found`/`restore`/`target` on repeat in that order; `delete` lines come before `pin-rule`.
# RECOVER appends its own lines (`recover-start` first, then `stop`, `restore`, `delete`, `validate recover`, the enable
# steps) the same way.
# A cut journal: its last line may be lost (runner-journal's residual); the step it names may or may not have started.
# A last line with no newline was cut while it was written: RECOVER drops it.
#
# RECOVER (PLAN D5, RECOVER 1-5), ru_recover: an open window journal that no run holds (the window holds the updater
# lock for its whole run) is ended by the next pass or command, under the updater lock, before anything else starts. It
# reads the journal ONLY by the patterns above (a line no pattern reads, or a key it does not know: STOP, RECOVER
# changes nothing) and the facts. No step on CI depends on jq: jq only reads and writes the state (the STOPs, the image
# record of D2's ONE RULE), so an untested jq (new work only) never stops it; a jq that fails leaves the journal open
# after CI is back. RESIDUAL (S3b-4a r1 P3-6): the caller loads the state with jq BEFORE RECOVER (load_state), so a jq
# that cannot run at all keeps RECOVER from running (the run refuses, and CI stays as the kill left it); PLAN :60's "no
# jq" holds for an untested jq only. Beside the journal it reads only the window's own files the journal names by sha
# (the backup; a rollback's verdict). The family's sets are the journal's (its first TARGET), never the families
# file's. In order:
#   0. The window had closed (its last line is `closed`): only the rename. FLAG present and no `disable-done` (or no
#      `disable-start`): nothing was disabled: the journal closes, no STOP, and the state is not written. FLAG FIRST
#      (S3b-4a r1 F5): FLAG absent with no `disable-start` is "nothing was disabled" only when `disable-start` cannot
#      be the lost line. D1 loses only the LAST line, so it can be lost only when the journal ends at the line written
#      just before it (`backup`; a rollback's `edited-sha`): then its runner-disable may have run, CI is down, and
#      RECOVER goes on as for a disabled window (2 on: CI comes back on the pre-window config; it cannot tell this from
#      a person's runner-disable after the kill). A journal that ends earlier never wrote `disable-start`: its window
#      disabled nothing, FLAG absent is a person's, and nothing restarts (the ROLLBACK precondition's rule); the journal
#      closes, and (S3b-4a r2 P3-b) a no-action STOP CI DISABLED is held that names runner-enable: CI down is never
#      silent. RESIDUAL (S3b-4a r2 P3-b, named): two lost lines (`backup` and `disable-start` after runner-disable ran)
#      are beyond D1's one; they leave the same journal and the same host as a person's runner-disable, so RECOVER does
#      not bring CI back there either: the STOP is what tells a person to. DECIDED ONCE (S3b-4a r2 N1): RECOVER writes
#      `recover-start` before any other line of its own; a journal with that line had an earlier RECOVER act on it and is
#      never "nothing was disabled" again (the FLAG read now may be that RECOVER's own runner-enable), and the F5 rules
#      read the WINDOW's last line, the one before it, never a line RECOVER appended. A journal that ended in POOL DOWN
#      (a `stop POOL DOWN` line, or two `pre-close-failure` lines): it closes held, and RECOVER runs neither
#      runner-disable nor runner-enable.
#   1. FLAG present after the last `enable-start` (the updater's enable), or after an `installed` that is the journal's
#      last line or the WINDOW's last line (the lost line may be `enable-start`, whose runner-enable ran: S3b-4a r1 F5,
#      r2 N1): the config's family lines must be the LAST TARGET (the window's `target` and RECOVER's `recover-target`
#      lines, in order) and its CONTENT the last `installed` line's content sha (the file the last runner-enable
#      started; PLAN D1 as amended 2026-11-03, S3b-4a r2 P3-c: whole-line comments and blank lines are left out, as a
#      comment cannot change what runs; an older line with no content sha: its sha, S3b-4a r1 P3-3), else a person's
#      config runs: STOP HAND CHANGE and no action. The target must run (a runscaler started after the journaled install
#      time, not the file's mtime now) within CLOSE_WAIT s (ru_w_wait_target), and the journal closes; else a pre-close
#      failure (at most once per journal: the second is STOP POOL DOWN, no runner-disable); the first runs runner-disable
#      and RECOVER goes on at 3. A pre-close failure journaled after that enable (the window's, or an earlier
#      RECOVER's: S3b-4a r2 N2) is decided already: no new wait, no second `pre-close-failure`; RECOVER runs the
#      runner-disable it decided and goes on at 3. FLAG present after the last `disable-done` with no `enable-start`
#      after it: a person enabled CI: STOP HAND CHANGE, no action.
#   2. FLAG absent: it waits until nothing is busy (ru_rc_busy): no process of this user has a journaled tool open (by
#      the `tool` lines' dev+inode, over EVERY open file: `LSOF -n -P -a -u UID -F pDi`, never only the executables:
#      zsh holds its script on a descriptor, so a builder whose lockf was killed alone still holds its tool while the
#      lock reads free), no gold-*, n1-* or s1-* VM runs (tart's list), and the release's runner-lock-free says free.
#      A read that fails is busy. ONE bound: RECOVER_WAIT s from the first `recover-wait` line (a run after it checks
#      once): then STOP CI DISABLED (held; it is not held again at the close), the journal stays open, and the next
#      pass checks again.
#   3. A switch's builder names (the work VM, the output, the gate's clone) that tart lists, unless the gate passed
#      (`gate green 0`), and only when no non-comment line of the config names them: deleted, each journaled first
#      (ru_w_prune).
#   4. The config (ru_rc_config): the `edited-sha` -> the backup goes back (`restore`); the `config-sha` -> left;
#      another sha -> a person's file, left as found; CI goes on it only when it validates first (AFTER THE INSTALL: a
#      copy, the ONE VALIDATE RULE, step `hand`) with STOP HAND CHANGE; when it does not validate, STOP HAND CHANGE,
#      CI stays down and the journal stays open (the next pass validates it again). A sha an earlier RECOVER chose
#      (`recover-target`) is enabled with no validate.
#   Then RECOVER's own TARGET (D1): `recover-target` (the sha and the lines of the config it leaves), and
#   5. ru_w_enable on that sha: `enable-start`, runner-enable, `enable-done`, the target runs (`running`); a pre-close
#      failure there is the window's (at most once per journal).
# Its close: the journal's STOPs held again (its CI DISABLED lines are not), then RECOVER's own; a switch whose FIRST
# TARGET (the candidate's lines) ran, with no STOP, switched (the candidate is set: R1 stays armed); one that did not
# and holds no STOP is `check failed` (it was interrupted). Then ru_w_close: the pin by D2's ONE RULE, THE STOP RULE as
# a window that ran runner-disable (a held CI DISABLED is replaced), the protected list.
# A ROLLBACK window's RECOVER: step 4 is CONFIG EDIT's rule. When the journal already decided it (a `stop ROLLBACK
# FAILED` line, a ROLLBACK FAILED this RECOVER raised at step 1, a `pre-close-failure` line: the target did not run
# (S3b-4a r2 N2), or a `validate post|recover N NON-API|UNKNOWN` line: the target's lines just failed validate), the
# backup goes back with NO new validate of them and no runner-enable on them (S3b-4a r1 F2): a pre-close failure and
# NON-API hold ROLLBACK FAILED (retry clears it), UNKNOWN none, and the candidate and its image stay; CI goes on the
# pre-window config, and a failure there is the journal's second pre-close failure (POOL DOWN, no runner-disable). Else the installed target stays when it
# validates (a copy, step `recover`; three API-ONLY count), else the backup goes back (NON-API: STOP ROLLBACK FAILED;
# UNKNOWN: none, it is tried again). A rollback that did not reach its target holds no STOP of its own (R1 stays armed).
# Its ROLLED BACK keeps R1's verdict: WDIR/verdict.json when its sha is the `verdict` line's, else the `reason` text.
# THE `restart` MEMBER beside an open journal (S3b-3 fix r1 carry (b)): a journal that disabled nothing (0) keeps it:
# its runscaler, the member's `to`, was never stopped. Every other close writes `restart` from the journal's own `from`
# and `stopped` lines and the `running` RECOVER saw, with no pre-close failure (THE OWN RESTART), or removes it: the
# older member's `to` was stopped by this journal's runner-disable, and a gap is the safe default.
#
# THE ROLLBACK WINDOW (PLAN D5 ROLLBACK precondition, CONFIG EDIT; D6 ROLLBACK, DELETION, CONNECT-ONLY): ru_rb_window
# FAMILY COMMAND REASON SINCE. ru_rollback FAMILY REASON SINCE is the automatic one, the function a later pass calls on
# an R1 verdict: REASON = r1.jq's verdict of the family, one JSON object {set, failures, connect_only[, reason]} (the
# ROLLED BACK STOP's detail); SINCE = when that verdict began (the 2-h bound). `back FAMILY` is a person's (COMMAND
# back; REASON unused). KIND rollback: the family's sets go from the image they run to the state's `previous` image (the
# switch window's journaled old image; after a rebuild of an open candidate, the image before the candidate's version:
# CLOSE, SUPERSEDE): the TARGET. Returns 0 rolled back (the window closed on the target); 1 a STOP
# (held) or a REFUSE; 2 pending ("rollback pending: ...": nothing changed, nothing held); 3 the journal stays open.
# Before runner-disable (no journal yet; a failure: no runner-disable, NO drain):
#   - the state: one previous image. pass: a candidate, no ROLLBACK FAILED held (R1 starts no rollback window while it
#     holds; `retry FAMILY` or a newer release clears it), REASON an R1 verdict. back: a candidate (before ACCEPT, the
#     D10 rehearsal) or back_until not passed (after ACCEPT); else REFUSE.
#   - FAMILY LINES on the backup: one image, the candidate's lines (else a pending hand edit: STOP HAND CHANGE), and not
#     the target already.
#   - the rejection, decided here and journaled (`reject`): pass: the version it leaves, except a first rollback whose
#     counted failures are all connect-class (CONNECT-ONLY: one retry after 1 h; when the state counts a connect-only
#     rollback of that version already, the family's `connect_only` member, never a STOP: S3b-4a r1 P3-5, this is the
#     second: it rejects). back: only when the version it leaves is newer than
#     the restored image's (both known: the state's image record, else golden-build's log).
#   - FLAG absent (a person disabled CI): "rollback pending: CI disabled by a person": nothing restarts.
#     ru_rb_nocount (S3b-4b r1 P1-1): `flag` here, `hand` at a pending hand edit above: no try could start, so the
#     caller (the pass) does not count this time against the bound: it restarts SINCE.
#   - `runner-enable --check` (else STOP ROLLBACK FAILED); PRE-VALIDATE the TARGET (the backup with the family's lines
#     set to it, ru_w_edit, a temp copy) under the ONE VALIDATE RULE: NON-API = STOP ROLLBACK FAILED at once; UNKNOWN =
#     pending, tried again while the verdict holds, until ROLLBACK_BOUND (2 h) from SINCE, then STOP ROLLBACK FAILED.
#     No START STATE, no DISK, no idle pair: the failing family's demand never blocks a rollback.
#   - THE 2-H BOUND (ru_rb_bound; S3b-4a r1 F3), on every call, before runner-disable: every try that ends with no
#     rollback (a runner-disable time-out, an UNKNOWN validate before or after the edit) is tried again on the next
#     call; past ROLLBACK_BOUND from SINCE, STOP ROLLBACK FAILED and no runner-disable. `back` passes SINCE = now. SINCE
#     is the first pass that could start a try (the pass's r1_since); the STOP's text says so and names it.
#   - ru_w_began (both windows): 1 once the call writes its journal's first line, so it used the pass's ONE window; a
#     call that ends before (pending, not now, a STOP or a REFUSE) leaves it 0 and the pass's window to the next family.
#   - `from` (THE OWN RESTART), R1's verdict whole in WDIR/verdict.json (pass), the journal (window family kind
#     command version reason [verdict] reject image(the image it leaves) image(the target) pin-before target
#     validate... from config-sha backup edited-sha), the protected list, the config's sha again (another: no window,
#     pending).
# The window: runner-disable (the drain finishes busy jobs; a failure, a time-out, is a rollback that cannot START: the
# journal stays open, the next run's RECOVER brings CI back on the backup with no STOP, and the rollback is tried again
# under the bound), `stopped`; CONFIG EDIT under the runner lock as a switch's (another sha: A HAND CHANGE UNDER THE
# RUNNER LOCK: no edit, STOP HAND CHANGE, CI on the file as found only when a copy validates); the target installed and
# `runner-start validate`: CONFIG EDIT's rollback rule: NON-API = the BACKUP back, CI enabled on it, STOP ROLLBACK
# FAILED; UNKNOWN = the backup back, CI on it, no STOP (tried again); CI is NEVER enabled on lines that just failed
# validate; a hand change after the install is a switch's. ENABLE as a switch's (ru_w_enable on the target's sha; a
# pre-close failure puts the backup back: STOP ROLLBACK FAILED). A FUTURE MTIME is ROLLBACK FAILED too.
# Its CLOSE (ru_rb_close): rolled back = the target ran with no STOP: the candidate, previous and back_until cleared,
# `reject`'s version added to rejected, an automatic connect-only rollback counted in `connect_only` ({V: {n, at}}:
# the first, which rejects nothing, and a second whose R1 verdict was connect-only too; the pass's 1-h retry reads
# it), STOP ROLLED BACK (an automatic rollback: R1's failures and connect_only), the
# candidate's observation STOPs (JOBS FAIL ON THE NEW IMAGE, NO EVIDENCE) dropped, the target image's version recorded,
# `restart` as a switch's; after the journal closes, the image it left is deleted by its recorded name when the state
# recorded it as the family's (its candidate's lines, or the image record: one the updater built or adopted; a
# person's hand image stays: S3b-4a r1 P3-1), no non-comment config line names it and no window journal is open
# (DELETION), journaled first in ACTIONS (`delete NAME`). Held: the STOPs only (THE STOP RULE); the candidate stays,
# so R1 stays armed. The pin by D2's ONE RULE (the restored image's version, its sha from the family's journals when it
# is not the literal's). EVERY ROLLBACK FAILED names `runner-updater retry FAMILY` as its hand line, from every raiser
# (THE HAND RULE, ru_w_stopjson: one copy; S3b-4a r1 F1), so `retry` clears it.

typeset -g ru_W='["check failed","HAND CHANGE","POOL DOWN","NO IDLE","DISK","ROLLBACK FAILED","CI DISABLED"]'   # a window's
# THE STOP RULE (the header): kept(...) = the family's STOPs after a window that raised $new; $disabled: it ran
# runner-disable; $running: it saw its target run
typeset -g ru_w_kept='def kept($W; $new; $disabled; $running):
  [(.stops // [])[] | .stop as $s | select(([$new[] | .stop] | index($s)) == null)
   | select(if $s == "POOL DOWN" then ($running | not) elif ($W | index($s)) != null then ($disabled | not)
            else true end)]
  + $new;'
typeset -gi NO_IDLE_S=259200   # D5 NO IDLE: 3 days from eligibility

ru_wsay() { print -r -- "runner-updater: window: $*" }

# ---- small helpers
# FILE -> REPLY = its sha256; 1 when it cannot be read
ru_w_sha() {
  local o
  o=$(/usr/bin/shasum -a 256 < $1 2>/dev/null) || return 1
  [[ $o =~ '^[0-9a-f]{64}  -$' ]] || return 1
  REPLY=${o[1,64]}
}
# FILE -> REPLY = its bytes, exactly; 1 when it cannot be read
ru_w_bytes() {
  REPLY=$(/bin/cat -- $1 && print -rn -- .) || return 1
  REPLY=${REPLY%.}
}
ru_tart() { /usr/bin/env -i HOME=${TARTDIR:h} PATH=/usr/bin:/bin:/usr/sbin:/sbin $REAL "$@" }
# -> REPLY = CONFIG's sha256 now, or "unreadable"
ru_w_csha() { ru_w_sha $CONFIG || REPLY=unreadable }
# FILE -> reply = (its sha256, the sha256 of its CONTENT), from ONE read; 1 when it cannot be read. CONTENT (PLAN D1 as
# amended 2026-11-03, S3b-4a r2 P3-c): the file's lines with whole-line comments (first non-blank character `#`) and
# blank lines removed, each kept line byte for byte with its newline (an inline comment or a space inside a line is a
# change). Only RECOVER step 1's "is the candidate still what runs" compares it; every other check is sha-exact
ru_w_shas() {
  local l o s
  local -a kept
  reply=()
  ru_w_bytes $1 || return 1
  o=$(print -rn -- $REPLY | /usr/bin/shasum -a 256 2>/dev/null) && [[ $o =~ '^[0-9a-f]{64}  -$' ]] || return 1
  s=${o[1,64]}
  for l in "${(@ps:\n:)REPLY}"; do
    [[ $l =~ '^[[:blank:]]*(#|$)' ]] || kept+=("$l")
  done
  o=
  (( ${#kept} )) && o="${(pj:\n:)kept}"$'\n'
  o=$(print -rn -- $o | /usr/bin/shasum -a 256 2>/dev/null) && [[ $o =~ '^[0-9a-f]{64}  -$' ]] || return 1
  reply=($s ${o[1,64]})
}
# TEXT (a tool's) -> REPLY = one journal value: each control character a `?`, at most 900 bytes (LC_ALL=C: bytes)
ru_w_clean() { REPLY=${${1//[[:cntrl:]]/?}[1,900]} }

# KEY VALUE: one journal line, appended and synced BEFORE its side effect; 1 + REPLY when runner-journal fails (it
# prints its own STOP line)
ru_j() {
  /bin/zsh -f $RELBIN/runner-journal $WINDOW $1 "$2" \
    || { REPLY="the window journal $WINDOW could not record '$1' (above): the window stops before that step"; return 1 }
}

# NAME TEXT [HAND]: a STOP this window raises; held in the state for the family when the window ends. Its detail: the
# text, the release's sha (switch-now reruns a NO IDLE's release with it), a hand line for a STOP that needs one
ru_w_stop() {
  ru_w_stopjson "$1" "$2" "${3-}"
  ru_w_stops+=($REPLY)
  print -r -- "runner-updater: STOP $1: $2"
  # one journal line (ru_w_clean: a tab in a tool's output is a `?` there); the state keeps the text whole
  ru_w_clean "$1: $2"
  (( ! ru_w_open )) || ru_j stop $REPLY || true
}

# NAME TEXT [HAND] -> REPLY = the STOP as the state holds it (one JSON object; a jq that fails: the STOP with no
# detail). THE HAND RULE, ONE copy: every STOP a window or RECOVER holds goes through here, so a STOP that needs a hand
# line gets it from every raiser (S3b-4a r1 F1), also one RECOVER holds again from a journal line: POOL DOWN names
# runner-enable; ROLLBACK FAILED names `runner-updater retry FAMILY` (D7: only retry or a newer release clears it, and
# retry clears exactly the STOPs whose status line names it). HAND, when given, wins
ru_w_stopjson() {
  local h=${3-}
  if [[ -z $h ]]; then
    case $1 in
      ("POOL DOWN") h=$BIN/runner-enable ;;
      ("ROLLBACK FAILED") h="runner-updater retry $ru_w_fam" ;;
    esac
  fi
  REPLY=$($JQ -n -c --arg f "$ru_w_fam" --arg s "$1" --arg v "$ru_w_ver" --arg t "$2" --arg h "$h" --arg sha "$ru_w_sha" \
        '{family: $f, stop: $s, version: (if $v == "" then null else $v end), user: null,
          detail: ({text: $t} + (if $sha != "" then {sha: $sha} else {} end) + (if $h != "" then {hand: $h} else {} end))}' \
        2>/dev/null) && [[ -n $REPLY ]] \
    || REPLY="{\"family\":\"$ru_w_fam\",\"stop\":\"$1\",\"version\":null,\"user\":null,\"detail\":null}"
}
# NAME: 0 when this run holds a STOP of that name already (ru_w_stops)
ru_w_hasstop() {
  local s
  for s in $ru_w_stops; do [[ $s == *"\"stop\":\"$1\""* ]] && return 0; done
  return 1
}

# FILTER [JQ OPTION...]: the state changed by FILTER, written by rename (ru_write); 1 + REPLY
ru_w_state() {
  local f=$1 new
  shift
  new=$(print -r -- $ru_state | $JQ -c "$@" $f) && [[ -n $new ]] || { REPLY="jq could not change the state"; return 1 }
  ru_write $STATE "$new"$'\n' || return 1
  ru_state=$new
}
typeset -g ru_w_family_new='{candidate: null, previous: null, back_until: null, rejected: [], recipe: null, stops: []}'

# a STOP before runner-disable, held (THE STOP RULE): it replaces only the family's held STOPs of its own name
ru_w_hold_stops() {
  ru_w_state "$ru_w_kept .families[\$f] = ((.families[\$f] // $ru_w_family_new) | .stops = kept(\$W; \$new; false; false))" \
    --arg f $ru_w_fam --argjson W $ru_W --argjson new "[${(j:,:)ru_w_stops}]" \
    || { print -r -- "runner-updater: STOP the state cannot be written ($REPLY): the STOP above is not held; $STATE is as it was"; return 1 }
}

# ---- the families' builders (PLAN D2 pins, D4 checks): mac-golden is golden-build's (pin PINDIR/mac-golden)
# FAMILY DATE -> REPLY = the builder's output name, reply = (its work VM's name)
ru_w_names() { REPLY=liveapp-mac-golden-$2; reply=(gold-$2) }

# FAMILY LINES: FAMILY -> REPLY = the old image, reply = the family's sets that the config has (config order); 1 +
# REPLY. Reads ru_config's globals (the caller ran ru_config and ru_families)
ru_w_lines() {
  local s img=
  local -a fs=(${(s: :)ru_fam[$1]})
  reply=()
  for s in $ru_sets; do
    (( ${fs[(Ie)$s]} )) || continue
    (( ${+ru_lines[$s]} )) || { REPLY="the set $s of $1 has no runner-image line in $CONFIG"; return 1 }
    [[ -z $img || $ru_lines[$s] == "$img" ]] \
      || { REPLY="the sets of $1 name more than one image in $CONFIG ($img, $ru_lines[$s]): FAMILY LINES must agree"; return 1 }
    img=$ru_lines[$s]
    reply+=($s)
  done
  (( ${#reply} )) || { REPLY="no set of $1 is in $CONFIG"; return 1 }
  REPLY=$img
}
# SETS IMAGE -> REPLY = the TARGET text "S=I S=I ..."
ru_w_target() {
  local s img=$1
  local -a t
  shift
  for s in "$@"; do t+=("$s=$img"); done
  REPLY=${(j: :)t}
}
# FAMILY -> REPLY = the family's lines in CONFIG now as a TARGET text ("S=I ..."); 1 + REPLY
ru_w_lines_now() {
  local s
  local -a t fs
  ru_config || return 1
  fs=(${(s: :)ru_fam[$1]})
  for s in $ru_sets; do
    (( ${fs[(Ie)$s]} )) || continue
    t+=("$s=${ru_lines[$s]-}")
  done
  REPLY=${(j: :)t}
}

# the host pin of FAMILY -> REPLY = none | "V SHA"; 1 + REPLY for a pin that is not one line (golden-build's rule)
ru_w_pin_read() {
  local f=$PINDIR/$1 c
  ru_reach $f || { REPLY="$REPLY: a host pin behind it would look absent"; return 1 }
  [[ -e $f || -L $f ]] || { REPLY=none; return 0 }
  [[ -f $f && ! -L $f && -r $f ]] || { REPLY="the host pin $f is not one line 'VERSION SHA256'"; return 1 }
  ru_w_bytes $f || { REPLY="the host pin $f cannot be read"; return 1 }
  c=${REPLY%$'\n'}
  [[ $c =~ '^[0-9]+\.[0-9]+\.[0-9]+ [0-9a-f]{64}$' && $c == "$MATCH" ]] \
    || { REPLY="the host pin $f is not one line 'VERSION SHA256'"; return 1 }
  REPLY=$c
}
# FAMILY "V SHA": the pin written by rename (synced); 1 + REPLY
ru_w_pin_write() {
  [[ -d $PINDIR ]] || /bin/mkdir -m 700 -- $PINDIR || { REPLY="cannot create $PINDIR"; return 1 }
  ru_write $PINDIR/$1 "$2"$'\n'
}

# the release literal of the builder (RELBIN/golden-build's RUNNER_VERSION and RUNNER_SHA lines) -> reply = (V SHA)
ru_w_literal() {
  local l v= s=
  reply=()
  ru_w_bytes $RELBIN/golden-build || return 1
  for l in "${(@f)REPLY}"; do
    [[ $l =~ '^RUNNER_VERSION=([0-9]+\.[0-9]+\.[0-9]+)([[:space:]]|$)' ]] && v=$match[1]
    [[ $l =~ '^RUNNER_SHA=([0-9a-f]{64})([[:space:]]|$)' ]] && s=$match[1]
  done
  [[ -n $v && -n $s ]] || return 1
  reply=($v $s)
}

# IMAGE -> REPLY = its runner version (D2's ONE RULE): the state's image record; this window's output; else the
# version golden-build's log LOGDIR/golden-<date>.log printed for it (the `start: IMAGE ..., runner V (` line of the
# run that printed `DONE: IMAGE`). 1 when none is found; 2 when jq cannot read the state (that is not "no record")
ru_w_version() {
  local img=$1 v l cand= found=
  v=$(print -r -- $ru_state | $JQ -r --arg i $img '.images[$i] // empty' 2>/dev/null) || return 2
  [[ $v =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] && { REPLY=$v; return 0 }
  [[ -n ${ru_w_out-} && $img == "$ru_w_out" && -n $ru_w_ver ]] && { REPLY=$ru_w_ver; return 0 }
  [[ $img =~ '^liveapp-mac-golden-([0-9]{8})$' ]] || return 1
  [[ -f $LOGDIR/golden-$match[1].log ]] && ru_w_bytes $LOGDIR/golden-$match[1].log || return 1
  for l in "${(@f)REPLY}"; do
    if [[ $l =~ '^golden-build: [0-9]{2}:[0-9]{2}:[0-9]{2} start: ([^ ]+) from [^ ]+, runner ([0-9]+\.[0-9]+\.[0-9]+) \(' ]]; then
      [[ $match[1] == "$img" ]] && cand=$match[2] || cand=
    elif [[ $l =~ '^golden-build: [0-9]{2}:[0-9]{2}:[0-9]{2} DONE: (.+)$' && $match[1] == "$img" && -n $cand ]]; then
      found=$cand
    fi
  done
  [[ -n $found ]] || return 1
  REPLY=$found
}
# VERSION -> REPLY = a sha256 of that runner version: this window's, the pre-window pin's, the release literal's, else
# the one the family's pin had in its newest closed journal that names one (ru_w_sha_journals: a rollback's restored
# version is neither this window's nor, after the updater moved past it, the literal's; S3b-4a r1 F4)
ru_w_sha_for() {
  [[ -n $ru_w_ver && $1 == "$ru_w_ver" && -n $ru_w_sha ]] && { REPLY=$ru_w_sha; return 0 }
  [[ ${ru_w_pinbefore-} == "$1 "* ]] && { REPLY=${ru_w_pinbefore#* }; return 0 }
  ru_w_literal && [[ $reply[1] == "$1" ]] && { REPLY=$reply[2]; return 0 }
  ru_w_sha_journals $1
}
# VERSION -> REPLY = the sha256 the FAMILY's (ru_w_fam's) host pin had for that version, by the closed journals in
# WINDOWS (named WINDOW-ID, newest name first; each read whole, by strict patterns: its first `family` line must be the
# family's): the last `pin-write V H`, `pin-rule V H` or `pin-before V H` line of the newest journal that has one. 1
# none
ru_w_sha_journals() {
  local j l v=$1 fam hit
  [[ $v =~ '^[0-9]+\.[0-9]+\.[0-9]+$' && -d $WINDOWS ]] || return 1
  for j in $WINDOWS/<->-<->(N.On); do
    [[ ${j:t} =~ '^[0-9]{14}-[0-9]+$' ]] && ru_w_bytes $j || continue
    fam= hit=
    for l in "${(@f)REPLY}"; do
      if [[ -z $fam && $l =~ '^family ([a-z][a-z0-9-]{0,40})$' ]]; then fam=$match[1]
      elif [[ $l =~ '^pin-(write|rule|before) ([0-9]+\.[0-9]+\.[0-9]+) ([0-9a-f]{64})$' && $match[2] == "$v" ]]; then hit=$match[3]; fi
    done
    [[ $fam == "$ru_w_fam" && -n $hit ]] && { REPLY=$hit; return 0 }
  done
  return 1
}

# ---- what the commands switch to
# rebuild: FAMILY -> reply = (V SHA) of the image its sets run now; 1 + REPLY (REFUSE), 2 + REPLY (FAMILY LINES: a
# STOP). The caller ran ru_config and ru_families
ru_w_current() {
  local old v
  ru_w_lines $1 || return 2
  old=$REPLY
  ru_w_out= ru_w_ver= ru_w_sha=
  ru_w_version $old || { REPLY="the runner version of $old, the image $1 runs, is not known: the state has no record of it and no golden-build log in $LOGDIR names it"; return 1 }
  v=$REPLY
  ru_w_pin_read $1 && [[ $REPLY != none ]] && ru_w_pinbefore=$REPLY || ru_w_pinbefore=
  ru_w_sha_for $v || { REPLY="no sha256 of runner $v is known (not the host pin's, not the release literal's)"; return 1 }
  reply=($v $REPLY)
}
# switch-now: FAMILY -> reply = (V SHA) of the release its NO IDLE STOP holds; 1 when it holds none
ru_w_due() {
  local t
  t=$(print -r -- $ru_state | $JQ -r --arg f $1 '[(.families[$f].stops // [])[] | select(.stop == "NO IDLE")
        | select((.version | type) == "string" and (.detail.sha | type) == "string")] | last // empty
        | "\(.version) \(.detail.sha)"' 2>/dev/null) || return 1
  [[ $t =~ '^([0-9]+\.[0-9]+\.[0-9]+) ([0-9a-f]{64})$' ]] || return 1
  reply=($match[1] $match[2])
}

# ---- the checks
# not now: REASON. A release due 3 days (NO_IDLE_S) from SINCE is STOP NO IDLE (held: return 1), else return 2
ru_w_notnow() {
  if (( EPOCHSECONDS - ru_w_since >= NO_IDLE_S )); then
    ru_w_stop "NO IDLE" "$1 (due since $(strftime '%Y-%m-%d %H:%M UTC' $ru_w_since))"
    ru_w_hold_stops
    return 1
  fi
  print -r -- "runner-updater: $ru_w_cmd $ru_w_fam: not now: $1; nothing changed"
  return 2
}

# START STATE (D5): 0, or 1 + REPLY (why not now). Reads ru_config's globals of the backup copy
ru_w_start_state() {
  local start reads
  [[ -e $FLAG ]] || { REPLY="START STATE: CI is disabled ($FLAG is absent)"; return 1 }
  ru_proc || { REPLY="START STATE: $REPLY"; return 1 }
  [[ $REPLY =~ '^\{"pid":([0-9]+),"start":([0-9]+)\}$' ]] || { REPLY="START STATE: runscaler is not running"; return 1 }
  start=$match[2]
  (( ru_installed < start )) \
    || { REPLY="START STATE: $CONFIG was installed at $ru_installed, not before runscaler started ($start): it has not read it yet"; return 1 }
  ru_healthz $ru_w_dir/start-healthz.json 1 > /dev/null || { REPLY="START STATE: cannot write $ru_w_dir/start-healthz.json"; return 1 }
  reads=$(print -r -- $ru_state | $JQ -r --slurpfile h $ru_w_dir/start-healthz.json --argjson now $EPOCHSECONDS \
            --args '(.core.not_ready_since // {}) as $nrs | $ARGS.positional[] as $s
              | ([$h[0].scale_sets[]? | select(.name == $s)] | .[0]) as $r
              | select(($r.ready != true) and ((($nrs[$s] // $now) | $now - .) < 86400)) | $s' $ru_w_fsets 2>/dev/null) \
    || { REPLY="START STATE: jq could not read the /healthz read"; return 1 }
  [[ -s $ru_w_dir/start-healthz.json ]] || { REPLY="START STATE: no /healthz read"; return 1 }
  [[ -z $reads ]] || { REPLY="START STATE: not ready on /healthz: ${(j:, :)${(f)reads}}"; return 1 }
}

# DISK (D5): OLD -> 0, or 1 + REPLY
ru_w_disk() {
  local vol=$TARTDIR free kib img need
  [[ -d $vol ]] || vol=${TARTDIR:h}
  free=$($DF -Pk $vol 2>/dev/null | /usr/bin/awk 'NR==2 {print int($4/1048576)}')
  [[ $free =~ '^[0-9]+$' ]] || { REPLY="cannot read the free disk of $vol"; return 1 }
  kib=$($DU -sk $TARTDIR/vms/$1 2>/dev/null | /usr/bin/awk 'NR==1 {print $1}')
  [[ $kib =~ '^[0-9]+$' ]] || { REPLY="cannot read the size of the image $1 ($TARTDIR/vms/$1)"; return 1 }
  (( img = (kib + 1048575) / 1048576, need = FLOOR_GIB + img ))
  (( free >= need )) \
    || { REPLY="free disk ${free} GiB < ${need} GiB (the builder's floor ${FLOOR_GIB} GiB + the image $1 ${img} GiB) on $vol"; return 1 }
  ru_wsay "DISK: free ${free} GiB >= ${need} GiB (the builder's floor ${FLOOR_GIB} GiB + the image ${img} GiB)"
}

# `runner-enable --check`: 0, or 1 + REPLY
ru_w_check() {
  local t rc
  t=$($RELBIN/runner-enable --check 2>&1)
  rc=$?
  (( rc == 0 )) && [[ ${t##*$'\n'} == 'runner-enable: check passed ('*')' ]] && return 0
  REPLY="runner-enable --check (exit $rc): ${${t##*$'\n'}:-no output}"
  return 1
}

# THE ONE VALIDATE RULE: STEP [CONFIG] -> 0 (PASS, or API-ONLY after its third try), or 1 + REPLY (a STOP class).
# Each try's whole output: WDIR/validate-STEP-N.out; each result into ru_w_vals ("STEP N CLASS") and, while the
# journal is open, the journal
ru_w_validate() {
  local step=$1 n o rc class
  local -a hit
  shift
  for n in 1 2 3; do
    (( n == 1 )) || /bin/sleep $VALIDATE_GAP
    if [[ $step == post ]]; then   # the installed edit, before each try: else a person's file (never validated)
      ru_w_csha; [[ $REPLY == "$ru_w_tsha" ]] || { ru_w_hand_after $REPLY "before post-edit validate try $n"; return 3 }
    fi
    o=$ru_w_dir/validate-$step-$n.out
    $RELBIN/runner-start validate "$@" > $o 2>&1
    rc=$?
    class=$(/bin/zsh -f $RELBIN/validate-class $rc $o 2>/dev/null) || class=UNKNOWN
    [[ $class == (PASS|API-ONLY|NON-API|UNKNOWN) ]] || class=UNKNOWN
    ru_w_vals+=("$step $n $class")
    if (( ru_w_open )); then ru_j validate "$step $n $class" || return 3; fi
    if [[ $step == post ]]; then   # and after it: else the try read a person's file, not the edit
      ru_w_csha; [[ $REPLY == "$ru_w_tsha" ]] || { ru_w_hand_after $REPLY "during post-edit validate try $n"; return 3 }
    fi
    ru_wsay "validate ($step) try $n: $class (exit $rc; its output: $o)"
    case $class in
      (PASS) return 0 ;;
      (API-ONLY) (( n < 3 )) || { ru_wsay "validate ($step): three API-ONLY results count as PASS (the API part reads only URLs and tokens, which a switch never changes)"; return 0 } ;;
      (*)
        hit=(${(M)${(f)"$(<$o)"}:#(runner-start: REFUSE *|  ✗ *)})   # an array: [1] of a scalar is its first letter
        REPLY="validate ($step) is $class (exit $rc)${hit[1]:+: $hit[1]}"
        return 1 ;;
    esac
  done
}

# the idle pair (MODE idle): 0 idle; 1 + REPLY not idle; 2 + REPLY the core could not decide
ru_w_idle() {
  local h=$ru_w_dir/idle-healthz.json o=$ru_w_dir/idle.json
  ru_healthz $h > /dev/null || { REPLY="cannot write $h"; return 2 }
  print -r -- $ru_state | $JQ -c '.core // empty' > $ru_w_dir/idle-state.json \
    && $JQ -n -c '{format: 1, sets: $ARGS.positional}' --args $ru_sets > $ru_w_dir/idle-facts.json \
    || { REPLY="cannot write the idle inputs"; return 2 }
  $JQ -n -L $CORE/lib -f $CORE/idle.jq --slurpfile state $ru_w_dir/idle-state.json \
      --slurpfile facts $ru_w_dir/idle-facts.json --slurpfile healthz $h --arg now $EPOCHSECONDS > $o 2> $o.err \
    || { REPLY="core could not decide (idle): ${$(/usr/bin/head -n 1 $o.err 2>/dev/null):-no output}"; return 2 }
  REPLY=$($JQ -r '"\(.verdict) \(.reason)"' $o 2>/dev/null) || { REPLY="core could not decide (idle)"; return 2 }
  [[ $REPLY == 'idle '* ]] && return 0
  REPLY="IDLE: ${REPLY#* }"
  return 1
}

# the dev+inode of each tool script the builder and the gate run (resolved through links): journaled
ru_w_tools() {
  local t p
  typeset -A st
  for t in golden-build golden-emudhra golden-gate real-run; do
    if [[ $t == real-run ]]; then p=$REALRUN; else p=$RELBIN/$t; fi
    p=${p:A}
    zstat -H st $p 2>/dev/null || { REPLY="cannot stat the tool $p"; return 1 }
    ru_j tool "$t $st[device] $st[inode] $p" || return 1
  done
}

# the config edit: IN OUT NEWIMAGE SET...: IN with the non-comment runner-image line of each [[scaleset]] block named
# SET set to NEWIMAGE (the rest of each line, its indent and comment, kept), into OUT; the result read back by
# ru_config must differ from IN only in those lines. 1 + REPLY
ru_w_edit() {
  local in=$1 out=$2 new=$3 l i cur=0 nb=0 n ws='[[:space:]]*'
  shift 3
  local -a sets=($@) lines
  local -A imgat nameof before
  ru_w_bytes $in || { REPLY="cannot read $in"; return 1 }
  lines=("${(@ps:\n:)REPLY}")
  for (( i = 1; i <= ${#lines}; i++ )); do
    l=$lines[i]
    [[ $l =~ "^${ws}(#.*)?\$" ]] && continue
    if [[ $l =~ "^${ws}\\[\\[${ws}scaleset${ws}\\]\\]" ]]; then (( nb++ )); cur=$nb
    elif [[ $l =~ "^${ws}\\[" ]]; then cur=0
    elif (( cur )) && [[ $l =~ "^${ws}runner-image${ws}=" ]]; then imgat[$cur]=$i
    elif (( cur )) && [[ $l =~ "^${ws}name${ws}=${ws}\"([^\"]*)\"" ]]; then nameof[$cur]=$match[1]
    fi
  done
  n=0
  for cur in ${(k)imgat}; do
    (( ${sets[(Ie)${nameof[$cur]-}]} )) || continue
    i=$imgat[$cur]
    [[ $lines[i] =~ "^(${ws}runner-image${ws}=${ws}\")([^\"]*)(\".*)\$" ]] || { REPLY="line $i is not one this edits"; return 1 }
    lines[i]="$match[1]$new$match[3]"
    (( n++ ))
  done
  (( n == ${#sets} )) || { REPLY="$n runner-image lines of ${#sets} sets edited"; return 1 }
  print -rn -- ${(pj:\n:)lines} > $out || { REPLY="cannot write $out"; return 1 }
  # read back: the family's sets name NEWIMAGE, every other line ru_config reads is as it was
  CONFIG=$in ru_config || { REPLY="the backup: $REPLY"; return 1 }
  before=("${(@kv)ru_lines}")
  local -a sets_before=($ru_sets)
  CONFIG=$out ru_config || { REPLY="the edit: $REPLY"; return 1 }
  [[ ${(j: :)ru_sets} == "${(j: :)sets_before}" ]] || { REPLY="the edit changed the sets"; return 1 }
  for l in ${(k)before}; do
    if (( ${sets[(Ie)$l]} )); then [[ ${ru_lines[$l]-} == "$new" ]] || { REPLY="the set $l does not name $new after the edit"; return 1 }
    else [[ ${ru_lines[$l]-} == "$before[$l]" ]] || { REPLY="the edit changed the set $l"; return 1 }; fi
  done
  (( ${#ru_lines} == ${#before} )) || { REPLY="the edit changed which sets have an image"; return 1 }
}

# ---- THE OWN RESTART (the header)
# FROM (step 6): the runscaler the window will stop -> ru_w_from "PID START" when it is the state's boundary process
# (the core state's boundary.owner: the process the last pass saw at its position), else ""
ru_w_read_from() {
  local now b
  ru_w_from=
  ru_proc && [[ $REPLY =~ '^\{"pid":([0-9]+),"start":([0-9]+)\}$' ]] || return 0
  now="$match[1] $match[2]"
  b=$(print -r -- $ru_state | $JQ -r '.core.boundary.owner // empty
        | select((.pid | type) == "number" and (.start | type) == "number") | "\(.pid) \(.start)"' 2>/dev/null)
  [[ $b == "$now" ]] && ru_w_from=$now
  return 0
}
# STOPPED (step 8): after runner-disable returned (the lock is free), with no runscaler running before and after it,
# the log position (ru_capture, as a pass takes it) -> ru_w_stopped "INODE OFFSET SHA", else ""
ru_w_read_stopped() {
  local pos=
  ru_w_stopped=
  ru_proc && [[ $REPLY == null ]] || return 0
  ru_pass=$ru_w_dir ru_fd=
  ru_capture $RUNLOG && pos="$ru_inode $ru_offset $ru_sha_now"
  if [[ -n $ru_fd ]]; then exec {ru_fd}<&-; fi
  [[ $pos =~ '^[0-9]+ [0-9]+ [0-9a-f]{64}$' ]] && ru_proc && [[ $REPLY == null ]] && ru_w_stopped=$pos
  return 0
}
# -> REPLY = the state's `restart` member {from, to, stopped} (core/README.md, facts.restart) when this window read
# `from`, captured `stopped`, saw its target run (`to`) and had no pre-close failure; else null
ru_w_restart() {
  local -a f=(${(s: :)ru_w_from}) t=(${(s: :)ru_w_to}) p=(${(s: :)ru_w_stopped})
  REPLY=null
  (( ${#f} == 2 && ${#t} == 2 && ${#p} == 3 && ! ru_w_preclosed )) || return 0
  REPLY="{\"from\":{\"pid\":$f[1],\"start\":$f[2]},\"to\":{\"pid\":$t[1],\"start\":$t[2]},\"stopped\":{\"inode\":\"$p[1]\",\"offset\":$p[2],\"sha\":\"$p[3]\"}}"
}

# ---- a person's file, and a future mtime
# A HAND CHANGE AFTER THE INSTALL (the header): FOUND WHEN. Nothing goes over the person's file and CI is not enabled
# on it: STOP HAND CHANGE, CI stays down, the journal stays open for RECOVER. Returns 3
ru_w_hand_after() {
  ru_j hand-change $1 || return 3
  ru_w_stop "HAND CHANGE" "$CONFIG changed after the window installed its edit or chose the file to enable CI on ($2; sha $1): the window leaves it as it is and does not enable CI on it, so CI stays down. Check the file, then run \`$BIN/runner-enable\` by hand; the window journal $WINDOW stays open: the next run's RECOVER validates the file before it enables CI"
  return 3
}
# A HAND CHANGE UNDER THE RUNNER LOCK (the header; PLAN :236-243 as amended, S3b-4a r1 F6): SHA, the config's, found
# under the lock (released) before the edit. No edit, STOP HAND CHANGE. CI goes on the file as found ONLY when a copy of
# it validates under the ONE VALIDATE RULE (step `hand`); NON-API, UNKNOWN, or a copy that is not that file: no
# runner-enable, CI stays down, and the journal stays open with its `hand-change` line (RECOVER validates it again).
# -> ru_w_enable's return (0 the file runs, 1 POOL DOWN), or 3 (the journal stays open)
ru_w_hand_lock() {
  local t=$1 copy=$ru_w_dir/config.toml.hand rc
  ru_j hand-change $t || return 3
  if /bin/cp -p -- $CONFIG $copy 2>/dev/null && ru_w_sha $copy && [[ $REPLY == "$t" ]]; then
    ru_w_validate hand $copy
    rc=$?
    (( rc == 3 )) && return 3
  else
    rc=1 REPLY="it cannot be copied whole to $copy"
  fi
  if (( rc == 0 )); then
    ru_w_stop "HAND CHANGE" "$CONFIG changed inside the window (sha $t; the window's start: $ru_w_bsha): no edit; a copy of the file as found validates, so CI is enabled on it"
    ru_w_enable $t
    return $?
  fi
  ru_w_stop "HAND CHANGE" "$CONFIG changed inside the window (sha $t; the window's start: $ru_w_bsha): no edit, and the file as found does not validate ($REPLY), so CI is not enabled on it and stays down. Check the file, then run \`$BIN/runner-enable\` by hand; the window journal $WINDOW stays open: the next run's RECOVER validates the file again before it enables CI"
  return 3
}
# A FUTURE MTIME (the header): MTIME. The window's failure STOP (a switch: check failed; a rollback: ROLLBACK FAILED,
# S3b-4a r1 P3-4), the file as found kept in WDIR, the backup back, CI enabled on it (ru_w_enable's return). A second
# one in the window: the journal stays open (3)
ru_w_future() {
  local kept=$ru_w_dir/config.toml.found
  if (( ru_w_futured )); then
    print -r -- "runner-updater: STOP the config's mtime $1 is ahead of the clock again, after the backup went back: the window journal stays open: RECOVER ends it"
    return 3
  fi
  ru_w_futured=1
  ru_w_stop $ru_w_failname "the config's mtime $1 is $(( $1 - EPOCHSECONDS )) s ahead of the clock (more than $MTIME_WAIT s: clock skew, or a hand touch): the window cannot prove that runscaler read it; the file as found is kept as $kept, the backup goes back, and CI is enabled on it"
  ru_j found $kept || return 3
  /bin/cp -p -- $CONFIG $kept || { print -r -- "runner-updater: STOP cannot copy $CONFIG to $kept: the window journal stays open: RECOVER ends it"; return 3 }
  ru_j restore $ru_w_backup || return 3
  ru_w_bytes $ru_w_backup && ru_write $CONFIG $REPLY \
    || { print -r -- "runner-updater: STOP the backup $ru_w_backup cannot go back over $CONFIG: the window journal stays open: RECOVER ends it"; return 3 }
  ru_wsay "the backup is back: $CONFIG = $ru_w_backup"
  ru_w_enable $ru_w_bsha
}

# A held close whose gate did not pass: the builder's names that tart lists are deleted, each journaled first, and only
# when no non-comment line of the config names it (the header). The old image is never one. A delete that fails is
# printed and the close goes on. 3: the journal stays open
ru_w_prune() {
  local n t l named
  local -a jl have cl
  jl=(${(f)"$(<$WINDOW)"})
  (( ${jl[(Ie)gate green 0]} )) && return 0
  t=$(ru_tart list --source local -q 2>/dev/null) \
    || { ru_wsay "tart list failed: the builder's names stay (delete them by hand when no config line names them)"; return 0 }
  have=(${(f)t})
  ru_w_bytes $CONFIG || { ru_wsay "cannot read $CONFIG: the builder's names stay"; return 0 }
  cl=("${(@f)REPLY}")
  local -a names=($ru_w_work $ru_w_out)
  for l in ${(M)jl:#gate-clone *}; do [[ ${l#gate-clone } =~ '^s1-gate-[0-9]{14}$' ]] && names+=(${l#gate-clone }); done
  for n in $names; do
    [[ -n $n && $n != "$ru_w_old" ]] && (( ${have[(Ie)$n]} )) || continue
    named=0
    for l in $cl; do
      [[ $l =~ '^[[:space:]]*#' ]] && continue
      [[ $l == *"$n"* ]] && { named=1; break }
    done
    if (( named )); then ru_wsay "$n stays: a line of $CONFIG names it"; continue; fi
    ru_j delete $n || return 3
    if ru_tart delete $n > /dev/null 2>&1; then ru_wsay "deleted $n (the gate did not pass it)"
    else ru_wsay "cannot delete $n (tart delete failed): delete it by hand when no config line names it"; fi
  done
}

# ---- the window's end
# the journal closes: `closed`, renamed to WINDOWS/ID, the protected list rewritten. 1: it stays open
ru_w_archive() {
  ru_j closed $EPOCHSECONDS || return 1
  /bin/mv -- $WINDOW $WINDOWS/$ru_w_id || { print -r -- "runner-updater: STOP cannot rename $WINDOW to $WINDOWS/$ru_w_id: the window journal stays open"; return 1 }
  ru_w_open=0
  ru_protect $ru_state $EPOCHSECONDS \
    || print -r -- "runner-updater: STOP the protected list cannot be written ($REPLY): $PROTECTED is as it was; \`runner-updater protect\` writes it"
  return 0
}

# D2's ONE RULE, when a journal closes: the pin names the version of the image the family's lines name in the config
# that runs; none found = the pin is removed. 1 + REPLY: the journal stays open
ru_w_pin_rule() {
  local img= l v s f=$PINDIR/$ru_w_fam why
  if ru_config; then
    for l in $ru_sets; do
      (( ${${(s: :)ru_fam[$ru_w_fam]}[(Ie)$l]} && ${+ru_lines[$l]} )) || continue
      if [[ -z $img ]]; then img=$ru_lines[$l]; elif [[ $img != "$ru_lines[$l]" ]]; then img='?'; fi
    done
  fi
  v= s=
  if [[ -n $img && $img != '?' ]]; then
    ru_w_version $img
    case $? in
      (0) v=$REPLY; ru_w_sha_for $v && s=$REPLY ;;
      (2) REPLY="jq cannot read the state's record of $img: the pin is not decided"; return 1 ;;
    esac
  fi
  if [[ -n $v && -n $s ]]; then
    ru_j pin-rule "$v $s" || return 1
    ru_w_pin_write $ru_w_fam "$v $s" || { REPLY="cannot write the pin $f: $REPLY"; return 1 }
    ru_wsay "the pin $f: $v (the version of $img, which the config runs)"
  else
    if [[ -z $img || $img == '?' ]]; then why="the family's lines in $CONFIG name no one image"
    elif [[ -z $v ]]; then why="the runner version of $img is not known"
    else why="no sha256 of runner $v is known"; fi
    ru_j pin-rule removed || return 1
    /bin/rm -f -- $f || { REPLY="cannot remove the pin $f"; return 1 }
    ru_wsay "the pin $f is removed: $why; a hand golden-build uses the release literal (status shows it)"
  fi
}

# CLOSE (after runner-disable): SWITCHED (1 = the new image runs) -> 0 switched, 1 a STOP was held, 3 the journal stays
# open. ONE state write: the family (THE STOP RULE), the image records, the `restart` member (THE OWN RESTART).
# SUPERSEDE (PLAN D6 AFTER ACCEPT, 11-04): a SWITCHED close of a family that holds a KEEP (no candidate, a back_until:
# both from before this window, which writes neither until here) makes the window's old image (the accepted one) the
# family's `previous`; each image the old `previous` named that is not that old image leaves the state, so the
# protected list written at the close no longer names it, and it is deleted by its recorded name after the journal
# closed (ru_w_delete: DELETION). It supersedes ONLY a keep (S3b-4b r2 P2-2): a switched close of an OPEN candidate
# (a rebuild, or switch-now, of the image under observation: the window's old image is the candidate's) keeps
# `previous`, the image before the candidate's version, as the rollback target and `back`'s, and deletes nothing (the
# old candidate's image is no longer protected; golden-prune may delete it). Any other switched close: `previous` = the
# window's old image (PLAN D5 FAMILY LINES), and nothing is deleted. A held close supersedes nothing.
# PINNED RUNNER RETIRED (PLAN D7, 11-04): a SWITCHED close to a version newer than a RETIRED STOP's clears that STOP (the
# family runs the newer image); a held close leaves it. THE OBSERVATION STOPs (S3b-4b r3 P3-1): a SWITCHED close drops
# the family's JOBS FAIL ON THE NEW IMAGE and NO EVIDENCE (they judged the candidate it replaced: KEEP judges the new
# one), as ru_rb_close and the pass's PINNED RUNNER RETIRED do; a held close keeps them
typeset -g ru_w_retired_jq='def vnum: try (split(".") | map(tonumber)) catch null;
  def cleared($v): .stop == "PINNED RUNNER RETIRED" and (.version | type) == "string" and (.version | vnum) != null
    and ($v | vnum) != null and (.version | vnum) < ($v | vnum);'
ru_w_close() {
  local switched=$1 oldv= rs running=false img i keep=false
  local -a sup own retired
  (( switched )) || ru_w_prune || return 3
  if (( switched )); then
    keep=$(print -r -- $ru_state | $JQ -r --arg f $ru_w_fam '(.families[$f] // {}) | .candidate == null and .back_until != null') \
      && [[ $keep == (true|false) ]] || keep=false
  fi
  if [[ $keep == true ]]; then
    for img in ${(f)"$(print -r -- $ru_state | $JQ -r --arg f $ru_w_fam --arg old "$ru_w_old" --arg out "$ru_w_out" \
                        '[(.families[$f].previous // {})[]] | unique | .[] | select(. != $old and . != $out)')"}; do
      sup+=($img)
      # the image record is read before this close writes the state: an image the updater built or adopted
      if print -r -- $ru_state | $JQ -e --arg i $img '(.images // {}) | has($i)' > /dev/null 2>&1; then own+=(1); else own+=(0); fi
    done
  fi
  ru_w_pin_rule || { print -r -- "runner-updater: STOP $REPLY: the window journal stays open: RECOVER ends it"; return 3 }
  ru_w_version $ru_w_old && oldv=$REPLY
  ru_w_restart
  rs=$REPLY
  (( ru_w_running )) && running=true
  # the RETIRED STOPs this close clears (switched: each of a version older than the window's), named after the write
  retired=()
  if (( switched )); then
    retired=(${(f)"$(print -r -- $ru_state | $JQ -r --arg f $ru_w_fam --arg v $ru_w_ver "$ru_w_retired_jq"'
                       [(.families[$f].stops // [])[] | select(cleared($v)) | .version] | unique | .[]')"})
  fi
  ru_j state-write ${${switched:#0}:+switched}${${switched:#1}:+held} || return 3
  ru_w_state "$ru_w_kept $ru_w_retired_jq .families[\$f] = ((.families[\$f] // $ru_w_family_new)
        | if \$sw then
            ((.candidate // null) as \$c | \$c != null and .previous != null and ([\$c.lines[]] | unique) == [\$old]) as \$open
            | .candidate = ({version: \$v, lines: (\$sets | split(\" \") | map({(.): \$out}) | add), closed_at: \$now}
                            + (if \$rec != \"\" then {recipe: \$rec} else {} end))
            | (if \$open then . else .previous = (\$sets | split(\" \") | map({(.): \$old}) | add) end) | .back_until = null
          else . end
        | .stops = kept(\$W; \$new; true; \$running)
        | if \$sw then .stops = [.stops[] | select(cleared(\$v) | not)
                                 | select(.stop != \"JOBS FAIL ON THE NEW IMAGE\" and .stop != \"NO EVIDENCE\")]
          else . end)
      | if \$sw then .images[\$out] = \$v else . end | if \$oldv != \"\" then .images[\$old] = \$oldv else . end
      | if \$rs == null then del(.restart) else .restart = \$rs end" \
      --arg f $ru_w_fam --arg v $ru_w_ver --arg out $ru_w_out --arg old $ru_w_old --arg oldv "$oldv" --arg rec "${ru_w_recipe-}" \
      --argjson now $EPOCHSECONDS --argjson W $ru_W --arg sets "${(j: :)ru_w_fsets}" --argjson rs $rs \
      --argjson sw ${${switched:#0}:+true}${${switched:#1}:+false} --argjson running $running \
      --argjson new "[${(j:,:)ru_w_stops}]" \
    || { print -r -- "runner-updater: STOP the state cannot be written ($REPLY): the window journal stays open: RECOVER ends it"; return 3 }
  for i in $retired; do ru_wsay "STOP PINNED RUNNER RETIRED (runner $i) is cleared: the family runs runner $ru_w_ver"; done
  ru_w_archive || return 3
  for (( i = 1; i <= ${#sup}; i++ )); do
    ru_w_delete $sup[i] $own[i] "the previous image of $ru_w_fam, which this window superseded"
  done
  (( switched )) && return 0
  return 1
}

# ENABLE (step 15): EXPECT -> CI on the config only when its sha is EXPECT, the file the window (or RECOVER) chose
# (ru_w_chosen: every enable passes it, the pre-close path's too); its family lines are the TARGET (a new TARGET line
# when they are not the last one). The file must not change until runner-enable (else A HAND CHANGE AFTER THE
# INSTALL); an mtime more than MTIME_WAIT s ahead of the clock is A FUTURE MTIME. 0 the target runs; 1 POOL DOWN (held
# at the close); 3 the journal stays open
ru_w_enable() {
  local expect=$1 esha lines mtime t rc
  typeset -A st
  ru_w_chosen=$expect
  ru_w_csha
  esha=$REPLY
  [[ -n $expect && $esha == "$expect" ]] || { ru_w_hand_after $esha "before runner-enable"; return 3 }
  ru_w_lines_now $ru_w_fam || { print -r -- "runner-updater: STOP the config cannot be read ($REPLY): the window journal stays open: RECOVER ends it"; return 3 }
  lines=$REPLY
  if [[ $lines != "$ru_w_last_target" ]]; then ru_j target $lines || return 3; ru_w_last_target=$lines; fi
  zstat -H st $CONFIG || { print -r -- "runner-updater: STOP cannot stat $CONFIG: the window journal stays open"; return 3 }
  mtime=$st[mtime]
  if (( mtime > EPOCHSECONDS + MTIME_WAIT )); then ru_w_future $mtime; return $?; fi
  while (( EPOCHSECONDS <= mtime )); do /bin/sleep 0.2; done   # whole seconds: a start in the same second is not proven
  ru_w_shas $CONFIG || reply=(unreadable)
  [[ $reply[1] == "$esha" ]] || { ru_w_hand_after $reply[1] "while runner-enable waited past the install second"; return 3 }
  # the file runner-enable starts: its install time, its sha (S3b-4a r1 P3-3), and the sha of its CONTENT, from the
  # same read (S3b-4a r2 P3-c: RECOVER step 1 compares it)
  ru_j installed "$mtime $esha $reply[2]" || return 3
  ru_j enable-start '' || return 3
  t=$($RELBIN/runner-enable 2>&1)
  rc=$?
  if (( rc != 0 )); then
    ru_j enable-refused $rc || return 3
    ru_w_preclose "runner-enable refused (exit $rc): ${${t##*$'\n'}:-no output}"
    return $?
  fi
  ru_j enable-done '' || return 3
  ru_wsay "enabled: waiting up to $CLOSE_WAIT s for runscaler to start on $lines"
  ru_w_wait_target $lines $mtime
  rc=$?
  (( rc == 0 || rc == 3 )) && return $rc
  ru_w_preclose "the target did not run within $CLOSE_WAIT s (FLAG, a runscaler started after $mtime, the lines $lines)"
}

# LINES MTIME: the TARGET runs: FLAG present, ONE runscaler started after MTIME (whole seconds), and the config's
# family lines = LINES, within CLOSE_WAIT s (polled every CLOSE_POLL): `running`. 0 it runs; 1 not in time; 3 the
# journal could not record it
ru_w_wait_target() {
  local lines=$1 mtime=$2 deadline pid start
  (( deadline = EPOCHSECONDS + CLOSE_WAIT ))
  while :; do
    if [[ -e $FLAG ]] && ru_proc && [[ $REPLY =~ '^\{"pid":([0-9]+),"start":([0-9]+)\}$' ]]; then
      pid=$match[1] start=$match[2]
      if (( start > mtime )) && ru_w_lines_now $ru_w_fam && [[ $REPLY == "$lines" ]]; then
        ru_j running "$pid $start" || return 3
        ru_w_running=1 ru_w_to="$pid $start" ru_w_ran=$lines   # THE OWN RESTART's `to`
        ru_wsay "runscaler $pid started at $start, after the config's install ($mtime): the target runs"
        return 0
      fi
    fi
    (( EPOCHSECONDS < deadline )) || return 1
    /bin/sleep $CLOSE_POLL
  done
}

# a PRE-CLOSE FAILURE: WHY. At most once per journal: the first time runner-disable, the backup back when the config
# is the window's edit, CI enabled again on the file the window chose (the backup when it went back); the second time
# STOP POOL DOWN and no runner-disable
ru_w_preclose() {
  local why=$1
  local -a seen
  seen=(${(M)${(f)"$(<$WINDOW)"}:#pre-close-failure *})   # an array: ${#} of one match would be its length
  ru_w_preclosed=1   # THE OWN RESTART: no record (the text between two runner-disables may be a third runscaler's)
  ru_w_clean $why
  ru_j pre-close-failure $REPLY || return 3
  if (( ${#seen} >= 1 )); then
    ru_w_stop "POOL DOWN" "$why; a second pre-close failure in this window, so no runner-disable follows: CI is down on this host"
    return 1
  fi
  ru_j disable-start '' || return 3
  $RELBIN/runner-disable || { ru_j disable-failed $? ; print -r -- "runner-updater: STOP runner-disable failed (above): the window journal stays open: RECOVER ends it"; return 3 }
  ru_j disable-done '' || return 3
  ru_w_restored=0
  ru_w_unedit || return 3
  (( ru_w_restored )) && ru_w_chosen=$ru_w_bsha
  (( ${#ru_w_stops} )) || ru_w_stop $ru_w_failname "$why"
  ru_w_enable $ru_w_chosen
}

# the backup back over the config when the config is this window's edit (by rename): 0, or 3 (journal stays open)
ru_w_unedit() {
  [[ -n ${ru_w_tsha-} ]] && ru_w_sha $CONFIG && [[ $REPLY == "$ru_w_tsha" ]] || return 0
  ru_j restore $ru_w_backup || return 3
  ru_w_bytes $ru_w_backup && ru_write $CONFIG $REPLY \
    || { print -r -- "runner-updater: STOP the backup $ru_w_backup cannot go back over $CONFIG: the window journal stays open: RECOVER ends it"; return 3 }
  ru_w_restored=1
  ru_wsay "the backup is back: $CONFIG = $ru_w_backup"
}

# a failure after runner-disable (steps 9-14): STOP check failed WHY, the backup back when the config is the edit, CI
# enabled on the config, close. -> ru_w_close's return (1 or 3)
ru_w_back() {
  ru_w_stop "check failed" "$1"
  ru_w_unedit || return 3
  ru_w_enable $ru_w_bsha
  case $? in (0|1) ru_w_close 0; return $? ;; (*) return 3 ;; esac
}

# ---- THE WINDOW
ru_window() {
  local fam=$1 ver=$2 sha=$3 mode=$4 cmd=$6 t rc have old out date csha idle=idle f
  local -a work
  ru_w_fam=$fam ru_w_ver=$ver ru_w_sha=$sha ru_w_since=$5 ru_w_cmd=$cmd ru_w_recipe=${7-} ru_w_began=0
  ru_w_stops=() ru_w_vals=() ru_w_open=0 ru_w_tsha= ru_w_last_target= ru_w_out= ru_w_old= ru_w_pinbefore= ru_w_work=
  ru_w_from= ru_w_stopped= ru_w_to= ru_w_running=0 ru_w_preclosed=0 ru_w_futured=0 ru_w_ran= ru_w_chosen=
  ru_w_restored=0 ru_w_kind=switch ru_w_failname="check failed" ru_w_bsha=
  ru_w_id="$(strftime '%Y%m%d%H%M%S' $EPOCHSECONDS)-$$"
  [[ $ver =~ '^[0-9]+\.[0-9]+\.[0-9]+$' && $sha =~ '^[0-9a-f]{64}$' && $mode == (idle|now) && $5 =~ '^[0-9]+$' ]] \
    || { print -r -- "runner-updater: REFUSE the window's arguments: '$ver' '$sha' '$mode' '$5'"; return 1 }
  [[ $cmd == (rebuild|switch-now|pass) ]] || { print -r -- "runner-updater: REFUSE the window's command: '$cmd'"; return 1 }
  [[ -z $ru_w_recipe || $ru_w_recipe =~ '^[0-9a-f]{64}$' ]] \
    || { print -r -- "runner-updater: REFUSE the window's recipe: '$ru_w_recipe'"; return 1 }
  [[ ! -e $WINDOW && ! -L $WINDOW ]] \
    || { print -r -- "runner-updater: STOP RECOVER needed: the window journal $WINDOW is open (ru_recover ends it first)"; return 1 }
  [[ -d $WINDOWS ]] || /bin/mkdir -m 700 -- $WINDOWS || { print -r -- "runner-updater: REFUSE cannot create $WINDOWS"; return 1 }
  ru_w_dir=$WINDOWS/$ru_w_id.d
  /bin/mkdir -m 700 -- $ru_w_dir || { print -r -- "runner-updater: REFUSE cannot create $ru_w_dir"; return 1 }
  ru_w_backup=$ru_w_dir/config.toml.backup
  ru_wsay "$cmd $fam: runner $ver; the window's files: $ru_w_dir"

  # 1. FAMILY LINES, on the backup: one copy of the config, read once (its mtime kept)
  /bin/cp -p -- $CONFIG $ru_w_backup && ru_w_sha $ru_w_backup \
    || { print -r -- "runner-updater: REFUSE cannot copy $CONFIG to $ru_w_backup"; return 1 }
  csha=$REPLY ru_w_bsha=$REPLY
  CONFIG=$ru_w_backup ru_config && ru_families && ru_pools \
    || { print -r -- "runner-updater: REFUSE $REPLY: no window"; return 1 }
  (( ${+ru_fam[$fam]} )) || { print -r -- "runner-updater: REFUSE no family $fam in $FAMILIES: no window"; return 1 }
  if ! ru_w_lines $fam; then ru_w_stop "check failed" "pre-window: $REPLY"; ru_w_hold_stops; return 1; fi
  ru_w_old=$REPLY ru_w_fsets=($reply)
  old=$ru_w_old
  date=$(strftime '%Y%m%d' $EPOCHSECONDS)
  ru_w_names $fam $date
  out=$REPLY ru_w_out=$REPLY work=($reply) ru_w_work=$reply[1]
  ru_w_target $out $ru_w_fsets
  ru_w_last_target=$REPLY
  t=$(ru_tart list --source local -q 2>/dev/null) \
    || { ru_w_stop "check failed" "pre-window: tart list failed"; ru_w_hold_stops; return 1 }
  have=(${(f)t})
  if (( ! ${have[(Ie)$old]} )); then
    ru_w_stop "check failed" "pre-window: the old image $old is not on this host (tart list): it is the window's way back"
    ru_w_hold_stops; return 1
  fi
  if (( ${have[(Ie)$out]} )); then
    ru_w_stop "check failed" "pre-window: $out already exists and no open window journals it as ours: no window (golden-build makes one image a day: wait a day, or delete it when no config line names it)"
    ru_w_hold_stops; return 1
  fi
  if ! ru_w_pin_read $fam; then ru_w_stop "check failed" "pre-window: $REPLY"; ru_w_hold_stops; return 1; fi
  ru_w_pinbefore=${REPLY:#none}
  t=$REPLY

  # 2. START STATE
  if ! ru_w_start_state; then ru_w_notnow $REPLY; rc=$?; (( rc == 2 )) && /bin/rm -rf -- $ru_w_dir; return $rc; fi
  # 3. DISK
  if ! ru_w_disk $old; then ru_w_stop DISK $REPLY; ru_w_hold_stops; return 1; fi
  # 4. runner-enable --check
  if ! ru_w_check; then ru_w_stop "check failed" "pre-window: $REPLY"; ru_w_hold_stops; return 1; fi
  # 5. PRE-VALIDATE: the current config (the backup) as a temp copy
  if ! ru_w_validate pre $ru_w_backup; then ru_w_stop "check failed" "pre-window $REPLY"; ru_w_hold_stops; return 1; fi
  # 6. `from` (THE OWN RESTART), then the idle pair, last: from its second read on, only local writes come before
  # runner-disable
  ru_w_read_from
  if [[ $mode == now ]]; then
    idle=skipped
    print -r -- "runner-updater: switch-now $fam: no idle pair: runner-disable drains every set now, and a drain stops the jobs still running at its end"
  else
    ru_w_idle
    rc=$?
    if (( rc == 2 )); then print -r -- "runner-updater: REFUSE $REPLY: no window"; return 1; fi
    if (( rc == 1 )); then ru_w_notnow $REPLY; rc=$?; (( rc == 2 )) && /bin/rm -rf -- $ru_w_dir; return $rc; fi
  fi

  # 7. the window's start: the journal, the protected list, the config's sha once more (ru_w_began: this call opened a
  # journal, so it used the pass's one window)
  ru_w_open=1 ru_w_began=1
  { ru_j window $ru_w_id && ru_j family $fam && ru_j kind switch && ru_j command $cmd && ru_j version $ver \
      && ru_j runner-sha $sha && ru_j date $date && ru_j image $old && ru_j image $work[1] && ru_j image $out \
      && ru_w_tools && ru_j pin-before ${ru_w_pinbefore:-none} && ru_j target $ru_w_last_target } || return 3
  for f in $ru_w_vals; do ru_j validate $f || return 3; done
  ru_j idle $idle && ru_j from ${ru_w_from:-none} && ru_j config-sha $csha && ru_j backup $ru_w_backup || return 3
  ru_protect $ru_state $EPOCHSECONDS \
    || { print -r -- "runner-updater: STOP the protected list cannot be written ($REPLY): the window journal stays open"; return 3 }
  if ! ru_w_sha $CONFIG || [[ $REPLY != "$csha" ]]; then
    print -r -- "runner-updater: REFUSE $CONFIG changed while the window checked it (its sha is not the backup's): no window; run $cmd again"
    ru_w_archive || return 3
    return 1
  fi

  # 8. runner-disable
  ru_j disable-start '' || return 3
  ru_wsay "runner-disable (runscaler drains every set)"
  $RELBIN/runner-disable
  rc=$?
  if (( rc != 0 )); then
    ru_j disable-failed $rc
    print -r -- "runner-updater: STOP runner-disable failed (exit $rc, above): FLAG is gone and runscaler may still drain; the window journal stays open: RECOVER ends it"
    return 3
  fi
  ru_j disable-done '' || return 3
  ru_w_read_stopped
  ru_j stopped ${ru_w_stopped:-none} || return 3

  # 9. the pin (D2: before the build), and golden-build reads it
  ru_j pin-write "$ver $sha" || return 3
  ru_w_pin_write $fam "$ver $sha" || { ru_w_back "pin: $REPLY"; return $? }
  t=$($RELBIN/golden-build --print-runner 2>&1)
  [[ $t == "host pin $ver (release literal "*")" ]] \
    || { ru_w_back "pin: golden-build --print-runner printed '${t%%$'\n'*}', not the host pin $ver"; return $? }

  # 10. the build, with the journaled date
  ru_j build-start $date || return 3
  ru_wsay "golden-build --date $date (its output: $ru_w_dir/build.out and $LOGDIR/golden-$date.log)"
  $RELBIN/golden-build --date $date > $ru_w_dir/build.out 2>&1
  rc=$?
  t=$(<$ru_w_dir/build.out)
  local -a done=(${(M)${(f)t}:#golden-build: [0-9][0-9]:[0-9][0-9]:[0-9][0-9] DONE: *})
  local -a runl=(${(M)${(f)t}:#golden-build: [0-9][0-9]:[0-9][0-9]:[0-9][0-9] runner *})
  if (( rc != 0 )); then
    ru_j build-failed "exit $rc" || return 3
    ru_w_back "build: golden-build exit $rc: ${${(f)t}[-1]:-no output}"; return $?
  fi
  if (( ${#done} != 1 )) || [[ ${done[1]#*DONE: } != "$out" ]]; then
    ru_w_clean "DONE ${done[1]#*DONE: }"
    ru_j build-failed $REPLY || return 3
    ru_w_back "build: golden-build's DONE line names '${done[1]#*DONE: }', not $out"; return $?
  fi
  if (( ${#runl} != 1 )) || [[ ${runl[1]#*runner } != "$ver" ]]; then
    ru_w_clean "runner ${runl[1]#*runner }"
    ru_j build-failed $REPLY || return 3
    ru_w_back "build: golden-build's runner line names '${runl[1]#*runner }', not $ver"; return $?
  fi
  ru_j build-done $out || return 3

  # 11. the gate on the saved image
  ru_j gate-start $out || return 3
  $RELBIN/golden-gate $out --journal $WINDOW > $ru_w_dir/gate.out 2>&1
  rc=$?
  case $rc in (0) t=green ;; (1) t=red ;; (2) t=stop ;; (*) t=other ;; esac
  ru_j gate "$t $rc" || return 3
  if (( rc != 0 )) || [[ $(/usr/bin/tail -n 1 $ru_w_dir/gate.out) != "golden-gate: GREEN $out" ]]; then
    ru_w_back "gate: golden-gate $t (exit $rc): $(/usr/bin/tail -n 1 $ru_w_dir/gate.out)"; return $?
  fi

  # 12. runner-enable --check again, before the config edit
  if ru_w_check; then ru_j enable-check pass || return 3
  else ru_j enable-check fail || return 3; ru_w_back $REPLY; return $?; fi

  # 13. the target, as a temp copy, under the ONE VALIDATE RULE
  ru_w_edit $ru_w_backup $ru_w_dir/config.toml.target $out $ru_w_fsets || { ru_w_back "the config edit: $REPLY"; return $? }
  ru_w_sha $ru_w_dir/config.toml.target || { ru_w_back "cannot read $ru_w_dir/config.toml.target"; return $? }
  ru_w_tsha=$REPLY
  ru_w_validate target $ru_w_dir/config.toml.target
  rc=$?
  (( rc == 3 )) && return 3
  (( rc == 0 )) || { ru_w_back $REPLY; return $? }

  # 14. CONFIG EDIT, under the runner lock
  ru_j edited-sha $ru_w_tsha || return 3
  [[ -e $LOCK ]] || ( : >> $LOCK ) 2> /dev/null   # the tmp cleaner may have removed it (runner-disable's header)
  zsystem flock -t 0.01 -f ru_w_lfd $LOCK 2> /dev/null   # -t 0 returns 1 on a held lock (measured): 0.01 returns 2
  case $? in
    (0) ;;
    (2) ru_w_back "the runner lock $LOCK is held: runscaler, an install, wall-check, golden-build or golden-gate is running"; return $? ;;
    (*) ru_w_back "cannot take the runner lock $LOCK"; return $? ;;
  esac
  ru_w_csha
  if [[ $REPLY != "$csha" ]]; then
    t=$REPLY
    zsystem flock -u $ru_w_lfd
    ru_w_hand_lock $t
    case $? in (0|1) ru_w_close 0; return $? ;; (*) return 3 ;; esac
  fi
  ru_w_bytes $ru_w_dir/config.toml.target && ru_write $CONFIG $REPLY \
    || { zsystem flock -u $ru_w_lfd; ru_w_back "cannot install the edited config: $REPLY"; return $? }
  ru_wsay "the config names $out for ${(j:, :)ru_w_fsets}"
  ru_w_validate post
  rc=$?
  zsystem flock -u $ru_w_lfd
  (( rc == 3 )) && return 3
  (( rc == 0 )) || { ru_w_back "after the edit: $REPLY"; return $? }

  # 15. enable (on the edit only), wait for the target, close
  ru_w_enable $ru_w_tsha
  rc=$?
  (( rc == 3 )) && return 3
  if (( rc == 0 && ${#ru_w_stops} == 0 )); then
    ru_w_close 1
    return $?
  fi
  ru_w_close 0
}

# ---- RECOVER (the header, "RECOVER"): an open window journal that no run holds is ended
typeset -gA ru_rc_pat
() {
  local V='[0-9]+\.[0-9]+\.[0-9]+' H='[0-9a-f]{64}' I='[A-Za-z0-9][A-Za-z0-9._-]*' S='[A-Za-z0-9][A-Za-z0-9._-]{0,99}'
  local P='/[^[:space:]]*' T
  T="$S=$I( $S=$I)*"
  ru_rc_pat=(
    window '[0-9]{14}-[0-9]+'           family '[a-z][a-z0-9-]{0,40}'      kind '(switch|rollback)'
    command '(rebuild|switch-now|pass|back)'                              version "($V|none)"
    runner-sha "$H"                     date '[0-9]{8}'                    reason '.+'
    reject "($V|none)"                  verdict "$H"                       image "$I"
    tool "(golden-build|golden-emudhra|golden-gate|real-run) [0-9]+ [0-9]+ $P"
    pin-before "(none|$V $H)"           target "$T"
    validate '(pre|target|post|recover|hand) [1-3] (PASS|API-ONLY|NON-API|UNKNOWN)'
    idle '(idle|skipped)'               from '([0-9]+ [0-9]+|none)'        config-sha "$H"
    backup "$P"                         disable-start ''                   disable-failed '[0-9]+'
    disable-done ''                     stopped "([0-9]+ [0-9]+ $H|none)"  pin-write "$V $H"
    build-start '[0-9]{8}'              build-failed '.+'                  build-done "$I"
    gate-start "$I"                     gate-clone "$I"                    gate '(green|red|stop|other) [0-9]+'
    enable-check '(pass|fail)'          edited-sha "$H"                    hand-change "($H|unreadable)"
    found "$P"                          restore "$P"                       installed "[0-9]+( $H( $H)?)?"
    enable-start ''                     enable-refused '[0-9]+'            enable-done ''
    pre-close-failure '.+'              running '[0-9]+ [0-9]+'            delete "$I"
    stop '(check failed|HAND CHANGE|POOL DOWN|DISK|NO IDLE|ROLLBACK FAILED|CI DISABLED|ROLLED BACK): .*'
    pin-rule "(removed|$V $H)"          state-write '(switched|rolled|held)'  closed '[0-9]+'
    recover-start '[0-9]+'              recover-wait '[0-9]+'              recover-target "$H $T"
  )
}

ru_rcsay() { print -r -- "runner-updater: recover: $*" }

# THE JOURNAL as RECOVER reads it: WINDOW once; each line `KEY VALUE` by its KEY's pattern (ru_rc_pat, the header's
# table) -> ru_rc_k (the keys) and ru_rc_v (the values), in order. A last line with no newline was cut while it was
# written: dropped. 1 + REPLY: a line no pattern reads (RECOVER then changes nothing)
ru_rc_read() {
  local text l key val n=0
  ru_rc_k=() ru_rc_v=()
  [[ -f $WINDOW && ! -L $WINDOW && -r $WINDOW ]] || { REPLY="$WINDOW is not a readable regular file"; return 1 }
  text=$(/bin/cat -- $WINDOW && print -rn -- .) || { REPLY="$WINDOW cannot be read"; return 1 }
  text=${text%.}
  if [[ -n $text && $text != *$'\n' ]]; then
    if [[ $text == *$'\n'* ]]; then text=${text%$'\n'*}$'\n'; else text=; fi
  fi
  for l in "${(@f)${text%$'\n'}}"; do
    [[ -n $text ]] || break
    (( n++ ))
    [[ $l =~ '^([a-z][a-z0-9-]{0,40}) (.*)$' ]] || { REPLY="line $n is not 'KEY VALUE'"; return 1 }
    key=$match[1] val=$match[2]
    (( ${+ru_rc_pat[$key]} )) || { REPLY="line $n: RECOVER does not read the key '$key'"; return 1 }
    [[ $val =~ "^(${ru_rc_pat[$key]})\$" ]] || { REPLY="line $n: a '$key' value RECOVER does not read"; return 1 }
    ru_rc_k+=($key) ru_rc_v+=("$val")
  done
  return 0
}
# KEY -> REPLY = its first value; 1 when the journal has none
ru_rc_first() {
  local i=${ru_rc_k[(i)$1]}
  (( i <= ${#ru_rc_k} )) || return 1
  REPLY=$ru_rc_v[i]
}

# the window's globals from the journal (ru_rc_read's), as ru_window sets them
ru_rc_load() {
  local i v
  local -a img t
  ru_w_id= ru_w_fam= ru_w_kind= ru_w_ver= ru_w_sha= ru_w_old= ru_w_work= ru_w_out= ru_w_rbt= ru_w_pinbefore=
  ru_w_bsha= ru_w_tsha= ru_w_backup= ru_w_from= ru_w_stopped= ru_w_to= ru_w_ran= ru_w_chosen= ru_w_reject=
  ru_w_running=0 ru_w_preclosed=0 ru_w_futured=0 ru_w_restored=0 ru_w_open=1 ru_w_cmd=recover ru_w_jcmd=
  ru_w_reason= ru_w_reason_text= ru_w_vsha= ru_rc_iepoch= ru_rc_isha= ru_rc_icsha= ru_rc_bad= ru_w_recipe=
  ru_w_stops=() ru_w_vals=() ru_w_fsets=() ru_rc_targets=() ru_rc_ok=() ru_rc_tools=() ru_rc_jstops=()
  ru_rc_first window && ru_w_id=$REPLY
  ru_rc_first family && ru_w_fam=$REPLY
  ru_rc_first kind && ru_w_kind=$REPLY
  ru_rc_first command && ru_w_jcmd=$REPLY
  ru_rc_first version && ru_w_ver=${REPLY:#none}
  ru_rc_first runner-sha && ru_w_sha=$REPLY
  ru_rc_first reject && ru_w_reject=${REPLY:#none}
  ru_rc_first reason && ru_w_reason_text=$REPLY
  ru_rc_first verdict && ru_w_vsha=$REPLY
  ru_rc_first pin-before && ru_w_pinbefore=${REPLY:#none}
  ru_rc_first config-sha && ru_w_bsha=$REPLY
  ru_rc_first backup && ru_w_backup=$REPLY
  ru_rc_first edited-sha && ru_w_tsha=$REPLY
  ru_rc_first from && ru_w_from=${REPLY:#none}
  ru_rc_first stopped && ru_w_stopped=${REPLY:#none}
  for (( i = 1; i <= ${#ru_rc_k}; i++ )); do
    v=$ru_rc_v[i]
    case $ru_rc_k[i] in
      (image) img+=($v) ;;
      (target) ru_rc_targets+=($v) ;;
      (recover-target) ru_rc_targets+=(${v#* }); ru_rc_ok+=(${v%% *}) ;;
      (tool) t=(${(s: :)v}); ru_rc_tools+=("$(printf '0x%x' $t[2]):$t[3]") ;;
      (stop) [[ $v == 'CI DISABLED: '* ]] || ru_rc_jstops+=($v) ;;   # CI DISABLED is RECOVER's wait: tried again
      (pre-close-failure) ru_w_preclosed=1 ;;
      (found) ru_w_futured=1 ;;
      (installed)   # the last one's install time, sha and content sha ("": an older line has none)
        t=(${(s: :)v}); ru_rc_iepoch=$t[1] ru_rc_isha=${t[2]-} ru_rc_icsha=${t[3]-} ;;
      (validate) [[ $v == (post|recover)' '[1-3]' '(NON-API|UNKNOWN) ]] && ru_rc_bad=${v##* } ;;
    esac
  done
  if [[ $ru_w_kind == rollback ]]; then ru_w_old=${img[1]-} ru_w_rbt=${img[2]-}
  else ru_w_old=${img[1]-} ru_w_work=${img[2]-} ru_w_out=${img[3]-}; fi
  ru_w_last_target=${ru_rc_targets[-1]-}
  for v in ${(s: :)${ru_rc_targets[1]-}}; do ru_w_fsets+=(${v%%=*}); done
  # the family's sets are the journal's (its first TARGET), never the families file's now: ru_w_lines_now reads them
  typeset -gA ru_fam
  [[ -z $ru_w_fam ]] || ru_fam[$ru_w_fam]=${(j: :)ru_w_fsets}
  ru_w_failname="check failed"
  [[ $ru_w_kind == rollback ]] && ru_w_failname="ROLLBACK FAILED"
  ru_w_dir=$WINDOWS/${ru_w_id:-recovered}.d
  [[ -d $ru_w_dir ]] || /bin/mkdir -m 700 -p -- $ru_w_dir 2>/dev/null
}

# a journal RECOVER acts on names its family, its kind, the pre-window config and its backup (that file, whole), and
# a TARGET: 0, or 1 + REPLY
ru_rc_complete() {
  local k
  for k in family kind config-sha backup target; do
    (( ${ru_rc_k[(Ie)$k]} )) || { REPLY="it has no '$k' line"; return 1 }
  done
  [[ $ru_w_kind == rollback || -n $ru_w_out ]] || { REPLY="it has no output image line"; return 1 }
  ru_w_sha $ru_w_backup && [[ $REPLY == "$ru_w_bsha" ]] \
    || { REPLY="its backup $ru_w_backup is not the config-sha it journaled"; return 1 }
}

# STEP 2 (FLAG absent): BUSY -> 0 + REPLY = what still runs; 1 nothing does. A process of this user that has a
# journaled tool open (by its dev+inode, over EVERY open file: the REAL lsof, never only `-d txt`, as zsh holds its
# script on a descriptor), a gold-*, n1-* or s1-* VM running (tart's list), or a runner lock that is not free (the
# release's runner-lock-free). A read that fails is busy (never "free")
ru_rc_busy() {
  local out l p= d= lf
  local -a hits vms w
  if (( ${#ru_rc_tools} )); then
    out=$(/usr/bin/env -i $LSOF -n -P -a -u $UID -F pDi 2>/dev/null) && [[ -n $out ]] \
      || { REPLY="lsof failed: it cannot tell whether a tool of the window still runs"; return 0 }
    for l in ${(f)out}; do
      case $l in
        (p*) p=${l#p} ;;
        (D*) d=${l#D} ;;
        (i*) (( ${ru_rc_tools[(Ie)$d:${l#i}]} )) && hits+=($p) ;;
      esac
    done
    hits=(${(u)hits})
    (( ${#hits} == 0 )) || { REPLY="a process has a tool of the window open (pid ${(j:, :)hits})"; return 0 }
  fi
  out=$(ru_tart list --source local 2>/dev/null) || { REPLY="tart list failed"; return 0 }
  for l in ${${(f)out}[2,-1]}; do
    w=(${=l})
    (( ${#w} >= 3 )) && [[ $w[-1] == running && $w[2] == (gold|n1|s1)-* ]] && vms+=($w[2])
  done
  (( ${#vms} == 0 )) || { REPLY="a VM of a builder or the gate runs (${(j:, :)vms})"; return 0 }
  lf=$($RELBIN/runner-lock-free 2>&1)
  [[ $lf == free ]] || { REPLY="the runner lock $LOCK is not free (${lf:-no answer})"; return 0 }
  return 1
}
# STEP 2: wait until nothing is busy. ONE bound: RECOVER_WAIT s from the journal's first `recover-wait` line (a later
# run that finds it past checks once). At its end STOP CI DISABLED, held; the journal stays open and the next pass tries
# again. 0 quiet; 3 not
ru_rc_quiet() {
  local since deadline why= last=
  if ru_rc_first recover-wait; then since=$REPLY; else since=$EPOCHSECONDS; ru_j recover-wait $since || return 3; fi
  (( deadline = since + RECOVER_WAIT ))
  while ru_rc_busy; do
    why=$REPLY
    [[ $why == "$last" ]] || ru_rcsay "waits: $why (up to $(strftime '%Y-%m-%d %H:%M:%S UTC' $deadline))"
    last=$why
    (( EPOCHSECONDS < deadline )) || {
      ru_w_stop "CI DISABLED" "RECOVER has waited since $(strftime '%Y-%m-%d %H:%M UTC' $since) for the window's tools, VMs and the runner lock: $why. CI stays disabled; the next pass checks again"
      ru_w_hold_stops
      return 3
    }
    /bin/sleep $RECOVER_POLL
  done
  return 0
}

# STEP 4: the config -> 0 + REPLY = the sha CI goes on: the pre-window config, the one an earlier RECOVER chose, or a
# file RECOVER validated now; 1 (a rollback: the window's state is decided, REPLY too); 3 the journal stays open.
# The window's edit (a switch's): the backup goes back. Another file is a person's: left as found, and (AFTER THE
# INSTALL) CI goes on it only when it validates first under the ONE VALIDATE RULE, as a copy
ru_rc_config() {
  local now copy=$ru_w_dir/config.toml.hand
  ru_w_csha; now=$REPLY
  [[ $now != unreadable ]] || { print -r -- "runner-updater: STOP RECOVER cannot read $CONFIG: CI stays as it is"; return 3 }
  local undo=0
  if [[ -n $ru_w_tsha && $now == "$ru_w_tsha" ]]; then
    undo=1   # a switch's edit: the backup goes back; a rollback's: CONFIG EDIT's rule (ru_rb_decided)
    if [[ $ru_w_kind == rollback ]] && ! ru_rb_decided; then
      undo=0
      ru_rb_recover_target || return $?
      ru_w_csha; now=$REPLY
    fi
  fi
  if (( undo )); then
    ru_j restore $ru_w_backup || return 3
    ru_w_bytes $ru_w_backup && ru_write $CONFIG $REPLY \
      || { print -r -- "runner-updater: STOP the backup $ru_w_backup cannot go back over $CONFIG: the window journal stays open"; return 3 }
    ru_rcsay "the window's edit is undone: $CONFIG = its backup $ru_w_backup"
    ru_w_csha; now=$REPLY
  fi
  if [[ $now == "$ru_w_bsha" ]] || (( ${ru_rc_ok[(Ie)$now]} )) || [[ $ru_w_kind == rollback && $now == "$ru_w_tsha" ]]; then
    REPLY=$now
    return 0
  fi
  # a person's file: validated as a copy, then CI only on that sha (ru_w_enable compares it again)
  /bin/cp -p -- $CONFIG $copy && ru_w_sha $copy && [[ $REPLY == "$now" ]] \
    || { print -r -- "runner-updater: STOP RECOVER cannot copy $CONFIG whole to $copy: CI stays as it is"; return 3 }
  if ru_w_validate hand $copy; then
    ru_w_hasstop "HAND CHANGE" || (( ${ru_rc_jstops[(I)HAND CHANGE: *]} )) \
      || ru_w_stop "HAND CHANGE" "$CONFIG changed while the window had CI disabled (sha $now): RECOVER leaves it as found; it validates, so CI goes on it"
    REPLY=$now
    return 0
  fi
  ru_w_stop "HAND CHANGE" "$CONFIG changed while the window had CI disabled (sha $now), and it does not validate ($REPLY): RECOVER leaves it as found and does not enable CI on it, so CI stays down. Check the file, then run \`$BIN/runner-enable\` by hand; the window journal stays open and the next pass validates the file again"
  ru_w_hold_stops
  return 3
}

# STEP 1, FLAG present after the updater's enable (E: its place in the journal: the last `enable-start`, or the
# `installed` line whose lost enable-start ran): the window closes when its LAST TARGET runs; the config's family
# lines are another, or its CONTENT is not the last `installed` line's (a person's config runs): STOP HAND CHANGE, CI as
# it is. Not in CLOSE_WAIT s: a pre-close failure, at most once per journal (the second: POOL DOWN, no runner-disable);
# the first runs runner-disable and RECOVER goes on at step 3. A pre-close failure journaled after E is finished as
# decided, with no new wait. -> the close's return, 3 open, 4 go on at step 3
ru_rc_flagged() {
  local e=$1 lines why lpc since
  typeset -A st
  ru_w_lines_now $ru_w_fam || { print -r -- "runner-updater: STOP RECOVER cannot read the config ($REPLY): the window journal stays open"; return 3 }
  lines=$REPLY
  if [[ $lines != "$ru_w_last_target" ]]; then
    ru_w_stop "HAND CHANGE" "CI runs $CONFIG with the family's lines $lines, not the window's last TARGET ($ru_w_last_target): a person's config; RECOVER leaves CI and the file as they are"
    ru_rc_close
    return $?
  fi
  # and the file itself (PLAN D1 as amended 2026-11-03, S3b-4a r2 P3-c): its CONTENT (ru_w_shas: whole-line comments
  # and blank lines removed) must be the content sha the last `installed` line journaled, for the file the last
  # runner-enable started, never re-derived. A comment cannot change what runs (a HAND CHANGE would drop a live
  # candidate); any other change is a person's. An older line with no content sha: the file's sha (S3b-4a r1 P3-3); no
  # sha at all (an older window): the lines only
  ru_w_shas $CONFIG || reply=(unreadable unreadable)
  if [[ -n $ru_rc_icsha && $reply[2] != "$ru_rc_icsha" ]]; then
    ru_w_stop "HAND CHANGE" "CI runs $CONFIG with content sha $reply[2] (comments and blank lines left out), not the content of the file the window's last runner-enable started ($ru_rc_icsha): a person's config; RECOVER leaves CI and the file as they are"
    ru_rc_close
    return $?
  elif [[ -z $ru_rc_icsha && -n $ru_rc_isha && $reply[1] != "$ru_rc_isha" ]]; then
    ru_w_stop "HAND CHANGE" "CI runs $CONFIG with sha $reply[1], not the file the window's last runner-enable started (sha $ru_rc_isha): a person's config; RECOVER leaves CI and the file as they are"
    ru_rc_close
    return $?
  fi
  lpc=${ru_rc_k[(I)pre-close-failure]}
  if (( lpc > e )); then
    # that enable's pre-close failure is journaled already (the window's, or an earlier RECOVER's), and the
    # runner-disable it decided did not finish (no disable-done after it; FLAG is present): RECOVER finishes it, as
    # decided (S3b-4a r2 N2). No new wait, and it is not a second pre-close failure
    why="the target did not run (the journal's pre-close failure: $ru_rc_v[lpc])"
    ru_rcsay "$why: RECOVER finishes it (runner-disable, then the window's rule for its config)"
  else
    # the start must follow the INSTALL TIME (D1): the last `installed` line's, journaled; not the file's mtime now,
    # which a comment a person added after the start moved (an older journal with no such line: the mtime)
    since=$ru_rc_iepoch
    if [[ -z $since ]]; then
      zstat -H st $CONFIG || { print -r -- "runner-updater: STOP RECOVER cannot stat $CONFIG: the window journal stays open"; return 3 }
      since=$st[mtime]
    fi
    ru_rcsay "CI is enabled after the window's enable-start: waiting up to $CLOSE_WAIT s for its last TARGET to run ($lines)"
    ru_w_wait_target $lines $since
    case $? in
      (0) ru_rcsay "the target runs"; ru_rc_close; return $? ;;
      (3) return 3 ;;
    esac
    why="the target did not run within $CLOSE_WAIT s (FLAG, a runscaler started after $since, the lines $lines)"
    ru_w_clean $why
    ru_j pre-close-failure $REPLY || return 3
    if (( ru_w_preclosed )); then
      ru_w_stop "POOL DOWN" "$why; a second pre-close failure in this window, so no runner-disable follows: CI is down on this host"
      ru_rc_close
      return $?
    fi
  fi
  ru_w_preclosed=1
  ru_j disable-start '' || return 3
  $RELBIN/runner-disable || { ru_j disable-failed $?; print -r -- "runner-updater: STOP runner-disable failed (above): the window journal stays open"; return 3 }
  ru_j disable-done '' || return 3
  ru_w_stop $ru_w_failname $why
  return 4
}

# the close of a journal RECOVER ends: the journal's STOPs held again (its CI DISABLED lines are not: RECOVER's own
# wait), then RECOVER's; a switch that did not reach its candidate and holds no STOP is `check failed` (interrupted).
# -> ru_w_close's (or the rollback's) return
ru_rc_close() {
  local s n sw=0
  local -a own=($ru_w_stops)
  ru_w_stops=()
  for s in $ru_rc_jstops $own; do
    if [[ $s == '{'* ]]; then
      [[ $s =~ '"stop":"([^"]*)"' ]] && ru_w_hasstop $match[1] && continue
      ru_w_stops+=($s)
    else
      n=${s%%: *}
      ru_w_hasstop $n && continue
      ru_w_stopjson $n "${s#*: }"   # THE HAND RULE (ru_w_stopjson) gives POOL DOWN and ROLLBACK FAILED their line
      ru_w_stops+=($REPLY)
    fi
  done
  # the window's own TARGET (its first) ran, and no STOP holds: it switched (a rollback: it rolled back; its own
  # ROLLED BACK, journaled at its close, is no STOP against it)
  local -a against=(${ru_w_stops:#*\"stop\":\"ROLLED BACK\"*})
  (( ru_w_running && ${#against} == 0 )) && [[ $ru_w_ran == "${ru_rc_targets[1]}" ]] && sw=1
  if [[ $ru_w_kind == rollback ]]; then ru_rb_close $sw; return $?; fi
  if (( ! sw && ${#ru_w_stops} == 0 )); then
    ru_w_stop "check failed" "the window was interrupted (its own lines end at \`${ru_rc_wl:-${ru_rc_k[-1]-}}\`): RECOVER ended it and CI runs the config it left"
  fi
  ru_w_close $sw
}

# the journal archived as it is (the window had closed, or nothing was disabled): no state write, so the `restart`
# member stays (its runscaler, the member's `to`, still runs); 0, or 3 (it stays open)
ru_rc_archive() {
  [[ -n $ru_w_id ]] || ru_w_id="$(strftime '%Y%m%d%H%M%S' $EPOCHSECONDS)-$$"
  if [[ ${ru_rc_k[-1]-} == closed ]]; then
    /bin/mv -- $WINDOW $WINDOWS/$ru_w_id || { print -r -- "runner-updater: STOP cannot rename $WINDOW to $WINDOWS/$ru_w_id: the window journal stays open"; return 3 }
    ru_w_open=0
    ru_protect $ru_state $EPOCHSECONDS \
      || print -r -- "runner-updater: STOP the protected list cannot be written ($REPLY): $PROTECTED is as it was; \`runner-updater protect\` writes it"
    return 0
  fi
  ru_w_archive || return 3
}

# RECOVER (the header): -> 0 the journal closed (a window that switched or rolled back, or nothing was disabled); 1 it
# closed with a STOP held; 3 it stays open (a STOP printed, held when the state can be written). The caller holds the
# updater lock, loaded the state (ru_state) and sourced this file and the lib
ru_recover() {
  local flag=0 lds ldd le e wn rc h lines pre
  [[ -e $WINDOW || -L $WINDOW ]] || return 0
  ru_rcsay "the window journal $WINDOW is open and no run holds the updater lock: RECOVER ends it"
  ru_rc_read || { print -r -- "runner-updater: STOP RECOVER cannot read the window journal $WINDOW ($REPLY): it changes nothing; look at the file"; return 3 }
  ru_rc_load
  if [[ ${ru_rc_k[-1]-} == closed ]]; then
    ru_rcsay "the window had closed (its last line is \`closed\`): its journal goes to $WINDOWS"
    ru_rc_archive
    return $?
  fi
  # THE WINDOW'S OWN LINES (S3b-4a r2 N1): the lines before RECOVER's first `recover-start` (every line when there is
  # none). The F5 rules read the WINDOW's last line, never a line an earlier RECOVER appended
  wn=$(( ${ru_rc_k[(i)recover-start]} - 1 ))
  ru_rc_wl=
  (( wn )) && ru_rc_wl=$ru_rc_k[wn]
  lds=${ru_rc_k[(I)disable-start]} ldd=${ru_rc_k[(I)disable-done]} le=${ru_rc_k[(I)enable-start]}
  [[ -e $FLAG ]] && flag=1
  # FLAG first (step 1; S3b-4a r1 F5). FLAG present and no disable-done (or no disable-start): nothing was disabled.
  # FLAG absent and no disable-start: D1 loses only the journal's LAST line, so disable-start can be the lost line only
  # when the journal ends at the line written just before it (`backup`; a rollback's `edited-sha`). Then its
  # runner-disable may have run: CI is down, and RECOVER goes on as for a disabled window (step 2 on). A journal that
  # ends earlier never wrote disable-start: its window disabled nothing, and FLAG absent is a person's (nothing restarts).
  # Decided ONCE (S3b-4a r2 N1): a journal with a `recover-start` line had an earlier RECOVER act on it (it decided CI
  # was down because of the window, or reached the window's enable), and RECOVER never decides "nothing was disabled"
  # for it again: the FLAG it reads now may be that RECOVER's own runner-enable
  pre=backup
  [[ $ru_w_kind == rollback ]] && pre=edited-sha
  if (( wn == ${#ru_rc_k} )) && { (( flag && ! ldd )) || { (( ! lds )) && [[ $ru_rc_wl != "$pre" ]] } }; then
    if (( flag )); then
      if (( lds )); then ru_rcsay "nothing was disabled (FLAG present and no disable-done): the journal closes, no STOP"
      else ru_rcsay "nothing was disabled (no disable-start): the journal closes, no STOP"; fi
      ru_rc_archive
      return $?
    fi
    # FLAG absent (S3b-4a r2 P3-b): by D1 a person disabled CI, and nothing restarts. Two lost lines (`backup` and
    # `disable-start`, after runner-disable ran) leave the same journal and the same host: beyond D1, and RECOVER cannot
    # tell them apart. So CI down is never silent: a no-action STOP CI DISABLED, held, names runner-enable
    ru_rcsay "nothing was disabled (no disable-start): CI is disabled ($FLAG is absent), and the window's journal shows no runner-disable of its own: CI stays as it is; the journal closes"
    ru_w_stop "CI DISABLED" "CI is disabled ($FLAG is absent), and the journal of an interrupted window (its last line: \`$ru_rc_wl\`) shows no runner-disable of its own: a person disabled CI, or a power loss lost more than the journal's last line. RECOVER changes nothing. If no person disabled CI, enable it by hand. This STOP holds $ru_w_fam until a window of it disables CI again (for example \`runner-updater rebuild $ru_w_fam\`)" $BIN/runner-enable
    if [[ -n $ru_w_fam ]]; then ru_w_hold_stops || return 3; fi
    ru_rc_archive || return 3
    return 1
  fi
  (( lds || flag )) || ru_rcsay "CI is disabled ($FLAG is absent) and the window's lines end at \`$pre\`: its lost last line may be disable-start, whose runner-disable ran: RECOVER brings CI back"
  ru_rc_complete || { print -r -- "runner-updater: STOP RECOVER cannot act on the window journal $WINDOW ($REPLY): it changes nothing; look at the file"; return 3 }
  # RECOVER acts: its first line, once per journal, before any other line of its own
  if (( wn == ${#ru_rc_k} )); then ru_j recover-start $EPOCHSECONDS || return 3; fi
  # a journal that ended in POOL DOWN (its second pre-close failure): it closes held, and nothing more runs
  if (( ${ru_rc_jstops[(I)POOL DOWN: *]} )) || (( ${#${(M)ru_rc_k:#pre-close-failure}} >= 2 )); then
    (( ${ru_rc_jstops[(I)POOL DOWN: *]} )) \
      || ru_w_stop "POOL DOWN" "a second pre-close failure in this window (its journal), so no runner-disable follows: CI is down on this host"
    ru_rcsay "the window ended in POOL DOWN: no runner-disable, no runner-enable"
    ru_rc_close
    return $?
  fi
  if (( flag )); then
    # FLAG present after the last enable-start; or after an `installed` that is the journal's last line, or the
    # WINDOW's last line (S3b-4a r2 N1: an earlier RECOVER appended after it): the lost line may be enable-start, whose
    # runner-enable ran (S3b-4a r1 F5), and the file it names is the one it was to start. E: that enable's place
    e=$le
    [[ ${ru_rc_k[-1]-} == installed ]] && e=${#ru_rc_k}
    [[ $ru_rc_wl == installed ]] && (( wn > e )) && e=$wn
    if (( e > ldd )); then
      ru_rc_flagged $e
      rc=$?
      (( rc == 4 )) || return $rc
    else
      ru_w_stop "HAND CHANGE" "CI was enabled while the window had it disabled (FLAG present after disable-done, no enable-start): RECOVER leaves CI and $CONFIG as they are"
      ru_rc_close
      return $?
    fi
  else
    ru_rcsay "CI is disabled (FLAG absent): RECOVER waits for the window's tools, VMs and the runner lock"
    ru_rc_quiet || return 3
  fi
  # STEP 3: a switch's builder names, unless its gate passed and no config line names them
  if [[ $ru_w_kind == switch ]]; then ru_w_prune || return 3; fi
  # STEP 4, then RECOVER's own TARGET (D1), then STEP 5
  ru_rc_config
  rc=$?
  (( rc == 0 )) || return $rc
  h=$REPLY
  ru_w_lines_now $ru_w_fam || { print -r -- "runner-updater: STOP RECOVER cannot read the config ($REPLY): the window journal stays open"; return 3 }
  lines=$REPLY
  ru_j recover-target "$h $lines" || return 3
  ru_w_last_target=$lines ru_rc_targets+=($lines) ru_rc_ok+=($h)
  ru_rcsay "CI goes on $CONFIG (sha $h): its target $lines"
  ru_w_enable $h
  (( $? == 3 )) && return 3
  ru_rc_close
}

# ---- THE ROLLBACK WINDOW (the header, "THE ROLLBACK WINDOW")
# A > B as runner versions (N.N.N, compared number by number): 0, else 1
ru_rb_newer() {
  local -a a=(${(s:.:)1}) b=(${(s:.:)2})
  local i
  for i in 1 2 3; do
    (( a[i] > b[i] )) && return 0
    (( a[i] < b[i] )) && return 1
  done
  return 1
}

# the family's state for a rollback: FAMILY -> ru_rb_cand (the candidate's version, "" none), ru_rb_clines (its lines
# "S=I ...", "" none), ru_rb_prev (the one image `previous` names, "" none; 1 + REPLY when it names more than one),
# ru_rb_until (back_until, "" none), ru_rb_rf (1 when a ROLLBACK FAILED is held), ru_rb_cofirst (1 when the state
# counts a connect-only rollback of the candidate's version already, its `connect_only` member, never a STOP: this one
# is the second, and it rejects; S3b-4a r1 P3-5)
ru_rb_state() {
  local o
  o=$(print -r -- $ru_state | $JQ -r --arg f $1 '(.families[$f] // {}) as $x
        | ($x.candidate.version // ""), (($x.candidate.lines // {}) | to_entries | map("\(.key)=\(.value)") | join(" ")),
          (($x.previous // {}) | [.[]] | unique | if length == 0 then "" elif length == 1 then .[0] else "?" end),
          ($x.back_until // "" | tostring),
          (if any(($x.stops // [])[]; .stop == "ROLLBACK FAILED") then 1 else 0 end),
          (if (($x.connect_only // {})[$x.candidate.version // ""].n // 0) >= 1 then 1 else 0 end)' 2>/dev/null) \
    || { REPLY="jq could not read the family $1 of the state"; return 1 }
  local -a l=("${(@f)o}")
  (( ${#l} == 6 )) || { REPLY="jq could not read the family $1 of the state"; return 1 }
  ru_rb_cand=$l[1] ru_rb_clines=$l[2] ru_rb_prev=$l[3] ru_rb_until=$l[4] ru_rb_rf=$l[5] ru_rb_cofirst=$l[6]
  [[ $ru_rb_prev != '?' ]] || { REPLY="the previous lines of $1 name more than one image"; return 1 }
}

# a pending hand edit before runner-disable: WHY -> STOP HAND CHANGE (held), 1. No try could start: ru_rb_nocount (the
# pass then does not count this time against the 2-h bound; S3b-4b r1 P1-1)
ru_rb_hand() {
  ru_rb_nocount=hand
  ru_w_stop "HAND CHANGE" "a pending hand edit: $1"
  ru_w_hold_stops
  return 1
}
# not now: WHY (no STOP; nothing changed) -> 2
ru_rb_pending() {
  print -r -- "runner-updater: rollback pending: $1"
  /bin/rm -rf -- $ru_w_dir
  return 2
}

# THE 2-H BOUND (S3b-4a r1 F3): a rollback that cannot start (a runner-disable time-out: the journal stays open and the
# next run's RECOVER brings CI back), or whose validate before or after the edit is UNKNOWN (the backup back), is tried
# again while the verdict holds, for ROLLBACK_BOUND (2 h) from SINCE; past it STOP ROLLBACK FAILED (held) and no more
# runner-disable. WHY -> 0 within the bound; 1 the STOP (the window's folder removed)
ru_rb_bound() {
  (( EPOCHSECONDS - ru_w_since < ROLLBACK_BOUND )) && return 0
  ru_w_stop "ROLLBACK FAILED" "$1; tried since $(strftime '%Y-%m-%d %H:%M UTC' $ru_w_since) (the first pass that could start a try), and no try rolled the family back in 2 h"
  ru_w_hold_stops
  /bin/rm -rf -- $ru_w_dir
  return 1
}
# a validate before the edit that is UNKNOWN: WHY -> 2 pending (within the bound), 1 the STOP
ru_rb_retry() {
  ru_rb_bound "$1" || return 1
  ru_rb_pending "$1; R1 stays armed and the next pass tries again (until $(strftime '%Y-%m-%d %H:%M UTC' $(( ru_w_since + ROLLBACK_BOUND ))))"
}

# a failure after runner-disable: [STOP] WHY -> the backup (the config that ran before the window) back when the config is
# the window's edit, CI enabled on it, the window closes held. STOP ROLLBACK FAILED, or (an UNKNOWN validate) no STOP:
# the rollback is tried again. Never CI on lines that just failed validate
ru_rb_back() {
  if [[ $1 == - ]]; then ru_wsay "$2: the backup goes back, CI is enabled on it, and the rollback is tried again"
  else ru_w_stop "ROLLBACK FAILED" "$2"; fi
  ru_w_unedit || return 3
  ru_w_enable $ru_w_bsha
  case $? in (0|1) ru_rb_close 0; return $? ;; (*) return 3 ;; esac
}

# RECOVER of a rollback window whose edit is installed (step 4, CONFIG EDIT's rule): its lines if they validate (an
# API-ONLY three times counts); NON-API: the backup back and STOP ROLLBACK FAILED; UNKNOWN: the backup back, no STOP
# (tried again). 0 (the config is then the target or the backup), 3 the journal stays open
ru_rb_recover_target() {
  local copy=$ru_w_dir/config.toml.recover
  /bin/cp -p -- $CONFIG $copy && ru_w_sha $copy && [[ $REPLY == "$ru_w_tsha" ]] \
    || { print -r -- "runner-updater: STOP RECOVER cannot copy $CONFIG whole to $copy: CI stays as it is"; return 3 }
  ru_w_validate recover $copy && return 0
  if [[ ${ru_w_vals[-1]-} == *' NON-API' ]]; then ru_w_stop "ROLLBACK FAILED" "RECOVER: the rollback's lines do not validate now ($REPLY): the backup goes back"
  else ru_rcsay "the rollback's lines are UNKNOWN to validate ($REPLY): the backup goes back; the rollback is tried again"; fi
  ru_j restore $ru_w_backup || return 3
  ru_w_bytes $ru_w_backup && ru_write $CONFIG $REPLY \
    || { print -r -- "runner-updater: STOP the backup $ru_w_backup cannot go back over $CONFIG: the window journal stays open"; return 3 }
  return 0
}

# RECOVER step 4 of a rollback whose installed edit is still the config: 0 when the journal (or this RECOVER) already
# decided CONFIG EDIT's rule (S3b-4a r1 F2): a ROLLBACK FAILED (journaled, or raised now by step 1's pre-close
# failure); a `pre-close-failure` line (S3b-4a r2 N2: the window's, or an earlier RECOVER's: the target did not run,
# and its ROLLBACK FAILED comes only after `restore`, so a kill before it leaves the line alone); or a `validate
# post|recover N NON-API|UNKNOWN` line: the target's lines just failed validate. Then the backup goes back with NO new
# validate of them and no runner-enable on them; a pre-close failure or a NON-API with no ROLLBACK FAILED yet raises it,
# an UNKNOWN none. 1 not decided: the target's lines are validated now (ru_rb_recover_target)
ru_rb_decided() {
  if ru_w_hasstop "ROLLBACK FAILED" || (( ${ru_rc_jstops[(I)ROLLBACK FAILED: *]} )); then
    ru_rcsay "the rollback's ROLLBACK FAILED is decided: the backup goes back, with no new validate of its lines"
    return 0
  fi
  if (( ru_w_preclosed )); then
    ru_w_stop "ROLLBACK FAILED" "RECOVER: the rollback's target did not run (the journal's pre-close failure): the backup goes back, and CI is never enabled again on the target that just failed to run"
    return 0
  fi
  [[ -n $ru_rc_bad ]] || return 1
  if [[ $ru_rc_bad == NON-API ]]; then
    ru_w_stop "ROLLBACK FAILED" "RECOVER: the window's validate of the rollback's lines was NON-API (its journal): the backup goes back, and CI is never enabled on lines that just failed validate"
  else
    ru_rcsay "the window's validate of the rollback's lines was UNKNOWN (its journal): the backup goes back with no new validate; the rollback is tried again"
  fi
  return 0
}

# CLOSE of a rollback window: ROLLED (1: the target runs, no STOP) -> 0 rolled back; 1 held; 3 the journal stays open.
# Rolled back: the candidate, previous and back_until cleared, the rejection (`reject`) added, STOP ROLLED BACK (an
# automatic rollback: R1's failures), the candidate's observation STOPs (JOBS FAIL ON THE NEW IMAGE, NO EVIDENCE) gone,
# the target image's version recorded; after the journal closes, the image it left is deleted by its recorded name
# (when the state records it as the family's, S3b-4a r1 P3-1, and no non-comment config line names it: DELETION's
# condition), journaled first in ACTIONS. Held: only the STOPs (THE STOP RULE), R1 stays armed. The pin by D2's ONE
# RULE, the `restart` member as a switch's. RECOVER's ROLLED BACK keeps R1's verdict (ru_rb_verdict, P3-2)
ru_rb_close() {
  local rolled=$1 rs running=false tv= detail co=false cnt=false own=0
  local -a seen
  ru_w_stops=(${ru_w_stops:#*\"stop\":\"ROLLED BACK\"*})   # one ROLLED BACK, with R1's detail
  # read before this close writes the state (it clears the candidate): the image it leaves is the family's
  ru_rb_owned $ru_w_old && own=1
  if (( rolled )) && [[ $ru_w_jcmd == pass ]]; then
    [[ -n $ru_w_reason || -z ${ru_w_vsha-} ]] || ru_rb_verdict
    [[ -z $ru_w_reject ]] && co=true   # an automatic rollback that rejects nothing was a first connect-class one
    detail=${ru_w_reason:-$($JQ -n -c --arg t "${ru_w_reason_text-}" --argjson co $co '{text: $t, connect_only: $co}' 2>/dev/null)}
    # the state counts each connect-only rollback of the version (CONNECT-ONLY: the first rejects nothing, a second
    # rejects; S3b-4a r1 P3-5): the first, and a second that R1's verdict says was connect-class only too
    [[ $co == true || $(print -r -- $detail | $JQ -r '.connect_only' 2>/dev/null) == true ]] && cnt=true
    ru_w_stopjson "ROLLED BACK" "${ru_w_reason_text-}"
    REPLY=$(print -r -- $REPLY | $JQ -c --argjson d "${detail:-{\}}" '.detail = ((.detail // {}) + $d)' 2>/dev/null) || REPLY=
    [[ -n $REPLY ]] || ru_w_stopjson "ROLLED BACK" "${ru_w_reason_text-}"
    ru_w_stops+=($REPLY)
    print -r -- "runner-updater: STOP ROLLED BACK: ${ru_w_reason_text-}"
    seen=(${(M)${(f)"$(<$WINDOW)"}:#stop ROLLED BACK: *})
    if (( ${#seen} == 0 )); then ru_w_clean "ROLLED BACK: ${ru_w_reason_text-}"; ru_j stop $REPLY || return 3; fi
  fi
  ru_w_pin_rule || { print -r -- "runner-updater: STOP $REPLY: the window journal stays open"; return 3 }
  ru_w_version $ru_w_rbt && tv=$REPLY
  ru_w_restart
  rs=$REPLY
  (( ru_w_running )) && running=true
  ru_j state-write ${${rolled:#0}:+rolled}${${rolled:#1}:+held} || return 3
  ru_w_state "$ru_w_kept .families[\$f] = ((.families[\$f] // $ru_w_family_new)
        | if \$rb then .candidate = null | .previous = null | .back_until = null
            | .rejected = (((.rejected // []) + (if \$rej != \"\" then [\$rej] else [] end)) | unique)
            | if \$cnt and \$v != \"\" then .connect_only[\$v] = {n: ((.connect_only[\$v].n // 0) + 1), at: \$now}
              else . end
            | .stops = [(.stops // [])[] | select(.stop != \"JOBS FAIL ON THE NEW IMAGE\" and .stop != \"NO EVIDENCE\")]
          else . end
        | .stops = kept(\$W; \$new; true; \$running))
      | if \$tv != \"\" then .images[\$tgt] = \$tv else . end
      | if \$rs == null then del(.restart) else .restart = \$rs end" \
      --arg f $ru_w_fam --arg rej "$ru_w_reject" --arg tv "$tv" --arg tgt $ru_w_rbt --argjson W $ru_W --argjson rs $rs \
      --argjson cnt $cnt --arg v "$ru_w_ver" --argjson now $EPOCHSECONDS \
      --argjson rb ${${rolled:#0}:+true}${${rolled:#1}:+false} --argjson running $running \
      --argjson new "[${(j:,:)ru_w_stops}]" \
    || { print -r -- "runner-updater: STOP the state cannot be written ($REPLY): the window journal stays open"; return 3 }
  ru_w_archive || return 3
  (( rolled )) || return 1
  ru_rb_delete $ru_w_old $own
  return 0
}

# IMAGE: 0 when the state records it as an image of the family (S3b-4a r1 P3-1): in its candidate's lines, or in the
# image record (an image the updater built or adopted: after ACCEPT, the accepted one). A person's hand image is in
# neither; a jq that fails: not recorded (it stays)
ru_rb_owned() {
  [[ -n $1 ]] || return 1
  print -r -- $ru_state | $JQ -e --arg f $ru_w_fam --arg i $1 \
    '(((.families[$f].candidate.lines // {}) | any(.[]; . == $i)) or ((.images // {}) | has($i)))' > /dev/null 2>&1
}

# RECOVER: R1's verdict that the rollback window kept in its folder (WDIR/verdict.json), read only when its sha is the
# journaled `verdict` line's -> ru_w_reason and its text; 1 when it is not (the ROLLED BACK keeps the journaled reason)
ru_rb_verdict() {
  local f=$ru_w_dir/verdict.json t
  if ! { ru_w_sha $f && [[ $REPLY == "$ru_w_vsha" ]] }; then
    ru_rcsay "the verdict $f is not the one the journal names: the ROLLED BACK keeps only the journaled reason"
    return 1
  fi
  t=$($JQ -c 'if type == "object" and (.failures | type) == "array" and (.connect_only | type) == "boolean"
        then . else error("not an R1 verdict") end' $f 2>/dev/null) && [[ -n $t ]] || return 1
  ru_w_reason=$t
  ru_w_reason_text=$(print -r -- $t | $JQ -r '.reason // "R1 on set \(.set): \(.failures | length) counted failures"' 2>/dev/null)
}

# the image a rollback left, deleted by its recorded NAME after the journal closed (ru_w_delete), when it is not the
# rollback's target
ru_rb_delete() {
  [[ -n $1 && $1 != "$ru_w_rbt" ]] || return 0
  ru_w_delete $1 ${2:-0} "the image the rollback left"
}
# NAME OWN WHAT: an image the updater keeps no longer (WHAT names it), deleted by its recorded NAME after its window's
# journal closed (DELETION, PLAN D6): only when OWN (the state recorded it as the family's: its candidate's, or one the
# updater built or adopted), no non-comment line of the config names it and no open window's journal does, and tart
# lists it; journaled first in ACTIONS (`delete NAME`). A delete that fails leaves it for a person (no record keeps it)
ru_w_delete() {
  local n=$1 what=$3 l t
  [[ -n $n ]] || return 0
  (( ${2:-0} )) || { ru_wsay "$n stays: the state does not record it as an image of $ru_w_fam (not its candidate's, not one the updater built or adopted): a person's image is never deleted"; return 0 }
  [[ ! -e $WINDOW && ! -L $WINDOW ]] || { ru_wsay "$n stays: a window journal is open"; return 0 }
  ru_w_bytes $CONFIG || { ru_wsay "cannot read $CONFIG: $n stays"; return 0 }
  for l in "${(@f)REPLY}"; do
    [[ $l =~ '^[[:space:]]*#' ]] && continue
    [[ $l == *"$n"* ]] && { ru_wsay "$n stays: a line of $CONFIG names it"; return 0 }
  done
  t=$(ru_tart list --source local -q 2>/dev/null) || { ru_wsay "tart list failed: $n stays (delete it by hand when no config line names it)"; return 0 }
  (( ${${(f)t}[(Ie)$n]} )) || return 0
  /bin/zsh -f $RELBIN/runner-journal $ACTIONS delete $n \
    || { ru_wsay "the action journal could not record the delete of $n (above): it stays"; return 0 }
  if ru_tart delete $n > /dev/null 2>&1; then ru_wsay "deleted $n ($what)"
  else ru_wsay "cannot delete $n (tart delete failed): delete it by hand when no config line names it"; fi
}

# ru_rollback FAMILY REASON SINCE: the AUTOMATIC rollback (4b's pass calls it on an R1 verdict): REASON is r1.jq's
# verdict of the family (one JSON object {set, failures, connect_only}, the ROLLED BACK STOP's detail; its text is r1's
# `reason`, REASON's .reason when it has one), SINCE when that verdict began (the 2-h bound). -> ru_rb_window's return
ru_rollback() { ru_rb_window $1 pass "$2" $3 }

# ru_rb_window FAMILY COMMAND REASON SINCE: ONE rollback window (the header). COMMAND pass (ru_rollback) | back (`back
# FAMILY`, a person's: REASON is ignored). 0 rolled back; 1 a STOP (held) or a REFUSE; 2 pending (nothing changed,
# nothing held); 3 the journal stays open
ru_rb_window() {
  local fam=$1 cmd=$2 reason=$3 t rc csha cur tgt v= tv= rej= f
  ru_w_fam=$fam ru_w_cmd=$cmd ru_w_jcmd=$cmd ru_w_since=$4 ru_w_kind=rollback ru_w_failname="ROLLBACK FAILED"
  ru_w_began=0 ru_rb_nocount=
  ru_w_stops=() ru_w_vals=() ru_w_open=0 ru_w_tsha= ru_w_last_target= ru_w_out= ru_w_old= ru_w_pinbefore= ru_w_work=
  ru_w_from= ru_w_stopped= ru_w_to= ru_w_running=0 ru_w_preclosed=0 ru_w_futured=0 ru_w_ran= ru_w_chosen= ru_w_restored=0
  ru_w_ver= ru_w_sha= ru_w_reject= ru_w_reason= ru_w_reason_text= ru_w_rbt= ru_w_bsha= ru_w_vsha=
  ru_w_id="$(strftime '%Y%m%d%H%M%S' $EPOCHSECONDS)-$$"
  [[ $cmd == (pass|back) && $4 =~ '^[0-9]+$' ]] || { print -r -- "runner-updater: REFUSE the rollback's arguments: '$cmd' '$4'"; return 1 }
  [[ ! -e $WINDOW && ! -L $WINDOW ]] \
    || { print -r -- "runner-updater: STOP RECOVER needed: the window journal $WINDOW is open (ru_recover ends it first)"; return 1 }
  ru_rb_state $fam || { print -r -- "runner-updater: REFUSE $REPLY: no rollback"; return 1 }
  [[ -n $ru_rb_prev ]] || { print -r -- "runner-updater: REFUSE $fam has no previous image to go back to: no rollback"; return 1 }
  if [[ $cmd == pass ]]; then
    [[ -n $ru_rb_cand ]] || { print -r -- "runner-updater: REFUSE $fam has no candidate to roll back: no rollback"; return 1 }
    (( ! ru_rb_rf )) \
      || { print -r -- "runner-updater: REFUSE $fam holds ROLLBACK FAILED: R1 starts no rollback window until \`runner-updater retry $ru_w_fam\` (or a newer release) clears it"; return 1 }
    t=$(print -r -- $reason | $JQ -c 'if type == "object" and (.failures | type) == "array" and (.connect_only | type) == "boolean"
          then . else error("not an R1 verdict") end' 2>/dev/null) \
      || { print -r -- "runner-updater: REFUSE the rollback's REASON is not r1's verdict {set, failures, connect_only}: no rollback"; return 1 }
    ru_w_reason=$t
    ru_w_reason_text=$(print -r -- $t | $JQ -r '.reason // "R1 on set \(.set): \(.failures | length) counted failures"' 2>/dev/null)
  else
    if [[ -z $ru_rb_cand ]] && { [[ -z $ru_rb_until ]] || (( EPOCHSECONDS >= ru_rb_until )) }; then
      print -r -- "runner-updater: REFUSE back $fam: the family has no candidate, and its previous image is kept for \`back\` only until 7 days after the accept${ru_rb_until:+ ($(strftime '%Y-%m-%d %H:%M UTC' $ru_rb_until))}: nothing changed"
      return 1
    fi
    ru_w_reason_text="back by a person"
  fi
  [[ -d $WINDOWS ]] || /bin/mkdir -m 700 -- $WINDOWS || { print -r -- "runner-updater: REFUSE cannot create $WINDOWS"; return 1 }
  ru_w_dir=$WINDOWS/$ru_w_id.d
  /bin/mkdir -m 700 -- $ru_w_dir || { print -r -- "runner-updater: REFUSE cannot create $ru_w_dir"; return 1 }
  ru_w_backup=$ru_w_dir/config.toml.backup
  ru_wsay "rollback $fam ($cmd): to $ru_rb_prev; the window's files: $ru_w_dir"

  # FAMILY LINES on the backup: the image the family runs (the image the rollback leaves)
  /bin/cp -p -- $CONFIG $ru_w_backup && ru_w_sha $ru_w_backup \
    || { print -r -- "runner-updater: REFUSE cannot copy $CONFIG to $ru_w_backup"; return 1 }
  csha=$REPLY ru_w_bsha=$REPLY
  CONFIG=$ru_w_backup ru_config && ru_families && ru_pools || { print -r -- "runner-updater: REFUSE $REPLY: no rollback"; return 1 }
  (( ${+ru_fam[$fam]} )) || { print -r -- "runner-updater: REFUSE no family $fam in $FAMILIES: no rollback"; return 1 }
  # a pending hand edit (ru_rb_hand; and, below, CI disabled by a person): no try can start
  if ! ru_w_lines $fam; then ru_rb_hand $REPLY; return 1; fi
  cur=$REPLY ru_w_fsets=($reply) ru_w_old=$REPLY tgt=$ru_rb_prev ru_w_rbt=$ru_rb_prev
  [[ $cur != "$tgt" ]] || { print -r -- "runner-updater: REFUSE $fam runs $tgt already: no rollback"; return 1 }
  if [[ -n $ru_rb_clines ]]; then
    ru_w_target $cur $ru_w_fsets
    [[ $REPLY == "$ru_rb_clines" ]] \
      || { ru_rb_hand "$CONFIG names $REPLY for $fam, not its candidate's lines ($ru_rb_clines)"; return 1 }
  fi
  # the version it leaves, and the rejection (decided now, journaled): an automatic rollback rejects it, but the first
  # of a connect-class-only R1 does not (one retry after 1 h; the second rejects it); `back` rejects it only when it is
  # newer than the restored image's version
  if [[ -n $ru_rb_cand ]]; then v=$ru_rb_cand; else ru_w_version $cur && v=$REPLY; fi
  ru_w_version $tgt && tv=$REPLY
  ru_w_ver=$v
  if [[ $cmd == pass ]]; then
    if [[ $(print -r -- $ru_w_reason | $JQ -r '.connect_only') == true ]] && (( ! ru_rb_cofirst )); then rej=
    else rej=$v; fi
  elif [[ -n $v && -n $tv ]] && ru_rb_newer $v $tv; then rej=$v
  fi
  ru_w_reject=$rej
  # CI disabled by a person: nothing restarts (and no try can start: ru_rb_nocount)
  [[ -e $FLAG ]] || { ru_rb_nocount=flag; ru_rb_pending "CI disabled by a person ($FLAG is absent): nothing restarts"; return 2 }
  ru_w_pin_read $fam && ru_w_pinbefore=${REPLY:#none}
  # runner-enable --check (CI must come back after the switch), then PRE-VALIDATE the TARGET as a temp copy
  if ! ru_w_check; then ru_w_stop "ROLLBACK FAILED" "pre-window: $REPLY"; ru_w_hold_stops; return 1; fi
  ru_w_edit $ru_w_backup $ru_w_dir/config.toml.target $tgt $ru_w_fsets \
    || { ru_w_stop "ROLLBACK FAILED" "pre-window: the config edit: $REPLY"; ru_w_hold_stops; return 1 }
  ru_w_sha $ru_w_dir/config.toml.target || { print -r -- "runner-updater: REFUSE cannot read $ru_w_dir/config.toml.target"; return 1 }
  ru_w_tsha=$REPLY
  ru_w_target $tgt $ru_w_fsets
  ru_w_last_target=$REPLY
  if ! ru_w_validate pre $ru_w_dir/config.toml.target; then
    if [[ ${ru_w_vals[-1]-} == *' NON-API' ]]; then
      ru_w_stop "ROLLBACK FAILED" "pre-window $REPLY: the target ($tgt) is not one runscaler takes; no runner-disable"
      ru_w_hold_stops
      return 1
    fi
    ru_rb_retry "pre-window $REPLY"
    return $?
  fi
  # THE 2-H BOUND, before every runner-disable: an earlier try of this verdict ended with no rollback (a runner-disable
  # time-out, an UNKNOWN validate); past the bound no try starts
  ru_rb_bound "R1's verdict holds and no rollback has completed (a runner-disable that timed out, or a validate it could not read, ends a try)" \
    || return 1
  ru_w_read_from

  # R1's verdict, whole, in the window's folder (a journal line holds at most 900 bytes): RECOVER's ROLLED BACK reads
  # it by the sha of the `verdict` line (S3b-4a r1 P3-2)
  local vsha=
  if [[ -n $ru_w_reason ]] && ru_write $ru_w_dir/verdict.json "$ru_w_reason"$'\n' && ru_w_sha $ru_w_dir/verdict.json; then
    vsha=$REPLY
  fi
  # the window's start (ru_w_began: this call opened a journal, so it used the pass's one window)
  ru_w_open=1 ru_w_began=1
  ru_w_clean $ru_w_reason_text
  { ru_j window $ru_w_id && ru_j family $fam && ru_j kind rollback && ru_j command $cmd && ru_j version ${v:-none} \
      && ru_j reason "${REPLY:-?}" && { [[ -z $vsha ]] || ru_j verdict $vsha } && ru_j reject ${rej:-none} \
      && ru_j image $cur && ru_j image $tgt && ru_j pin-before ${ru_w_pinbefore:-none} && ru_j target $ru_w_last_target } \
    || return 3
  for f in $ru_w_vals; do ru_j validate $f || return 3; done
  ru_j from ${ru_w_from:-none} && ru_j config-sha $csha && ru_j backup $ru_w_backup && ru_j edited-sha $ru_w_tsha || return 3
  ru_protect $ru_state $EPOCHSECONDS \
    || { print -r -- "runner-updater: STOP the protected list cannot be written ($REPLY): the window journal stays open"; return 3 }
  if ! ru_w_sha $CONFIG || [[ $REPLY != "$csha" ]]; then
    print -r -- "runner-updater: REFUSE $CONFIG changed while the rollback checked it (its sha is not the backup's): no rollback; it is tried again"
    ru_w_archive || return 3
    return 2
  fi

  # runner-disable: the drain finishes busy jobs (no idle wait: the failing family's demand never blocks a rollback).
  # A failure (a time-out) is a rollback that cannot START: the journal stays open, RECOVER brings CI back, and the
  # rollback is tried again while the verdict holds (the 2-h bound)
  ru_j disable-start '' || return 3
  ru_wsay "runner-disable (runscaler drains every set; no idle wait)"
  $RELBIN/runner-disable
  rc=$?
  if (( rc != 0 )); then
    ru_j disable-failed $rc
    print -r -- "runner-updater: STOP runner-disable failed (exit $rc, above): the rollback could not start; the window journal stays open: the next run's RECOVER brings CI back, and the rollback is tried again"
    return 3
  fi
  ru_j disable-done '' || return 3
  ru_w_read_stopped
  ru_j stopped ${ru_w_stopped:-none} || return 3

  # CONFIG EDIT, under the runner lock (CONFIG EDIT's rule: a STOP after the install is the BACKUP back, CI on it)
  [[ -e $LOCK ]] || ( : >> $LOCK ) 2> /dev/null
  zsystem flock -t 0.01 -f ru_w_lfd $LOCK 2> /dev/null   # -t 0 returns 1 on a held lock (measured): 0.01 returns 2
  case $? in
    (0) ;;
    (2) ru_rb_back ROLLBACK "the runner lock $LOCK is held: runscaler, an install, wall-check, golden-build or golden-gate is running"; return $? ;;
    (*) ru_rb_back ROLLBACK "cannot take the runner lock $LOCK"; return $? ;;
  esac
  ru_w_csha
  if [[ $REPLY != "$csha" ]]; then
    t=$REPLY
    zsystem flock -u $ru_w_lfd
    ru_w_hand_lock $t
    case $? in (0|1) ru_rb_close 0; return $? ;; (*) return 3 ;; esac
  fi
  ru_w_bytes $ru_w_dir/config.toml.target && ru_write $CONFIG $REPLY \
    || { zsystem flock -u $ru_w_lfd; ru_rb_back ROLLBACK "cannot install the rollback's config: $REPLY"; return $? }
  ru_wsay "the config names $tgt for ${(j:, :)ru_w_fsets}"
  ru_w_validate post
  rc=$?
  zsystem flock -u $ru_w_lfd
  (( rc == 3 )) && return 3
  if (( rc != 0 )); then
    if [[ ${ru_w_vals[-1]-} == *' NON-API' ]]; then ru_rb_back ROLLBACK "after the edit: $REPLY"; return $?; fi
    ru_rb_back - "after the edit: $REPLY"; return $?
  fi
  ru_w_enable $ru_w_tsha
  rc=$?
  (( rc == 3 )) && return 3
  if (( rc == 0 && ${#ru_w_stops} == 0 )); then ru_rb_close 1; return $?; fi
  ru_rb_close 0
}
