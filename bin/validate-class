#!/bin/zsh -f
# validate-class RC OUTPUT_FILE — the ONE VALIDATE RULE: the class of one validate's result. RC is the exit code of
# `runner-start validate [CONFIG]` (which execs `runner validate`); OUTPUT_FILE holds its stdout and stderr together, in
# order. Every validate of the updater (before runner-disable, after a build, after the config edit) is classified
# here, so the rule has one copy: this header states it.
# It prints exactly one of these on stdout:
#   PASS      RC 0 and a line that is exactly "All checks passed.", with no "  ✗ " line and no "runner-start: REFUSE "
#             line (runscaler returns after every ✗ line, and runner-start exits 1 after a REFUSE, so either line with
#             RC 0 is a contradiction: UNKNOWN).
#   API-ONLY  RC not 0, no line that starts with "runner-start: REFUSE ", and the FIRST line that starts with "  ✗ " is
#             a GitHub API line: `  ✗ scaleset[N] "NAME" GitHub API: ` (NAME as Go's %q writes it). Every other line
#             is ignored: the scaleset client's log records (INFO, ERRO; from 0.10.0 INFO and ERROR in a 5-wide
#             column), the token-scopes hint, cobra's "Error:" and its usage. The API part reads only the URLs and the
#             tokens, which an image switch never changes.
#   NON-API   RC not 0 and a line that starts with "runner-start: REFUSE " (anywhere), or a FIRST "  ✗ " line that is
#             one of runscaler's config checks: "  ✗ config: ", "  ✗ global config: ", `  ✗ scaleset[N] "NAME": `,
#             "  ✗ scale set collection: " (cmd/runner/cmd_validate.go; runscaler v0.9.5 and v0.12.0: the same four
#             prints).
#   UNKNOWN   anything else: RC 0 without the PASS line, an empty OUTPUT_FILE, RC not 0 with no "  ✗ " line (cobra's
#             error alone: a config file that does not parse), or a first "  ✗ " line of another check (the Docker
#             client, Docker connectivity, the Tart binary: they test the host, not the config).
# Exit: 0 with the class on stdout. 2 on a usage error (not two arguments, RC not a whole number 0-255 without a
# leading zero, OUTPUT_FILE not a readable regular file): "validate-class: usage: ..." on stderr, nothing on stdout.
# It reads OUTPUT_FILE and nothing else, and runs no other program (no jq). It has no constant.
set -u
export LC_ALL=C   # bytes: "✗" is matched as its three UTF-8 bytes, whatever else the output holds

usage() { print -u2 -r -- "validate-class: usage: validate-class RC OUTPUT_FILE${1:+ ($1)}"; exit 2 }
(( $# == 2 )) || usage "two arguments"
[[ $1 =~ '^(0|[1-9][0-9]{0,2})$' ]] && (( $1 <= 255 )) || usage "RC is not a whole number 0-255: '$1'"
rc=$1 file=$2
[[ -f $file && -r $file ]] || usage "OUTPUT_FILE is not a readable regular file: '$file'"
text=$(<$file) || usage "OUTPUT_FILE cannot be read: '$file'"

# Go's %q: a quoted string whose inner quotes and backslashes are escaped
api_re='^  ✗ scaleset\[[0-9]+\] "([^"\\]|\\.)*" GitHub API: '
config_re='^  ✗ (config: |global config: |scale set collection: |scaleset\[[0-9]+\] "([^"\\]|\\.)*": )'

refuse=0 passed=0 first=
for l in "${(@f)text}"; do
  [[ $l == 'runner-start: REFUSE '* ]] && refuse=1
  [[ $l == 'All checks passed.' ]] && passed=1
  [[ -z $first && $l == '  ✗ '* ]] && first=$l   # the FIRST failed check only: runscaler stops at it
done

if (( rc == 0 )); then
  if (( passed && ! refuse )) && [[ -z $first ]]; then print -r -- PASS; else print -r -- UNKNOWN; fi
elif (( refuse )); then print -r -- NON-API
elif [[ $first =~ $api_re ]]; then print -r -- API-ONLY
elif [[ $first =~ $config_re ]]; then print -r -- NON-API
else print -r -- UNKNOWN
fi
exit 0
